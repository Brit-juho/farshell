{
  "name": "FarShell",
  "version": "1.0.0",
  "private": true,
  "description": "FarShell frontend test tooling (jsdom for DOM-dependent unit tests)",
  "keywords": [
    "remote-terminal",
    "tmux",
    "voice-coding",
    "pwa",
    "self-hosted",
    "claude-code",
    "ssh-alternative",
    "mobile-terminal",
    "speech-to-text"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && VOICE_BUILD=1 vite build",
    "watch": "vite build --watch",
    "test": "npm run typecheck && node --experimental-vm-modules --test frontend/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brit-juho/farshell.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Brit-juho/farshell/issues"
  },
  "homepage": "https://github.com/Brit-juho/farshell#readme",
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.5",
    "dompurify": "3.4.17",
    "jsdom": "^31.0.0",
    "marked": "18.1.3",
    "solid-js": "^1.9.15",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
