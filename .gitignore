# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node (혹시 prebuild 도입 시)
node_modules/
dist/
build/
.next/

# OS
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs / runtime
*.log
*.bak

# Local config (절대 커밋 금지 — 토큰·시크릿)
.env
.env.local
.vt.env

# 세션 임시 파일 (ralph-loop, 자동 생성 상태)
.claude/*.local.md
.claude/settings.local.json
.claude/sessions/
**/.claude/ralph-loop.local.md
server/.claude/

# 작업/플랜/점검/리뷰 문서 (가이드는 루트 유지)
docs/*
# 단, vt help가 런타임에 사용하는 도움말 토픽은 추적 (W2-5)
!docs/help/
