# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node — F1(2026-09)에서 Vite/Tailwind 빌드 도입. frontend/dist/ 가 산출물(ADR-2, 커밋 안 함)
node_modules/
dist/
build/
.next/

# OS
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs / runtime
*.log
*.bak

# Local config (절대 커밋 금지 — 토큰·시크릿)
.env
.env.local
.vt.env

# 세션 임시 파일 (ralph-loop, 자동 생성 상태)
.claude/*.local.md
.claude/settings.local.json
.claude/sessions/
**/.claude/ralph-loop.local.md
server/.claude/

# 작업/플랜/점검/리뷰 문서 (가이드는 루트 유지)
docs/*
# 단, vt help가 런타임에 사용하는 도움말 토픽은 추적 (W2-5)
!docs/help/
.gstack/

# 릴리스 산출물 — .github/workflows/release.yml 이 저장소 루트에 만든다.
# 로컬에서 릴리스 절차를 시험해보면(scripts/release_notes.py, tar czf) 그대로 남는다.
RELEASE_NOTES.md
farshell-*.tar.gz

# .claude/ 는 부분 추적이다. 추적하는 것은 .claude/skills/ 하나뿐 —
# 저장소가 제공하는 fsh 스킬이라 클론한 사람에게 따라가야 한다.
#
# settings.json + hooks/ 는 개인/팀 툴체인 설정이라 제외한다. settings.json 의
# PreToolUse 훅이 gstack 미설치 환경에서 Skill 사용을 전부 deny 하므로, 추적하면
# 클론한 사람의 Claude Code 가 망가진다(파일은 로컬에 남아 내 환경에서는 계속 동작).
.claude/settings.json
.claude/hooks/

# 나머지는 하네스가 만드는 런타임 상태. 예전엔 .git/info/exclude 에만 있었는데
# 그건 clone 시 공유되지 않아서, 다른 사람이 받으면 미추적 파일로 쏟아졌다.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/agent-registry.json
.claude/assistant-daemon-state.json
.claude/first-run
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-memory-local/

# install.sh가 만들던 구 vendor 다운로드 경로 (지금은 frontend/vendor/가 git에 직접
# 커밋되어 서빙되므로 install.sh의 다운로드 단계는 제거됨 — 예전 로컬 잔여물 방지용)
frontend/static/
