*.py[cod]
*$py.class
.venv/
.venv          # 심링크로 커밋된 적이 있다(절대 경로가 그대로 노출됐다)
venv/
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node — F1(2026-09)에서 Vite/Tailwind 빌드 도입. frontend/dist/ 가 산출물(ADR-2, 커밋 안 함)
node_modules/
dist/
# N18 — `vite build --mode test`(tests/helpers/solid-env.js) 산출물
dist-test/
