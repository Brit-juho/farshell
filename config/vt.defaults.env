# voice-terminal — 기본 설정 (커밋됨)
#
# 이 파일은 모든 사용자에게 공유되는 기본값입니다.
# 사용자별 설정은 ~/.vt.env에 두세요 (gitignored, install.sh가 자동 생성).
# 로드 우선순위: 환경변수 > ~/.vt.env > 이 파일 > bin/vt 내부 기본값
#
# 주석을 풀어 ~/.vt.env로 복사해서 사용하세요.

# ── 네트워크 ──────────────────────────────────────────────
# VT_PORT=7777                    # 서버 포트
# VT_START_DIR=                    # 새 세션(셸/tmux)의 시작 디렉토리. 미설정 시 홈(~).
#   - 예전엔 서버 cwd(프로젝트 폴더)에서 열려서, 홈이 기본이 되도록 변경됨
#   - 예: VT_START_DIR=~/projects 로 특정 폴더에서 시작
# ── 인증 (웹 접속 보호) ───────────────────────────────────
# VT_AUTH_TOKEN=                  # 기계용 토큰(데몬/QR/URL). 설정 시 인증 활성화 (= 레거시 VT_TOKEN)
# ↓ 아래 둘은 'vt password'가 관리 — 직접 편집 금지
# VT_AUTH_PASSWORD_HASH=          # 웹 로그인 비밀번호 scrypt 해시. 원문 미저장 (= 레거시 VT_PASSWORD_HASH)
# VT_AUTH_SESSION_KEY=            # 세션 쿠키 HMAC 서명키. 자동 생성 (= 레거시 VT_SECRET_KEY)
# VT_NOTIFY_URL=                  # 푸시 알림 ntfy URL (D2, 선택)
# VT_NETWORK_MODE=all             # localhost | lan | tailscale | all (vt mobile --network와 동일)
#   - tailscale: Cloudflare 터널 없이 tailnet CIDR(100.64.0.0/10)+localhost만 허용.
#     회사망처럼 LAN 자체를 못 믿는 환경에서 vt mobile --network tailscale로 사용 (D9)
# VT_NOTIFY_CLIENT_EVENTS=0       # 1이면 tmux client-attached/detached 시 push 알림
#   - SSH(vt ssh)처럼 서버가 자연히 못 보는 클라이언트의 접속을 가시화 (D9)
#   - VT_NOTIFY_URL 또는 VT_TELEGRAM_TOKEN/CHAT_ID가 설정돼 있어야 실제로 전송됨

# ── Python 실행 환경 ───────────────────────────────────────
# VT_PYTHON 자동 감지 순서:
#   1) 환경변수 VT_PYTHON / ~/.vt.env
#   2) 프로젝트 .venv/bin/python (install.sh 결과)
#   3) 시스템 python3
#
# 직접 지정하려면:
# VT_PYTHON=/path/to/python
#
# 예시 — conda whisper env 사용 시:
# VT_PYTHON=/opt/homebrew/Caskroom/miniforge/base/envs/whisper/bin/python
#
# 예시 — pyenv 사용 시:
# VT_PYTHON=$HOME/.pyenv/versions/3.11.7/bin/python

# ── tmux 격리 ─────────────────────────────────────────────
# VT_TMUX_SOCKET=vt               # 격리 소켓 이름 (기존 tmux와 충돌 방지)
# VT_TMUX_CONF=                   # 사용자 정의 tmux.conf 경로

# ── 음성 / Voice Daemon ───────────────────────────────────
# VT_HOTKEY=ctrl+shift+v          # 음성 입력 토글 핫키
# VT_STT_BACKEND=auto             # auto | mlx-whisper | faster-whisper
# VT_TTS_BACKEND=auto             # auto | edge-tts | say | espeak-ng

# ── 클립보드 동기화 (vt clip) ──────────────────────────────
# VT_CLIPBOARD_POLL_SEC=0.7       # NSPasteboard.changeCount 폴링 간격(초)

# ── 안전 모드 ─────────────────────────────────────────────
# VT_SAFE_MODE=0                  # 1로 설정 시 Claude 위험 도구 차단 강화
# VT_DISALLOWED_TOOLS=            # Claude --disallowedTools 직접 지정
