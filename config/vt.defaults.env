# farshell — 기본 설정 (커밋됨)
#
# 이 파일은 모든 사용자에게 공유되는 기본값입니다.
# 사용자별 설정은 ~/.vt.env에 두세요 (gitignored, install.sh가 자동 생성).
# 로드 우선순위: 환경변수 > ~/.vt.env > 이 파일 > bin/vt 내부 기본값
#
# ~/.vt.env 형식 (lib/vt_env.sh가 정의, server/vt_env.py가 같은 규칙으로 읽음):
#   'literal'   홑따옴표 — 확장 없음. 값에 $나 공백이 있으면 이걸 쓰세요. (writer 기본)
#   "expanded"  큰따옴표 — ${VAR} / $VAR 확장
#   bare        따옴표 없음 — 공백 전까지, 확장 있음
#
#   이 파일들은 실행되지 않습니다(source 아님). 명령 치환 $( ) / 백틱 / 조건문은
#   지원하지 않으며 리터럴로 남습니다. 동적인 값이 필요하면 셸 rc에
#   'export VT_X=$(...)' 를 두세요 — 환경변수가 파일보다 우선합니다.
#
#   'vt doctor'가 형식·권한(600)·값이 사라지는 참조를 점검합니다.
#   쓰기는 vt password / vt hotkey / vt tunnel setup 등 vt 명령을 쓰세요.
#
# 주석을 풀어 ~/.vt.env로 복사해서 사용하세요.

# ── 네트워크 ──────────────────────────────────────────────
# VT_PORT=7777                    # 서버 포트
# VT_START_DIR=                    # 새 세션(셸/tmux)의 시작 디렉토리. 미설정 시 홈(~).
#   - 예전엔 서버 cwd(프로젝트 폴더)에서 열려서, 홈이 기본이 되도록 변경됨
#   - 예: VT_START_DIR=~/projects 로 특정 폴더에서 시작
# ── 인증 (웹 접속 보호) ───────────────────────────────────
# VT_AUTH_TOKEN=                  # 기계용 토큰(데몬 전용). 설정 시 인증 활성화 (= 레거시 VT_TOKEN)
#   - QR/URL에는 더 이상 쓰지 않는다: 'vt mobile'은 5분짜리 1회용 등록 티켓(?ticket=)을 싣는다.
#     상시 토큰을 URL에 박으면 로그·브라우저 히스토리·QR 이미지에 영구히 남는다.
# ↓ 아래 둘은 'vt password'가 관리 — 직접 편집 금지
# VT_AUTH_PASSWORD_HASH=          # 웹 로그인 비밀번호 scrypt 해시. 원문 미저장 (= 레거시 VT_PASSWORD_HASH)
# VT_AUTH_SESSION_KEY=            # 세션 쿠키 HMAC 서명키. 자동 생성 (= 레거시 VT_SECRET_KEY)
#
# OTP(새 기기 등록 관문)와 등록 기기 목록은 여기가 아니라 ~/.vt/ 아래 상태 파일로 관리된다
# (서버 재시작 없이 즉시 반영). 조작은 'vt otp' / 'vt device' 명령으로만 하세요.
#
# VT_ALLOWED_ORIGINS=             # 추가 허용 출처(콤마 구분). 기본은 동일 출처만 허용이며,
#   그 외 Origin은 HTTP·WS 모두 403이다. 임의의 웹사이트가 localhost:7777에 붙어
#   명령을 실행하는 것(쿠키가 있으면 인증도 통과한다)을 막는 유일한 방어선이므로,
#   외부 클라이언트를 직접 붙이는 경우에만 최소한으로 여세요.
# VT_MAX_UPLOAD_MB=200            # 업로드 최대 크기
# VT_STATE_DIR=                   # 런타임 상태 디렉토리 (기본 ~/.vt)
# VT_NOTIFY_URL=                  # 푸시 알림 ntfy URL (D2, 선택)
# VT_NETWORK_MODE=all             # localhost | lan | tailscale | all (vt mobile --network와 동일)
#   - tailscale: Cloudflare 터널 없이 tailnet CIDR(100.64.0.0/10)+localhost만 허용.
#     회사망처럼 LAN 자체를 못 믿는 환경에서 vt mobile --network tailscale로 사용 (D9)
# VT_NOTIFY_CLIENT_EVENTS=0       # 1이면 tmux client-attached/detached 시 push 알림
#   - SSH(vt ssh)처럼 서버가 자연히 못 보는 클라이언트의 접속을 가시화 (D9)
#   - VT_NOTIFY_URL 또는 VT_TELEGRAM_TOKEN/CHAT_ID가 설정돼 있어야 실제로 전송됨

# ── 터널 URL 변경 훅 ──────────────────────────────────────
# 익명 터널은 재시작마다 URL이 바뀐다. 바뀔 때 임의의 명령을 한 번 부른다.
# stdin으로 "라벨<TAB>URL" 줄들이 들어가고, VT_TUNNEL_EVENT/VT_TUNNEL_MAIN_URL이 env로 전달된다.
# 어디로 보낼지는 각자 다르므로(Notion/Slack/ntfy/파일...) vt는 서비스를 알지 않는다.
# 예시와 주의사항: vt help tunnel-hook
# ⚠ 훅에 토큰이 필요하면 그 값도 ~/.vt.env(홈, gitignored)에만 둘 것.
# VT_TUNNEL_HOOK=                 # 예: 'cat > ~/Documents/vt-urls.txt'
# VT_TUNNEL_MAIN_LABEL=터미널 (VT) # 메인 URL에 붙일 라벨 (훅 stdin 첫 줄)

# ── Python 실행 환경 ───────────────────────────────────────
# VT_PYTHON 자동 감지 순서:
#   1) 환경변수 VT_PYTHON / ~/.vt.env
#   2) 프로젝트 .venv/bin/python (install.sh 결과)
#   3) 시스템 python3
#
# 직접 지정하려면:
# VT_PYTHON=/path/to/python
#
# 예시 — conda whisper env 사용 시:
# VT_PYTHON=/opt/homebrew/Caskroom/miniforge/base/envs/whisper/bin/python
#
# 예시 — pyenv 사용 시:
# VT_PYTHON=$HOME/.pyenv/versions/3.11.7/bin/python

# ── tmux 격리 ─────────────────────────────────────────────
# VT_TMUX_SOCKET=vt               # 격리 소켓 이름 (기존 tmux와 충돌 방지)
# VT_TMUX_CONF=                   # 사용자 정의 tmux.conf 경로

# ── 음성 / Voice Daemon ───────────────────────────────────
# VT_HOTKEY=ctrl+shift+v          # 음성 입력 토글 핫키
# VT_STT_BACKEND=auto             # auto | mlx-whisper | faster-whisper
# VT_TTS_BACKEND=auto             # auto | edge-tts | say | espeak-ng

# ── 클립보드 동기화 (vt clip) ──────────────────────────────
# VT_CLIPBOARD_POLL_SEC=0.7       # NSPasteboard.changeCount 폴링 간격(초)

# ── 안전 모드 ─────────────────────────────────────────────
# VT_SAFE_MODE=0                  # 1로 설정 시 Claude 위험 도구 차단 강화
# VT_DISALLOWED_TOOLS=            # Claude --disallowedTools 직접 지정

# ── 프롬프트 큐 (P4) ───────────────────────────────────────
# 에이전트가 작업 중일 때 지시를 쌓아뒀다 순차 투입. 저장은 ~/.vt/queue.json (0600).
# 자동 투입은 Claude Code의 stop 훅에서만 걸린다 — codex/aider는 훅이 없어
# 'vt queue run' 또는 웹UI "지금 실행"으로 수동 투입해야 한다.
# VT_QUEUE_AUTODRAIN=1          # 0이면 자동 투입 끔(수동 실행만)
# VT_QUEUE_GRACE_SEC=3          # stop 직후 이만큼 기다렸다 투입.
#                               # 0으로 두면 사용자가 직접 타이핑을 시작한 중간에 끼어든다.

# ── 코드 뷰어 (읽기 전용, P2) ──────────────────────────────
# 웹 UI의 "코드 뷰어"가 열람할 수 있는 루트. ':' 로 여러 개 지정.
# ⚠ $HOME 을 넣지 말 것 — ~/.ssh, ~/.aws 가 통째로 사정권에 들어온다.
#   (거부 목록이 2차로 막지만, 루트를 좁히는 것이 1차 방어선이다)
# VT_BROWSE_ROOTS=$HOME/GitHub    # 기본값. 예: $HOME/GitHub:$HOME/work
# VT_FS_MAX_BYTES=524288          # 파일 1건 최대 전송 바이트. 초과분은 잘리고 truncated 표시

# ── 터널 좀비 재연결 워치독 (server/tunnel_watchdog.py) ────
# cloudflared가 프로세스는 살아있는데(kill -0 성공) 엣지와의 컨트롤 스트림만
# 끊긴 채 재연결을 무한 반복하는 상태를 감지해 'vt tunnel restart'를 자동 호출.
# vt start/voice/mobile 시 자동 기동. 상태 확인: vt status / vt tunnel watchdog
# VT_TUNNEL_WATCHDOG_POLL_SEC=20      # 로그 확인 주기(초)
# VT_TUNNEL_WATCHDOG_WINDOW_SEC=90    # 이 시간 안의 실패만 카운트
# VT_TUNNEL_WATCHDOG_THRESHOLD=4      # WINDOW_SEC 안에 이 횟수 이상이면 좀비로 판단
# VT_TUNNEL_WATCHDOG_COOLDOWN_SEC=120 # 재시작 직후 이 시간 동안은 재판정 안 함(폭주 방지)

# ── Web Push (P5) ──────────────────────────────────────────
# 앱이 닫혀 있어도 작업 완료 알림을 받는다. pywebpush 필요(requirements-core).
# ⚠ https 접속에서만 동작한다 — 평문 http에서는 브라우저가 Service Worker를 막는다.
# ⚠ iOS는 홈 화면에 PWA로 추가해야 한다(iOS 16.4+). 사파리 탭에서는 구독이 안 만들어진다.
# ⚠ 구독은 origin에 묶인다. trycloudflare URL이 바뀌면 기존 구독은 무효가 되고
#   재구독이 필요하다(서버가 자동으로 건너뛰고, 만료 응답은 그때 정리한다).
# VAPID 키는 ~/.vt/vapid.json(0600)에 자동 생성 — 지우면 기존 구독이 전부 무효화된다.
# VT_PUSH_SUBJECT=mailto:vt@localhost   # VAPID claims의 sub (푸시 서비스가 연락처로 씀)
