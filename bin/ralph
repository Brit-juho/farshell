#!/bin/bash
# ralph — Voice Terminal 통합 CLI
# 어디서든 실행 가능. 노션 작업 중에도 음성으로 코딩.
#
# 사용법:
#   ralph voice    — 음성 모드 (백그라운드, 작업 방해 없음)
#   ralph mobile   — 모바일 접속 URL 제공 (서버 자동 시작)
#   ralph start    — 서버 + 터널 시작
#   ralph stop     — 모든 ralph 프로세스 종료
#   ralph status   — 현재 상태 확인

set -uo pipefail

# 심링크를 따라가서 실제 경로 찾기
_SELF="$0"
[ -L "$_SELF" ] && _SELF="$(readlink "$_SELF")"
RALPH_DIR="$(cd "$(dirname "$_SELF")/.." && pwd)"
RALPH_CONFIG="$HOME/.ralph.env"

# 설정 파일 로드 (있으면)
[ -f "$RALPH_CONFIG" ] && source "$RALPH_CONFIG"

# 설정 가능한 변수 (환경변수 또는 ~/.ralph.env로 오버라이드)
RALPH_PORT="${RALPH_PORT:-7777}"

# Python 자동 감지 — 우선순위:
#   1) 환경변수 RALPH_PYTHON / ~/.ralph.env
#   2) 프로젝트 .venv (install.sh로 만든 것)
#   3) legacy whisper conda env (기존 사용자 호환)
#   4) 시스템 python3
_detect_python() {
  if [ -x "$RALPH_DIR/.venv/bin/python" ]; then
    echo "$RALPH_DIR/.venv/bin/python"
  elif [ -x "/opt/homebrew/Caskroom/miniforge/base/envs/whisper/bin/python" ]; then
    echo "/opt/homebrew/Caskroom/miniforge/base/envs/whisper/bin/python"
  else
    command -v python3 2>/dev/null || echo python3
  fi
}
RALPH_PYTHON="${RALPH_PYTHON:-$(_detect_python)}"
SERVER_LOG="/tmp/ralphton-server.log"
TUNNEL_LOG="/tmp/cloudflared.log"
DAEMON_LOG="/tmp/ralph-voice-daemon.log"
PID_DIR="/tmp/ralph-pids"
mkdir -p "$PID_DIR"

_is_running() {
  local pidfile="$PID_DIR/$1.pid"
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

_port_in_use() {
  "$RALPH_PYTHON" -c "import socket;s=socket.socket();s.settimeout(1);exit(0 if s.connect_ex(('127.0.0.1',$1))==0 else 1)" 2>/dev/null
}

_start_server() {
  if _port_in_use $RALPH_PORT; then
    echo "✓ 서버 이미 실행 중 (port $RALPH_PORT)"
    return 0
  fi
  echo "▸ 서버 시작 중..."
  cd "$RALPH_DIR/server"
  nohup "$RALPH_PYTHON" -m uvicorn main:app --host 0.0.0.0 --port $RALPH_PORT > "$SERVER_LOG" 2>&1 &
  echo $! > "$PID_DIR/server.pid"
  sleep 2
  if curl -sf http://localhost:$RALPH_PORT/ -o /dev/null 2>/dev/null; then
    echo "✓ 서버 시작 완료 (http://localhost:$RALPH_PORT)"
  else
    echo "✗ 서버 시작 실패. 로그: $SERVER_LOG"
    return 1
  fi
}

_start_tunnel() {
  if _is_running tunnel; then
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    echo "✓ 터널 이미 실행 중: $url"
    return 0
  fi
  echo "▸ Cloudflare Tunnel 시작 중..."
  : > "$TUNNEL_LOG"
  nohup cloudflared tunnel --url http://localhost:$RALPH_PORT > "$TUNNEL_LOG" 2>&1 &
  echo $! > "$PID_DIR/tunnel.pid"
  # URL 추출 대기
  for i in $(seq 1 30); do
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    if [ -n "$url" ]; then
      echo "✓ 터널: $url"
      return 0
    fi
    sleep 1
  done
  echo "✗ 터널 URL 대기 시간 초과. 로그: $TUNNEL_LOG"
  return 1
}

_start_voice_daemon() {
  if _is_running voice; then
    echo "✓ Voice Daemon 이미 실행 중"
    return 0
  fi
  echo "▸ Voice Daemon 시작 중..."
  nohup "$RALPH_PYTHON" "$RALPH_DIR/server/voice_daemon.py" > "$DAEMON_LOG" 2>&1 &
  echo $! > "$PID_DIR/voice.pid"
  sleep 1
  if _is_running voice; then
    echo "✓ Voice Daemon 시작 (Ctrl+Shift+V 로 녹음)"
  else
    echo "✗ Voice Daemon 실패. 로그: $DAEMON_LOG"
    return 1
  fi
}

_ensure_tmux() {
  if ! tmux list-sessions 2>/dev/null | grep -q .; then
    # -x/-y로 윈도우 크기를 명시 → detached 상태에서 tcgetattr 실패 방지
    tmux new-session -d -s dev -x 200 -y 50
    echo "✓ tmux 세션 'dev' 생성"
  else
    echo "✓ tmux 세션 존재: $(tmux list-sessions -F '#{session_name}' | tr '\n' ' ')"
  fi
}

# 새 터미널 창에서 tmux dev 세션 + claude --resume 자동 실행.
# 이미 tmux 안에 있으면 호출하지 않음 (멱등성).
# $TERM_PROGRAM 기반으로 현재 쓰는 터미널 앱에 맞춰 오픈.
# 지원: iTerm2, Terminal.app(Apple), WezTerm, Warp, Alacritty, Kitty, Ghostty
_open_tmux_terminal() {
  [ "$(uname)" = "Darwin" ] || return 1

  local cmd='tmux new -A -s dev "claude --resume"'
  local term="${TERM_PROGRAM:-}"
  # 소문자 정규화 (kitty 등 일부 터미널은 소문자로 설정)
  local term_lc
  term_lc="$(printf '%s' "$term" | tr '[:upper:]' '[:lower:]')"

  _try_iterm() {
    [ -d "/Applications/iTerm.app" ] || return 1
    osascript <<APPLESCRIPT 2>/dev/null
tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "$cmd"
  end tell
end tell
APPLESCRIPT
  }

  _try_terminal_app() {
    osascript <<APPLESCRIPT 2>/dev/null
tell application "Terminal"
  activate
  do script "$cmd"
end tell
APPLESCRIPT
  }

  _try_wezterm() {
    command -v wezterm >/dev/null 2>&1 || return 1
    wezterm cli spawn --new-window -- bash -lc "$cmd" >/dev/null 2>&1
  }

  _try_warp() {
    # Warp는 URL scheme 제한적 — 새 탭을 열되 명령 주입은 클립보드로
    [ -d "/Applications/Warp.app" ] || return 1
    open -na Warp 2>/dev/null || return 1
    # 사용자에게 명령 복사 안내
    printf '%s' "$cmd" | pbcopy 2>/dev/null
    echo "  ⓘ Warp 새 창 열림 — 아래 명령이 클립보드에 복사됨. 붙여넣기 하세요:"
    echo "      $cmd"
  }

  _try_alacritty() {
    [ -d "/Applications/Alacritty.app" ] || return 1
    open -na Alacritty --args -e bash -lc "$cmd; exec bash" 2>/dev/null
  }

  _try_kitty() {
    [ -d "/Applications/kitty.app" ] || return 1
    open -na kitty --args bash -lc "$cmd; exec bash" 2>/dev/null
  }

  _try_ghostty() {
    [ -d "/Applications/Ghostty.app" ] || return 1
    open -na Ghostty --args -e bash -lc "$cmd; exec bash" 2>/dev/null
  }

  # 1순위: 현재 사용 중인 터미널
  case "$term" in
    iTerm.app)        _try_iterm        && return 0 ;;
    Apple_Terminal)   _try_terminal_app && return 0 ;;
    WezTerm)          _try_wezterm      && return 0 ;;
    WarpTerminal)     _try_warp         && return 0 ;;
  esac
  case "$term_lc" in
    ghostty)          _try_ghostty      && return 0 ;;
    kitty)            _try_kitty        && return 0 ;;
    alacritty)        _try_alacritty    && return 0 ;;
  esac

  # 2순위: 설치된 터미널을 우선순위대로 시도
  _try_iterm        && return 0
  _try_ghostty      && return 0
  _try_wezterm      && return 0
  _try_kitty        && return 0
  _try_alacritty    && return 0
  _try_terminal_app && return 0  # Terminal.app은 어디에나 있지만 최후
  return 1
}

_print_attach_guide() {
  echo ""
  if [ -n "${TMUX:-}" ]; then
    echo "  ✓ 이미 tmux 안 ($(tmux display -p '#S')). 이 창에서 작업을 계속하세요."
    return
  fi
  if _open_tmux_terminal; then
    local opened="${TERM_PROGRAM:-터미널}"
    echo "  ✓ 새 ${opened} 창에 tmux 'dev' 세션이 열렸습니다."
    echo "    → resume 목록에서 현재 대화를 고르면 음성/모바일이 그 Claude로 연결됩니다."
  else
    echo "  ⓘ 자동 오픈 실패. 다른 터미널에서 다음 명령을 실행하세요:"
    echo "      tmux new -A -s dev 'claude --resume'"
  fi
}

cmd_voice() {
  echo ""
  echo "  🎤 ralph voice — 음성 모드"
  echo "  노션/브라우저 작업을 계속하면서 음성으로 코딩"
  echo ""

  _ensure_tmux
  _start_server
  _start_voice_daemon

  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  echo "  │  음성 모드 활성화 완료                      │"
  echo "  │                                         │"
  echo "  │  Ctrl+Shift+V → 녹음 시작/종료           │"
  echo "  │  말한 내용 → STT → tmux에 자동 입력       │"
  echo "  │  결과 → TTS로 음성 확인                   │"
  echo "  │                                         │"
  echo "  │  작업을 계속하세요. 음성이 백그라운드에서    │"
  echo "  │  동작합니다.                              │"
  echo "  │                                         │"
  echo "  │  종료: ralph stop                        │"
  echo "  └─────────────────────────────────────────┘"

  _print_attach_guide
  echo ""
}

cmd_mobile() {
  # 옵션: --e2e 로 E2E 암호화 모드 (D3)
  local want_e2e=0
  for arg in "$@"; do
    [ "$arg" = "--e2e" ] && want_e2e=1
  done

  echo ""
  echo "  📱 ralph mobile — 모바일 접속$([ $want_e2e -eq 1 ] && echo ' (E2E 암호화)')"
  echo ""

  _ensure_tmux
  _start_server
  _start_tunnel

  local url
  url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
  local token=${RALPH_TOKEN:-}
  # E2E 활성화 시 URL hash fragment에 #e2e=1 추가 (서버 로그에 안 남음)
  local e2e_frag=""
  [ $want_e2e -eq 1 ] && e2e_frag="#e2e=1"

  # 최종 URL 빌드 (토큰 + E2E hash)
  local full_url="$url"
  [ -n "$token" ] && full_url="${url}?token=${token}"
  full_url="${full_url}${e2e_frag}"

  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  echo "  │  모바일 접속 준비 완료                     │"
  echo "  │                                         │"
  echo "  │  URL: $full_url"
  echo "  │                                         │"
  echo "  │  폰 브라우저에서 위 URL을 열면             │"
  echo "  │  tmux 세션에 자동 연결됩니다               │"
  if [ $want_e2e -eq 1 ]; then
  echo "  │                                         │"
  echo "  │  🔒 E2E 암호화 모드                        │"
  echo "  │     cloudflared 터널이 평문을 볼 수 없음   │"
  fi
  echo "  │                                         │"
  echo "  │  🎧 음성 전용 모드: 🎧 버튼 탭            │"
  echo "  │  🔄 핸즈프리: 🔄 버튼 탭                  │"
  echo "  │                                         │"
  echo "  │  종료: ralph stop                        │"
  echo "  └─────────────────────────────────────────┘"
  echo ""

  # QR 코드 (qrencode 설치 시)
  if command -v qrencode >/dev/null 2>&1; then
    echo "  QR 코드:"
    qrencode -t UTF8 "$full_url" 2>/dev/null || true
  fi

  # adb 연결 시 자동 열기
  if adb devices 2>/dev/null | grep -q "device$"; then
    echo "  📱 Android 기기 감지. Chrome에서 열기..."
    adb shell am start -a android.intent.action.VIEW -d "$full_url" com.android.chrome 2>/dev/null || true
  fi

  _print_attach_guide
}

cmd_start() {
  echo ""
  echo "  🚀 ralph start — 전체 시작"
  echo ""

  _ensure_tmux
  _start_server
  _start_tunnel
  _start_voice_daemon

  echo ""
  echo "  모든 서비스 시작 완료."
  echo "  ralph status 로 상태 확인"

  _print_attach_guide
  echo ""
}

cmd_stop() {
  echo ""
  echo "  ⏹  ralph stop"
  echo ""

  for svc in voice tunnel server; do
    local pidfile="$PID_DIR/$svc.pid"
    if [ -f "$pidfile" ]; then
      local pid
      pid=$(cat "$pidfile")
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        echo "  ✓ $svc 종료 (PID $pid)"
      fi
      rm -f "$pidfile"
    fi
  done

  # 혹시 남은 프로세스 정리
  pkill -f "voice_daemon.py" 2>/dev/null || true
  pkill -f "cloudflared tunnel" 2>/dev/null || true
  if command -v lsof >/dev/null 2>&1; then
    lsof -i :$RALPH_PORT -t 2>/dev/null | xargs kill 2>/dev/null || true
  elif command -v fuser >/dev/null 2>&1; then
    fuser -k $RALPH_PORT/tcp 2>/dev/null || true
  fi

  echo "  ✓ 모든 ralph 프로세스 종료"
  echo ""
}

cmd_doctor() {
  # 설치 상태 및 실행 환경 진단
  echo ""
  echo "  🩺 ralph doctor — 설치/환경 진단"
  echo ""

  local ok=0 warn=0 fail=0
  _check() {
    local label="$1" status="$2" detail="$3"
    case "$status" in
      ok)   printf "  ✓ %-22s %s\n" "$label" "$detail"; ok=$((ok+1)) ;;
      warn) printf "  ⚠ %-22s %s\n" "$label" "$detail"; warn=$((warn+1)) ;;
      fail) printf "  ✗ %-22s %s\n" "$label" "$detail"; fail=$((fail+1)) ;;
    esac
  }

  # 1. Python
  if [ -x "$RALPH_PYTHON" ]; then
    local pyver; pyver="$("$RALPH_PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "?")"
    _check "Python" ok "$RALPH_PYTHON (v$pyver)"
  else
    _check "Python" fail "$RALPH_PYTHON — 실행 불가. install.sh 재실행"
  fi

  # 2. venv
  if [ -d "$RALPH_DIR/.venv" ]; then
    _check "venv" ok "$RALPH_DIR/.venv"
  elif [ -d "/opt/homebrew/Caskroom/miniforge/base/envs/whisper" ]; then
    _check "venv" warn "legacy conda whisper env 사용 중 (install.sh로 venv 전환 권장)"
  else
    _check "venv" fail ".venv 없음 → './install.sh' 실행"
  fi

  # 3. 핵심 Python 패키지
  if "$RALPH_PYTHON" -c "import fastapi, uvicorn" 2>/dev/null; then
    _check "core packages" ok "fastapi, uvicorn 설치됨"
  else
    _check "core packages" fail "pip install -r requirements-core.txt"
  fi
  if "$RALPH_PYTHON" -c "import faster_whisper, edge_tts, sounddevice" 2>/dev/null; then
    _check "voice packages" ok "faster-whisper, edge-tts, sounddevice"
  else
    _check "voice packages" warn "음성 기능 미설치 ('./install.sh voice'로 추가)"
  fi

  # 4. tmux
  if command -v tmux >/dev/null 2>&1; then
    _check "tmux" ok "$(tmux -V)"
  else
    _check "tmux" fail "brew install tmux / apt install tmux"
  fi

  # 5. cloudflared (원격 접속용)
  if command -v cloudflared >/dev/null 2>&1; then
    _check "cloudflared" ok "$(cloudflared --version 2>&1 | head -1)"
  else
    _check "cloudflared" warn "원격 접속 시 필요. brew install cloudflared"
  fi

  # 6. ffmpeg (모바일 음성 입력 디코딩)
  if command -v ffmpeg >/dev/null 2>&1; then
    _check "ffmpeg" ok "설치됨"
  else
    _check "ffmpeg" warn "모바일 음성 입력 시 필요. brew install ffmpeg"
  fi

  # 7. 포트 사용 상태
  if _port_in_use "$RALPH_PORT"; then
    _check "port $RALPH_PORT" warn "사용 중 (서버 이미 실행 중일 수 있음)"
  else
    _check "port $RALPH_PORT" ok "사용 가능"
  fi

  # 8. ralph CLI 심링크
  if [ -L "$HOME/.local/bin/ralph" ]; then
    _check "ralph CLI" ok "~/.local/bin/ralph"
  elif [ -f "$HOME/.local/bin/ralph" ]; then
    _check "ralph CLI" warn "심링크 아닌 파일 (install.sh 재실행 권장)"
  else
    _check "ralph CLI" warn "~/.local/bin/ralph 없음 (현재 $0로 실행 중)"
  fi

  # 9. PATH
  if echo ":$PATH:" | grep -q ":$HOME/.local/bin:"; then
    _check "PATH" ok "~/.local/bin 포함"
  else
    _check "PATH" warn "~/.local/bin 미포함. echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc"
  fi

  # 10. 설정 파일
  if [ -f "$HOME/.ralph.env" ]; then
    _check ".ralph.env" ok "$HOME/.ralph.env"
  else
    _check ".ralph.env" warn "없음. install.sh가 자동 생성"
  fi

  # 11. 인증 토큰
  if [ -n "${RALPH_TOKEN:-}" ]; then
    _check "RALPH_TOKEN" ok "설정됨 (원격 인증 활성)"
  else
    _check "RALPH_TOKEN" warn "미설정 (공개 터널에선 누구나 접속 가능)"
  fi

  # 12. 푸시 알림
  if [ -n "${RALPH_NOTIFY_URL:-}" ]; then
    _check "RALPH_NOTIFY_URL" ok "$(echo "$RALPH_NOTIFY_URL" | sed 's|https://||;s|/.*|/...|')"
  elif [ -n "${RALPH_TELEGRAM_TOKEN:-}" ]; then
    _check "Telegram" ok "토큰 설정됨"
  else
    _check "push 알림" warn "미설정 (작업 완료 알림 받으려면 RALPH_NOTIFY_URL=https://ntfy.sh/your-topic)"
  fi

  # 13. macOS 터미널 앱 감지 (자동 창 오픈용)
  if [ "$(uname)" = "Darwin" ]; then
    local detected=()
    [ -d "/Applications/iTerm.app" ] && detected+=("iTerm2")
    [ -d "/Applications/Ghostty.app" ] && detected+=("Ghostty")
    [ -d "/Applications/WezTerm.app" ] && detected+=("WezTerm")
    [ -d "/Applications/kitty.app" ] && detected+=("Kitty")
    [ -d "/Applications/Alacritty.app" ] && detected+=("Alacritty")
    [ -d "/Applications/Warp.app" ] && detected+=("Warp")
    # Terminal.app은 맥에 기본 내장이므로 항상 사용 가능
    detected+=("Terminal.app")
    _check "터미널 앱" ok "감지: ${detected[*]} — 현재 TERM_PROGRAM=${TERM_PROGRAM:-unknown}"
  fi

  echo ""
  echo "  결과: ✓ $ok  ⚠ $warn  ✗ $fail"
  echo ""
  if [ $fail -gt 0 ]; then
    echo "  🔴 치명적 문제 있음. ✗ 항목부터 해결하세요."
    return 1
  elif [ $warn -gt 0 ]; then
    echo "  🟡 기본 동작은 가능하지만 일부 기능 미설치. ⚠ 항목 확인 권장."
  else
    echo "  🟢 모든 체크 통과."
  fi
  echo ""
}

cmd_claude() {
  # ralph claude — 새 터미널 창에 tmux dev + claude --resume 즉시 실행
  # 이미 tmux 안이면 현재 창에서 바로 claude 실행
  echo ""
  echo "  🤖 ralph claude — Claude Code 시작 (tmux dev)"
  echo ""
  _ensure_tmux
  if [ -n "${TMUX:-}" ]; then
    echo "  ✓ 이미 tmux 안. 현재 창에서 claude 실행."
    exec claude "$@"
  fi
  if _open_tmux_terminal; then
    echo "  ✓ 새 ${TERM_PROGRAM:-터미널} 창에서 'tmux dev' + 'claude --resume' 시작"
  else
    echo "  ⓘ 터미널 자동 오픈 실패. 수동으로:"
    echo "      tmux new -A -s dev 'claude --resume'"
  fi
  echo ""
}

cmd_handoff() {
  # ralph handoff mobile  — 폰으로 현재 tmux 세션 넘기기 (QR + 좌표)
  # ralph handoff desktop — 맥북 iTerm으로 tmux 가져오기
  local target="${1:-mobile}"

  case "$target" in
    mobile)
      echo ""
      echo "  📱 ralph handoff mobile — 현재 tmux 세션을 폰으로"
      echo ""
      _ensure_tmux
      _start_server
      _start_tunnel

      # 현재 tmux 세션 결정 (TMUX 안이면 그 세션, 아니면 dev)
      local session
      if [ -n "${TMUX:-}" ]; then
        session="$(tmux display -p '#S')"
      else
        session="dev"
      fi

      local url
      url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
      local token=${RALPH_TOKEN:-}
      local full_url="$url"
      [ -n "$token" ] && full_url="${url}?token=${token}"
      # 폰이 접속하면 이 tmux 세션을 기본으로 보도록 hash 파라미터 추가
      full_url="${full_url}#tmux=${session}"

      echo ""
      echo "  ┌─────────────────────────────────────────┐"
      echo "  │  핸드오프 준비 완료                        │"
      echo "  │  tmux 세션: $session"
      echo "  │  URL: $full_url"
      echo "  └─────────────────────────────────────────┘"
      echo ""
      if command -v qrencode >/dev/null 2>&1; then
        echo "  QR 코드:"
        qrencode -t UTF8 "$full_url" 2>/dev/null || true
      fi
      if adb devices 2>/dev/null | grep -q "device$"; then
        echo "  📱 Android 기기 감지. Chrome에서 열기..."
        adb shell am start -a android.intent.action.VIEW -d "$full_url" com.android.chrome 2>/dev/null || true
      fi
      ;;
    desktop|mac)
      echo ""
      echo "  🖥  ralph handoff desktop — 맥북 터미널로 tmux"
      echo ""
      _ensure_tmux
      if [ -n "${TMUX:-}" ]; then
        echo "  ⓘ 이미 tmux 안 ($(tmux display -p '#S')). 추가 동작 없음."
        return
      fi
      if _open_tmux_terminal; then
        echo "  ✓ 새 ${TERM_PROGRAM:-터미널} 창에 tmux 'dev' + claude --resume 열림"
      else
        echo "  ⓘ 터미널 자동 오픈 실패. 수동: tmux new -A -s dev 'claude --resume'"
      fi
      ;;
    *)
      echo "사용법: ralph handoff [mobile|desktop]"
      return 1
      ;;
  esac
  echo ""
}

cmd_status() {
  echo ""
  echo "  📊 ralph status"
  echo ""

  local server_status="✗ 중지"
  local tunnel_status="✗ 중지"
  local voice_status="✗ 중지"
  local tmux_status="✗ 없음"

  if _port_in_use $RALPH_PORT; then
    server_status="✓ 실행 중 (port $RALPH_PORT)"
  fi

  if _is_running tunnel; then
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    tunnel_status="✓ $url"
  fi

  if _is_running voice; then
    voice_status="✓ 실행 중 (Ctrl+Shift+V)"
  fi

  if tmux list-sessions 2>/dev/null | grep -q .; then
    tmux_status="✓ $(tmux list-sessions -F '#{session_name}' | tr '\n' ' ')"
  fi

  echo "  서버:        $server_status"
  echo "  터널:        $tunnel_status"
  echo "  Voice Daemon: $voice_status"
  echo "  tmux:        $tmux_status"
  echo ""
}

# --- Main ---
case "${1:-help}" in
  voice)   cmd_voice ;;
  mobile)  cmd_mobile ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  claude)  shift; cmd_claude "$@" ;;
  handoff) shift; cmd_handoff "$@" ;;
  doctor)  cmd_doctor ;;
  *)
    echo ""
    echo "  ralph — Voice Terminal CLI"
    echo ""
    echo "  사용법:"
    echo "    ralph voice              음성 모드 (백그라운드)"
    echo "    ralph mobile [--e2e]     모바일 접속 URL + QR (--e2e: 페이로드 암호화)"
    echo "    ralph start              전체 시작 (서버+터널+음성)"
    echo "    ralph stop               모든 프로세스 종료"
    echo "    ralph status             상태 확인"
    echo "    ralph claude             tmux dev 안에서 claude --resume 시작"
    echo "    ralph handoff mobile     현재 tmux 세션을 폰으로 넘김 (QR)"
    echo "    ralph handoff desktop    tmux dev를 새 터미널 창으로 가져옴"
    echo "    ralph doctor             설치/환경 진단"
    echo ""
    ;;
esac
