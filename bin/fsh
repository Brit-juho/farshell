      tmux -L $VT_TMUX_SOCKET new -A -s dev

      (체크: "Run command in shell")

EOF
}

cmd_shell_init() {
  # Phase 6 #6-3: 셸별 안전 통합 스니펫 출력
  # 사용법: eval "$(fsh shell-init zsh)" >> ~/.zshrc 형태로 한 줄 통합
  local shell="${1:-zsh}"
  case "$shell" in
    zsh)             _print_zsh_init ;;
    bash)            _print_bash_init ;;
    fish)            _print_fish_init ;;
    pwsh|powershell) _print_pwsh_init ;;
    *)
      echo "사용법: fsh shell-init [zsh|bash|fish|pwsh]" >&2
      return 1
      ;;
  esac
}

_print_zsh_init() {
  cat <<EOF
# fsh shell-init zsh — instant prompt 위에 배치 (p10k와 함께 쓰는 경우 ~/.zshrc 최상단)
if [[ -o interactive ]] \\
   && [[ -t 0 && -t 1 ]] \\
   && [[ -z "\$TMUX" ]] \\
   && [[ -z "\$INSIDE_EMACS\$VSCODE_INJECTION\$ZED_TERM\$INTELLIJ_ENVIRONMENT_READER" ]] \\
   && command -v tmux >/dev/null; then
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
fi
EOF
}

_print_bash_init() {
  cat <<EOF
# fsh shell-init bash — ~/.bashrc 또는 ~/.bash_profile 상단에 추가
case \$- in *i*) ;; *) return ;; esac
if [ -t 0 ] && [ -t 1 ] && [ -z "\$TMUX" ] \\
   && [ -z "\$INSIDE_EMACS\$VSCODE_INJECTION\$ZED_TERM" ] \\
   && command -v tmux >/dev/null; then
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
fi
EOF
}

_print_fish_init() {
  cat <<EOF
# fsh shell-init fish — ~/.config/fish/config.fish에 추가
if status is-interactive
  and not set -q TMUX
  and isatty stdin
  and isatty stdout
  and not set -q INSIDE_EMACS
  and not set -q VSCODE_INJECTION
  and not set -q ZED_TERM
  and command -v tmux >/dev/null
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
end
EOF
}

_print_pwsh_init() {
  cat <<EOF
# fsh shell-init pwsh — \$PROFILE에 추가 (WSL2 PowerShell용)
# Windows Terminal profile에 직접 등록을 더 권장
if (-not \$env:TMUX -and -not \$env:INSIDE_EMACS) {
  if (Get-Command tmux -ErrorAction SilentlyContinue) {
    & tmux -L $VT_TMUX_SOCKET new -A -s dev
    exit
  }
}
EOF
}

cmd_status() {
  echo ""
  echo "  📊 fsh status"
  echo ""

  local server_status="✗ 중지"
  local tunnel_status="✗ 중지"
  local ts_status="✗ 미설치"
  local voice_status="✗ 중지"
  local clip_status="✗ 중지"
  local watchdog_status="✗ 중지"
  local tmux_status="✗ 없음"

  if _port_in_use $VT_PORT; then
    server_status="✓ 실행 중 (port $VT_PORT)"
  fi

  # Phase 8 G1: cloudflared 정밀 표시
  local tunnel_installed="✗"
  command -v cloudflared >/dev/null 2>&1 && tunnel_installed="✓"
  local tunnel_pids
  tunnel_pids="$(_main_tunnel_pids)"
  if [ -n "$tunnel_pids" ]; then
    local url
    if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
      url="https://$VT_TUNNEL_HOSTNAME"
    else
      url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    fi
    tunnel_status="✓ PID $tunnel_pids — $url"
  fi

  # D9: Tailscale 상태 (회사망 등에서 fsh ssh로 접속하는 경로)
  if command -v tailscale >/dev/null 2>&1; then
    local ts_ip
    ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    if [ -n "$ts_ip" ]; then
      ts_status="✓ $ts_ip"
    else
      ts_status="⚠ 설치됨, 미연결 ('tailscale up' 필요)"
    fi
  fi

  if _is_running voice; then
    voice_status="✓ 실행 중 (Ctrl+Shift+V)"
  fi

  if _is_running clip; then
    clip_status="✓ 실행 중"
  fi

  if _is_running tunnel-watchdog; then
    watchdog_status="✓ 실행 중 (좀비 재연결 자동 감지)"
  fi

  if "${TMUX_BASE[@]}" list-sessions 2>/dev/null | grep -q .; then
    tmux_status="✓ $("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' | tr '\n' ' ')"
  fi

  echo "  서버:        $server_status"
  echo "  Cloudflare:"
  echo "    설치:       $tunnel_installed"
  echo "    실행:       $tunnel_status"
  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "    모드:       명명 (named) → $VT_TUNNEL_HOSTNAME"
  else
    echo "    모드:       익명 (anonymous, trycloudflare.com)"
  fi
  _registry_prune
  if [ -s "$TUNNEL_REGISTRY" ]; then
    echo "    추가 포트:"
    awk -F'\t' '{printf "      %-6s %s  (%s)\n", $1, $2, ($3==""?"-":$3)}' "$TUNNEL_REGISTRY"
  fi
  if [ -n "${VT_TUNNEL_HOOK:-}" ]; then
    echo "  URL 변경 훅: ✓ 설정됨 (fsh tunnel hook)"
  else
    echo "  URL 변경 훅: ✗ 미설정 (fsh help tunnel-hook)"
  fi
  echo "  터널 워치독: $watchdog_status"
  echo "  Tailscale:   $ts_status  (원격 SSH 접속: fsh ssh)"
  echo "  Voice Daemon: $voice_status"
  echo "  Clipboard:   $clip_status"
  echo "  tmux:        $tmux_status"
  echo ""
}

# --- Main ---
case "${1:-help}" in
  voice)   cmd_voice ;;
  clip)    cmd_clip ;;
  mobile)  cmd_mobile ;;
  start)   shift 2>/dev/null || true; cmd_start "$@" ;;
  stop)    shift 2>/dev/null || true; cmd_stop "$@" ;;
  status)  cmd_status ;;
  claude)   shift; cmd_claude "$@" ;;
  agent)    shift; cmd_agent "$@" ;;
  handoff)  shift; cmd_handoff "$@" ;;
  attach)   shift; cmd_attach "$@" ;;
  ssh)      shift; cmd_ssh "$@" ;;
  doctor)   cmd_doctor ;;
  shell-init) shift; cmd_shell_init "$@" ;;
  install-profiles) shift; cmd_install_profiles "$@" ;;
  setup-keybind) shift; cmd_setup_keybind "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  template) shift; cmd_template "$@" ;;
  popup)    shift; cmd_popup "$@" ;;
  run)      shift; cmd_run "$@" ;;
  queue)    shift; cmd_queue "$@" ;;
  help)     shift 2>/dev/null || true; cmd_help "$@" ;;
  hotkey)   shift; cmd_hotkey "$@" ;;
  password) shift; cmd_password "$@" ;;
  otp)      shift; cmd_otp "$@" ;;
  device|devices) shift; cmd_device "$@" ;;
  voice-target) shift; cmd_voice_target "$@" ;;
  manage)   shift; cmd_manage "$@" ;;
  tui)      shift; cmd_manage "$@" ;;
  *)
    echo ""
    echo "  fsh — FarShell CLI"
    echo ""
    echo "  사용법:"
    echo "    fsh voice              음성 모드 (백그라운드)"
    echo "    fsh clip               클립보드 동기화 데몬 (맥 클립보드 → 웹, OSC52 보완)"
    echo "    fsh mobile [--e2e] [--safe] [--force]"
    echo "                          모바일 접속 (--e2e: 암호화, --safe: 위험명령 차단,"
    echo "                          --force: 인증 미설정이어도 공개 터널 강행 — 비권장)"
    echo "    fsh start [--voice]    전체 시작 (서버+터널, --voice로 음성도 함께)"
    echo "    fsh stop               모든 프로세스 종료"
    echo "    fsh status             상태 확인"
    echo "    fsh password [clear]   웹 로그인 비밀번호 설정 (해시 저장) / clear=해제"
    echo "    fsh otp [setup|status|disable]"
    echo "                          새 기기 등록 시 OTP 요구 (setup 전까지 비활성)"
    echo "    fsh device [list|revoke <id>]"
    echo "                          등록된 기기 조회 / 폐기 (폰 분실 시)"
    echo "    fsh claude             tmux dev 안에서 claude --resume 시작"
    echo "    fsh agent <name>       claude/codex/aider/gemini 시작"
    echo "    fsh template [save|apply|list|rm] <이름>"
    echo "                          CLAUDE.md 템플릿 관리"
    echo "    fsh popup <action>     tmux 3.2+ popup으로 빠른 호출"
    echo "    fsh run \"명령\"          headless claude -p 백그라운드 실행"
    echo "    fsh queue [add|run|rm]  프롬프트 큐 (작업 중 지시를 쌓아뒀다 순차 투입)"
    echo "    fsh handoff mobile     현재 tmux 세션을 폰으로 넘김 (QR)"
    echo "    fsh handoff desktop    tmux dev를 새 터미널 창으로 가져옴"
    echo "    fsh ssh [session]      Tailscale + SSH로 tmux 세션 직접 접속 명령 안내"
    echo "    fsh doctor             설치/환경 진단"
    echo "    fsh install-profiles [--dry-run]"
    echo "                          터미널 앱 profile 자동 등록 (iTerm2 등)"
    echo "    fsh shell-init [zsh|bash|fish|pwsh]"
    echo "                          셸별 안전 통합 스니펫 출력"
    echo "    fsh setup-keybind [key] [action]"
    echo "                          tmux popup 키바인딩 자동 등록 (default: prefix+v → status)"
    echo "    fsh tunnel [status|list|hook|restart|watchdog|setup|teardown|switch <anon|named>]"
    echo "                          Cloudflare Tunnel 관리 (명명 터널 옵트인)"
    echo "    fsh tunnel restart     좀비 재연결(응답 없음) 상태여도 강제로 새 터널 기동"
    echo "    fsh tunnel watchdog    좀비 재연결 자동 감지 데몬 상태 확인/시작"
    echo "                          (fsh start/voice/mobile 시 자동 기동, 감지 시 자동 restart)"
    echo "    fsh tunnel expose <port> [라벨]"
    echo "                          다른 로컬 앱(예: 3000)을 별도 터널로 공개"
    echo "    fsh tunnel unexpose <port>"
    echo "                          해당 포트 터널 종료"
    echo "                          URL을 어딘가에 자동 게시: fsh help tunnel-hook"
    echo "    fsh mobile --network <localhost|lan|tailscale|all>"
    echo "                          모바일 모드 — localhost(같은 머신) / lan(같은 네트워크) / tailscale(같은 tailnet) / all(터널, default)"
    echo ""
    ;;
esac
