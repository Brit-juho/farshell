#!/bin/bash
# fsh — FarShell 통합 CLI
# 어디서든 실행 가능. 노션 작업 중에도 음성으로 코딩.
#
# 사용법:
#   fsh voice    — 음성 모드 (백그라운드, 작업 방해 없음)
#   fsh mobile   — 모바일 접속 URL 제공 (서버 자동 시작)
#   fsh start    — 서버 + 터널 시작
#   fsh stop     — 모든 fsh 프로세스 종료
#   fsh status   — 현재 상태 확인

set -uo pipefail

# 호출 시점에 이미 환경에 있던 VT_* 이름 — 파일보다 우선한다.
# 반드시 아래에서 VT_DIR/VT_CONFIG 등을 대입하기 '전에' 떠야 한다.
_VT_ENV_PRESET_NAMES=" "
for _vt_v in ${!VT_@}; do _VT_ENV_PRESET_NAMES="$_VT_ENV_PRESET_NAMES$_vt_v "; done
unset _vt_v

# 심링크를 따라가서 실제 경로 찾기
_SELF="$0"
[ -L "$_SELF" ] && _SELF="$(readlink "$_SELF")"
VT_DIR="$(cd "$(dirname "$_SELF")/.." && pwd)"
# 설정 파일 경로. 오버라이드 가능해야 프로필을 나눠 쓰거나 테스트에서 격리할 수 있다.
VT_CONFIG="${VT_CONFIG:-$HOME/.vt.env}"
VT_DEFAULTS="$VT_DIR/config/vt.defaults.env"

# ~/.vt.env 읽기/쓰기 단일 구현 (형식 정의 + 권한 보장).
# 시크릿이 들어가는 파일이므로 손으로 echo/sed 하지 말고 vt_env_set/unset만 쓸 것.
# shellcheck source=../lib/vt_env.sh
if [ -f "$VT_DIR/lib/vt_env.sh" ]; then
  . "$VT_DIR/lib/vt_env.sh"
else
  echo "fsh: lib/vt_env.sh 를 찾을 수 없습니다 ($VT_DIR/lib/vt_env.sh)" >&2
  echo "    설치가 손상됐을 수 있습니다 — './install.sh' 로 복구하세요." >&2
  exit 1
fi

# 설정 파일 로드 — defaults 먼저, 그 다음 사용자 override.
#
# source가 아니라 vt_env_load(파서)를 쓴다. 설정 파일은 데이터이지 코드가 아니다:
#   - 파일 안의 어떤 구문도 실행되지 않는다 (임의 코드 실행 경로 제거)
#   - 레거시 라인 하나가 set -u에 걸려 fsh 전체를 죽이는 일이 없다
#   - bash와 server/vt_env.py가 정의상 같은 값을 읽는다
# 우선순위 '환경변수 > ~/.vt.env > defaults'는 _VT_ENV_PRESET_NAMES로 구조적으로 성립한다.
vt_env_load "$VT_DEFAULTS"
vt_env_load "$VT_CONFIG"

# 설정 가능한 변수 (환경변수 또는 ~/.vt.env로 오버라이드)
VT_PORT="${VT_PORT:-7777}"

# 격리된 tmux 소켓 — 사용자 기존 tmux 세션과 분리
VT_TMUX_SOCKET="${VT_TMUX_SOCKET:-fsh}"

# Phase 8 G3: 격리 config 자동 탐색 (XDG → 레포 → 미사용)
_resolve_tmux_conf() {
  if [ -n "${VT_TMUX_CONF:-}" ] && [ -f "$VT_TMUX_CONF" ]; then
    echo "$VT_TMUX_CONF"; return
  fi
  if [ -f "$HOME/.config/vt/tmux.conf" ]; then
    echo "$HOME/.config/vt/tmux.conf"; return
  fi
  if [ -f "$VT_DIR/config/vt-tmux.conf" ]; then
    echo "$VT_DIR/config/vt-tmux.conf"; return
  fi
}
VT_TMUX_CONF_PATH="$(_resolve_tmux_conf)"
if [ -n "$VT_TMUX_CONF_PATH" ]; then
  TMUX_BASE=(tmux -u -L "$VT_TMUX_SOCKET" -f "$VT_TMUX_CONF_PATH")
else
  TMUX_BASE=(tmux -u -L "$VT_TMUX_SOCKET")
fi

# Python 자동 감지 — 우선순위:
#   1) 환경변수 VT_PYTHON / ~/.vt.env / config/vt.defaults.env
#   2) 프로젝트 .venv (install.sh로 만든 것)
#   3) 시스템 python3
# conda/pyenv 등 다른 환경은 ~/.vt.env에 VT_PYTHON으로 명시하세요.
_detect_python() {
  if [ -x "$VT_DIR/.venv/bin/python" ]; then
    echo "$VT_DIR/.venv/bin/python"
  else
    command -v python3 2>/dev/null || echo python3
  fi
}
VT_PYTHON="${VT_PYTHON:-$(_detect_python)}"

# ~/.vt.env에서 온 값은 set -a 덕에 이미 export됐지만, 위에서 '기본값으로 계산된' 값들은
# 그냥 두면 export되지 않는다. 그러면 부모(fsh)와 자식(서버·데몬·훅)이 서로 다른 설정을
# 보게 된다 — VT_TUNNEL_HOOK 안의 "$VT_PYTHON"이 빈 값이 되는 식. 한곳에서 내보낸다.
export VT_PYTHON VT_PORT VT_TMUX_SOCKET VT_CONFIG VT_DIR

# Phase 8 G4: Claude --disallowedTools 정책 (도구 호출 단계 차단, 정규식보다 견고)
_DEFAULT_DISALLOWED='Bash(rm -rf /:*),Bash(sudo:*),Bash(git push --force:*),Bash(dd if=*:*),Bash(chmod -R 777 /:*),Bash(mkfs.*:*)'
_SAFE_DISALLOWED="$_DEFAULT_DISALLOWED,Bash(curl * | sh:*),Bash(curl * | bash:*),Bash(wget * | sh:*),Bash(rm:*),Bash(git push:*),Bash(git clean:*),Edit(/etc/*),Edit(/usr/*),Write(/etc/*),Write(/usr/*)"

_resolve_disallowed_tools() {
  if [ -n "${VT_DISALLOWED_TOOLS:-}" ]; then
    echo "$VT_DISALLOWED_TOOLS"
  elif [ "${VT_SAFE_MODE:-}" = "1" ]; then
    echo "$_SAFE_DISALLOWED"
  else
    echo "$_DEFAULT_DISALLOWED"
  fi
}

SERVER_LOG="/tmp/vt-server.log"
TUNNEL_LOG="/tmp/cloudflared.log"
DAEMON_LOG="/tmp/vt-voice-daemon.log"
CLIP_DAEMON_LOG="/tmp/vt-clipboard-daemon.log"
WATCHDOG_LOG="/tmp/vt-tunnel-watchdog.log"
PID_DIR="/tmp/vt-pids"
mkdir -p "$PID_DIR"
# 추가 포트 터널 레지스트리 (TSV: port<TAB>url<TAB>label)
TUNNEL_REGISTRY="$PID_DIR/tunnels.tsv"

_is_running() {
  local pidfile="$PID_DIR/$1.pid"
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

_port_in_use() {
  "$VT_PYTHON" -c "import socket;s=socket.socket();s.settimeout(1);exit(0 if s.connect_ex(('127.0.0.1',$1))==0 else 1)" 2>/dev/null
}

_start_server() {
  if _port_in_use $VT_PORT; then
    echo "✓ 서버 이미 실행 중 (port $VT_PORT)"
    return 0
  fi
  echo "▸ 서버 시작 중..."
  cd "$VT_DIR/server"
  # VT_NETWORK_MODE를 실제 bind 주소에 반영한다. 예전엔 무조건 0.0.0.0으로 열고
  # 미들웨어에서 403으로 걸러내기만 해서, localhost 모드로 설정해도 포트 자체는
  # 모든 인터페이스(카페 wifi 포함)에 노출돼 있었다.
  local bind_host
  bind_host="$("$VT_PYTHON" -c 'import network_access as n; print(n.resolve_bind_host(n.get_current_spec()))' 2>/dev/null || echo 0.0.0.0)"
  nohup "$VT_PYTHON" -m uvicorn main:app --host "$bind_host" --port $VT_PORT > "$SERVER_LOG" 2>&1 &
  echo $! > "$PID_DIR/server.pid"
  sleep 2
  if curl -sf http://localhost:$VT_PORT/ -o /dev/null 2>/dev/null; then
    echo "✓ 서버 시작 완료 (http://localhost:$VT_PORT)"
  else
    echo "✗ 서버 시작 실패. 로그: $SERVER_LOG"
    return 1
  fi
}

# 메인 터널 시작. 성공 시 URL 변경 훅 실행 + 좀비 재연결 감시 데몬 기동 (설정된 경우에만).
_start_tunnel() {
  _start_tunnel_impl "$@"
  local rc=$?
  if [ $rc -eq 0 ]; then
    _run_tunnel_hook start
    _start_tunnel_watchdog
  fi
  return $rc
}

# 좀비 재연결 상태에서도 프로세스는 살아있어(kill -0 성공) _is_running만으론
# 못 잡으므로, PID를 무조건 죽이고 새로 띄운다. 워치독이 자동 호출하거나
# 'fsh tunnel restart'로 수동 호출.
_tunnel_restart() {
  echo "  ▸ 터널 재시작 중..."
  local pids
  pids="$(_main_tunnel_pids)"
  if [ -n "$pids" ]; then
    for p in $pids; do kill "$p" 2>/dev/null || true; done
    sleep 1
    for p in $pids; do kill -9 "$p" 2>/dev/null || true; done
  fi
  rm -f "$PID_DIR/tunnel.pid"

  _start_tunnel_impl
  local rc=$?
  if [ $rc -eq 0 ]; then
    _run_tunnel_hook start
    _start_tunnel_watchdog
    echo "  ✓ 재시작 완료"
  else
    echo "  ✗ 재시작 실패"
  fi
  return $rc
}

# 터널 좀비 재연결 감시 데몬. 로그에 재연결 실패가 짧은 시간에 몰리면
# _tunnel_restart를 자동 호출한다 (server/tunnel_watchdog.py).
_start_tunnel_watchdog() {
  if _is_running tunnel-watchdog; then
    return 0
  fi
  nohup "$VT_PYTHON" "$VT_DIR/server/tunnel_watchdog.py" > "$WATCHDOG_LOG" 2>&1 &
  echo $! > "$PID_DIR/tunnel-watchdog.pid"
  sleep 0.5
  if _is_running tunnel-watchdog; then
    echo "✓ 터널 워치독 시작 (좀비 재연결 자동 감지)"
  else
    echo "  ⚠ 터널 워치독 시작 실패. 로그: $WATCHDOG_LOG"
  fi
}

_start_tunnel_impl() {
  # Phase 8 G1: 외부에서 떠있는 cloudflared도 발견하여 재사용 (옵션 A)
  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "✗ cloudflared 미설치. brew install cloudflared (macOS) 또는 https://github.com/cloudflare/cloudflared/releases"
    return 1
  fi

  # 우리 PID file 또는 외부 cloudflared 프로세스 감지.
  # 'fsh tunnel expose'로 뜬 추가 포트 터널을 메인 터널로 오인하지 않도록,
  # 명명 터널(tunnel run) 또는 VT_PORT를 향한 익명 터널만 센다.
  local existing_pids=""
  if command -v pgrep >/dev/null 2>&1; then
    existing_pids="$(pgrep -f "cloudflared.*tunnel run" 2>/dev/null || true)"
    existing_pids="$existing_pids $(pgrep -f "cloudflared.*--url http://localhost:$VT_PORT\$" 2>/dev/null || true)"
    existing_pids="$(echo "$existing_pids" | tr ' ' '\n' | grep -v '^$' | tr '\n' ' ' | sed 's/ $//')"
  fi

  if _is_running tunnel || [ -n "$existing_pids" ]; then
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
      url="https://$VT_TUNNEL_HOSTNAME"
    fi
    if [ -n "$url" ]; then
      echo "✓ 터널 이미 실행 중 (PID${existing_pids:+: $existing_pids}): $url"
      return 0
    fi
  fi

  # 명명 터널 우선 (옵션 C: VT_TUNNEL_NAME + VT_TUNNEL_HOSTNAME 필요)
  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "▸ Cloudflare 명명 터널 시작 중 (name=$VT_TUNNEL_NAME → $VT_TUNNEL_HOSTNAME)..."
    : > "$TUNNEL_LOG"
    nohup cloudflared tunnel run "$VT_TUNNEL_NAME" > "$TUNNEL_LOG" 2>&1 &
    echo $! > "$PID_DIR/tunnel.pid"
    sleep 2
    if _is_running tunnel; then
      echo "✓ 명명 터널: https://$VT_TUNNEL_HOSTNAME"
      return 0
    fi
    echo "  ⚠ 명명 터널 시작 실패 — 익명 터널로 fallback"
  fi

  # 익명 터널 (옵션 A 기본 동작)
  echo "▸ Cloudflare 익명 터널 시작 중..."
  : > "$TUNNEL_LOG"
  nohup cloudflared tunnel --url http://localhost:$VT_PORT > "$TUNNEL_LOG" 2>&1 &
  echo $! > "$PID_DIR/tunnel.pid"
  for i in $(seq 1 30); do
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    if [ -n "$url" ]; then
      echo "✓ 터널: $url"
      return 0
    fi
    sleep 1
  done
  echo "✗ 터널 URL 대기 시간 초과. 로그: $TUNNEL_LOG"
  return 1
}

# ── 추가 포트 터널 (fsh tunnel expose <port>) ─────────────────────────
# 메인 터널은 VT 서버(VT_PORT) 전용이다. Cloudflare quick tunnel은
# 호스트명↔포트 1:1이라 경로로 포트를 바꿔치기할 수 없으므로,
# 다른 로컬 앱(예: localhost:3000)은 별도 터널을 하나 더 띄운다.

_extra_tunnel_log() { echo "/tmp/cloudflared-$1.log"; }

_registry_set() {
  local port="$1" url="$2" label="$3"
  touch "$TUNNEL_REGISTRY"
  grep -v "^${port}$(printf '\t')" "$TUNNEL_REGISTRY" > "$TUNNEL_REGISTRY.tmp" 2>/dev/null || true
  printf '%s\t%s\t%s\n' "$port" "$url" "$label" >> "$TUNNEL_REGISTRY.tmp"
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_registry_del() {
  local port="$1"
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  grep -v "^${port}$(printf '\t')" "$TUNNEL_REGISTRY" > "$TUNNEL_REGISTRY.tmp" 2>/dev/null || true
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_registry_url() {
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  awk -F'\t' -v p="$1" '$1==p {print $2}' "$TUNNEL_REGISTRY" | head -1
}

# 죽은 터널 항목 청소 — pid 파일 기준
_registry_prune() {
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  local port rest
  : > "$TUNNEL_REGISTRY.tmp"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    port="${line%%$(printf '\t')*}"
    if _is_running "tunnel-$port"; then
      printf '%s\n' "$line" >> "$TUNNEL_REGISTRY.tmp"
    fi
  done < "$TUNNEL_REGISTRY"
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_start_extra_tunnel() {
  local port="${1:-}" label="${2:-}"

  case "$port" in
    ''|*[!0-9]*) echo "  ✗ 포트는 숫자여야 합니다: '${port}'"; return 1 ;;
  esac
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "  ✗ 포트 범위(1-65535)를 벗어났습니다: $port"; return 1
  fi
  if [ "$port" = "$VT_PORT" ]; then
    echo "  ✗ $port 는 VT 서버 포트입니다 — 메인 터널(fsh start)이 이미 담당합니다"
    return 1
  fi
  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "  ✗ cloudflared 미설치. brew install cloudflared"
    return 1
  fi

  label="${label:-localhost:$port}"

  if _is_running "tunnel-$port"; then
    echo "  ✓ 이미 노출 중: $(_registry_url "$port")"
    return 0
  fi

  if ! _port_in_use "$port"; then
    echo "  ⚠ localhost:$port 에 응답하는 서비스가 없습니다 — 터널은 띄우지만 앱을 먼저 켜세요"
  fi

  local log; log="$(_extra_tunnel_log "$port")"
  echo "  ▸ localhost:$port 터널 시작 중..."
  : > "$log"
  nohup cloudflared tunnel --url "http://localhost:$port" > "$log" 2>&1 &
  echo $! > "$PID_DIR/tunnel-$port.pid"

  local i url
  for i in $(seq 1 30); do
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$log" 2>/dev/null | head -1)
    if [ -n "$url" ]; then
      _registry_set "$port" "$url" "$label"
      echo "  ✓ $label → $url"
      _run_tunnel_hook expose
      return 0
    fi
    sleep 1
  done
  echo "  ✗ 터널 URL 대기 시간 초과. 로그: $log"
  return 1
}

_stop_extra_tunnel() {
  local port="${1:-}"
  local pidfile="$PID_DIR/tunnel-$port.pid"
  if [ ! -f "$pidfile" ]; then
    echo "  ⓘ 포트 $port 로 열린 터널이 없습니다"
    _registry_del "$port"
    return 0
  fi
  local pid; pid="$(cat "$pidfile")"
  kill "$pid" 2>/dev/null && echo "  ✓ 포트 $port 터널 종료 (PID $pid)" || echo "  ⓘ 이미 종료됨 (PID $pid)"
  rm -f "$pidfile"
  _registry_del "$port"
  _run_tunnel_hook unexpose
}

# ── 터널 URL 변경 훅 (VT_TUNNEL_HOOK) ────────────────────────────────
# 익명 터널은 재시작마다 URL이 바뀐다. 그 URL을 어디로 흘려보낼지는
# 사람마다 다르므로(Notion / Slack / ntfy / 파일 / 사내 위키...) fsh는
# 특정 서비스를 알지 않는다. URL이 바뀔 때 임의의 명령을 부를 뿐이다.
#
# 계약 (자세히: fsh help tunnel-hook):
#   stdin — "라벨<TAB>URL" 줄들 (메인 터널 먼저, 이후 expose된 포트들)
#   env   — VT_TUNNEL_EVENT (start|expose|unexpose|manual)
#           VT_TUNNEL_MAIN_URL (메인 터널 URL, 없으면 빈 값)
#   훅의 실패는 터널 동작에 영향을 주지 않는다.

# 메인 터널(VT_PORT 또는 명명 터널)의 PID만 — 공백 구분 한 줄.
# 'expose'로 뜬 다른 포트 터널은 제외한다.
_main_tunnel_pids() {
  command -v pgrep >/dev/null 2>&1 || return 0
  {
    pgrep -f "cloudflared.*tunnel run" 2>/dev/null || true
    pgrep -f "cloudflared.*--url http://localhost:$VT_PORT\$" 2>/dev/null || true
  } | grep -v '^$' | tr '\n' ' ' | sed 's/ $//'
}

_main_tunnel_url() {
  if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "https://$VT_TUNNEL_HOSTNAME"
    return 0
  fi
  grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1
}

# stdout: "라벨<TAB>URL" 줄들 — 훅의 stdin이자 fsh tunnel list의 원본
_tunnel_entries() {
  local url
  url="$(_main_tunnel_url)"
  [ -n "$url" ] && printf '%s\t%s\n' "${VT_TUNNEL_MAIN_LABEL:-터미널 (VT)}" "$url"
  _registry_prune
  if [ -f "$TUNNEL_REGISTRY" ]; then
    awk -F'\t' 'NF>=2 && $2!="" {print ($3==""?"localhost:"$1:$3) "\t" $2}' "$TUNNEL_REGISTRY"
  fi
}

_run_tunnel_hook() {
  local event="${1:-manual}"
  # 미설정이면 조용히 통과 — 터널 동작을 절대 방해하지 않는다
  [ -n "${VT_TUNNEL_HOOK:-}" ] || return 0

  local entries
  entries="$(_tunnel_entries)"
  if [ -z "$entries" ]; then
    [ "$event" = "manual" ] && echo "  ⓘ 알릴 URL이 없습니다 (터널 미실행)"
    return 0
  fi

  local out rc
  out="$(printf '%s\n' "$entries" | \
    VT_TUNNEL_EVENT="$event" \
    VT_TUNNEL_MAIN_URL="$(_main_tunnel_url)" \
    /bin/sh -c "$VT_TUNNEL_HOOK" 2>&1)"
  rc=$?
  if [ $rc -eq 0 ]; then
    echo "  ✓ 훅 실행${out:+: $out}"
  else
    echo "  ⚠ 훅 실패(rc=$rc)${out:+: $out}"
  fi
  return 0
}

_start_voice_daemon() {
  if _is_running voice; then
    echo "✓ Voice Daemon 이미 실행 중"
    return 0
  fi
  echo "▸ Voice Daemon 시작 중..."
  nohup "$VT_PYTHON" "$VT_DIR/server/voice_daemon.py" > "$DAEMON_LOG" 2>&1 &
  echo $! > "$PID_DIR/voice.pid"
  sleep 1
  if _is_running voice; then
    echo "✓ Voice Daemon 시작 (Ctrl+Shift+V 로 녹음)"
  else
    echo "✗ Voice Daemon 실패. 로그: $DAEMON_LOG"
    return 1
  fi
}

_start_clipboard_daemon() {
  if _is_running clip; then
    echo "✓ Clipboard Daemon 이미 실행 중"
    return 0
  fi
  echo "▸ Clipboard Daemon 시작 중..."
  nohup "$VT_PYTHON" "$VT_DIR/server/clipboard_daemon.py" > "$CLIP_DAEMON_LOG" 2>&1 &
  echo $! > "$PID_DIR/clip.pid"
  sleep 1
  if _is_running clip; then
    echo "✓ Clipboard Daemon 시작 (맥 클립보드 변경 → 웹 자동 동기화)"
  else
    echo "✗ Clipboard Daemon 실패. 로그: $CLIP_DAEMON_LOG"
    return 1
  fi
}

# Phase 6 #6-4: detached → optional populate → attach 3단계 분리
# 비-TTY 컨텍스트(CI·백그라운드)에서도 tcgetattr 경고 없이 동작.

# 1단계: detached 세션 보장 (TTY 불필요).
# 이미 있으면 0, 없으면 생성. -x/-y는 detached에서 tcgetattr 실패 회피.
_ensure_tmux_session() {
  local name="${1:-dev}"
  if "${TMUX_BASE[@]}" has-session -t "$name" 2>/dev/null; then
    return 0
  fi
  "${TMUX_BASE[@]}" new-session -d -s "$name" -x 200 -y 50 2>/dev/null
}

# 2단계: 옵션 명령 주입 (TTY 불필요).
_tmux_populate() {
  local name="$1"; local cmd="${2:-}"
  [ -z "$cmd" ] && return 0
  "${TMUX_BASE[@]}" send-keys -t "$name" "$cmd" C-m 2>/dev/null
}

# 3단계: attach (호출자가 TTY 컨텍스트 보장).
# tmux 안이면 switch-client, 밖이면 exec attach.
_tmux_attach_or_switch() {
  local name="${1:-dev}"
  if [ -n "${TMUX:-}" ]; then
    "${TMUX_BASE[@]}" switch-client -t "$name"
  else
    exec "${TMUX_BASE[@]}" attach-session -t "$name"
  fi
}

# 기존 _ensure_tmux는 wrapper로 유지 (회귀 호환).
_ensure_tmux() {
  local name="${1:-dev}"
  if "${TMUX_BASE[@]}" has-session -t "$name" 2>/dev/null; then
    echo "✓ tmux 세션 존재 (소켓: $VT_TMUX_SOCKET): $("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' | tr '\n' ' ')"
    _maybe_register_client_hooks
    return 0
  fi
  if _ensure_tmux_session "$name"; then
    echo "✓ tmux 세션 '$name' 생성 (소켓: $VT_TMUX_SOCKET)"
    _maybe_register_client_hooks
  else
    echo "✗ tmux 세션 '$name' 생성 실패"
    return 1
  fi
}

# D9: SSH(+Tailscale)로 붙는 클라이언트는 web/voice 경로와 달리 서버가 자연히
# 알 방법이 없다 — tmux client-attached/detached 훅으로 "누가 언제 접속했는지"를
# push 알림(ntfy/Telegram)으로 알려준다. 기본은 OFF (VT_NOTIFY_CLIENT_EVENTS=1로 옵트인),
# 매 _ensure_tmux 호출마다 재등록해도 set-hook은 멱등이라 안전함.
_maybe_register_client_hooks() {
  [ "${VT_NOTIFY_CLIENT_EVENTS:-0}" = "1" ] || return 0
  local hook_script="$VT_DIR/server/hooks/tmux_client_notify.sh"
  [ -f "$hook_script" ] || return 0
  chmod +x "$hook_script" 2>/dev/null
  "${TMUX_BASE[@]}" set-hook -g client-attached \
    "run-shell -b '\"$hook_script\" attached \"#{client_tty}\" \"#{session_name}\"'" 2>/dev/null
  "${TMUX_BASE[@]}" set-hook -g client-detached \
    "run-shell -b '\"$hook_script\" detached \"#{client_tty}\" \"#{session_name}\"'" 2>/dev/null
}

# AppleScript 문자열 리터럴에 임의 텍스트를 안전하게 넣기 위한 이스케이프.
# 백슬래시를 먼저(순서 중요), 그다음 큰따옴표. 이걸 빼먹으면 명령에 포함된
# 따옴표(예: --disallowedTools "...")가 osascript 문법 오류(-2741)를 낸다.
_as_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# 자동 오픈 실패 원인 안내. osascript 실패 시 stderr가 담긴 VT_AUTOOPEN_ERR을
# 읽어, 특히 macOS 자동화(Automation) 권한 거부(-1743)를 감지해 해결법을 출력한다.
# 출력 후 변수를 비워 다음 호출에 이전 오류가 새지 않게 한다.
_autoopen_failure_hint() {
  local err="${VT_AUTOOPEN_ERR:-}"
  VT_AUTOOPEN_ERR=""
  [ -n "$err" ] || return 0
  case "$err" in
    *-1743*|*"Not authorized"*|*"not allowed to send"*|*"권한"*|*"승인"*)
      echo "  ⚠ 원인: 터미널을 자동 제어할 '자동화(Automation)' 권한이 없습니다."
      echo "     시스템 설정 → 개인정보 보호 및 보안 → 자동화 에서"
      echo "     지금 실행 중인 앱(iTerm/Terminal/Claude)의 'iTerm' 항목을 켜세요."
      ;;
    *)
      echo "  ⚠ 원인: $err"
      ;;
  esac
}

# 새 터미널 창에서 tmux dev 세션 + claude --resume 자동 실행.
# 이미 tmux 안에 있으면 호출하지 않음 (멱등성).
# $TERM_PROGRAM 기반으로 현재 쓰는 터미널 앱에 맞춰 오픈.
# 지원: iTerm2, Terminal.app(Apple), WezTerm, Warp, Alacritty, Kitty, Ghostty
_open_tmux_terminal() {
  # 호환 wrapper: 디폴트는 dev + claude --resume (W1-3 이전 동작 유지)
  _open_tmux_terminal_with "dev" "claude --resume"
}

# W3-1: Linux 터미널 emulator 분기로 새 창 띄우기.
# 인자: $1 = 실행 명령어 문자열
_open_linux_terminal_with() {
  local cmd="$1"
  [ -z "$cmd" ] && return 1

  # WSL2는 글로벌 핫키/터미널 자동 오픈 미지원 — 가드
  if grep -qi microsoft /proc/version 2>/dev/null; then
    return 1
  fi

  # 우선순위 검색
  local emulators=(
    "gnome-terminal"
    "konsole"
    "alacritty"
    "kitty"
    "wezterm"
    "xfce4-terminal"
    "xterm"
  )
  local em
  for em in "${emulators[@]}"; do
    command -v "$em" >/dev/null 2>&1 || continue
    case "$em" in
      gnome-terminal)
        gnome-terminal -- bash -lc "$cmd; exec bash" >/dev/null 2>&1 &
        return 0
        ;;
      konsole)
        konsole -e bash -lc "$cmd; exec bash" >/dev/null 2>&1 &
        return 0
        ;;
      alacritty)
        alacritty -e bash -lc "$cmd; exec bash" >/dev/null 2>&1 &
        return 0
        ;;
      kitty)
        kitty bash -lc "$cmd; exec bash" >/dev/null 2>&1 &
        return 0
        ;;
      wezterm)
        wezterm start -- bash -lc "$cmd; exec bash" >/dev/null 2>&1 &
        return 0
        ;;
      xfce4-terminal)
        xfce4-terminal -e "bash -lc '$cmd; exec bash'" >/dev/null 2>&1 &
        return 0
        ;;
      xterm)
        xterm -e "bash -lc '$cmd; exec bash'" >/dev/null 2>&1 &
        return 0
        ;;
    esac
  done
  return 1
}

# 해당 tmux 세션에 이미 붙어있는 클라이언트의 tty 목록 (없으면 빈 문자열).
# 세션당 창 하나 원칙: 이미 어딘가 attach돼 있으면 새 창을 또 열지 않기 위한 판단 근거.
_tmux_session_client_ttys() {
  local name="${1:-dev}"
  "${TMUX_BASE[@]}" list-clients -t "$name" -F '#{client_tty}' 2>/dev/null
}

# iTerm2 창들 중 주어진 tty를 표시 중인 탭/세션을 찾아 앞으로 가져온다.
# iTerm session에는 tty 속성이 있어 client-tty와 직접 매칭 가능.
_focus_iterm_by_tty() {
  local tty="$1"
  [ -d "/Applications/iTerm.app" ] || return 1
  local ok
  ok="$(osascript <<APPLESCRIPT 2>/dev/null
tell application "iTerm"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$tty" then
          activate
          select w
          select t
          tell w to select s
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
  return "no"
end tell
APPLESCRIPT
)"
  [ "$ok" = "ok" ]
}

# 세션이 이미 다른 창에 attach돼 있으면 새 창을 열지 않고(가능하면 그 창으로
# 포커스만 전환) 성공(0)을 반환한다. attach된 곳이 없으면 1을 반환 — 호출자가
# 새 창을 열어야 한다는 뜻.
_tmux_already_open() {
  local name="${1:-dev}"
  local ttys first_tty
  ttys="$(_tmux_session_client_ttys "$name")"
  if [ -n "$ttys" ]; then
    first_tty="$(printf '%s\n' "$ttys" | head -1)"
    if [ "$(uname)" = "Darwin" ] && _focus_iterm_by_tty "$first_tty"; then
      echo "  ✓ tmux 세션 '$name'이 이미 열려 있어 그 창으로 전환했습니다."
    else
      echo "  ⓘ tmux 세션 '$name'이 이미 다른 창에 열려 있어 새 창을 열지 않습니다."
    fi
    return 0
  fi
  # 붙어있는 클라이언트가 하나도 없어도 세션 자체는 이미 존재할 수 있다(예: 이전에
  # 열어둔 창을 닫았거나, 웹에서만 attach 중인 경우). 이때도 매번 새 macOS 창을
  # 또 열면 fsh start/voice/mobile을 반복 호출할 때마다 창이 계속 늘어난다 —
  # "세션이 하나도 없을 때만 새로 연다"는 원칙으로, 세션 존재 자체를 마지막 방어선으로 확인.
  if "${TMUX_BASE[@]}" has-session -t "$name" 2>/dev/null; then
    echo "  ⓘ tmux 세션 '$name'이 이미 존재해 새 창을 열지 않습니다(다른 창에 붙어있진 않음)."
    echo "      수동으로 열려면: tmux -L $VT_TMUX_SOCKET attach -t $name"
    return 0
  fi
  return 1
}

# W1-3: 임의 세션을 새 OS 터미널 창에서 attach하는 일반화 헬퍼.
# 인자: $1=session_name, $2=optional command (없으면 attach만)
# macOS는 osascript 분기, Linux는 emulator 분기 (W3-1)
# 세션당 창 하나 원칙: 이미 attach된 창이 있으면 새로 열지 않는다.
_open_tmux_terminal_with() {
  local session="${1:-dev}"
  local extra_cmd="${2:-}"

  # 반환값 3종: 0=새 창을 실제로 열었음, 2=이미 있어서 안 열었음(안내 메시지는
  # _tmux_already_open이 이미 출력함 — 호출자가 "새로 열렸다"는 메시지를 또 찍으면 안 됨),
  # 1=열기 시도했으나 실패.
  _tmux_already_open "$session" && return 2

  local cmd
  if [ -n "$extra_cmd" ]; then
    cmd="tmux -L $VT_TMUX_SOCKET new -A -s $session \"$extra_cmd\""
  else
    cmd="tmux -L $VT_TMUX_SOCKET new -A -s $session"
  fi

  # Linux 분기 (W3-1)
  if [ "$(uname)" = "Linux" ]; then
    _open_linux_terminal_with "$cmd" && return 0
    return 1
  fi

  [ "$(uname)" = "Darwin" ] || return 1

  local term="${TERM_PROGRAM:-}"
  # 소문자 정규화 (kitty 등 일부 터미널은 소문자로 설정)
  local term_lc
  term_lc="$(printf '%s' "$term" | tr '[:upper:]' '[:lower:]')"

  local cmd_as
  cmd_as="$(_as_escape "$cmd")"

  _try_iterm() {
    [ -d "/Applications/iTerm.app" ] || return 1
    local _err
    _err="$(osascript 2>&1 <<APPLESCRIPT
tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "$cmd_as"
  end tell
end tell
APPLESCRIPT
)" && return 0
    VT_AUTOOPEN_ERR="$_err"
    return 1
  }

  _try_terminal_app() {
    local _err
    _err="$(osascript 2>&1 <<APPLESCRIPT
tell application "Terminal"
  activate
  do script "$cmd_as"
end tell
APPLESCRIPT
)" && return 0
    VT_AUTOOPEN_ERR="$_err"
    return 1
  }

  _try_wezterm() {
    command -v wezterm >/dev/null 2>&1 || return 1
    wezterm cli spawn --new-window -- bash -lc "$cmd" >/dev/null 2>&1
  }

  _try_warp() {
    # Warp는 URL scheme 제한적 — 새 탭을 열되 명령 주입은 클립보드로
    [ -d "/Applications/Warp.app" ] || return 1
    open -na Warp 2>/dev/null || return 1
    # 사용자에게 명령 복사 안내
    printf '%s' "$cmd" | pbcopy 2>/dev/null
    echo "  ⓘ Warp 새 창 열림 — 아래 명령이 클립보드에 복사됨. 붙여넣기 하세요:"
    echo "      $cmd"
  }

  _try_alacritty() {
    [ -d "/Applications/Alacritty.app" ] || return 1
    open -na Alacritty --args -e bash -lc "$cmd; exec bash" 2>/dev/null
  }

  _try_kitty() {
    [ -d "/Applications/kitty.app" ] || return 1
    open -na kitty --args bash -lc "$cmd; exec bash" 2>/dev/null
  }

  _try_ghostty() {
    [ -d "/Applications/Ghostty.app" ] || return 1
    open -na Ghostty --args -e bash -lc "$cmd; exec bash" 2>/dev/null
  }

  # 1순위: 현재 사용 중인 터미널
  case "$term" in
    iTerm.app)        _try_iterm        && return 0 ;;
    Apple_Terminal)   _try_terminal_app && return 0 ;;
    WezTerm)          _try_wezterm      && return 0 ;;
    WarpTerminal)     _try_warp         && return 0 ;;
  esac
  case "$term_lc" in
    ghostty)          _try_ghostty      && return 0 ;;
    kitty)            _try_kitty        && return 0 ;;
    alacritty)        _try_alacritty    && return 0 ;;
  esac

  # 2순위: 설치된 터미널을 우선순위대로 시도
  _try_iterm        && return 0
  _try_ghostty      && return 0
  _try_wezterm      && return 0
  _try_kitty        && return 0
  _try_alacritty    && return 0
  _try_terminal_app && return 0  # Terminal.app은 어디에나 있지만 최후
  return 1
}

_print_attach_guide() {
  echo ""
  if [ -n "${TMUX:-}" ]; then
    echo "  ✓ 이미 tmux 안 ($(tmux display -p '#S')). 이 창에서 작업을 계속하세요."
    return
  fi
  _open_tmux_terminal
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    local opened="${TERM_PROGRAM:-터미널}"
    echo "  ✓ 새 ${opened} 창에 tmux 'dev' 세션이 열렸습니다."
    echo "    → resume 목록에서 현재 대화를 고르면 음성/모바일이 그 Claude로 연결됩니다."
  elif [ "$rc" -eq 2 ]; then
    : # 이미 열려 있음 — 안내 메시지는 _tmux_already_open이 이미 출력했다.
  else
    echo "  ⓘ 자동 오픈 실패. 다른 터미널에서 다음 명령을 실행하세요:"
    echo "      tmux -L $VT_TMUX_SOCKET new -A -s dev 'claude --resume'"
    _autoopen_failure_hint
  fi
}

cmd_voice() {
  echo ""
  echo "  🎤 fsh voice — 음성 모드"
  echo "  노션/브라우저 작업을 계속하면서 음성으로 코딩"
  echo ""

  _onboarding_check  # W5-2: 첫 실행 시 안내

  _ensure_tmux
  _start_server
  _start_voice_daemon

  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  echo "  │  음성 모드 활성화 완료                      │"
  echo "  │                                         │"
  echo "  │  Ctrl+Shift+V → 녹음 시작/종료           │"
  echo "  │  말한 내용 → STT → tmux에 자동 입력       │"
  echo "  │  결과 → TTS로 음성 확인                   │"
  echo "  │                                         │"
  echo "  │  작업을 계속하세요. 음성이 백그라운드에서    │"
  echo "  │  동작합니다.                              │"
  echo "  │                                         │"
  echo "  │  종료: fsh stop                          │"
  echo "  └─────────────────────────────────────────┘"

  _print_attach_guide
  echo ""
}

cmd_clip() {
  echo ""
  echo "  📋 fsh clip — 클립보드 동기화"
  echo "  맥북 시스템 클립보드 변경 감지 → 웹이 열린 기기의 클립보드로 push"
  echo "  (vim/tmux copy-mode 등 터미널 내부 복사는 OSC52로 이미 자동 동기화됨 —"
  echo "   그 경우엔 이 데몬 없이도 동작)"
  echo ""

  _start_server
  _start_clipboard_daemon

  echo ""
  echo "  종료: fsh stop"
  echo ""
}

cmd_mobile() {
  # 옵션: --e2e (E2E 암호화), --safe (위험 명령 차단), --network <mode> (Phase 8 G1),
  #       --force (인증 미설정 상태에서도 공개 터널을 강행 — 위험, 큰 경고 출력)
  local want_e2e=0
  local want_safe=0
  local want_force=0
  local network_mode="${VT_NETWORK_MODE:-all}"
  local i=1
  for arg in "$@"; do
    case "$arg" in
      --e2e) want_e2e=1 ;;
      --safe) want_safe=1 ;;
      --force) want_force=1 ;;
      --network) eval "next_arg=\${$((i+1))}"; network_mode="${next_arg:-all}" ;;
      --network=*) network_mode="${arg#--network=}" ;;
    esac
    i=$((i+1))
  done

  # 모드 검증
  case "$network_mode" in
    localhost|lan|tailscale|all) ;;
    *)
      echo "  ✗ 지원되지 않는 --network 모드: $network_mode (localhost|lan|tailscale|all)"
      return 1 ;;
  esac
  export VT_NETWORK_MODE="$network_mode"

  # 공개 터널(all 모드)을 열기 전, 인증(비밀번호/VT_AUTH_TOKEN)이 설정돼 있는지 먼저
  # 확인한다. 서버는 인증 없이도 기동되고 startup()에서 경고만 로그로 남기지만, 그
  # 경고는 아무도 안 본다 — 공개 URL이 곧 인증 없는 원격 코드 실행이 되는 걸 여기서
  # 미리 막는다. localhost/lan/tailscale 모드는 네트워크 자체가 좁혀져 있으니 대상이
  # 아니다. --force는 사용자가 위험을 인지하고 명시적으로 우회하는 경로.
  if [ "$network_mode" = "all" ] && [ $want_force -eq 0 ]; then
    if ! (cd "$VT_DIR/server" && "$VT_PYTHON" auth.py status >/dev/null 2>&1); then
      echo ""
      echo "  ✗ 인증(비밀번호/VT_AUTH_TOKEN)이 설정되지 않았습니다."
      echo ""
      echo "    이 상태로 'fsh mobile'을 실행하면 공개 인터넷에 열리는 Cloudflare"
      echo "    터널에 아무 인증 없이 터미널이 노출됩니다 — URL을 아는 누구나"
      echo "    이 맥에서 명령을 실행할 수 있습니다."
      echo ""
      echo "    먼저 다음 중 하나를 하세요:"
      echo "      fsh password              비밀번호 설정 (권장)"
      echo "      export VT_AUTH_TOKEN=... 기계용 토큰 설정"
      echo ""
      echo "    위험을 감수하고 그대로 진행하려면: fsh mobile --force"
      echo ""
      return 1
    fi
  elif [ "$network_mode" = "all" ] && [ $want_force -eq 1 ]; then
    if ! (cd "$VT_DIR/server" && "$VT_PYTHON" auth.py status >/dev/null 2>&1); then
      echo ""
      echo "  ⚠️  경고: 인증 없이 --force로 공개 터널을 엽니다."
      echo "     URL을 아는 누구나 이 맥에서 명령을 실행할 수 있습니다."
      echo ""
    fi
  fi

  # --safe 플래그 → 환경변수로 서버에 전달 (서버 시작 전 export)
  if [ $want_safe -eq 1 ]; then
    export VT_SAFE_MODE=1
  fi

  echo ""
  local mode_tag=" [network=$network_mode]"
  [ $want_e2e -eq 1 ] && mode_tag="${mode_tag} (E2E)"
  [ $want_safe -eq 1 ] && mode_tag="${mode_tag} (SAFE)"
  echo "  📱 fsh mobile — 모바일 접속${mode_tag}"
  echo ""

  _ensure_tmux
  _start_server

  # localhost/lan 모드에선 Cloudflare Tunnel 안 띄움
  local full_url=""
  case "$network_mode" in
    localhost)
      full_url="http://127.0.0.1:$VT_PORT"
      echo "  ⓘ localhost 모드: 같은 머신에서만 접속 가능"
      ;;
    lan)
      local lan_ip
      lan_ip="$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')"
      [ -z "$lan_ip" ] && lan_ip="$(ifconfig 2>/dev/null | awk '/inet 192\\./{print $2; exit}')"
      [ -z "$lan_ip" ] && lan_ip="localhost"
      full_url="http://${lan_ip}:$VT_PORT"
      echo "  ⓘ lan 모드: 같은 네트워크에서만 접속 가능"
      ;;
    tailscale)
      local ts_ip
      ts_ip="$(command -v tailscale >/dev/null 2>&1 && tailscale ip -4 2>/dev/null | head -1)"
      if [ -z "$ts_ip" ]; then
        echo "  ✗ tailscale 미실행/미설치. 'tailscale up' 먼저 실행하세요"
        return 1
      fi
      full_url="http://${ts_ip}:$VT_PORT"
      echo "  ⓘ tailscale 모드: 같은 tailnet에서만 접속 가능 (회사망에서도 Cloudflare 없이 안전)"
      ;;
    all)
      _start_tunnel
      ;;
  esac

  local url
  url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
  if [ -n "${VT_TUNNEL_HOSTNAME:-}" ] && [ "$network_mode" = "all" ]; then
    url="https://$VT_TUNNEL_HOSTNAME"
  fi
  # localhost/lan 모드는 위에서 full_url 이미 설정됨 — all 모드는 url 사용
  if [ "$network_mode" = "all" ] && [ -n "$url" ]; then
    full_url="$url"
  fi
  # 상시 토큰 대신 1회용 기기 등록 티켓(5분)을 싣는다. QR을 띄우는 시점에 이 맥에
  # 대한 물리적 접근이 이미 증명됐으므로 스캔 = 기기 등록 승인으로 본다. 상시 토큰을
  # URL에 박던 예전 방식은 그 값이 로그·히스토리·QR 이미지에 영구히 남는 문제가 있었다.
  local ticket
  ticket="$(_issue_ticket "mobile")"
  # E2E 활성화 시 URL hash fragment에 #e2e=1 추가 (서버 로그에 안 남음)
  local e2e_frag=""
  [ $want_e2e -eq 1 ] && e2e_frag="#e2e=1"

  [ -n "$ticket" ] && full_url="${full_url}?ticket=${ticket}"
  full_url="${full_url}${e2e_frag}"

  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  echo "  │  모바일 접속 준비 완료                     │"
  echo "  │                                         │"
  echo "  │  URL: $full_url"
  echo "  │                                         │"
  echo "  │  폰 브라우저에서 위 URL을 열면             │"
  echo "  │  tmux 세션에 자동 연결됩니다               │"
  if [ $want_e2e -eq 1 ]; then
  echo "  │                                         │"
  echo "  │  🔒 E2E 암호화 모드                        │"
  echo "  │     cloudflared 터널이 평문을 볼 수 없음   │"
  fi
  echo "  │                                         │"
  echo "  │  🎧 음성 전용 모드: 🎧 버튼 탭            │"
  echo "  │  🔄 핸즈프리: 🔄 버튼 탭                  │"
  echo "  │                                         │"
  echo "  │  종료: fsh stop                          │"
  echo "  └─────────────────────────────────────────┘"
  echo ""

  # QR 코드 (qrencode 설치 시)
  if command -v qrencode >/dev/null 2>&1; then
    echo "  QR 코드:"
    qrencode -t UTF8 "$full_url" 2>/dev/null || true
  fi

  # adb 연결 시 자동 열기
  if adb devices 2>/dev/null | grep -q "device$"; then
    echo "  📱 Android 기기 감지. Chrome에서 열기..."
    adb shell am start -a android.intent.action.VIEW -d "$full_url" com.android.chrome 2>/dev/null || true
  fi

  _print_attach_guide
}

cmd_start() {
  # 음성은 기본 OFF — 켜려면 --voice 명시하거나 별도로 'fsh voice' 실행.
  # 항상 켜져 있던 예전 동작을 기대하고 핫키가 안 먹는다고 헷갈리지 않도록,
  # 옵션 없이 실행하면 "필요하면 --voice로" 안내를 남긴다.
  local want_voice=0
  for arg in "$@"; do
    case "$arg" in
      --voice) want_voice=1 ;;
      --help|-h)
        echo ""
        echo "  사용법: fsh start [--voice]"
        echo "    --voice   서버+터널과 함께 Voice Daemon도 시작"
        echo ""
        return 0 ;;
    esac
  done

  echo ""
  echo "  🚀 fsh start — 전체 시작"
  echo ""

  _ensure_tmux
  _start_server
  _start_tunnel
  if [ $want_voice -eq 1 ]; then
    _start_voice_daemon
  else
    echo "ⓘ 음성은 기본으로 안 켭니다 — 필요하면 'fsh start --voice' 또는 'fsh voice'"
  fi

  echo ""
  echo "  모든 서비스 시작 완료."
  echo "  fsh status 로 상태 확인"

  _print_attach_guide
  echo ""
}

# Wave 1 W1-3: 임의 tmux 세션을 새 OS 터미널 창에서 attach
cmd_attach() {
  local target="${1:-}"

  if [ -z "$target" ]; then
    # 인자 없으면 세션 목록 표시 후 선택
    if ! "${TMUX_BASE[@]}" list-sessions >/dev/null 2>&1; then
      echo "  ⓘ tmux 세션 없음. 'fsh voice' 또는 'fsh start'로 시작하세요."
      return 1
    fi
    echo ""
    echo "  📂 tmux 세션 (fsh 소켓):"
    echo ""
    "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}  (#{session_windows} window, #{session_attached} attached)" 2>/dev/null
    echo ""
    if command -v fzf >/dev/null 2>&1; then
      target=$("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' 2>/dev/null | fzf --prompt="attach which? > " --height=40% 2>/dev/null || true)
    else
      printf "  세션 이름을 입력하세요: "
      read -r target
    fi
    [ -z "$target" ] && return 0
  fi

  # 세션 이름 안전성 검증 — 셸/AppleScript 인젝션 방어
  if ! [[ "$target" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "  ✗ 안전하지 않은 세션 이름: '$target'"
    echo "  영숫자/dash/underscore만 허용됩니다."
    return 1
  fi

  # 세션 존재 확인
  if ! "${TMUX_BASE[@]}" has-session -t "$target" 2>/dev/null; then
    echo "  ✗ tmux 세션 '$target' 없음"
    echo ""
    echo "  사용 가능한 세션:"
    "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}" 2>/dev/null || echo "    (없음)"
    return 1
  fi

  # 이미 tmux 안이면 switch-client
  if [ -n "${TMUX:-}" ]; then
    "${TMUX_BASE[@]}" switch-client -t "$target"
    echo "  ✓ 현재 tmux 클라이언트를 '$target'으로 전환"
    return 0
  fi

  # 새 OS 터미널 창에 attach (W1-3)
  _open_tmux_terminal_with "$target"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "  ✓ 새 터미널 창에 tmux 세션 '$target' attach"
  elif [ "$rc" -eq 2 ]; then
    : # 이미 열려 있음 — 안내 메시지는 _tmux_already_open이 이미 출력했다.
  else
    echo "  ⓘ 터미널 자동 오픈 실패. 수동:"
    echo "      tmux -L $VT_TMUX_SOCKET attach -t $target"
    _autoopen_failure_hint
    return 1
  fi
}

# Wave 2 W2-5: 토픽별 도움말
cmd_help() {
  local topic="${1:-}"
  local docs_dir="$VT_DIR/docs/help"

  if [ -z "$topic" ]; then
    cat <<'HELP'

  fsh — FarShell CLI

  주요 명령:
    fsh voice               음성 모드 (백그라운드, 노션 작업 중에도)
    fsh mobile [--e2e]      모바일 접속 URL + QR
    fsh start [--voice]     전체 시작 (서버+터널, --voice로 음성도 함께)
    fsh stop [--purge]      종료 (--purge: tmux까지 완전 종료)
    fsh status              현재 상태
    fsh attach [name]       임의 tmux 세션을 새 창에 attach
    fsh claude              새 창 + tmux dev + claude --resume
    fsh handoff mobile      세션을 폰으로
    fsh handoff desktop     폰 세션을 맥으로
    fsh ssh [session]       Tailscale + SSH로 tmux 세션 직접 접속 명령 안내
    fsh hotkey              핫키 조회/변경
    fsh voice-target        음성 daemon 타깃 세션 lock/해제
    fsh queue               프롬프트 큐 — 작업 중일 때 지시를 쌓아뒀다 순차 투입
    fsh manage              TUI 관리 도구 (세션/타깃/핫키/상태)
    fsh doctor              설치/환경 진단
    fsh install-profiles    터미널 앱 자동 등록 (iTerm2 등)
    fsh help <topic>        토픽별 상세 도움말

  도움말 토픽:
    fsh help webui          웹 UI 사용법 (탭/세션관리/복사·붙여넣기·이미지)
    fsh help concepts       tmux/세션/음성 개념 (3-레이어 모델)
    fsh help voice          음성 입력 동작 + 핫키
    fsh help hotkeys        핫키 전체 목록 + 변경 방법
    fsh help target         음성 타깃 lock 설명
    fsh help ssh            Tailscale + SSH 원격 접속 (회사망 등)
    fsh help tunnel-hook    터널 URL이 바뀔 때 Notion/Slack 등에 자동 게시
    fsh help troubleshoot   자주 묻는 트러블슈팅
HELP
    return 0
  fi

  local file="$docs_dir/${topic}.md"
  if [ -f "$file" ]; then
    if command -v less >/dev/null 2>&1; then
      less -R "$file"
    else
      cat "$file"
    fi
  else
    echo "  ✗ 도움말 토픽 '$topic' 없음"
    echo "  사용 가능한 토픽: webui / concepts / voice / hotkeys / target / ssh / tunnel-hook / troubleshoot"
    return 1
  fi
}

# Wave 2 W2-2: 핫키 조회/변경
cmd_hotkey() {
  local sub="${1:-list}"
  local env_file="$HOME/.vt.env"

  case "$sub" in
    list|"")
      echo ""
      echo "  ⌨  fsh hotkey — 현재 핫키 설정"
      echo ""
      local voice_hotkey
      voice_hotkey="$(vt_env_get VT_HOTKEY_VOICE)"
      [ -z "$voice_hotkey" ] && voice_hotkey="ctrl+shift+v (디폴트)"
      local voice_disabled
      voice_disabled="$(vt_env_get VT_HOTKEY_VOICE_DISABLED)"
      local voice_state="활성"
      [ "$voice_disabled" = "true" ] && voice_state="비활성 (DISABLED)"
      echo "    voice (음성 토글):     $voice_hotkey  [$voice_state]"
      echo ""
      echo "  변경: fsh hotkey set voice <ctrl+shift+x>"
      echo "  비활성: fsh hotkey disable voice"
      echo "  복구: fsh hotkey reset voice"
      echo ""
      echo "  ⓘ 변경 후 'fsh stop && fsh voice'로 daemon 재시작 필요"
      ;;
    set)
      local action="${2:-}"
      local value="${3:-}"
      if [ -z "$action" ] || [ -z "$value" ]; then
        echo "  사용법: fsh hotkey set <action> <hotkey>"
        echo "  예시:   fsh hotkey set voice ctrl+shift+x"
        return 1
      fi
      _hotkey_validate_action "$action" || return 1
      _hotkey_validate_spec "$value" || return 1
      vt_env_set "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')" "$value"
      echo "  ✓ $action 핫키 → $value"
      echo "  ⓘ daemon 재시작 필요: fsh stop && fsh voice"
      ;;
    reset)
      local action="${2:-}"
      [ -z "$action" ] && { echo "  사용법: fsh hotkey reset <action>"; return 1; }
      _hotkey_validate_action "$action" || return 1
      vt_env_unset "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')"
      vt_env_unset "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')_DISABLED"
      echo "  ✓ $action 핫키 디폴트로 복구"
      ;;
    disable)
      local action="${2:-}"
      [ -z "$action" ] && { echo "  사용법: fsh hotkey disable <action>"; return 1; }
      _hotkey_validate_action "$action" || return 1
      vt_env_set "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')_DISABLED" "true"
      echo "  ✓ $action 핫키 비활성화"
      ;;
    *)
      echo "  사용법: fsh hotkey [list|set|reset|disable] [args]"
      return 1
      ;;
  esac
}

# 액션 이름 화이트리스트 — sed/env 인젝션 방어
_hotkey_validate_action() {
  local a="$1"
  case "$a" in
    voice) return 0 ;;
    *)
      echo "  ✗ 지원되지 않는 action: '$a' (지원: voice)"
      return 1
      ;;
  esac
}

# 핫키 spec 형식 검증 — alphanumeric + '+' 만 허용
_hotkey_validate_spec() {
  local s="$1"
  if [[ "$s" =~ ^[a-zA-Z0-9_+]+$ ]]; then
    return 0
  fi
  echo "  ✗ 잘못된 핫키 형식: '$s' (예: ctrl+shift+v)"
  return 1
}

# ~/.vt.env 쓰기는 전부 lib/vt_env.sh의 vt_env_set / vt_env_unset로 일원화됐다.
# 이전엔 큰따옴표로 쓰는 setter와 홑따옴표로 쓰는 setter가 공존해서,
# 큰따옴표 쪽으로 $가 든 값(scrypt 해시 등)이 흘러가면 source 시 조용히 파괴됐다.
# 또 tmp 파일을 umask(644)로 만들어 mv하는 바람에 시크릿 파일 권한이 600→644로
# 강등됐다. 두 문제 모두 단일 구현에서 구조적으로 막는다.

# 웹 로그인 비밀번호 설정 — 원문은 저장/노출하지 않고 scrypt 해시만 ~/.vt.env에 기록.
# 세션 서명키(VT_SECRET_KEY)가 없으면 자동 생성. 기계 토큰 VT_TOKEN과는 독립.
# 프롬프트 큐 (P4) — 에이전트가 작업 중일 때 지시를 쌓아뒀다 순차 투입.
# 서버가 안 떠 있어도 동작하도록 queue_store.py CLI를 직접 호출한다(auth.py와 같은 방식).
cmd_queue() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요."
    return 1
  fi
  local sub="${1:-list}"
  case "$sub" in
    list|ls|add|rm|remove|delete|clear|unblock|run)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && "$VT_PYTHON" queue_store.py "$sub" "$@")
      ;;
    *)
      echo "사용법: fsh queue [list|add \"내용\" [세션]|rm <id>|unblock <id>|clear|run]"
      return 1 ;;
  esac
}

cmd_password() {
  local env_file="$HOME/.vt.env"
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요."
    return 1
  fi
  local sub="${1:-set}"
  if [ "$sub" = "clear" ] || [ "$sub" = "disable" ]; then
    vt_env_unset "VT_AUTH_PASSWORD_HASH"
    vt_env_unset "VT_PASSWORD_HASH"   # 레거시 이름도 함께 정리
    echo "  ✓ 웹 로그인 비밀번호 해제 (VT_AUTH_PASSWORD_HASH 제거)"
    echo "  ⓘ 서버 재시작 필요: fsh stop && fsh start"
    return 0
  fi
  local pw pw2
  printf "  새 웹 로그인 비밀번호: " >&2; read -rs pw; echo >&2
  printf "  확인 입력: " >&2; read -rs pw2; echo >&2
  if [ -z "$pw" ]; then echo "  ✗ 비밀번호가 비어 있습니다."; return 1; fi
  if [ "$pw" != "$pw2" ]; then echo "  ✗ 두 입력이 일치하지 않습니다."; return 1; fi
  if [ "${#pw}" -lt 6 ]; then echo "  ✗ 6자 이상이어야 합니다."; return 1; fi
  # 원문은 stdin으로만 python에 전달 → ps/argv/환경변수에 노출되지 않음
  local hash
  hash="$(cd "$VT_DIR/server" && printf '%s' "$pw" | "$VT_PYTHON" -c 'import sys, auth; print(auth.hash_password(sys.stdin.read()))')" \
    || { echo "  ✗ 해시 생성 실패"; return 1; }
  unset pw pw2
  if [ -z "$hash" ]; then echo "  ✗ 해시 생성 실패(빈 값)"; return 1; fi
  vt_env_set "VT_AUTH_PASSWORD_HASH" "$hash"
  vt_env_unset "VT_PASSWORD_HASH"   # 레거시 이름 잔재 제거(중복 방지)
  if ! grep -qE '^VT_AUTH_SESSION_KEY=' "$env_file" && ! grep -qE '^VT_SECRET_KEY=' "$env_file"; then
    local secret
    secret="$("$VT_PYTHON" -c 'import secrets; print(secrets.token_hex(32))')"
    vt_env_set "VT_AUTH_SESSION_KEY" "$secret"
    echo "  ✓ 세션 서명키(VT_AUTH_SESSION_KEY) 자동 생성"
  fi
  echo "  ✓ 웹 로그인 비밀번호 설정 완료 — 해시만 저장(원문 미저장)"
  echo "  ⓘ 적용하려면 서버 재시작: fsh stop && fsh start"
}

# OTP(TOTP) 연동 — 여기서 setup을 하기 전까지 OTP는 완전히 비활성이고,
# 로그인은 기존과 똑같이 비밀번호만으로 동작한다. setup 이후부터 "처음 보는 기기"에만
# 6자리를 요구한다(이미 등록된 맥/폰은 영향 없음).
cmd_otp() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요."
    return 1
  fi
  local sub="${1:-status}"
  local py_dir="$VT_DIR/server"
  case "$sub" in
    status)
      local enabled
      enabled="$(cd "$py_dir" && "$VT_PYTHON" auth.py otp-status 2>/dev/null)"
      echo ""
      if echo "$enabled" | grep -q '"enabled": *true'; then
        echo "  🔐 OTP: 활성 — 새 기기 등록 시 6자리 코드 필요"
      else
        echo "  🔓 OTP: 비활성 — 비밀번호만으로 동작 (기존과 동일)"
        echo "     연동하려면: fsh otp setup"
      fi
      echo ""
      ;;
    setup)
      if [ -z "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ]; then
        echo "  ✗ 먼저 웹 로그인 비밀번호를 설정하세요: fsh password"
        echo "    OTP는 비밀번호를 대체하지 않고, '새 기기 등록' 관문으로만 쓰입니다."
        return 1
      fi
      local out secret uri
      out="$(cd "$py_dir" && "$VT_PYTHON" auth.py otp-setup)" || { echo "  ✗ 시크릿 생성 실패"; return 1; }
      secret="$(printf '%s' "$out" | "$VT_PYTHON" -c 'import sys,json; print(json.load(sys.stdin)["secret"])')"
      uri="$(printf '%s' "$out" | "$VT_PYTHON" -c 'import sys,json; print(json.load(sys.stdin)["uri"])')"
      echo ""
      echo "  🔐 인증 앱에 등록하세요 (1Password / Authy / Google Authenticator 등)"
      echo ""
      if command -v qrencode >/dev/null 2>&1; then
        qrencode -t UTF8 "$uri" 2>/dev/null || true
      else
        echo "  (qrencode 설치 시 QR로 표시됩니다: brew install qrencode)"
      fi
      echo ""
      echo "  수동 입력용 키: $secret"
      echo ""
      printf "  등록 후 확인을 위해 6자리 코드를 입력하세요: "
      local code; read -r code
      if (cd "$py_dir" && "$VT_PYTHON" auth.py otp-verify "$code" >/dev/null); then
        echo "  ✓ OTP 연동 완료 — 지금부터 '새' 기기 등록 시에만 코드를 요구합니다"
        echo "  ⓘ 현재 등록된 기기는 그대로 통과합니다: fsh device list"
      else
        echo "  ✗ 코드가 맞지 않습니다. 시계 동기화를 확인하고 'fsh otp setup'을 다시 실행하세요."
        echo "    (지금 상태로는 새 기기 등록 시 코드가 필요하니, 확실히 하려면 재실행 권장)"
        return 1
      fi
      ;;
    disable|clear|off)
      (cd "$py_dir" && "$VT_PYTHON" auth.py otp-disable >/dev/null)
      echo "  ✓ OTP 연동 해제 — 새 기기도 비밀번호만으로 등록됩니다"
      ;;
    *)
      echo "  사용법: fsh otp [status|setup|disable]"
      return 1
      ;;
  esac
}

# 등록된 기기(화이트리스트) 조회/폐기. 폰 분실 시 revoke하면 그 기기의 세션 쿠키까지 함께 죽는다.
cmd_device() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요."
    return 1
  fi
  local sub="${1:-list}"
  local py_dir="$VT_DIR/server"
  case "$sub" in
    list|ls|"")
      (cd "$py_dir" && "$VT_PYTHON" auth.py device-list-pretty)
      ;;
    revoke|rm|remove)
      local id="${2:-}"
      if [ -z "$id" ]; then echo "  사용법: fsh device revoke <id앞자리>"; return 1; fi
      if (cd "$py_dir" && "$VT_PYTHON" auth.py device-revoke "$id" >/dev/null); then
        echo "  ✓ 기기 폐기 완료 — 해당 기기의 세션도 즉시 무효화됩니다"
      else
        echo "  ✗ 해당 id로 시작하는 기기를 찾지 못했습니다 (fsh device list로 확인)"
        return 1
      fi
      ;;
    *)
      echo "  사용법: fsh device [list|revoke <id>]"
      return 1
      ;;
  esac
}

# 모바일/핸드오프 URL에 붙일 1회용 기기 등록 티켓. 인증이 꺼져 있으면 빈 문자열.
_issue_ticket() {
  [ -z "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ] && [ -z "${VT_AUTH_TOKEN:-${VT_TOKEN:-}}" ] && return 0
  [ -z "${VT_PYTHON:-}" ] && return 0
  (cd "$VT_DIR/server" && "$VT_PYTHON" auth.py ticket-new "$1" 2>/dev/null) || true
}

# Wave 2 W2-4: 음성 daemon 타깃 세션 lock/해제 (V3-R)
cmd_voice_target() {
  local target_file="$HOME/.vt/voice_target"
  mkdir -p "$HOME/.vt"

  local arg="${1:-}"
  case "$arg" in
    ""|list|status)
      echo ""
      echo "  🎤 fsh voice-target — 현재 음성 타깃"
      echo ""
      if [ -f "$target_file" ]; then
        local locked
        locked="$(cat "$target_file" 2>/dev/null)"
        if [ -n "$locked" ]; then
          echo "    🔒 LOCK: $locked"
        else
          echo "    🔓 AUTO: tmux most-recent (lock 없음)"
        fi
      else
        echo "    🔓 AUTO: tmux most-recent (lock 없음)"
      fi
      echo ""
      echo "  사용 가능한 세션:"
      "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}" 2>/dev/null || echo "    (없음)"
      echo ""
      echo "  변경: fsh voice-target <세션명>     # lock"
      echo "  해제: fsh voice-target --auto       # auto로"
      echo ""
      ;;
    --auto|auto)
      rm -f "$target_file"
      echo "  ✓ 음성 타깃 → AUTO (most-recent)"
      ;;
    *)
      # 세션 존재 확인
      if ! "${TMUX_BASE[@]}" has-session -t "$arg" 2>/dev/null; then
        echo "  ✗ tmux 세션 '$arg' 없음"
        return 1
      fi
      printf '%s\n' "$arg" > "$target_file"
      echo "  ✓ 음성 타깃 → $arg (lock)"
      ;;
  esac
}

# Wave 5 W5-2: 첫 실행 onboarding 안내
_onboarding_check() {
  local marker="$HOME/.vt/onboarded"
  [ -f "$marker" ] && return 0
  mkdir -p "$HOME/.vt"

  # 셸 init 또는 iTerm Dynamic Profile 등록 여부 확인 (구 파일명 vt.json도 인식)
  local has_profile=0
  if [ -f "$HOME/Library/Application Support/iTerm2/DynamicProfiles/fsh.json" ] || \
     [ -f "$HOME/Library/Application Support/iTerm2/DynamicProfiles/vt.json" ]; then
    has_profile=1
  fi
  local has_shellinit=0
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.config/fish/config.fish"; do
    if [ -f "$rc" ] && grep -q "tmux -L $VT_TMUX_SOCKET new -A -s dev" "$rc" 2>/dev/null; then
      has_shellinit=1
      break
    fi
  done

  if [ "$has_profile" -eq 0 ] && [ "$has_shellinit" -eq 0 ]; then
    echo ""
    echo "  ⚡ 첫 실행 안내"
    echo ""
    echo "  새 터미널 창이 자동으로 FarShell tmux로 진입하도록 설정하지 않았습니다."
    echo "  이 설정 없이도 'fsh voice'는 동작하지만, 새 창에서 자동 attach가 더 편리합니다."
    echo ""
    echo "  설정하려면:"
    echo "    fsh install-profiles               (iTerm2 등 자동 등록)"
    echo "    eval \"\$(fsh shell-init zsh)\" >> ~/.zshrc   (셸 init)"
    echo ""
    echo "  개념 설명: fsh help concepts"
    echo ""
  fi

  touch "$marker"
}

# Wave 4 W4-1: TUI 관리 도구 진입점
cmd_manage() {
  if ! "$VT_PYTHON" -c "import textual" 2>/dev/null; then
    echo ""
    echo "  ✗ textual 미설치 — TUI를 실행할 수 없습니다."
    echo ""
    echo "  설치:"
    echo "    cd $VT_DIR && .venv/bin/pip install textual"
    echo "  또는:"
    echo "    ./install.sh"
    echo ""
    return 1
  fi
  export VT_BIN="$VT_DIR/bin/fsh"
  exec "$VT_PYTHON" "$VT_DIR/server/tui_manager.py" "$@"
}

cmd_stop() {
  # Wave 1 W1-4: --purge 옵션으로 tmux까지 종료
  local purge=0
  for arg in "$@"; do
    case "$arg" in
      --purge|-p) purge=1 ;;
    esac
  done

  echo ""
  echo "  ⏹  fsh stop"
  echo ""

  for svc in voice clip tunnel-watchdog tunnel server; do
    local pidfile="$PID_DIR/$svc.pid"
    if [ -f "$pidfile" ]; then
      local pid
      pid=$(cat "$pidfile")
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        echo "  ✓ $svc 종료 (PID $pid)"
      fi
      rm -f "$pidfile"
    fi
  done

  # 추가 포트 터널 (fsh tunnel expose)
  for pidfile in "$PID_DIR"/tunnel-*.pid; do
    [ -f "$pidfile" ] || continue
    local epid
    epid="$(cat "$pidfile")"
    if kill -0 "$epid" 2>/dev/null; then
      kill "$epid" 2>/dev/null
      echo "  ✓ $(basename "$pidfile" .pid) 종료 (PID $epid)"
    fi
    rm -f "$pidfile"
  done
  rm -f "$TUNNEL_REGISTRY"

  # 혹시 남은 프로세스 정리
  pkill -f "voice_daemon.py" 2>/dev/null || true
  pkill -f "clipboard_daemon.py" 2>/dev/null || true
  pkill -f "tunnel_watchdog.py" 2>/dev/null || true
  pkill -f "cloudflared tunnel" 2>/dev/null || true
  if command -v lsof >/dev/null 2>&1; then
    lsof -i :$VT_PORT -t 2>/dev/null | xargs kill 2>/dev/null || true
  elif command -v fuser >/dev/null 2>&1; then
    fuser -k $VT_PORT/tcp 2>/dev/null || true
  fi

  echo "  ✓ 서버/터널/음성 데몬 종료"
  echo ""

  # tmux 세션 처리: 디폴트는 살림(영속성), --purge면 완전 종료
  local sessions=""
  if "${TMUX_BASE[@]}" list-sessions 2>/dev/null | grep -q .; then
    sessions="$("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ')"
  fi

  if [ "$purge" -eq 1 ]; then
    if [ -n "$sessions" ]; then
      "${TMUX_BASE[@]}" kill-server 2>/dev/null || true
      echo "  ✓ tmux 세션 완전 종료 (--purge): $sessions"
    else
      echo "  ⓘ 종료할 tmux 세션 없음"
    fi
    echo ""
  else
    if [ -n "$sessions" ]; then
      echo "  ⓘ tmux 세션은 살아있습니다 (영속성):"
      echo "      $sessions"
      echo "  완전 종료: fsh stop --purge"
    fi
    echo ""
  fi
}

cmd_doctor() {
  # 설치 상태 및 실행 환경 진단
  echo ""
  echo "  🩺 fsh doctor — 설치/환경 진단"
  echo ""

  local ok=0 warn=0 fail=0
  _check() {
    local label="$1" status="$2" detail="$3"
    case "$status" in
      ok)   printf "  ✓ %-22s %s\n" "$label" "$detail"; ok=$((ok+1)) ;;
      warn) printf "  ⚠ %-22s %s\n" "$label" "$detail"; warn=$((warn+1)) ;;
      fail) printf "  ✗ %-22s %s\n" "$label" "$detail"; fail=$((fail+1)) ;;
    esac
  }

  # 1. Python
  if [ -x "$VT_PYTHON" ]; then
    local pyver; pyver="$("$VT_PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "?")"
    _check "Python" ok "$VT_PYTHON (v$pyver)"
  else
    _check "Python" fail "$VT_PYTHON — 실행 불가. install.sh 재실행"
  fi

  # 2. venv
  if [ -d "$VT_DIR/.venv" ]; then
    _check "venv" ok "$VT_DIR/.venv"
  elif [ -n "${VT_PYTHON:-}" ] && [ "$VT_PYTHON" != "$VT_DIR/.venv/bin/python" ] && [ -x "$VT_PYTHON" ]; then
    _check "venv" ok "외부 환경 사용: $VT_PYTHON (~/.vt.env)"
  else
    _check "venv" fail ".venv 없음 → './install.sh' 실행 또는 ~/.vt.env에 VT_PYTHON 지정"
  fi

  # 3. 핵심 Python 패키지
  if "$VT_PYTHON" -c "import fastapi, uvicorn" 2>/dev/null; then
    _check "core packages" ok "fastapi, uvicorn 설치됨"
  else
    _check "core packages" fail "pip install -r requirements-core.txt"
  fi
  if "$VT_PYTHON" -c "import faster_whisper, edge_tts, sounddevice" 2>/dev/null; then
    _check "voice packages" ok "faster-whisper, edge-tts, sounddevice"
  else
    _check "voice packages" warn "음성 기능 미설치 ('./install.sh voice'로 추가)"
  fi

  # 4. tmux
  if command -v tmux >/dev/null 2>&1; then
    _check "tmux" ok "$(tmux -V)"
  else
    _check "tmux" fail "brew install tmux / apt install tmux"
  fi

  # 5. cloudflared (원격 접속용)
  if command -v cloudflared >/dev/null 2>&1; then
    _check "cloudflared" ok "$(cloudflared --version 2>&1 | head -1)"
  else
    _check "cloudflared" warn "원격 접속 시 필요. brew install cloudflared"
  fi

  # 5b. Tailscale (D9: 회사망 등 화면 원격이 막힌 환경의 SSH 경유 접속용, `fsh ssh`)
  if command -v tailscale >/dev/null 2>&1; then
    local ts_ip
    ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    if [ -n "$ts_ip" ]; then
      _check "Tailscale" ok "연결됨 ($ts_ip) — 'fsh ssh'로 원격 SSH 접속 명령 안내"
    else
      _check "Tailscale" warn "설치됨, 미연결 — 'tailscale up' 실행 필요"
    fi
  else
    _check "Tailscale" warn "미설치 — 회사망 등에서 SSH로 원격 접속 시 필요. https://tailscale.com/download"
  fi

  # 6. ffmpeg (모바일 음성 입력 디코딩)
  if command -v ffmpeg >/dev/null 2>&1; then
    _check "ffmpeg" ok "설치됨"
  else
    _check "ffmpeg" warn "모바일 음성 입력 시 필요. brew install ffmpeg"
  fi

  # 7. 포트 사용 상태
  if _port_in_use "$VT_PORT"; then
    _check "port $VT_PORT" warn "사용 중 (서버 이미 실행 중일 수 있음)"
  else
    _check "port $VT_PORT" ok "사용 가능"
  fi

  # 8. fsh CLI 심링크
  if [ -L "$HOME/.local/bin/fsh" ]; then
    _check "fsh CLI" ok "~/.local/bin/fsh"
  elif [ -f "$HOME/.local/bin/fsh" ]; then
    _check "fsh CLI" warn "심링크 아닌 파일 (install.sh 재실행 권장)"
  else
    _check "fsh CLI" warn "~/.local/bin/fsh 없음 (현재 $0로 실행 중)"
  fi

  # 9. PATH
  if echo ":$PATH:" | grep -q ":$HOME/.local/bin:"; then
    _check "PATH" ok "~/.local/bin 포함"
  else
    _check "PATH" warn "~/.local/bin 미포함. echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc"
  fi

  # 10. 설정 파일 — 존재 / 권한 / 형식
  if [ -f "$VT_CONFIG" ]; then
    _check ".vt.env" ok "$VT_CONFIG"

    # 시크릿(토큰·비밀번호 해시·세션 서명키)이 담기므로 그룹/기타 읽기 권한은 위험
    local perm
    perm="$(ls -l "$VT_CONFIG" 2>/dev/null | cut -c1-10)"
    case "$perm" in
      -rw-------|-r--------)
        _check ".vt.env 권한" ok "$perm" ;;
      *)
        _check ".vt.env 권한" fail "$perm — 다른 사용자가 읽을 수 있음. 'chmod 600 $VT_CONFIG'" ;;
    esac

    # bash source와 Python 파서가 다르게 읽을 수 있는 줄 (따옴표 없음 / 큰따옴표)
    local badlines
    badlines="$(vt_env_lint "$VT_CONFIG" || true)"
    if [ -n "$badlines" ]; then
      _check ".vt.env 형식" warn "홑따옴표로 감싸지 않은 값이 있습니다 — bash가 \$를 확장해 값이 깨질 수 있음"
      printf '%s\n' "$badlines" | sed 's/^/        /'
    else
      _check ".vt.env 형식" ok "모든 값이 정규 형식"
    fi
  else
    _check ".vt.env" warn "없음. install.sh가 자동 생성"
  fi

  # 11. 인증 (비밀번호 해시 또는 토큰)
  if [ -n "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ]; then
    _check "인증" ok "웹 로그인 비밀번호 설정됨 (fsh password)"
  elif [ -n "${VT_AUTH_TOKEN:-${VT_TOKEN:-}}" ]; then
    _check "인증" ok "VT_AUTH_TOKEN 설정됨 (원격 인증 활성)"
  else
    _check "인증" warn "미설정 (공개 터널에선 누구나 접속 가능) — 'fsh password' 권장"
  fi

  # 11-b. OTP(새 기기 등록 관문) + 등록 기기 수
  if [ -x "${VT_PYTHON:-}" ]; then
    local _otp_json _ndev
    _otp_json="$(cd "$VT_DIR/server" && "$VT_PYTHON" auth.py otp-status 2>/dev/null)"
    _ndev="$(cd "$VT_DIR/server" && "$VT_PYTHON" -c 'import auth,sys; sys.stdout.write(str(len(auth.list_devices())))' 2>/dev/null || echo "?")"
    if echo "$_otp_json" | grep -q '"enabled": *true'; then
      _check "OTP" ok "활성 — 새 기기 등록 시 코드 필요 (등록 기기 ${_ndev}개)"
    else
      _check "OTP" warn "미연동 — 비밀번호만으로 새 기기도 접속 가능 (등록 기기 ${_ndev}개). 'fsh otp setup'"
    fi
  fi

  # 12. 푸시 알림
  if [ -n "${VT_NOTIFY_URL:-}" ]; then
    _check "VT_NOTIFY_URL" ok "$(echo "$VT_NOTIFY_URL" | sed 's|https://||;s|/.*|/...|')"
  elif [ -n "${VT_TELEGRAM_TOKEN:-}" ]; then
    _check "Telegram" ok "토큰 설정됨"
  else
    _check "push 알림" warn "미설정 (작업 완료 알림 받으려면 VT_NOTIFY_URL=https://ntfy.sh/your-topic)"
  fi

  # 13. macOS 터미널 앱 감지 (자동 창 오픈용)
  if [ "$(uname)" = "Darwin" ]; then
    local detected=()
    [ -d "/Applications/iTerm.app" ] && detected+=("iTerm2")
    [ -d "/Applications/Ghostty.app" ] && detected+=("Ghostty")
    [ -d "/Applications/WezTerm.app" ] && detected+=("WezTerm")
    [ -d "/Applications/kitty.app" ] && detected+=("Kitty")
    [ -d "/Applications/Alacritty.app" ] && detected+=("Alacritty")
    [ -d "/Applications/Warp.app" ] && detected+=("Warp")
    # Terminal.app은 맥에 기본 내장이므로 항상 사용 가능
    detected+=("Terminal.app")
    _check "터미널 앱" ok "감지: ${detected[*]} — 현재 TERM_PROGRAM=${TERM_PROGRAM:-unknown}"
  fi

  # W3-6: Linux 환경 검사
  if [ "$(uname)" = "Linux" ]; then
    # 14. Linux 터미널 emulator
    local lin_terms=()
    for em in gnome-terminal konsole alacritty kitty wezterm xfce4-terminal xterm; do
      command -v "$em" >/dev/null 2>&1 && lin_terms+=("$em")
    done
    if [ "${#lin_terms[@]}" -gt 0 ]; then
      _check "Linux 터미널" ok "감지: ${lin_terms[*]}"
    else
      _check "Linux 터미널" warn "지원 emulator 없음 — gnome-terminal/konsole 등 설치 권장"
    fi

    # 15. Linux TTS
    local lin_tts=""
    for t in espeak-ng espeak spd-say piper; do
      command -v "$t" >/dev/null 2>&1 && lin_tts="$lin_tts $t"
    done
    if [ -n "$lin_tts" ]; then
      _check "Linux TTS" ok "감지:$lin_tts"
    else
      _check "Linux TTS" warn "TTS 미설치 — sudo apt-get install espeak-ng"
    fi

    # 16. notify-send
    if command -v notify-send >/dev/null 2>&1; then
      _check "notify-send" ok "$(command -v notify-send)"
    else
      _check "notify-send" warn "데스크톱 알림 미지원 — sudo apt-get install libnotify-bin"
    fi

    # 17. Wayland 글로벌 핫키 가드
    local sess_type="${XDG_SESSION_TYPE:-unknown}"
    if [ "$sess_type" = "wayland" ]; then
      _check "Display Server" warn "Wayland — 글로벌 핫키 캡처 제한. X11 세션 또는 모바일 🎤 사용 권장"
    elif [ "$sess_type" = "x11" ]; then
      _check "Display Server" ok "X11"
    else
      _check "Display Server" warn "XDG_SESSION_TYPE=$sess_type"
    fi
  fi

  # 18. textual (TUI 의존성)
  if "$VT_PYTHON" -c "import textual" 2>/dev/null; then
    _check "TUI (textual)" ok "fsh manage 사용 가능"
  else
    _check "TUI (textual)" warn "fsh manage 사용 불가 — pip install textual"
  fi

  # 19. fzf (fsh attach 인터랙티브)
  if command -v fzf >/dev/null 2>&1; then
    _check "fzf" ok "fsh attach 인터랙티브 선택 가능"
  else
    _check "fzf" warn "fzf 미설치 — 'fsh attach' 시 텍스트 입력만 가능"
  fi

  echo ""
  echo "  결과: ✓ $ok  ⚠ $warn  ✗ $fail"
  echo ""
  if [ $fail -gt 0 ]; then
    echo "  🔴 치명적 문제 있음. ✗ 항목부터 해결하세요."
    return 1
  elif [ $warn -gt 0 ]; then
    echo "  🟡 기본 동작은 가능하지만 일부 기능 미설치. ⚠ 항목 확인 권장."
  else
    echo "  🟢 모든 체크 통과."
  fi
  echo ""
}

cmd_agent() {
  # fsh agent <claude|codex|aider|gemini> — 지정한 AI CLI를 tmux dev에서 시작
  local agent="${1:-claude}"
  shift || true

  local exec_cmd bin_name icon label
  # Phase 8 G4: Claude만 --disallowedTools 자동 주입 (다른 CLI는 미지원)
  local disallowed
  disallowed="$(_resolve_disallowed_tools)"
  case "$agent" in
    claude) exec_cmd="claude --resume --disallowedTools \"$disallowed\""; bin_name="claude"; icon="🟣"; label="Claude" ;;
    codex)  exec_cmd="codex"; bin_name="codex"; icon="🟢"; label="Codex" ;;
    aider)  exec_cmd="aider"; bin_name="aider"; icon="🔵"; label="Aider" ;;
    gemini) exec_cmd="gemini"; bin_name="gemini"; icon="🟡"; label="Gemini" ;;
    *)
      echo "  ✗ 지원되지 않는 agent: $agent"
      echo "  사용법: fsh agent <claude|codex|aider|gemini>"
      return 1
      ;;
  esac

  if ! command -v "$bin_name" >/dev/null 2>&1; then
    echo "  ✗ $label CLI 미설치: '$bin_name' 명령을 찾을 수 없습니다"
    return 1
  fi

  echo ""
  echo "  $icon fsh agent $agent — $label 시작 (tmux dev)"
  echo ""

  _ensure_tmux
  if [ -n "${TMUX:-}" ]; then
    echo "  ✓ 이미 tmux 안. 현재 창에서 $label 실행."
    # exec_cmd 내부 따옴표(--disallowedTools "...")를 셸이 파싱하도록 sh -c 경유.
    # 단순 단어분할(exec $exec_cmd)은 따옴표를 리터럴로 취급해 인자를 깬다.
    exec sh -c "$exec_cmd \"\$@\"" sh "$@"
  fi

  # 세션당 창 하나 원칙: 'dev'가 이미 다른 창에 열려 있으면 새로 열지 않는다.
  _tmux_already_open "dev" && { echo ""; return 0; }

  # 새 터미널 창에서 실행 — _open_tmux_terminal은 'claude --resume' 하드코딩이므로
  # 이 경로에선 직접 명령 빌드 후 동등한 로직 사용.
  # exec_cmd는 큰따옴표(--disallowedTools "...")를 포함하므로 작은따옴표로 감싸
  # 셸이 그대로 tmux에 넘기게 하고, osascript엔 이스케이프해서 전달한다.
  local cmd="tmux -L $VT_TMUX_SOCKET new -A -s dev '$exec_cmd'"
  local cmd_as
  cmd_as="$(_as_escape "$cmd")"
  if [ "$(uname)" = "Darwin" ] && [ -d "/Applications/iTerm.app" ]; then
    local _err
    if _err="$(osascript 2>&1 <<APPLESCRIPT
tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "$cmd_as"
  end tell
end tell
APPLESCRIPT
)"; then
      echo "  ✓ 새 iTerm 창에서 '$exec_cmd' 시작"
    else
      VT_AUTOOPEN_ERR="$_err"
      echo "  ⓘ 터미널 자동 오픈 실패. 수동으로:"
      echo "      $cmd"
      _autoopen_failure_hint
    fi
  else
    echo "  ⓘ 터미널 자동 오픈 실패. 수동으로:"
    echo "      $cmd"
  fi
  echo ""
}

# 하위 호환: fsh claude → fsh agent claude
cmd_claude() { cmd_agent claude "$@"; }

cmd_template() {
  # fsh template [save|apply|list|rm] <name>
  local action="${1:-list}"
  local name="${2:-default}"
  local DIR="$HOME/.config/vt/templates"
  mkdir -p "$DIR"

  case "$action" in
    save)
      if [ ! -f "CLAUDE.md" ]; then
        echo "  ✗ 현재 디렉토리에 CLAUDE.md가 없습니다"
        return 1
      fi
      cp "CLAUDE.md" "$DIR/$name.md"
      echo "  ✓ '$name' 템플릿으로 저장됨 → $DIR/$name.md"
      ;;
    apply)
      if [ ! -f "$DIR/$name.md" ]; then
        echo "  ✗ 템플릿 '$name'을 찾을 수 없습니다"
        echo "  사용 가능한 템플릿: $(ls -1 "$DIR" 2>/dev/null | sed 's/\.md$//' | tr '\n' ' ')"
        return 1
      fi
      if [ -f "CLAUDE.md" ]; then
        cp "CLAUDE.md" "CLAUDE.md.bak"
        echo "  ⓘ 기존 CLAUDE.md → CLAUDE.md.bak으로 백업"
      fi
      cp "$DIR/$name.md" "CLAUDE.md"
      echo "  ✓ '$name' 템플릿 적용 → ./CLAUDE.md"
      ;;
    list)
      echo ""
      echo "  📋 fsh template — 사용 가능한 템플릿"
      echo "  저장 위치: $DIR"
      echo ""
      if [ -d "$DIR" ] && [ "$(ls -A "$DIR" 2>/dev/null)" ]; then
        for t in "$DIR"/*.md; do
          [ -f "$t" ] || continue
          local base
          base="$(basename "$t" .md)"
          local size
          size="$(wc -c < "$t" | tr -d ' ')"
          printf "    • %-20s (%s bytes)\n" "$base" "$size"
        done
      else
        echo "    (템플릿 없음. 'fsh template save <이름>' 으로 저장)"
      fi
      echo ""
      ;;
    rm|remove|delete)
      if [ ! -f "$DIR/$name.md" ]; then
        echo "  ✗ 템플릿 '$name'을 찾을 수 없습니다"
        return 1
      fi
      rm "$DIR/$name.md"
      echo "  ✓ '$name' 템플릿 삭제"
      ;;
    *)
      echo "사용법: fsh template [save|apply|list|rm] <name>"
      return 1
      ;;
  esac
}

cmd_popup() {
  # fsh popup <action> — tmux 3.2+ display-popup으로 빠른 호출
  local action="${1:-status}"

  if [ -z "${TMUX:-}" ]; then
    # tmux 밖이면 그냥 직접 실행
    cmd_${action} 2>/dev/null || {
      echo "  ⓘ tmux 안에서만 popup으로 띄울 수 있습니다."
      echo "  대신 직접 실행: fsh $action"
    }
    return
  fi

  # tmux 3.2+ 확인
  local tmux_ver
  tmux_ver="$(tmux -V | awk '{print $2}')"
  local first_ver
  first_ver="$(printf '3.2\n%s' "$tmux_ver" | sort -V | head -1)"

  if [ "$first_ver" = "3.2" ]; then
    "${TMUX_BASE[@]}" display-popup -E -w 80% -h 70% \
      "$0 $action; echo; echo '엔터를 눌러 닫기'; read -r"
  else
    echo "  ⓘ tmux 3.2+ 필요 (현재: $tmux_ver). 직접 실행:"
    cmd_${action} 2>/dev/null
  fi
}

cmd_run() {
  # fsh run "..." — headless claude -p 백그라운드 실행 + 완료 시 TTS/푸시
  # Phase 8 G4: --disallowedTools 자동 주입 + lockfile (중복 실행 방지)
  local prompt="$*"
  if [ -z "$prompt" ]; then
    echo "사용법: fsh run \"명령어\""
    echo "  예: fsh run \"오늘 git 변경사항 요약해줘\""
    return 1
  fi

  if ! command -v claude >/dev/null 2>&1; then
    echo "  ✗ claude CLI 미설치"
    return 1
  fi

  # lockfile — 같은 프롬프트 중복 실행 방지 (reminder-watch 패턴)
  local prompt_hash
  prompt_hash="$(printf '%s' "$prompt" | shasum 2>/dev/null | cut -c1-8 || echo "$$")"
  local LOCK="/tmp/vt-run-${prompt_hash}.lock"
  if [ -f "$LOCK" ]; then
    local lock_pid
    lock_pid="$(cat "$LOCK" 2>/dev/null)"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo "  ⓘ 이미 실행 중 (PID $lock_pid). 같은 프롬프트는 동시 실행 차단."
      echo "    중복 해제: rm $LOCK"
      return 1
    else
      # stale lockfile → 자동 정리
      rm -f "$LOCK"
    fi
  fi

  local LOG="/tmp/vt-run-${prompt_hash}-$(date +%s).log"
  local TIMEOUT="${VT_RUN_TIMEOUT:-3600}"
  local disallowed
  disallowed="$(_resolve_disallowed_tools)"

  echo ""
  echo "  🚀 fsh run — 백그라운드 dispatch"
  echo "    프롬프트: $prompt"
  echo "    타임아웃: ${TIMEOUT}초"
  echo "    로그: $LOG"
  echo "    차단 도구: ${disallowed:0:60}..."
  echo ""

  (
    echo $$ > "$LOCK"
    trap 'rm -f "$LOCK"' EXIT

    local timeout_flag=0
    if command -v timeout >/dev/null 2>&1; then
      timeout "$TIMEOUT" claude -p "$prompt" \
        --permission-mode bypassPermissions \
        --disallowedTools "$disallowed" \
        > "$LOG" 2>&1
      [ $? -eq 124 ] && timeout_flag=1
    else
      claude -p "$prompt" \
        --permission-mode bypassPermissions \
        --disallowedTools "$disallowed" \
        > "$LOG" 2>&1
    fi

    local result
    result="$(tail -c 400 "$LOG" 2>/dev/null)"
    [ -z "$result" ] && result="(빈 응답 또는 실패)"
    local title_tag="fsh run 완료"
    if [ $timeout_flag -eq 1 ]; then
      title_tag="[TIMEOUT] fsh run"
      result="타임아웃 (${TIMEOUT}초): $result"
    fi

    # TTS — 서버 실행 중이면
    if curl -sf "http://localhost:${VT_PORT}/" -o /dev/null 2>/dev/null; then
      curl -sf -X POST "http://localhost:${VT_PORT}/voice/output" \
        -H 'Content-Type: application/json' \
        -d "$(python3 -c "import json,sys; print(json.dumps({'text': sys.argv[1][:200]}))" "$result")" \
        -o /tmp/vt-run-tts.mp3 2>/dev/null && \
        afplay /tmp/vt-run-tts.mp3 2>/dev/null
    else
      # fallback: macOS say
      command -v say >/dev/null && say -v Yuna "${result:0:200}" 2>/dev/null
    fi

    # ntfy 푸시
    if [ -n "${VT_NOTIFY_URL:-}" ]; then
      curl -sf -d "$result" \
        -H "Title: ${title_tag}" \
        -H "Tags: white_check_mark" \
        "$VT_NOTIFY_URL" >/dev/null 2>&1
    fi
  ) &

  local bg_pid=$!
  echo "  ✓ PID $bg_pid — 완료 시 TTS·푸시 알림"
  echo "    실시간 확인: tail -f $LOG"
  echo ""
}

cmd_handoff() {
  # fsh handoff mobile  — 폰으로 현재 tmux 세션 넘기기 (QR + 좌표)
  # fsh handoff desktop — 맥북 iTerm으로 tmux 가져오기
  local target="${1:-mobile}"

  case "$target" in
    mobile)
      echo ""
      echo "  📱 fsh handoff mobile — 현재 tmux 세션을 폰으로"
      echo ""
      _ensure_tmux
      _start_server
      _start_tunnel

      # 현재 tmux 세션 결정 (TMUX 안이면 그 세션, 아니면 dev)
      local session=""
      if [ -n "${TMUX:-}" ]; then
        session="$("${TMUX_BASE[@]}" display -p '#S' 2>/dev/null || tmux display -p '#S')"
      else
        session="dev"
      fi

      local url
      url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
      local ticket
      ticket="$(_issue_ticket "handoff")"
      local full_url="$url"
      [ -n "$ticket" ] && full_url="${url}?ticket=${ticket}"
      # 폰이 접속하면 이 tmux 세션을 기본으로 보도록 hash 파라미터 추가
      full_url="${full_url}#tmux=${session}"

      echo ""
      echo "  ┌─────────────────────────────────────────┐"
      echo "  │  핸드오프 준비 완료                        │"
      echo "  │  tmux 세션: $session"
      echo "  │  URL: $full_url"
      echo "  └─────────────────────────────────────────┘"
      echo ""
      if command -v qrencode >/dev/null 2>&1; then
        echo "  QR 코드:"
        qrencode -t UTF8 "$full_url" 2>/dev/null || true
      fi
      if adb devices 2>/dev/null | grep -q "device$"; then
        echo "  📱 Android 기기 감지. Chrome에서 열기..."
        adb shell am start -a android.intent.action.VIEW -d "$full_url" com.android.chrome 2>/dev/null || true
      fi
      ;;
    desktop|mac)
      echo ""
      echo "  🖥  fsh handoff desktop — 맥북 터미널로 tmux"
      echo ""
      _ensure_tmux
      if [ -n "${TMUX:-}" ]; then
        echo "  ⓘ 이미 tmux 안 ($(tmux display -p '#S')). 추가 동작 없음."
        return
      fi
      _ensure_tmux
      if _open_tmux_terminal; then
        echo "  ✓ 새 ${TERM_PROGRAM:-터미널} 창에 tmux 'dev' + claude --resume 열림"
      else
        echo "  ⓘ 터미널 자동 오픈 실패. 수동: tmux new -A -s dev 'claude --resume'"
        _autoopen_failure_hint
      fi
      ;;
    *)
      echo "사용법: fsh handoff [mobile|desktop]"
      return 1
      ;;
  esac
  echo ""
}

cmd_ssh() {
  # fsh ssh [session] [--user <name>] [--add-key "ssh-ed25519 AAAA..."]
  # 회사망처럼 화면 원격(RDP/VNC/크롬 원격 등)이 막힌 환경에서도 Tailscale은
  # 대개 통과함 → Tailscale + SSH로 이 맥북의 tmux -L fsh 세션에 바로 attach.
  # 이 명령은 "복사해서 다른 기기에서 실행할 명령어"를 안내만 한다 (원격 실행 없음).
  local session="dev"
  local remote_user
  remote_user="$(whoami)"
  local add_key=""
  local args=("$@")
  local i=0
  while [ $i -lt ${#args[@]} ]; do
    local arg="${args[$i]}"
    case "$arg" in
      --user) i=$((i+1)); remote_user="${args[$i]:-$remote_user}" ;;
      --user=*) remote_user="${arg#--user=}" ;;
      --add-key) i=$((i+1)); add_key="${args[$i]:-}" ;;
      --add-key=*) add_key="${arg#--add-key=}" ;;
      -*) echo "  ✗ 알 수 없는 옵션: $arg"; return 1 ;;
      *) session="$arg" ;;
    esac
    i=$((i+1))
  done

  echo ""
  echo "  🔑 fsh ssh — Tailscale + SSH로 tmux 세션 직접 접속"
  echo ""

  if [ -n "$add_key" ]; then
    case "$add_key" in
      ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *)
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        touch "$HOME/.ssh/authorized_keys" && chmod 600 "$HOME/.ssh/authorized_keys"
        if grep -qF "$add_key" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
          echo "  ⓘ 이미 등록된 공개키 (중복 스킵)"
        else
          echo "$add_key" >> "$HOME/.ssh/authorized_keys"
          echo "  ✓ 공개키를 ~/.ssh/authorized_keys에 추가했습니다"
        fi
        echo ""
        ;;
      *)
        echo "  ✗ 공개키 형식이 아님 (ssh-ed25519/ssh-rsa/ecdsa-sha2-*로 시작해야 함)"
        return 1
        ;;
    esac
  fi

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "  ✗ tailscale 미설치. brew install tailscale (macOS) 또는 https://tailscale.com/download"
    return 1
  fi

  local ts_json
  ts_json="$(tailscale status --json 2>/dev/null)"
  if ! echo "$ts_json" | grep -q '"BackendState":"Running"'; then
    echo "  ✗ tailscale 미실행. 'tailscale up' 실행 후 다시 시도하세요"
    return 1
  fi

  local ts_ip
  ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
  local ts_host
  ts_host="$("$VT_PYTHON" -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print((d.get('Self') or {}).get('DNSName', '').rstrip('.'))
except Exception:
    pass
" <<<"$ts_json" 2>/dev/null)"
  local target="${ts_host:-$ts_ip}"

  if [ -z "$target" ]; then
    echo "  ✗ tailscale IP/호스트명을 가져오지 못했습니다. 'tailscale status'로 확인하세요"
    return 1
  fi

  # 세션을 미리 보장해두면 이후 attach가 항상 성공 + 옵트인 시 client hook도 함께 등록됨
  _ensure_tmux "$session" >/dev/null

  local tmux_cmd="tmux -L $VT_TMUX_SOCKET attach -t $session || tmux -L $VT_TMUX_SOCKET new -A -s $session"

  echo "  이 머신의 tailnet 주소: $target"
  echo ""
  echo "  ── 다른 기기(예: 회사 노트북)에서 아래 명령을 그대로 실행 ──"
  echo ""
  echo "  # 1) 일반 SSH (이 머신 ~/.ssh/authorized_keys에 공개키 등록 필요)"
  echo "  ssh -t ${remote_user}@${target} '${tmux_cmd}'"
  echo ""
  echo "  # 2) Tailscale SSH (tailnet에서 SSH 허용 시 — 키 등록 불필요, tailscale 계정으로 인증)"
  echo "  tailscale ssh ${remote_user}@${target} -- '${tmux_cmd}'"
  echo ""
  if [ -z "$add_key" ]; then
    echo "  ⓘ 공개키 미등록이면: 그 기기에서 'cat ~/.ssh/id_ed25519.pub' 결과를 복사해"
    echo "     여기서 fsh ssh --add-key \"<붙여넣은 값>\" 실행"
  fi
  echo "  ⓘ 접속하면 fsh mobile/음성/데스크톱과 같은 tmux 세션 '$session'에 들어갑니다 (단일 tmux 서버 원칙)"
  echo "  ⓘ 회사망이 방화벽으로 막아도 Tailscale은 대개 UDP 홀펀칭 또는 443 DERP 폴백으로 통과함"
  echo "  ⓘ 음성 입력은 이 경로에선 동작하지 않습니다 (SSH는 텍스트 전용) — 그냥 키보드로 입력하세요"
  echo ""
  if [ "${VT_NOTIFY_CLIENT_EVENTS:-0}" = "1" ]; then
    echo "  🔔 클라이언트 접속/해제 알림: 활성화됨 (VT_NOTIFY_CLIENT_EVENTS=1)"
  else
    echo "  ⓘ 누가 언제 이 세션에 붙는지 push로 알림 받기: ~/.vt.env에 VT_NOTIFY_CLIENT_EVENTS=1 추가"
    echo "     (+ VT_NOTIFY_URL 또는 VT_TELEGRAM_TOKEN/CHAT_ID 설정 필요)"
  fi
  echo ""
}

cmd_tunnel() {
  # fsh tunnel <subcommand> — Phase 8 G1 옵션 C (명명 터널 옵트인)
  # subcommands: status | setup | teardown | switch [anon|named]
  local sub="${1:-status}"

  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "  ✗ cloudflared 미설치"
    return 1
  fi

  case "$sub" in
    status)
      _tunnel_print_status
      ;;
    setup)
      _tunnel_setup_named
      ;;
    teardown)
      _tunnel_teardown_named
      ;;
    switch)
      _tunnel_switch "${2:-}"
      ;;
    restart)
      echo ""
      _tunnel_restart
      echo ""
      ;;
    watchdog)
      echo ""
      if _is_running tunnel-watchdog; then
        echo "  ✓ 터널 워치독 실행 중 (PID $(cat "$PID_DIR/tunnel-watchdog.pid" 2>/dev/null))"
      else
        echo "  ✗ 터널 워치독 중지 상태 — 시작 중..."
        _start_tunnel_watchdog
      fi
      echo ""
      ;;
    expose)
      echo ""
      _start_extra_tunnel "${2:-}" "${3:-}"
      local rc=$?
      echo ""
      return $rc
      ;;
    unexpose)
      echo ""
      _stop_extra_tunnel "${2:-}"
      echo ""
      ;;
    list)
      _tunnel_list
      ;;
    hook)
      echo ""
      if [ -z "${VT_TUNNEL_HOOK:-}" ]; then
        echo "  VT_TUNNEL_HOOK 미설정 — URL이 바뀌어도 아무 곳에도 알리지 않습니다."
        echo "  Notion/Slack/ntfy 등으로 자동 게시하는 방법: fsh help tunnel-hook"
        echo ""
        return 0
      fi
      echo "  훅: $VT_TUNNEL_HOOK"
      echo "  전달할 내용 (stdin):"
      _tunnel_entries | sed 's/^/    /'
      _run_tunnel_hook manual
      echo ""
      ;;
    *)
      echo "사용법: fsh tunnel [status|list|hook|restart|watchdog|expose <port> [라벨]|unexpose <port>|setup|teardown|switch <anon|named>]"
      return 1
      ;;
  esac
}

_tunnel_list() {
  echo ""
  echo "  🌐 열려 있는 터널"
  echo ""
  local main; main="$(_main_tunnel_url)"
  if [ -n "$main" ]; then
    printf "  %-6s %-22s %s\n" "$VT_PORT" "터미널 (VT)" "$main"
  else
    echo "  (메인 터널 없음 — fsh start 또는 fsh mobile)"
  fi
  _registry_prune
  if [ -s "$TUNNEL_REGISTRY" ]; then
    awk -F'\t' '{printf "  %-6s %-22s %s\n", $1, ($3==""?"-":$3), $2}' "$TUNNEL_REGISTRY"
  fi
  echo ""
  echo "  추가:  fsh tunnel expose 3000 \"RAPA 앱\""
  echo "  해제:  fsh tunnel unexpose 3000"
  echo ""
}

_tunnel_print_status() {
  echo ""
  echo "  🌐 Cloudflare Tunnel 상태"
  echo ""
  local pids
  pids="$(pgrep -f 'cloudflared.*tunnel' 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$pids" ]; then
    echo "  실행:    ✓ PID(s) $pids  (메인: $(_main_tunnel_pids))"
  else
    echo "  실행:    ✗ 중지"
  fi

  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "  모드:    명명 (named)"
    echo "  이름:    $VT_TUNNEL_NAME"
    echo "  호스트:  $VT_TUNNEL_HOSTNAME"
    echo "  URL:     https://$VT_TUNNEL_HOSTNAME"
  else
    echo "  모드:    익명 (anonymous, trycloudflare.com)"
    local url
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | head -1)
    [ -n "$url" ] && echo "  URL:     $url"
  fi

  if [ -d "$HOME/.cloudflared" ] && [ -f "$HOME/.cloudflared/cert.pem" ]; then
    echo "  인증:    ✓ ~/.cloudflared/cert.pem 있음"
    local count
    count="$(ls -1 "$HOME/.cloudflared"/*.json 2>/dev/null | wc -l | tr -d ' ')"
    echo "  터널 수: $count (credentials JSON 파일)"
  else
    echo "  인증:    ✗ ~/.cloudflared/cert.pem 없음 — 'cloudflared tunnel login' 필요"
  fi
  echo ""
}

_tunnel_setup_named() {
  echo ""
  echo "  🔧 fsh tunnel setup — 명명 터널 마법사"
  echo ""
  echo "  요구사항:"
  echo "    1. Cloudflare 계정"
  echo "    2. Cloudflare DNS에 등록된 도메인"
  echo "  계속하시겠습니까? (y/N)"
  read -r ans
  case "$ans" in y|Y|yes) ;; *) echo "  중단됨"; return 1 ;; esac

  # 1. cloudflared 인증
  if [ ! -f "$HOME/.cloudflared/cert.pem" ]; then
    echo ""
    echo "▸ cloudflared 인증 (브라우저 자동 열림)..."
    cloudflared tunnel login || { echo "✗ 인증 실패"; return 1; }
  else
    echo "✓ cloudflared 이미 인증됨"
  fi

  # 2. 터널 이름
  echo ""
  printf "터널 이름 (default: vt-mobile): "
  read -r tunnel_name
  tunnel_name="${tunnel_name:-vt-mobile}"

  # 3. 호스트명
  echo ""
  printf "호스트명 (예: vt.example.com): "
  read -r hostname
  if [ -z "$hostname" ]; then
    echo "  ✗ 호스트명 필요"
    return 1
  fi

  # 4. 터널 생성
  echo ""
  echo "▸ 터널 생성: $tunnel_name"
  cloudflared tunnel create "$tunnel_name" 2>&1 | tail -5
  if [ $? -ne 0 ]; then
    echo "  ⓘ 이미 존재하는 이름이면 무시 가능"
  fi

  # 5. DNS 라우팅
  echo ""
  echo "▸ DNS 라우팅: $tunnel_name → $hostname"
  cloudflared tunnel route dns "$tunnel_name" "$hostname" 2>&1 | tail -3 || {
    echo "  ⚠ DNS 라우팅 실패 — 도메인이 Cloudflare DNS인지 확인"
  }

  # 6. config.yml 생성
  local cf_dir="$HOME/.cloudflared"
  local config_yml="$cf_dir/config.yml"
  local creds_json="$cf_dir/${tunnel_name}.json"
  if [ ! -f "$creds_json" ]; then
    # UUID 형태 파일 찾기
    creds_json="$(ls -1 "$cf_dir"/*.json 2>/dev/null | head -1)"
  fi
  cat > "$config_yml" <<EOF
tunnel: $tunnel_name
credentials-file: $creds_json
ingress:
  - hostname: $hostname
    service: http://localhost:${VT_PORT:-7777}
  - service: http_status:404
EOF
  echo "✓ config.yml 작성: $config_yml"

  # 7. ~/.vt.env에 저장
  vt_env_set "VT_TUNNEL_NAME" "$tunnel_name" || return 1
  vt_env_set "VT_TUNNEL_HOSTNAME" "$hostname" || return 1
  echo "✓ ~/.vt.env에 저장"

  echo ""
  echo "  ✅ 명명 터널 설정 완료"
  echo "    이제 'fsh mobile' 시 https://$hostname 사용"
  echo "    (DNS 전파 ~1분 소요 가능)"
}

_tunnel_teardown_named() {
  echo ""
  echo "  ⚠️  명명 터널 제거"
  echo "  현재 설정: ${VT_TUNNEL_NAME:-(없음)} → ${VT_TUNNEL_HOSTNAME:-(없음)}"
  echo "  ~/.vt.env에서 제거하고 익명 터널로 fallback (cloudflared 터널 자체는 유지)."
  echo "  계속? (y/N)"
  read -r ans
  case "$ans" in y|Y|yes) ;; *) echo "  중단됨"; return 1 ;; esac

  if vt_env_unset "VT_TUNNEL_NAME" "VT_TUNNEL_HOSTNAME"; then
    echo "✓ ~/.vt.env에서 VT_TUNNEL_NAME/HOSTNAME 제거"
  fi
  echo ""
  echo "  ⓘ cloudflared 터널 자체를 삭제하려면:"
  echo "    cloudflared tunnel delete <name>"
  echo "    cloudflared tunnel route dns <name> <hostname> --overwrite-dns"
}

_tunnel_switch() {
  local mode="${1:-}"
  case "$mode" in
    anon|anonymous)
      unset VT_TUNNEL_NAME VT_TUNNEL_HOSTNAME
      echo "✓ 현재 셸: 익명 터널 모드 (영구 적용은 fsh tunnel teardown)"
      ;;
    named)
      if [ -z "${VT_TUNNEL_NAME:-}" ] || [ -z "${VT_TUNNEL_HOSTNAME:-}" ]; then
        echo "  ✗ 명명 터널 미설정. fsh tunnel setup 먼저 실행"
        return 1
      fi
      echo "✓ 현재 셸: 명명 터널 사용 ($VT_TUNNEL_HOSTNAME)"
      ;;
    *)
      echo "사용법: fsh tunnel switch <anon|named>"
      return 1 ;;
  esac
}

cmd_setup_keybind() {
  # fsh setup-keybind [key] [action] — Phase 7 #7-2 (lunemis/mux popup.go 차용)
  # tmux conf에 popup 키바인딩 자동 등록. oh-my-tmux 호환, 마커 멱등 갱신, sentinel 보호.
  local key="${1:-v}"
  local action="${2:-status}"

  # tmux 3.2+ 확인
  if ! command -v tmux >/dev/null 2>&1; then
    echo "  ✗ tmux 미설치"
    return 1
  fi
  local tmux_ver first_ver
  tmux_ver="$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[a-z]$//')"
  first_ver="$(printf '3.2\n%s' "$tmux_ver" | sort -V | head -1)"
  if [ "$first_ver" != "3.2" ]; then
    echo "  ✗ tmux 3.2+ 필요 (현재: $tmux_ver)"
    return 1
  fi

  local self_path
  self_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  [ -L "$self_path" ] && self_path="$(readlink "$self_path")"

  local bind_line="bind $key display-popup -E -w 85% -h 80% \"$self_path $action\""
  local marker="# fsh popup keybinding"
  local tagged="${bind_line}  ${marker}"

  local conf_path
  conf_path="$(_find_tmux_conf)"

  if _is_oh_my_tmux "$conf_path"; then
    local local_path
    local_path="$(_find_tmux_conf_local "$conf_path")"
    _write_bind_to_local "$local_path" "$tagged" "$marker"
    # 메인 conf의 옛 잘못된 라인 정리
    local removed=0
    _strip_marker_lines "$conf_path" "$marker" && removed=1
    echo "  ✓ oh-my-tmux 감지 → $local_path"
    echo "    $bind_line"
    if [ $removed -eq 1 ]; then
      echo "  ⓘ $conf_path에서 옛 fsh 라인 제거 (oh-my-tmux heredoc 보호)"
    fi
    echo ""
    echo "  reload: tmux source-file $local_path"
  else
    _upsert_bind_line "$conf_path" "$tagged" "$marker"
    echo "  ✓ 등록 → $conf_path"
    echo "    $bind_line"
    echo ""
    echo "  reload: tmux source-file $conf_path"
  fi
  echo "  사용: prefix + $key  (default prefix: Ctrl+b)"
}

_find_tmux_conf() {
  if [ -n "${XDG_CONFIG_HOME:-}" ] && [ -f "$XDG_CONFIG_HOME/tmux/tmux.conf" ]; then
    echo "$XDG_CONFIG_HOME/tmux/tmux.conf"; return
  fi
  if [ -f "$HOME/.config/tmux/tmux.conf" ]; then
    echo "$HOME/.config/tmux/tmux.conf"; return
  fi
  if [ -f "$HOME/.tmux.conf" ]; then
    echo "$HOME/.tmux.conf"; return
  fi
  # 없으면 default 위치 (생성될 곳)
  echo "$HOME/.tmux.conf"
}

_find_tmux_conf_local() {
  local conf="$1"
  local dir base
  dir="$(dirname "$conf")"
  base="$(basename "$conf")"
  case "$base" in
    tmux.conf)  echo "$dir/tmux.conf.local" ;;
    .tmux.conf) echo "$dir/.tmux.conf.local" ;;
    *)          echo "$conf.local" ;;
  esac
}

_is_oh_my_tmux() {
  local conf="$1"
  [ -f "$conf" ] || return 1
  # 전략 1: symlink 타겟에 .tmux/ 포함
  if [ -L "$conf" ]; then
    local target
    target="$(readlink "$conf")"
    case "$target" in
      */.tmux/*) return 0 ;;
    esac
  fi
  # 전략 2: 첫 줄이 oh-my-tmux heredoc 시그니처
  local first_line
  first_line="$(head -1 "$conf" 2>/dev/null)"
  [ "$first_line" = "# : << 'EOF'" ] && return 0
  return 1
}

_upsert_bind_line() {
  # path, tagged_line, marker
  local path="$1" tagged="$2" marker="$3"
  local tmp
  tmp="$(mktemp)"
  if [ -f "$path" ]; then
    local replaced=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *"$marker"*) printf '%s\n' "$tagged" >> "$tmp"; replaced=1 ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$path"
    if [ $replaced -eq 0 ]; then
      printf '\n%s\n' "$tagged" >> "$tmp"
    fi
  else
    printf '%s\n' "$tagged" > "$tmp"
  fi
  mv "$tmp" "$path"
}

_write_bind_to_local() {
  # path, tagged_line, marker — sentinel ('# "$@"') 앞 삽입
  local path="$1" tagged="$2" marker="$3"
  local tmp
  tmp="$(mktemp)"
  local sentinel='# "$@"'

  if [ ! -f "$path" ]; then
    printf '%s\n' "$tagged" > "$path"
    return
  fi

  # marker 라인 있으면 in-place 교체
  if grep -qF "$marker" "$path" 2>/dev/null; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *"$marker"*) printf '%s\n' "$tagged" >> "$tmp" ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$path"
    mv "$tmp" "$path"
    return
  fi

  # sentinel 있으면 그 앞에 빈줄+태그+빈줄 삽입
  if grep -qxF "$sentinel" "$path" 2>/dev/null; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [ "$line" = "$sentinel" ]; then
        printf '\n%s\n\n' "$tagged" >> "$tmp"
      fi
      printf '%s\n' "$line" >> "$tmp"
    done < "$path"
    mv "$tmp" "$path"
    return
  fi

  # sentinel 없으면 EOF append
  rm -f "$tmp"
  printf '\n%s\n' "$tagged" >> "$path"
}

_strip_marker_lines() {
  # path, marker — 마커 또는 legacy 패턴 라인 제거
  local path="$1" marker="$2"
  [ -f "$path" ] || return 1
  if ! grep -qF "$marker" "$path" 2>/dev/null; then
    # legacy 패턴 (마커 없이 등록된 옛 라인)
    if ! grep -qE 'display-popup .*"fsh ' "$path" 2>/dev/null; then
      return 1
    fi
  fi
  local tmp
  tmp="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *"$marker"*) ;;
      *'display-popup'*'"fsh '*) ;;
      *) printf '%s\n' "$line" >> "$tmp" ;;
    esac
  done < "$path"
  mv "$tmp" "$path"
  return 0
}

cmd_install_profiles() {
  # Phase 6 #6-2: 터미널 앱 profile 자동 등록
  # --dry-run: 변경 없이 미리보기만
  local dry_run=0
  for arg in "$@"; do
    [ "$arg" = "--dry-run" ] && dry_run=1
  done

  echo ""
  echo "  📦 fsh install-profiles — 터미널 앱 profile 자동 등록"
  if [ $dry_run -eq 1 ]; then
    echo "  (dry-run: 실제 변경 없음)"
  fi
  echo ""

  local installed=0 skipped=0 hinted=0

  # iTerm2 Dynamic Profile (자동 등록)
  if [ -d "/Applications/iTerm.app" ]; then
    if _install_iterm_profile "$dry_run"; then
      installed=$((installed+1))
    else
      skipped=$((skipped+1))
    fi
  fi

  # Ghostty (config 주석 추가 — 사용자가 # 제거하여 활성화)
  if [ -d "/Applications/Ghostty.app" ] || command -v ghostty >/dev/null 2>&1; then
    if _install_ghostty_profile "$dry_run"; then
      installed=$((installed+1))
    else
      skipped=$((skipped+1))
    fi
  fi

  # WezTerm / Kitty / Alacritty / Windows Terminal — snippet 안내 (자동 편집은 위험)
  if command -v wezterm >/dev/null 2>&1 || [ -d "/Applications/WezTerm.app" ]; then
    _print_wezterm_snippet
    hinted=$((hinted+1))
  fi
  if command -v kitty >/dev/null 2>&1 || [ -d "/Applications/kitty.app" ]; then
    _print_kitty_snippet
    hinted=$((hinted+1))
  fi
  if command -v alacritty >/dev/null 2>&1 || [ -d "/Applications/Alacritty.app" ]; then
    _print_alacritty_snippet
    hinted=$((hinted+1))
  fi
  # Windows Terminal (WSL2)
  if grep -qi microsoft /proc/version 2>/dev/null; then
    _print_windows_terminal_snippet
    hinted=$((hinted+1))
  fi

  # macOS Terminal.app — 가이드만
  if [ "$(uname)" = "Darwin" ]; then
    _print_terminal_app_snippet
    hinted=$((hinted+1))
  fi

  echo ""
  echo "  결과: ✓ ${installed}개 자동 등록, ⓘ ${skipped}개 건너뜀, 📋 ${hinted}개 snippet 안내"
  echo ""
  if [ $dry_run -eq 1 ]; then
    echo "  실제 적용: fsh install-profiles (옵션 없이 재실행)"
    echo ""
  fi
}

_install_iterm_profile() {
  local dry_run="$1"
  local DIR="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
  local FILE="$DIR/fsh.json"
  local OLD_FILE="$DIR/vt.json"
  local cmd="tmux -L $VT_TMUX_SOCKET new -A -s dev"

  if [ "$dry_run" = "1" ]; then
    echo "  [dry-run] iTerm2 → $FILE 생성/갱신"
    [ -f "$OLD_FILE" ] && echo "  [dry-run] 구 프로필 제거 → $OLD_FILE (Guid가 바뀌어 중복 방지)"
    return 0
  fi

  mkdir -p "$DIR"
  cat > "$FILE" <<EOF
{
  "Profiles": [{
    "Name": "fsh (FarShell)",
    "Guid": "fsh-farshell",
    "Custom Command": "Custom Shell",
    "Command": "/bin/zsh -c '$cmd'",
    "Working Directory Type": "Recycle"
  }]
}
EOF
  # 구 파일(vt.json, Guid=vt-farshell)이 남아 있으면 iTerm2가 두 프로필을 동시에
  # 보여준다 — Guid를 바꾼 김에 구 파일도 정리해 중복 등록을 막는다.
  if [ -f "$OLD_FILE" ]; then
    rm -f "$OLD_FILE"
    echo "  ✓ 구 iTerm2 프로필 제거 (Guid 변경으로 인한 중복 방지) → $OLD_FILE"
  fi
  echo "  ✓ iTerm2 Dynamic Profile → $FILE"
  echo "    iTerm2 재시작 후 Profiles 메뉴에서 'fsh (FarShell)' 선택"
  return 0
}

_install_ghostty_profile() {
  local dry_run="$1"
  local CFG="$HOME/.config/ghostty/config"
  local snippet="# fsh (FarShell) — auto-attach (활성화 원하면 아래 # 제거)
# command = tmux -L $VT_TMUX_SOCKET new -A -s dev"

  # 예전 리네임(vt→fsh, farshell→FarShell) 이전에 등록된 마커도 인식해야
  # 중복 등록을 안 한다 — 이미 써둔 사용자 설정 파일을 소급 수정하진 않는다
  # (어차피 사람이 안 읽는 주석이라 그대로 둬도 무해하고, 잘못 건드리면
  # 사용자가 손으로 고쳐둔 부분까지 덮어쓸 위험이 있다).
  if grep -qE '# (vt|fsh) \((vt|farshell|FarShell)\) — auto-attach' "$CFG" 2>/dev/null; then
    echo "  ⓘ Ghostty 이미 등록됨: $CFG"
    return 1
  fi

  if [ "$dry_run" = "1" ]; then
    echo "  [dry-run] Ghostty → $CFG 에 다음 추가:"
    echo "$snippet" | sed 's/^/      /'
    return 0
  fi

  mkdir -p "$(dirname "$CFG")"
  printf '\n%s\n' "$snippet" >> "$CFG"
  echo "  ✓ Ghostty config 주석 추가 → $CFG"
  echo "    활성화: $CFG 열어 'command =' 라인의 # 제거"
  return 0
}

_print_wezterm_snippet() {
  cat <<EOF

  📋 WezTerm — ~/.config/wezterm/wezterm.lua 에 추가:

      config.default_prog = { 'tmux', '-L', '$VT_TMUX_SOCKET', 'new', '-A', '-s', 'dev' }

EOF
}

_print_kitty_snippet() {
  cat <<EOF

