#!/bin/bash
# fsh — FarShell 통합 CLI
# 어디서든 실행 가능. 노션 작업 중에도 음성으로 코딩.
#
# 사용법:
#   fsh voice    — 음성 모드 (백그라운드, 작업 방해 없음)
#   fsh start    — 서버 + 접속 경로(터널 등) 시작
#   fsh mobile   — 폰 접속 URL + QR (서버가 떠 있을 때)
#   fsh stop     — 모든 fsh 프로세스 종료
#   fsh status   — 현재 상태 확인

set -uo pipefail

# 호출 시점에 이미 환경에 있던 VT_* 이름 — 파일보다 우선한다.
# 반드시 아래에서 VT_DIR/VT_CONFIG 등을 대입하기 '전에' 떠야 한다.
_VT_ENV_PRESET_NAMES=" "
for _vt_v in ${!VT_@}; do _VT_ENV_PRESET_NAMES="$_VT_ENV_PRESET_NAMES$_vt_v "; done
unset _vt_v

# 심링크를 따라가서 실제 경로 찾기
_SELF="$0"
[ -L "$_SELF" ] && _SELF="$(readlink "$_SELF")"
VT_DIR="$(cd "$(dirname "$_SELF")/.." && pwd)"
# 설정 파일 경로. 오버라이드 가능해야 프로필을 나눠 쓰거나 테스트에서 격리할 수 있다.
VT_CONFIG="${VT_CONFIG:-$HOME/.vt.env}"
VT_DEFAULTS="$VT_DIR/config/vt.defaults.env"

# ~/.vt.env 읽기/쓰기 단일 구현 (형식 정의 + 권한 보장).
# 시크릿이 들어가는 파일이므로 손으로 echo/sed 하지 말고 vt_env_set/unset만 쓸 것.
# shellcheck source=../lib/vt_env.sh
if [ -f "$VT_DIR/lib/vt_env.sh" ]; then
  . "$VT_DIR/lib/vt_env.sh"
else
  echo "fsh: lib/vt_env.sh 를 찾을 수 없습니다 ($VT_DIR/lib/vt_env.sh)" >&2
  echo "    설치가 손상됐을 수 있습니다 — './install.sh' 로 복구하세요." >&2
  exit 1
fi

# 화면 언어(ko/en)와 메시지 번역 `_t` — server/i18n.py와 같은 순서로 언어를 정한다.
# shellcheck source=../lib/i18n.sh
[ -f "$VT_DIR/lib/i18n.sh" ] && . "$VT_DIR/lib/i18n.sh"
# shellcheck source=../lib/fsh_client.sh
[ -f "$VT_DIR/lib/fsh_client.sh" ] && . "$VT_DIR/lib/fsh_client.sh"

# 설정 파일 로드 — defaults 먼저, 그 다음 사용자 override.
#
# source가 아니라 vt_env_load(파서)를 쓴다. 설정 파일은 데이터이지 코드가 아니다:
#   - 파일 안의 어떤 구문도 실행되지 않는다 (임의 코드 실행 경로 제거)
#   - 레거시 라인 하나가 set -u에 걸려 fsh 전체를 죽이는 일이 없다
#   - bash와 server/vt_env.py가 정의상 같은 값을 읽는다
# 우선순위 '환경변수 > ~/.vt.env > defaults'는 _VT_ENV_PRESET_NAMES로 구조적으로 성립한다.
vt_env_load "$VT_DEFAULTS"
vt_env_load "$VT_CONFIG"
# 경계값만은 파일이 이긴다 — 낡은 셸 export가 보안 경계를 되돌리는 걸 막는다.
# 바로잡은 키는 VT_ENV_BOUNDARY_FIXED에 남고 fsh status/doctor가 그걸 보고한다
# (조용히 고치면 "왜 내 export가 안 먹지"를 아무도 설명해 주지 못한다).
vt_env_apply_boundary "$VT_CONFIG"

# 설정 가능한 변수 (환경변수 또는 ~/.vt.env로 오버라이드)
VT_PORT="${VT_PORT:-7777}"

# 격리된 tmux 소켓 — 사용자 기존 tmux 세션과 분리
VT_TMUX_SOCKET="${VT_TMUX_SOCKET:-fsh}"

# Phase 8 G3: 격리 config 자동 탐색 (XDG → 레포 → 미사용)
_resolve_tmux_conf() {
  if [ -n "${VT_TMUX_CONF:-}" ] && [ -f "$VT_TMUX_CONF" ]; then
    echo "$VT_TMUX_CONF"; return
  fi
  if [ -f "$HOME/.config/vt/tmux.conf" ]; then
    echo "$HOME/.config/vt/tmux.conf"; return
  fi
  if [ -f "$VT_DIR/config/vt-tmux.conf" ]; then
    echo "$VT_DIR/config/vt-tmux.conf"; return
  fi
}
VT_TMUX_CONF_PATH="$(_resolve_tmux_conf)"
if [ -n "$VT_TMUX_CONF_PATH" ]; then
  TMUX_BASE=(tmux -u -L "$VT_TMUX_SOCKET" -f "$VT_TMUX_CONF_PATH")
else
  TMUX_BASE=(tmux -u -L "$VT_TMUX_SOCKET")
fi

# Python 자동 감지 — 우선순위:
#   1) 환경변수 VT_PYTHON / ~/.vt.env / config/vt.defaults.env
#   2) 프로젝트 .venv (install.sh로 만든 것)
#   3) 시스템 python3
# conda/pyenv 등 다른 환경은 ~/.vt.env에 VT_PYTHON으로 명시하세요.
_detect_python() {
  if [ -x "$VT_DIR/.venv/bin/python" ]; then
    echo "$VT_DIR/.venv/bin/python"
  else
    command -v python3 2>/dev/null || echo python3
  fi
}
VT_PYTHON="${VT_PYTHON:-$(_detect_python)}"

# ~/.vt.env에서 온 값은 set -a 덕에 이미 export됐지만, 위에서 '기본값으로 계산된' 값들은
# 그냥 두면 export되지 않는다. 그러면 부모(fsh)와 자식(서버·데몬·훅)이 서로 다른 설정을
# 보게 된다 — VT_TUNNEL_HOOK 안의 "$VT_PYTHON"이 빈 값이 되는 식. 한곳에서 내보낸다.
export VT_PYTHON VT_PORT VT_TMUX_SOCKET VT_CONFIG VT_DIR

# Phase 8 G4: Claude --disallowedTools 정책 (도구 호출 단계 차단, 정규식보다 견고)
_DEFAULT_DISALLOWED='Bash(rm -rf /:*),Bash(sudo:*),Bash(git push --force:*),Bash(dd if=*:*),Bash(chmod -R 777 /:*),Bash(mkfs.*:*)'
_SAFE_DISALLOWED="$_DEFAULT_DISALLOWED,Bash(curl * | sh:*),Bash(curl * | bash:*),Bash(wget * | sh:*),Bash(rm:*),Bash(git push:*),Bash(git clean:*),Edit(/etc/*),Edit(/usr/*),Write(/etc/*),Write(/usr/*)"

_resolve_disallowed_tools() {
  if [ -n "${VT_DISALLOWED_TOOLS:-}" ]; then
    echo "$VT_DISALLOWED_TOOLS"
  elif [ "${VT_SAFE_MODE:-}" = "1" ]; then
    echo "$_SAFE_DISALLOWED"
  else
    echo "$_DEFAULT_DISALLOWED"
  fi
}

# 런타임 산출물(로그·PID·터널 레지스트리·업로드)의 뿌리. 기본 /tmp 라서 기존 경로는
# 그대로다 — 문서와 스킬이 /tmp/vt-server.log 를 안내하고 있다.
#
# 이걸 바꾸면 한 머신에서 **두 인스턴스를 동시에** 돌릴 수 있다. 예전엔 PID 파일이
# 공유돼서, 다른 트리에서 `fsh stop` 을 치면 돌아가던 서버를 죽였다.
# 격리 실행에는 VT_PORT · VT_TMUX_SOCKET · VT_STATE_DIR · VT_CONFIG ·
# VT_WORKSPACE_PATH 와 함께 쓴다. server 쪽은 tunnel_registry.py / routes/pty.py 가
# 같은 변수를 읽는다(bin/fsh 가 export 하므로 값이 갈라지지 않는다).
VT_RUN_DIR="${VT_RUN_DIR:-/tmp}"
export VT_RUN_DIR
mkdir -p "$VT_RUN_DIR"
SERVER_LOG="$VT_RUN_DIR/vt-server.log"
TUNNEL_LOG="$VT_RUN_DIR/cloudflared.log"
NGROK_LOG="$VT_RUN_DIR/ngrok.log"
DAEMON_LOG="$VT_RUN_DIR/vt-voice-daemon.log"
CLIP_DAEMON_LOG="$VT_RUN_DIR/vt-clipboard-daemon.log"
WATCHDOG_LOG="$VT_RUN_DIR/vt-tunnel-watchdog.log"
HOOK_RETRY_LOG="$VT_RUN_DIR/vt-tunnel-hook-retry.log"
PID_DIR="$VT_RUN_DIR/vt-pids"
mkdir -p "$PID_DIR"
# 추가 포트 터널 레지스트리 (TSV: port<TAB>url<TAB>label)
TUNNEL_REGISTRY="$PID_DIR/tunnels.tsv"

_is_running() {
  local pidfile="$PID_DIR/$1.pid"
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# N28 — "서버가 옛 코드로 돌고 있음" 경고.
#
# 파이썬은 import 시점에 모듈을 메모리에 올린다. 그래서 코드를 고쳐도 서버를
# 재시작하지 않으면 **고친 코드가 전혀 반영되지 않는다** — 2026-09-09에
# 붙여넣기 잘림을 몇 시간 동안 코드 버그로 쫓았는데, 실제 원인은 서버가
# 수정 8시간 51분 전에 뜬 프로세스였다는 것이다. 재발 방지책.
#
# 결과를 stdout으로 돌려주고(빈 문자열이면 문제 없음) 호출자가 배치한다.
_stale_server_warning() {
  local pidfile="$PID_DIR/server.pid" pid
  [ -f "$pidfile" ] || return 0
  pid="$(cat "$pidfile" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 0
  "${VT_PYTHON:-python3}" - "$pid" "$VT_DIR/server" "$PID_DIR" "$(vt_is_en && echo en || echo ko)" <<'PYEOF' 2>/dev/null
import os, subprocess, sys, time

pid, server_dir = sys.argv[1], sys.argv[2]
pid_dir = sys.argv[3] if len(sys.argv) > 3 else ""
lang = sys.argv[4] if len(sys.argv) > 4 else "ko"

# 프로세스 시작 시각. `etimes`(초)는 Linux 전용이고 **macOS ps에는 없다** —
# 그쪽은 `etime`([[dd-]hh:]mm:ss)을 파싱한다. 못 재면 아무 말도 하지 않는다
# (틀린 경고가 침묵보다 나쁘다).
def _elapsed_seconds(pid):
    try:
        out = subprocess.run(["ps", "-o", "etimes=", "-p", pid],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        if out.isdigit():
            return int(out)
    except Exception:
        pass
    try:
        out = subprocess.run(["ps", "-o", "etime=", "-p", pid],
                             capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        return None
    if not out:
        return None
    days, _, clock = out.rpartition("-")
    parts = [int(x) for x in clock.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return ((int(days) if days else 0) * 86400) + h * 3600 + m * 60 + sec


elapsed = _elapsed_seconds(pid)
if elapsed is None:
    sys.exit(0)
started = time.time() - elapsed

newest, newest_name = 0.0, ""
for root, dirs, files in os.walk(server_dir):
    dirs[:] = [d for d in dirs if d not in ("__pycache__", "tests", ".venv")]
    for f in files:
        if not f.endswith(".py"):
            continue
        try:
            m = os.stat(os.path.join(root, f)).st_mtime
        except OSError:
            continue
        if m > newest:
            newest, newest_name = m, os.path.relpath(os.path.join(root, f), server_dir)

# 여유 10초 — 서버가 뜨는 순간 자기 소스를 건드리는 경우(설치 스크립트 등)까지
# 경고로 만들지 않는다.
if newest > started + 10:
    # 수정 시각만으로는 주석·docstring만 고친 경우도 "옛 코드"로 오판한다. 서버를 띄울 때 남긴
    # 코드 지문(AST)과 지금 지문이 같으면 실행에 영향 주는 변경이 없으니 말하지 않는다.
    # 지문 기록이 없으면(옛 버전 fsh로 띄운 서버) 예전처럼 수정 시각으로 판단한다.
    try:
        saved = open(os.path.join(pid_dir, "server.codehash")).read().strip() if pid_dir else ""
        if saved:
            sys.path.insert(0, server_dir)
            import code_fingerprint
            if code_fingerprint.fingerprint(server_dir) == saved:
                sys.exit(0)
    except SystemExit:
        raise
    except Exception:
        pass
    gap = newest - started
    if lang == "en":
        if gap < 3600:
            ago = f"{int(gap / 60)} min"
        elif gap < 86400:
            ago = f"{gap / 3600:.1f} h"
        else:
            ago = f"{gap / 86400:.1f} days"
        print(f"The server is running old code: {newest_name} changed {ago} after the server "
              f"started. Run `fsh restart` (the access URL stays the same).")
        sys.exit(0)
    if gap < 3600:
        ago = f"{int(gap / 60)}분"
    elif gap < 86400:
        ago = f"{gap / 3600:.1f}시간"
    else:
        ago = f"{gap / 86400:.1f}일"
    print(f"서버가 옛 코드로 돌고 있습니다 — {newest_name}가 서버 시작보다 "
          f"{ago} 뒤에 바뀌었습니다. `fsh restart`로 재시작하세요(접속 주소는 유지됩니다).")
PYEOF
}

_port_in_use() {
  "$VT_PYTHON" -c "import socket;s=socket.socket();s.settimeout(1);exit(0 if s.connect_ex(('127.0.0.1',$1))==0 else 1)" 2>/dev/null
}

_start_server() {
  if _port_in_use $VT_PORT; then
    echo "✓ $(_t '서버 이미 실행 중 (port {port})' port="$VT_PORT")"
    return 0
  fi
  echo "▸ $(_t '서버 시작 중...')"
  cd "$VT_DIR/server"
  # VT_NETWORK_MODE를 실제 bind 주소에 반영한다. 예전엔 무조건 0.0.0.0으로 열고
  # 미들웨어에서 403으로 걸러내기만 해서, localhost 모드로 설정해도 포트 자체는
  # 모든 인터페이스(카페 wifi 포함)에 노출돼 있었다.
  local bind_host
  bind_host="$("$VT_PYTHON" -c 'import network_access as n; print(n.resolve_bind_host(n.get_current_spec()))' 2>/dev/null || echo 0.0.0.0)"
  # 지금 디스크의 코드 지문을 남긴다 — 나중에 "옛 코드로 돌고 있나"를 주석 수정과 구분하는 기준.
  "$VT_PYTHON" -m code_fingerprint "$VT_DIR/server" > "$PID_DIR/server.codehash" 2>/dev/null || rm -f "$PID_DIR/server.codehash"
  nohup "$VT_PYTHON" -m uvicorn main:app --host "$bind_host" --port $VT_PORT > "$SERVER_LOG" 2>&1 &
  echo $! > "$PID_DIR/server.pid"
  # 고정 sleep 대신 서버가 실제로 응답할 때까지 폴링한다. uvicorn 기동 시간은
  # 패키지 로딩량 등에 따라 달라져서, 고정 대기 중에 브라우저가 자동으로 열리거나
  # 사용자가 새로고침하면 아직 안 뜬 서버에 요청이 가서 프론트가 "세션 없음"으로
  # 오판해 tmux 세션을 중복 생성하는 원인이 됐다 (최대 10초, 100ms 간격).
  local waited=0
  while ! curl -sf http://localhost:$VT_PORT/ -o /dev/null 2>/dev/null; do
    if [ $waited -ge 10000 ]; then
      echo "✗ $(_t '서버 시작 실패(10초 타임아웃). 로그: {log}' log="$SERVER_LOG")"
      return 1
    fi
    sleep 0.1
    waited=$((waited + 100))
  done
  echo "✓ $(_t '서버 시작 완료 ({url})' url="http://localhost:$VT_PORT")"
}

# 메인 터널 시작. 성공 시 URL 변경 훅 실행 + 좀비 재연결 감시 데몬 기동 (설정된 경우에만).
_start_tunnel() {
  _start_tunnel_impl "$@"
  local rc=$?
  if [ $rc -eq 0 ]; then
    _run_tunnel_hook start
    # 워치독은 cloudflare 전용이다 — 좀비 재연결(프로세스는 살아있는데 QUIC
    # 제어 스트림만 끊김)은 cloudflared 특유의 증상이고, 감지 로직도 그 로그
    # 패턴 전용이다. ngrok에 붙이면 아무것도 감지 못 하면서 데몬만 하나 는다.
    [ "$(_tunnel_provider)" = "cloudflare" ] && _start_tunnel_watchdog
  fi
  return $rc
}

# 좀비 재연결 상태에서도 프로세스는 살아있어(kill -0 성공) _is_running만으론
# 못 잡으므로, PID를 무조건 죽이고 새로 띄운다. 워치독이 자동 호출하거나
# 'fsh tunnel restart'로 수동 호출.
_tunnel_restart() {
  echo "  ▸ $(_t '터널 재시작 중...')"
  local pids
  pids="$(_main_tunnel_pids)"
  if [ -n "$pids" ]; then
    for p in $pids; do kill "$p" 2>/dev/null || true; done
    sleep 1
    for p in $pids; do kill -9 "$p" 2>/dev/null || true; done
  fi
  rm -f "$PID_DIR/tunnel.pid"

  _start_tunnel_impl
  local rc=$?
  if [ $rc -eq 0 ]; then
    _run_tunnel_hook start
    [ "$(_tunnel_provider)" = "cloudflare" ] && _start_tunnel_watchdog
    echo "  ✓ $(_t '재시작 완료')"
  else
    echo "  ✗ $(_t '재시작 실패')"
  fi
  return $rc
}

# 터널 좀비 재연결 감시 데몬. 로그에 재연결 실패가 짧은 시간에 몰리면
# _tunnel_restart를 자동 호출한다 (server/tunnel_watchdog.py).
_start_tunnel_watchdog() {
  if _is_running tunnel-watchdog; then
    return 0
  fi
  # pid 파일을 잃었어도(다른 환경에서 stop/start 했거나 파일이 지워졌을 때) 이 트리의
  # 워치독이 이미 떠 있으면 새로 띄우지 않고 그 PID를 다시 기록한다 — 2026-10-06, restart마다
  # 워치독이 하나씩 늘었다(같은 터널을 둘이 감시하면 좀비 재연결이 두 번 일어난다).
  # `$VT_DIR/server/…` 절대경로로만 매칭해서 다른 인스턴스의 워치독은 건드리지 않는다.
  local _existing
  _existing="$(pgrep -f "$VT_DIR/server/tunnel_watchdog.py" 2>/dev/null | head -1)"
  if [ -n "$_existing" ] && kill -0 "$_existing" 2>/dev/null; then
    echo "$_existing" > "$PID_DIR/tunnel-watchdog.pid"
    return 0
  fi
  nohup "$VT_PYTHON" "$VT_DIR/server/tunnel_watchdog.py" > "$WATCHDOG_LOG" 2>&1 &
  echo $! > "$PID_DIR/tunnel-watchdog.pid"
  sleep 0.5
  if _is_running tunnel-watchdog; then
    echo "✓ $(_t '터널 워치독 시작 (좀비 재연결 자동 감지)')"
  else
    echo "  ⚠ $(_t '터널 워치독 시작 실패. 로그: {log}' log="$WATCHDOG_LOG")"
  fi
}

# ngrok 메인 터널. cloudflare 경로와 같은 계약을 지킨다:
#   - 이미 떠 있으면 재사용하고 성공으로 친다
#   - pid를 $PID_DIR/tunnel.pid에 남긴다 → cmd_stop이 제공자를 몰라도 죽인다
#   - 성공하면 URL을 한 줄 찍는다
_start_tunnel_ngrok() {
  if ! command -v ngrok >/dev/null 2>&1; then
    echo "✗ $(_t "ngrok 미설치. brew install ngrok — 설치 후 'ngrok config add-authtoken <토큰>'")"
    return 1
  fi
  local url
  if url="$(_ngrok_public_url "$VT_PORT")"; then
    echo "✓ $(_t 'ngrok 이미 실행 중: {url}' url="$url")"
    return 0
  fi
  local domain="${VT_NGROK_DOMAIN:-}"
  domain="${domain#https://}"; domain="${domain#http://}"; domain="${domain%/}"
  : > "$NGROK_LOG"
  if [ -n "$domain" ]; then
    echo "▸ $(_t 'ngrok 시작 중 (고정 도메인: {domain})...' domain="$domain")"
    nohup ngrok http "$VT_PORT" --url "https://$domain" --log "$NGROK_LOG" --log-format logfmt >/dev/null 2>&1 &
  else
    # 도메인을 예약해 두고도 --url을 안 붙이면 임시 주소가 잡힌다. 고정 주소가
    # 목적이라면 이 경고가 유일한 단서라서 조용히 넘기지 않는다.
    echo "▸ $(_t 'ngrok 시작 중 (임시 주소 — VT_NGROK_DOMAIN을 설정하면 고정됩니다)...')"
    nohup ngrok http "$VT_PORT" --log "$NGROK_LOG" --log-format logfmt >/dev/null 2>&1 &
  fi
  echo $! > "$PID_DIR/tunnel.pid"
  local i
  for i in $(seq 1 20); do
    if url="$(_ngrok_public_url "$VT_PORT")"; then
      echo "✓ ngrok: $url"
      return 0
    fi
    sleep 1
  done
  echo "✗ $(_t 'ngrok URL 대기 시간 초과. 로그: {log}' log="$NGROK_LOG")"
  return 1
}

_start_tunnel_impl() {
  case "$(_tunnel_provider)" in
    none)
      echo "  ⓘ $(_t 'VT_TUNNEL_PROVIDER=none — 공개 터널을 띄우지 않습니다')"
      return 0 ;;
    ngrok)
      _start_tunnel_ngrok
      return $? ;;
  esac

  # Phase 8 G1: 외부에서 떠있는 cloudflared도 발견하여 재사용 (옵션 A)
  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "✗ $(_t 'cloudflared 미설치. brew install cloudflared (macOS) 또는 https://github.com/cloudflare/cloudflared/releases')"
    return 1
  fi

  # 우리 PID file 또는 외부 cloudflared 프로세스 감지.
  # 'fsh tunnel expose'로 뜬 추가 포트 터널을 메인 터널로 오인하지 않도록,
  # 명명 터널(tunnel run) 또는 VT_PORT를 향한 익명 터널만 센다.
  local existing_pids=""
  if command -v pgrep >/dev/null 2>&1; then
    existing_pids="$(pgrep -f "^([^ ]*/)?cloudflared[[:space:]].*tunnel run" 2>/dev/null || true)"
    existing_pids="$existing_pids $(pgrep -f "^([^ ]*/)?cloudflared[[:space:]].*--url http://localhost:$VT_PORT\$" 2>/dev/null || true)"
    existing_pids="$(echo "$existing_pids" | tr ' ' '\n' | grep -v '^$' | tr '\n' ' ' | sed 's/ $//')"
  fi

  if _is_running tunnel || [ -n "$existing_pids" ]; then
    local url
    url=$(_quick_tunnel_url_from_log "$TUNNEL_LOG")
    if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
      url="https://$VT_TUNNEL_HOSTNAME"
    fi
    if [ -n "$url" ]; then
      echo "✓ $(_t '터널 이미 실행 중 (PID{pids}): {url}' pids="${existing_pids:+: $existing_pids}" url="$url")"
      return 0
    fi
  fi

  # 명명 터널 우선 (옵션 C: VT_TUNNEL_NAME + VT_TUNNEL_HOSTNAME 필요)
  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "▸ $(_t 'Cloudflare 명명 터널 시작 중 (name={name} → {host})...' name="$VT_TUNNEL_NAME" host="$VT_TUNNEL_HOSTNAME")"
    : > "$TUNNEL_LOG"
    nohup cloudflared tunnel run "$VT_TUNNEL_NAME" > "$TUNNEL_LOG" 2>&1 &
    echo $! > "$PID_DIR/tunnel.pid"
    sleep 2
    if _is_running tunnel; then
      echo "✓ $(_t '명명 터널: {url}' url="https://$VT_TUNNEL_HOSTNAME")"
      return 0
    fi
    echo "  ⚠ $(_t '명명 터널 시작 실패 — 익명 터널로 fallback')"
  fi

  # 익명 터널 (옵션 A 기본 동작)
  echo "▸ $(_t 'Cloudflare 익명 터널 시작 중...')"
  : > "$TUNNEL_LOG"
  nohup cloudflared tunnel --url http://localhost:$VT_PORT > "$TUNNEL_LOG" 2>&1 &
  echo $! > "$PID_DIR/tunnel.pid"
  for i in $(seq 1 30); do
    local url
    url=$(_quick_tunnel_url_from_log "$TUNNEL_LOG")
    if [ -n "$url" ]; then
      echo "✓ $(_t '터널: {url}' url="$url")"
      return 0
    fi
    sleep 1
  done
  echo "✗ $(_t '터널 URL 대기 시간 초과. 로그: {log}' log="$TUNNEL_LOG")"
  return 1
}

# ── 추가 포트 터널 (fsh tunnel expose <port>) ─────────────────────────
# 메인 터널은 VT 서버(VT_PORT) 전용이다. Cloudflare quick tunnel은
# 호스트명↔포트 1:1이라 경로로 포트를 바꿔치기할 수 없으므로,
# 다른 로컬 앱(예: localhost:3000)은 별도 터널을 하나 더 띄운다.

_extra_tunnel_log() {
  if [ "$(_tunnel_provider)" = "ngrok" ]; then
    echo "$VT_RUN_DIR/ngrok-$1.log"
  else
    echo "/tmp/cloudflared-$1.log"
  fi
}

_registry_set() {
  local port="$1" url="$2" label="$3"
  touch "$TUNNEL_REGISTRY"
  grep -v "^${port}$(printf '\t')" "$TUNNEL_REGISTRY" > "$TUNNEL_REGISTRY.tmp" 2>/dev/null || true
  printf '%s\t%s\t%s\n' "$port" "$url" "$label" >> "$TUNNEL_REGISTRY.tmp"
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_registry_del() {
  local port="$1"
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  grep -v "^${port}$(printf '\t')" "$TUNNEL_REGISTRY" > "$TUNNEL_REGISTRY.tmp" 2>/dev/null || true
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_registry_url() {
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  awk -F'\t' -v p="$1" '$1==p {print $2}' "$TUNNEL_REGISTRY" | head -1
}

# 죽은 터널 항목 청소 — pid 파일 기준
_registry_prune() {
  [ -f "$TUNNEL_REGISTRY" ] || return 0
  local port rest
  : > "$TUNNEL_REGISTRY.tmp"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    port="${line%%$(printf '\t')*}"
    if _is_running "tunnel-$port"; then
      printf '%s\n' "$line" >> "$TUNNEL_REGISTRY.tmp"
    fi
  done < "$TUNNEL_REGISTRY"
  mv "$TUNNEL_REGISTRY.tmp" "$TUNNEL_REGISTRY"
}

_port_share_cli() {
  # `fsh tunnel expose/pin/mode`가 서버 프로세스 없이 정책을 직접 읽고 쓴다 —
  # `_m auth otp-setup` 등과 같은 방식(bin/fsh:2046 근방). 실제로 리스너를
  # 띄우는 건 실행 중인 서버만 할 수 있으므로, 이 CLI로 쓴 뒤 반드시
  # _request_proxy_sync로 그 서버를 깨워야 한다.
  (cd "$VT_DIR/server" && "$VT_PYTHON" -m port_share_store "$@")
}

_authed_curl() {
  # unix socket 먼저(자격 없음 — 서버가 peer pid 로 안다), 소켓이 없거나 연결 실패(7)/소켓 계층 거부
  # (-f 로 22)면 예전처럼 토큰. 토큰은 curl 설정 파일(-K, 프로세스 치환)로 넘겨 argv(`ps`)에 오르지 않는다.
  # URL 의 호스트는 소켓 연결에서 쓰이지 않는다. 마지막 인자(URL)만 보고 경로를 정한다.
  local rc
  if declare -F fsh_sock_usable >/dev/null && fsh_sock_usable; then
    curl --unix-socket "$(fsh_sock_path)" -H 'X-Fsh-Svc: cli' "$@"; rc=$?
    case "$rc" in 7|22) ;; *) return "$rc" ;; esac
  fi
  local token="${VT_AUTH_TOKEN:-${VT_TOKEN:-}}"
  if [ -n "$token" ] && declare -F _fsh_curl_token_cfg >/dev/null; then
    curl -K <(_fsh_curl_token_cfg) "$@"
  else
    curl "$@"
  fi
}

# unix socket 상태 한 줄. `python -m authz sock-status` 출력(state|path|selftest|perms|dir|reachable|legacy24h|reason)을
# 읽어 "<level>\t<메시지>"로 돌려준다. level = ok|warn|fail. doctor 와 status 가 같이 쓴다.
_sock_status_line() {
  [ -x "${VT_PYTHON:-}" ] || return 1
  local raw st path selftest perms dirp reach legacy reason lvl msg
  raw="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m authz sock-status --port "$VT_PORT" 2>/dev/null)" || return 1
  [ -n "$raw" ] || return 1
  IFS='|' read -r st path selftest perms dirp reach legacy reason <<<"$raw"
  perms="${perms#perms=}"; dirp="${dirp#dir=}"; legacy="${legacy#legacy24h=}"; reach="${reach#reachable=}"
  case "$st:$reach" in
    listening:True)
      lvl=ok; msg="$(_t 'socket OK — {path} (권한 {perms}, 디렉터리 {dir}, 자가 시험 통과)' path="${path/#$HOME/~}" perms="$perms" dir="$dirp")" ;;
    listening:*|stale:*)
      lvl=warn; msg="$(_t '상태 파일은 켜짐인데 연결되지 않습니다 — fsh restart')" ;;
    failed:*)
      lvl=fail; msg="$(_t '자가 시험 실패 — 소켓을 서비스하지 않습니다(토큰으로만 동작): {reason}' reason="$reason")" ;;
    skipped:*)
      lvl=warn; msg="$(_t '건너뜀 — 토큰으로만 동작: {reason}' reason="$reason")" ;;
    disabled:*)
      lvl=warn; msg="$(_t 'VT_AUTHZ_SOCKET=0 — 소켓을 쓰지 않습니다(토큰으로만 동작)')" ;;
    *)
      lvl=warn; msg="$(_t '소켓 없음 — 서버가 꺼져 있거나 옛 코드입니다(fsh restart)')" ;;
  esac
  msg="$msg · $(_t '최근 24h 토큰 사용 {n}건' n="${legacy:-0}")"
  printf '%s\t%s\n' "$lvl" "$msg"
}

_request_proxy_sync() {
  # 2.2 — CLI가 방금 쓴 정책(생성/삭제/모드/PIN)을 실행 중인 서버의 리스너에
  # 즉시 반영시킨다. 승격이 필요 없다(routes/ports.py의 sync_port_proxy 참고) —
  # 접근 결정은 이미 디스크에 적혀 있고, 이 호출은 그 상태를 리스너에 맞출 뿐이다.
  _authed_curl -sf -X POST "http://localhost:$VT_PORT/api/ports/_proxy/sync" -o /dev/null 2>/dev/null
}

_json_field() {
  # "$1" = JSON 문자열, "$2" = 키. 없으면 빈 문자열.
  python3 -c "import json,sys
try:
    v = json.loads(sys.argv[1]).get(sys.argv[2])
    print(v if v is not None else '')
except Exception:
    print('')" "$1" "$2" 2>/dev/null
}

_ttl_word_to_seconds() {
  case "$1" in
    1h) echo 3600 ;;
    24h) echo 86400 ;;
    7d) echo 604800 ;;
    30d) echo 2592000 ;;
    *) return 1 ;;
  esac
}

_start_extra_tunnel() {
  # target_port — cloudflared가 실제로 가리킬 로컬 포트. 기본은 $port 자신
  # (레거시/내부 호출)이지만, 2.2부터 사람이 직접 `fsh tunnel expose`를 치면
  # `cmd_tunnel_expose`가 여기에 **내부 프록시 포트**를 넘긴다(ADR-30 — 노출
  # 트래픽은 항상 FarShell 프록시를 거친다). registry·로그 파일 이름 등
  # 부기(bookkeeping)는 전부 원래 앱 포트($port) 기준으로 그대로 둔다.
  local port="${1:-}" label="${2:-}" target_port="${3:-${1:-}}"

  case "$port" in
    ''|*[!0-9]*) echo "  ✗ $(_t "포트는 숫자여야 합니다: '{port}'" port="$port")"; return 1 ;;
  esac
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "  ✗ $(_t '포트 범위(1-65535)를 벗어났습니다: {port}' port="$port")"; return 1
  fi
  if [ "$port" = "$VT_PORT" ]; then
    echo "  ✗ $(_t '{port} 는 VT 서버 포트입니다 — 메인 터널(fsh start)이 이미 담당합니다' port="$port")"
    return 1
  fi
  local provider; provider="$(_tunnel_provider)"
  if [ "$provider" = "none" ]; then
    echo "  ✗ $(_t 'VT_TUNNEL_PROVIDER=none — 공개 터널을 쓰지 않도록 설정돼 있습니다')"
    return 1
  fi
  if [ "$provider" = "ngrok" ]; then
    if ! command -v ngrok >/dev/null 2>&1; then
      echo "  ✗ $(_t 'ngrok 미설치. brew install ngrok')"
      return 1
    fi
  elif ! command -v cloudflared >/dev/null 2>&1; then
    echo "  ✗ $(_t 'cloudflared 미설치. brew install cloudflared')"
    return 1
  fi

  label="${label:-localhost:$port}"

  if _is_running "tunnel-$port"; then
    echo "  ✓ $(_t '이미 노출 중: {url}' url="$(_registry_url "$port")")"
    return 0
  fi

  if [ "$target_port" != "$port" ] && ! _port_in_use "$target_port"; then
    echo "  ⚠ $(_t '내부 프록시(:{port})가 아직 응답하지 않습니다 — 서버가 막 떴다면 잠시 후 다시 시도하세요' port="$target_port")"
  fi
  if ! _port_in_use "$port"; then
    echo "  ⚠ $(_t 'localhost:{port} 에 응답하는 서비스가 없습니다 — 터널은 띄우지만 앱을 먼저 켜세요' port="$port")"
  fi

  local log; log="$(_extra_tunnel_log "$port")"
  echo "  ▸ $(_t 'localhost:{port} 터널 시작 중...' port="$target_port")"
  : > "$log"
  if [ "$provider" = "ngrok" ]; then
    # 고정 도메인은 계정당 1개(=메인 터널이 쓴다). 추가 포트는 임시 주소이고,
    # 그건 제약이지 결함이 아니다 — 대신 아래 출력에서 그 사실을 말한다.
    nohup ngrok http "$target_port" --log "$log" --log-format logfmt >/dev/null 2>&1 &
  else
    nohup cloudflared tunnel --url "http://localhost:$target_port" > "$log" 2>&1 &
  fi
  echo $! > "$PID_DIR/tunnel-$port.pid"

  local i url
  for i in $(seq 1 30); do
    if [ "$provider" = "ngrok" ]; then
      # 에이전트가 여럿이면 로컬 API 포트가 밀리므로, 여기서는 이 프로세스가
      # 직접 남기는 로그(logfmt의 url=...)를 읽는 쪽이 확실하다.
      url=$(grep -oE 'url=https://[^ ]+' "$log" 2>/dev/null | tail -1 | sed 's/^url=//')
    else
      url=$(_quick_tunnel_url_from_log "$log")
    fi
    if [ -n "$url" ]; then
      _registry_set "$port" "$url" "$label"
      echo "  ✓ $label → $url"
      [ "$provider" = "ngrok" ] && echo "     ⓘ $(_t '추가 포트는 임시 주소입니다(고정 도메인은 메인 터널이 씁니다)')"
      _run_tunnel_hook expose
      return 0
    fi
    sleep 1
  done
  echo "  ✗ $(_t '터널 URL 대기 시간 초과. 로그: {log}' log="$log")"
  return 1
}

_stop_extra_tunnel() {
  local port="${1:-}"
  # --keep-policy: 터널(cloudflared)만 내리고 노출 정책(shareId·PIN·만료)은 남긴다.
  # 웹의 「일시 닫기」·「주소 갱신」이 쓴다 — 다시 열어도 같은 자격으로 돌아오게.
  local keep_policy=0
  [ "${2:-}" = "--keep-policy" ] && keep_policy=1
  local pidfile="$PID_DIR/tunnel-$port.pid"
  if [ ! -f "$pidfile" ]; then
    echo "  ⓘ $(_t '포트 {port} 로 열린 터널이 없습니다' port="$port")"
    _registry_del "$port"
    return 0
  fi
  local pid; pid="$(cat "$pidfile")"
  kill "$pid" 2>/dev/null && echo "  ✓ $(_t '포트 {port} 터널 종료 (PID {pid})' port="$port" pid="$pid")" || echo "  ⓘ $(_t '이미 종료됨 (PID {pid})' pid="$pid")"
  rm -f "$pidfile"
  _registry_del "$port"
  # 2.2 — 정책도 함께 지운다. 재노출하면 새 shareId·PIN이 발급된다(plan §1).
  # 정책이 아예 없던 레거시/내부 호출일 수 있으니 실패는 무시한다.
  if [ "$keep_policy" -eq 0 ]; then
    _port_share_cli cli-remove "$port" >/dev/null 2>&1
  fi
  _request_proxy_sync
  _run_tunnel_hook unexpose
}

# ── fsh tunnel expose/pin/mode — 사람이 직접 치는 CLI 진입점 ──────────────────
#
# `--proxy-port`가 오면 **내부 호출**이다(routes/ports.py의 expose 핸들러가
# Python에서 정책·리스너를 이미 만든 뒤 cloudflared만 이 스크립트에 맡긴다).
# 그 외에는 사람이 직접 친 것 — 정책이 아직 없으므로 여기서 전부 만든다.
cmd_tunnel_expose() {
  local port="${1:-}"; shift || true
  local label="" mode="session" ttl="1h" proxy_port="" force=0 auto=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) mode="${2:-}"; shift 2 ;;
      --ttl) ttl="${2:-}"; shift 2 ;;
      --proxy-port) proxy_port="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      --auto-renew) auto=1; shift ;;
      --no-auto-renew) auto=0; shift ;;
      --*) echo "  ✗ $(_t '알 수 없는 옵션: {opt}' opt="$1")"; return 1 ;;
      *) [ -z "$label" ] && label="$1"; shift ;;
    esac
  done

  if [ -n "$proxy_port" ]; then
    _start_extra_tunnel "$port" "$label" "$proxy_port"
    return $?
  fi

  # 여기부터 사람이 직접 친 경로 — 정책이 아직 없다.
  local net_mode="${VT_NETWORK_MODE:-all}"
  if [ "$net_mode" != "all" ]; then
    # HTTP 라우트(routes/ports.py)와 같은 판정: 인증 붙은 모드도 함께 막는다
    # — "접근 범위를 좁혀놓고 거기서 다시 뚫지 않는다"(plan §10-3).
    echo "  ✗ $(_t "접근 범위가 '{mode}'로 제한된 상태입니다. 공개 터널을 여는 대신 같은 망에서 직접 접속하세요." mode="$net_mode")"
    return 1
  fi
  case "$mode" in
    public|session|pin) ;;
    *) echo "  ✗ $(_t '알 수 없는 모드: {mode} (public|session|pin)' mode="$mode")"; return 1 ;;
  esac
  local ttl_sec; ttl_sec="$(_ttl_word_to_seconds "$ttl")" || {
    echo "  ✗ $(_t '알 수 없는 만료: {ttl} (1h|24h|7d|30d)' ttl="$ttl")"; return 1
  }
  # 공개하면 그 자체가 원격 제어 수단이 되는 포트 — 판정은 웹과 같은 함수
  # (port_share_store.danger_reason). 막지는 않고 --force로 한 번 더 확인받는다.
  case "$port" in ''|*[!0-9]*) echo "  ✗ $(_t "포트는 숫자여야 합니다: '{port}'" port="$port")"; return 1 ;; esac
  local danger; danger="$(_port_share_cli cli-danger "$port" 2>/dev/null)"
  if [ -n "$danger" ]; then
    echo "  ⚠ $(_t '포트 {port}: {reason}' port="$port" reason="$danger")"
    if [ $force -ne 1 ]; then
      echo "  ✗ $(_t '위험한 포트라 노출하지 않았습니다. 정말 열려면 --force를 붙이세요.')"
      return 1
    fi
    echo "  ⚠ $(_t '--force — 경고를 확인하고 노출합니다')"
  fi
  if ! curl -sf "http://localhost:$VT_PORT/" -o /dev/null 2>/dev/null; then
    echo "  ✗ $(_t "FarShell 서버가 실행 중이 아닙니다 — 리스너는 서버 프로세스 안에서만 뜹니다. 'fsh start' 먼저 실행하세요.")"
    return 1
  fi

  # 자동 재노출 — 옵션으로 정하지 않았으면 사람에게 묻는다. 터미널이 아니면(스크립트,
  # 자동 시작) 입력을 기다리며 멈추지 않도록 묻지 않고 끈다.
  if [ -z "$auto" ]; then
    if [ -t 0 ]; then
      printf "  %s " "$(_t '기간이 끝나거나 재부팅해도 이 포트를 자동으로 다시 열까요? (y/N)')"
      local ans; read -r ans
      case "$ans" in y|Y|yes|YES) auto=1 ;; *) auto=0 ;; esac
    else
      auto=0
    fi
  fi

  local out
  out="$(_port_share_cli cli-create "$port" "${label:-localhost:$port}" "$mode" "$ttl_sec" "$auto" 2>&1)"
  if [ $? -ne 0 ]; then
    echo "  ✗ $(_t '정책 생성 실패: {out}' out="$out")"
    return 1
  fi
  proxy_port="$(_json_field "$out" proxyPort)"
  if [ -z "$proxy_port" ]; then
    echo "  ✗ $(_t '서버 응답을 해석할 수 없습니다: {out}' out="$out")"
    return 1
  fi
  local pin; pin="$(_json_field "$out" pin)"

  if ! _request_proxy_sync; then
    echo "  ✗ $(_t '실행 중인 서버에 리스너 시작을 알리지 못했습니다(비밀번호/토큰을 확인하세요).')"
    _port_share_cli cli-remove "$port" >/dev/null 2>&1
    return 1
  fi

  if ! _start_extra_tunnel "$port" "$label" "$proxy_port"; then
    _port_share_cli cli-remove "$port" >/dev/null 2>&1  # 되감기 — 터널 없는 정책을 남기지 않는다
    _request_proxy_sync
    return 1
  fi

  case "$mode" in
    session)
      echo "     ⓘ $(_t '접근: 이 FarShell에 로그인한 기기만')"
      # 공개 주소를 직접 열면 안내만 뜬다(메인 주소를 드러내지 않는다). 처음엔 아래로 연다.
      local _main _sid; _main="$(_main_tunnel_url)"; _sid="$(_json_field "$out" shareId)"
      [ -n "$_main" ] && [ -n "$_sid" ] && echo "     ⓘ $(_t '처음 열기: {url}' url="${_main%/}/p/authorize?share=${_sid}")"
      ;;
    pin) echo "     ⓘ $(_t '접속 코드: {pin} — 다시 표시되지 않습니다 (재발급: fsh tunnel pin {port})' pin="$pin" port="$port")" ;;
    public) echo "     ⚠ $(_t '접근: URL을 아는 누구나 (공개)')" ;;
  esac
  if [ "$auto" = "1" ]; then
    echo "     ⓘ $(_t '자동 재노출: 켜짐 — 만료되면 {ttl}씩 연장하고, 터널이 사라지면 서버가 다시 엽니다(주소는 바뀔 수 있음). 끄기: fsh tunnel auto {port} off' ttl="$ttl" port="$port")"
  else
    echo "     ⓘ $(_t '자동 재노출: 꺼짐 — 켜기: fsh tunnel auto {port} on' port="$port")"
  fi
}

cmd_tunnel_auto() {
  local port="${1:-}" value="${2:-}"
  if [ -z "$port" ] || { [ "$value" != "on" ] && [ "$value" != "off" ]; }; then
    echo "  $(_t '사용법: fsh tunnel auto <port> <on|off>')"; return 1
  fi
  case "$port" in *[!0-9]*) echo "  ✗ $(_t "포트는 숫자여야 합니다: '{port}'" port="$port")"; return 1 ;; esac
  local out; out="$(_port_share_cli cli-set-auto "$port" "$value" 2>&1)"
  if [ $? -ne 0 ]; then
    echo "  ✗ $(_t '포트 {port} 에 노출 정책이 없습니다 — 먼저 fsh tunnel expose {port}' port="$port")"; return 1
  fi
  _request_proxy_sync
  if [ "$value" = "on" ]; then
    echo "  ✓ $(_t '자동 재노출 켜짐: 포트 {port}. 만료되면 연장하고, 터널이 사라지면 서버가 1분 안에 다시 엽니다.' port="$port")"
  else
    echo "  ✓ $(_t '자동 재노출 꺼짐: 포트 {port}. 만료 시각이 되면 노출이 끝납니다.' port="$port")"
  fi
}

cmd_tunnel_pin() {
  local port="${1:-}"
  if [ -z "$port" ]; then
    echo "  $(_t '사용법: fsh tunnel pin <port>')"; return 1
  fi
  local out; out="$(_port_share_cli cli-regenerate-pin "$port" 2>&1)"
  if [ $? -ne 0 ]; then
    echo "  ✗ $out"; return 1
  fi
  _request_proxy_sync
  echo "  ✓ $(_t '새 접속 코드: {pin} — 다시 표시되지 않습니다. 터널·URL은 그대로입니다.' pin="$(_json_field "$out" pin)")"
  echo "     ⓘ $(_t '이전 코드로 들어와 있던 사람도 새 코드를 입력해야 합니다.')"
}

cmd_tunnel_mode() {
  local port="${1:-}" mode="${2:-}"
  if [ -z "$port" ] || [ -z "$mode" ]; then
    echo "  $(_t '사용법: fsh tunnel mode <port> <public|session|pin>')"; return 1
  fi
  case "$mode" in
    public|session|pin) ;;
    *) echo "  ✗ $(_t '알 수 없는 모드: {mode} (public|session|pin)' mode="$mode")"; return 1 ;;
  esac
  local out; out="$(_port_share_cli cli-set-mode "$port" "$mode" 2>&1)"
  if [ $? -ne 0 ]; then
    echo "  ✗ $out"; return 1
  fi
  _request_proxy_sync
  echo "  ✓ $(_t '모드 변경: {mode}. 터널·URL은 그대로입니다. 이전에 통과한 사람은 다시 인증해야 합니다.' mode="$mode")"
  local pin; pin="$(_json_field "$out" pin)"
  [ -n "$pin" ] && echo "     ⓘ $(_t '새 접속 코드: {pin} — 다시 표시되지 않습니다' pin="$pin")"
  if [ "$mode" = "session" ]; then
    local _main _sid; _main="$(_main_tunnel_url)"; _sid="$(_json_field "$out" shareId)"
    [ -n "$_main" ] && [ -n "$_sid" ] && echo "     ⓘ $(_t '처음 열기: {url}' url="${_main%/}/p/authorize?share=${_sid}")"
  fi
}

# ── 터널 URL 변경 훅 (VT_TUNNEL_HOOK) ────────────────────────────────
# 익명 터널은 재시작마다 URL이 바뀐다. 그 URL을 어디로 흘려보낼지는
# 사람마다 다르므로(Notion / Slack / ntfy / 파일 / 사내 위키...) fsh는
# 특정 서비스를 알지 않는다. URL이 바뀔 때 임의의 명령을 부를 뿐이다.
#
# 계약 (자세히: fsh help tunnel-hook):
#   stdin — "라벨<TAB>URL" 줄들 (메인 터널 먼저, 이후 expose된 포트들)
#   env   — VT_TUNNEL_EVENT (start|expose|unexpose|stop|manual)
#           VT_TUNNEL_MAIN_URL (메인 터널 URL, 없으면 빈 값)
#   훅의 실패는 터널 동작에 영향을 주지 않는다.
#
# `stop`은 **stdin이 비어 있는 유일한 이벤트**다. 알릴 URL이 없다는 뜻이 아니라
# "이제 접속할 곳이 없다"는 뜻이라, 게시 대상에 그 상태를 반영해야 한다.
# 2026-09-21에 이게 없어서, 터널을 내린 뒤에도 노션 페이지가 죽은 URL을 계속
# 가리키고 있었다 — 훅이 고장난 건지 그냥 꺼진 건지 페이지만 봐선 알 수 없었다.

# 메인 터널(VT_PORT 또는 명명 터널)의 PID만 — 공백 구분 한 줄.
# 'expose'로 뜬 다른 포트 터널은 제외한다.
# ── 공개 입구 제공자 ────────────────────────────────────────────────────
# VT_TUNNEL_PROVIDER = cloudflare(기본) | ngrok | none.
# 미설정이면 cloudflare — 기존 사용자의 동작은 한 글자도 바뀌지 않는다.
# 모르는 값은 막지 않고 cloudflare로 진행하되 경고한다(터널은 켜지는 게 우선이다).
_tunnel_provider() {
  local p
  p="$(printf '%s' "${VT_TUNNEL_PROVIDER:-cloudflare}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  case "$p" in
    cloudflare|ngrok|none) printf '%s' "$p" ;;
    "")                    printf 'cloudflare' ;;
    *)  printf 'cloudflare'
        echo "  ⚠ $(_t "알 수 없는 VT_TUNNEL_PROVIDER='{p}' — cloudflare로 진행합니다" p="$p")" >&2 ;;
  esac
}

# ngrok 에이전트 로컬 API에서 특정 로컬 포트로 가는 공개 URL을 찾는다.
#
# 에이전트를 여러 개 띄우면(메인 + fsh tunnel expose) 두 번째부터 4040이 이미
# 점유돼 4041, 4042…로 밀린다 — 그래서 한 포트만 보면 안 되고 훑어야 한다.
# VT_NGROK_API를 주면 그 주소만 본다.
_ngrok_public_url() {
  local want="${1:-$VT_PORT}" api json url
  local candidates="${VT_NGROK_API:-}"
  if [ -z "$candidates" ]; then
    candidates="http://127.0.0.1:4040 http://127.0.0.1:4041 http://127.0.0.1:4042 http://127.0.0.1:4043"
  fi
  local py="${VT_PYTHON:-}"
  [ -n "$py" ] && [ -x "$py" ] || py="python3"
  for api in $candidates; do
    json="$(curl -s --max-time 2 "$api/api/tunnels" 2>/dev/null)"
    [ -n "$json" ] || continue
    url="$(printf '%s' "$json" | "$py" -c '
import json, sys
try:
    tunnels = json.load(sys.stdin).get("tunnels") or []
except Exception:
    raise SystemExit(0)
port = sys.argv[1]
# 우리 포트로 가는 터널만 취한다 — 다른 앱을 내보내는 ngrok이 떠 있을 수 있고,
# 그걸 FarShell 입구로 표시하면 화면이 거짓말을 하게 된다.
for t in tunnels:
    addr = str((t.get("config") or {}).get("addr") or "")
    pub = str(t.get("public_url") or "")
    if addr.rsplit(":", 1)[-1] == port and pub.startswith("https"):
        print(pub)
        break
' "$want" 2>/dev/null)"
    [ -n "$url" ] && { printf '%s' "$url"; return 0; }
  done
  return 1
}

_main_tunnel_pids() {
  command -v pgrep >/dev/null 2>&1 || return 0
  if [ "$(_tunnel_provider)" = "ngrok" ]; then
    # 메인 = VT_PORT를 내보내는 에이전트. expose로 띄운 다른 포트 에이전트와 갈린다.
    pgrep -f "ngrok .*http .*\b$VT_PORT\b" 2>/dev/null | grep -v '^$' | tr '\n' ' ' | sed 's/ $//'
    return 0
  fi
  {
    pgrep -f "^([^ ]*/)?cloudflared[[:space:]].*tunnel run" 2>/dev/null || true
    pgrep -f "^([^ ]*/)?cloudflared[[:space:]].*--url http://localhost:$VT_PORT\$" 2>/dev/null || true
  } | grep -v '^$' | tr '\n' ' ' | sed 's/ $//'
}

# 메인 공개 URL의 단일 진실의 원천. status·mobile·handoff·훅이 전부 이걸 부른다
# (예전엔 각자 로그를 grep해서 제공자를 하나 더 들이면 그만큼 드리프트했다).
# 익명 quick tunnel 로그에서 주소 읽기 — 단일 진입점(2026-09-30).
#   -a      : 로그에 NUL 바이트가 섞여도 텍스트로 읽는다. 다른 cloudflared가 같은
#             파일을 덮어쓰면(원래 프로세스는 예전 오프셋에 계속 쓴다) 중간이 NUL로
#             채워지고, BSD grep은 그 파일을 바이너리로 보고 주소 대신
#             "Binary file … matches"를 출력했다 — fsh가 그 문구를 주소로 알고
#             재시작을 멈추고 훅에 게시하려 했다(실사고).
#   tail -1 : 가장 나중에 받은 주소. 로그가 섞였을 때 첫 주소는 이미 죽은 것일 수 있다.
# 로그만으로는 살아 있는지 모른다 — 외부에 알리기 전에는 _tunnel_url_alive로 확인한다.
_quick_tunnel_url_from_log() {
  grep -aoE 'https://[a-z0-9-]+\.trycloudflare\.com' "$1" 2>/dev/null | tail -1
}

# 주소가 실제로 응답하는가. 000(연결 불가)·530/1033(Cloudflare: 그런 터널 없음)만
# 죽음으로 본다 — 502는 터널은 살아 있고 서버만 내려간 상태라 살아 있음이다.
# 새 quick tunnel은 DNS가 퍼지는 데 시간이 걸려 몇 번 다시 본다. 처음엔 5회(약
# 15초)였는데, 부팅 직후 자동 시작(2026-10-01 08:08)에서 막 생긴 터널이 그 안에
# 안 열려 "죽은 주소"로 판정됐고 새 주소가 게시되지 않았다 — 약 60초(20회×3초)
# 기다린다. 살아 있는 주소는 첫 시도에서 바로 통과하므로 평소엔 늦어지지 않는다.
_tunnel_url_alive() {
  local url="$1" code i tries="${VT_TUNNEL_ALIVE_TRIES:-20}"
  [ -n "$url" ] || return 1
  for i in $(seq 1 "$tries"); do
    code="$(curl -s -o /dev/null -m 6 -w '%{http_code}' "$url" 2>/dev/null || true)"
    case "$code" in
      000|530|1033|"") ;;
      *) return 0 ;;
    esac
    [ "$i" -lt "$tries" ] && sleep 3
  done
  return 1
}

_main_tunnel_url() {
  case "$(_tunnel_provider)" in
    none)  return 0 ;;
    ngrok) _ngrok_public_url "$VT_PORT" || return 0 ;;
    *)
      if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
        echo "https://$VT_TUNNEL_HOSTNAME"
        return 0
      fi
      _quick_tunnel_url_from_log "$TUNNEL_LOG"
      ;;
  esac
}

# stdout: "라벨<TAB>URL" 줄들 — 훅의 stdin이자 fsh tunnel list의 원본
_tunnel_entries() {
  local url
  url="$(_main_tunnel_url)"
  [ -n "$url" ] && printf '%s\t%s\n' "${VT_TUNNEL_MAIN_LABEL:-터미널 (FarShell)}" "$url"
  _registry_prune
  if [ -f "$TUNNEL_REGISTRY" ]; then
    awk -F'\t' 'NF>=2 && $2!="" {print ($3==""?"localhost:"$1:$3) "\t" $2}' "$TUNNEL_REGISTRY"
  fi
}

# 주소가 아직 안 열린 start 훅을 백그라운드에서 다시 시도한다. 한 번에 하나만 —
# 앞선 재시도는 이전 주소를 기다리는 것이라 새로 띄우기 전에 끝낸다. `fsh stop`이
# pid 파일(tunnel-hook-retry)로 함께 내린다.
_spawn_tunnel_hook_retry() {
  local url="$1" tries="${VT_TUNNEL_RETRY_TRIES:-40}" interval="${VT_TUNNEL_RETRY_INTERVAL:-15}"
  local pidfile="$PID_DIR/tunnel-hook-retry.pid"
  _is_running tunnel-hook-retry && kill "$(cat "$pidfile")" 2>/dev/null
  nohup "$VT_DIR/bin/fsh" tunnel __hook-retry "$url" > "$HOOK_RETRY_LOG" 2>&1 < /dev/null &
  echo $! > "$pidfile"
  echo "  ⚠ $(_t '터널 주소가 아직 응답하지 않습니다 — 백그라운드에서 최대 {min}분 더 기다렸다가 게시합니다: {url} (로그: {log})' \
    min="$(( (tries * interval + 59) / 60 ))" url="$url" log="$HOOK_RETRY_LOG")"
}

# `fsh tunnel __hook-retry <url>` 본체. 주소가 응답하면 start 훅을 한 번 실행한다.
# 그 사이 주소가 바뀌면(터널 재시작) 그만둔다 — 새 주소는 새 start가 맡는다.
_tunnel_hook_retry() {
  local url="$1" i tries="${VT_TUNNEL_RETRY_TRIES:-40}" interval="${VT_TUNNEL_RETRY_INTERVAL:-15}"
  local pidfile="$PID_DIR/tunnel-hook-retry.pid"
  [ -n "$url" ] || return 1
  for i in $(seq 1 "$tries"); do
    if [ "$(_main_tunnel_url)" != "$url" ]; then
      echo "$(date '+%F %T') url changed; stop waiting for $url"
      break
    fi
    if VT_TUNNEL_ALIVE_TRIES=1 _tunnel_url_alive "$url"; then
      echo "$(date '+%F %T') alive after try $i: $url"
      _FSH_HOOK_RETRYING=1 _run_tunnel_hook start
      break
    fi
    [ "$i" -lt "$tries" ] && sleep "$interval"
    [ "$i" -eq "$tries" ] && echo "$(date '+%F %T') gave up after $tries tries: $url"
  done
  [ "$(cat "$pidfile" 2>/dev/null)" = "$$" ] && rm -f "$pidfile"
  return 0
}

_run_tunnel_hook() {
  local event="${1:-manual}"
  # 미설정이면 조용히 통과 — 터널 동작을 절대 방해하지 않는다
  [ -n "${VT_TUNNEL_HOOK:-}" ] || return 0

  # ngrok 고정 도메인은 재시작해도 주소가 그대로다. 그런데도 start마다 훅을 쏘면
  # 노션·슬랙에 "바뀌지 않은 URL"을 계속 덮어쓰게 된다 — 훅의 이름과 계약
  # (`fsh help tunnel-hook`: URL이 바뀔 때 호출)에도 어긋난다. 그래서 자동
  # 이벤트는 지난번 게시한 주소와 다를 때만 보낸다. `fsh tunnel hook`으로
  # 직접 부르는 manual은 언제나 그대로 나간다.
  local url_now stamp="$PID_DIR/tunnel-hook-last-url"

  # 2026-09-30 — 죽은 주소를 게시하지 않는다. 로그는 다른 프로세스에 덮어써질 수
  # 있어(위 _quick_tunnel_url_from_log 주석) 로그에서 읽은 주소가 살아 있다는
  # 보장이 없다. 종료(stop)는 원래 주소를 비워 보내므로 확인 대상이 아니다.
  if [ "$event" != "stop" ] && [ "$(_tunnel_provider)" != "ngrok" ] && [ -z "${VT_TUNNEL_HOSTNAME:-}" ]; then
    url_now="$(_main_tunnel_url)"
    if [ -n "$url_now" ] && ! _tunnel_url_alive "$url_now"; then
      # 2026-10-14 — 새 quick tunnel이 60초 넘게 안 열려 여기서 건너뛰었고, 다시
      # 시도하는 곳이 없어 새 주소가 영영 게시되지 않았다(실사고). start는
      # 백그라운드에서 더 기다렸다가 게시한다. 재시도 자신은 다시 띄우지 않는다.
      if [ "$event" = "start" ] && [ -z "${_FSH_HOOK_RETRYING:-}" ]; then
        _spawn_tunnel_hook_retry "$url_now"
      else
        echo "  ⚠ $(_t '터널 주소가 응답하지 않아 훅 게시를 건너뜁니다: {url}' url="$url_now")"
      fi
      return 0
    fi
  fi
  if [ "$(_tunnel_provider)" = "ngrok" ] && [ "$event" != "manual" ]; then
    url_now="$(_main_tunnel_url)"
    if [ -n "$url_now" ] && [ -f "$stamp" ] && [ "$url_now" = "$(cat "$stamp" 2>/dev/null)" ]; then
      return 0
    fi
    [ -n "$url_now" ] && printf '%s' "$url_now" > "$stamp"
  fi

  # 2026-09-21: `fsh restart`가 생기면서 **cloudflare 익명 터널도 같은 사정**이
  # 됐다. restart는 cloudflared를 살려 두고 서버만 재기동하므로 start 시점에
  # URL이 그대로다(실측: 백엔드를 죽였다 살려도 quick tunnel URL 불변, 502 →
  # 200 자동 복구). 그대로인 주소를 다시 게시하면 노션 블록 타임스탬프만
  # 의미 없이 바뀐다 — 계약이 "URL이 바뀔 때 호출"이므로 제공자와 무관하게
  # start는 게이트한다.
  #
  # **start에만 건다.** expose/unexpose는 메인 URL이 그대로여도 목록이 바뀌니
  # 게이트하면 새 포트가 영영 안 알려지고, manual은 사용자가 직접 부른 것이라
  # 언제나 나가야 하며, stop은 URL이 없는 것 자체가 알릴 내용이다.
  if [ "$event" = "start" ]; then
    url_now="$(_main_tunnel_url)"
    if [ -n "$url_now" ] && [ -f "$stamp" ] && [ "$url_now" = "$(cat "$stamp" 2>/dev/null)" ]; then
      return 0
    fi
    [ -n "$url_now" ] && printf '%s' "$url_now" > "$stamp"
  fi

  local entries
  # 2026-09-21 실측으로 발견 — `stop`인데도 `_tunnel_entries()`를 그대로 부르면
  # 죽은 URL이 나온다. `_main_tunnel_url()`(cloudflare 기본값)은 프로세스
  # 생사가 아니라 **로그 파일을 grep**해서 URL을 구하는데(단일 진실 원천 —
  # 파일 상단 주석), `fsh stop`은 프로세스만 죽이고 로그는 안 지운다. 그래서
  # 터널을 내린 직후에도 로그엔 방금 죽은 URL이 그대로 남아 있어, `entries`가
  # 비지 않고 옛 URL을 그대로 돌려준다 — 훅은 "알릴 게 있다"로 착각해
  # 종료 마커 대신 그 죽은 URL을 다시 게시해 버린다(노션 콜아웃 실측으로 확인:
  # 타임스탬프만 갱신되고 URL은 그대로였다). `stop`의 계약 자체가 "stdin이
  # 비어야 종료로 읽힌다"이므로, 여기서 아예 `_tunnel_entries()`를 부르지
  # 않고 강제로 비운다.
  if [ "$event" = "stop" ]; then
    entries=""
  else
    entries="$(_tunnel_entries)"
  fi
  # `stop`은 비어 있는 게 정상이자 알려야 할 내용 그 자체다 — 여기서 걸러내면
  # 종료 사실이 영영 전달되지 않는다. 나머지 이벤트는 알릴 게 없으면 안 쏜다.
  if [ -z "$entries" ] && [ "$event" != "stop" ]; then
    [ "$event" = "manual" ] && echo "  ⓘ $(_t '알릴 URL이 없습니다 (터널 미실행)')"
    return 0
  fi

  # `stop`의 메인 URL도 비워야 한다 — entries와 같은 이유다. _main_tunnel_url()은
  # 로그 grep이라 터널을 내린 뒤에도 방금 죽은 주소를 돌려준다. 훅이
  # `$VT_TUNNEL_MAIN_URL`로 분기하면(계약상 "없으면 빈 값") 죽은 주소를 살아있는
  # 것으로 읽는다.
  local main_url=""
  [ "$event" = "stop" ] || main_url="$(_main_tunnel_url)"

  local out rc
  out="$(printf '%s\n' "$entries" | \
    VT_TUNNEL_EVENT="$event" \
    VT_TUNNEL_MAIN_URL="$main_url" \
    /bin/sh -c "$VT_TUNNEL_HOOK" 2>&1)"
  rc=$?
  # 종료했으면 마지막 게시 주소 기록도 지운다 — 안 지우면 다음 start가 같은
  # URL을 받았을 때(터널을 새로 띄웠는데 우연히 같을 일은 없지만, 명명 터널과
  # ngrok 고정 도메인은 항상 같다) 위 게이트에 걸려 "다시 살아났다"는 사실이
  # 영영 게시되지 않는다.
  [ "$event" = "stop" ] && rm -f "$stamp"
  if [ $rc -eq 0 ]; then
    echo "  ✓ $(_t '훅 실행{out}' out="${out:+: $out}")"
  else
    echo "  ⚠ $(_t '훅 실패(rc={rc}){out}' rc="$rc" out="${out:+: $out}")"
  fi
  return 0
}

_start_voice_daemon() {
  if _is_running voice; then
    echo "✓ $(_t 'Voice Daemon 이미 실행 중')"
    return 0
  fi
  echo "▸ $(_t 'Voice Daemon 시작 중...')"
  nohup "$VT_PYTHON" "$VT_DIR/server/voice_daemon.py" > "$DAEMON_LOG" 2>&1 &
  echo $! > "$PID_DIR/voice.pid"
  sleep 1
  if _is_running voice; then
    echo "✓ $(_t 'Voice Daemon 시작 (Ctrl+Shift+M 로 녹음)')"
  else
    echo "✗ $(_t 'Voice Daemon 실패. 로그: {log}' log="$DAEMON_LOG")"
    return 1
  fi
}

_start_clipboard_daemon() {
  if _is_running clip; then
    echo "✓ $(_t 'Clipboard Daemon 이미 실행 중')"
    return 0
  fi
  echo "▸ $(_t 'Clipboard Daemon 시작 중...')"
  nohup "$VT_PYTHON" "$VT_DIR/server/clipboard_daemon.py" > "$CLIP_DAEMON_LOG" 2>&1 &
  echo $! > "$PID_DIR/clip.pid"
  sleep 1
  if _is_running clip; then
    echo "✓ $(_t 'Clipboard Daemon 시작 (맥 클립보드 변경 → 웹 자동 동기화)')"
  else
    echo "✗ $(_t 'Clipboard Daemon 실패. 로그: {log}' log="$CLIP_DAEMON_LOG")"
    return 1
  fi
}

# Phase 6 #6-4: detached → optional populate → attach 3단계 분리
# 비-TTY 컨텍스트(CI·백그라운드)에서도 tcgetattr 경고 없이 동작.

# 1단계: detached 세션 보장 (TTY 불필요).
# 이미 있으면 0, 없으면 생성. -x/-y는 detached에서 tcgetattr 실패 회피.
# 터미널 창(탭) 제목을 세션 이름으로. tmux가 제목을 알려주지 않으면(set-titles off) Ghostty는
# 기본 아이콘만 보여줘 창이 여러 개일 때 구분이 안 된다. fsh 전용 서버(-L)에만 적용된다.
# (서버 쪽은 server/tmux_hooks.py의 TITLE_OPTIONS — 같은 값이어야 한다)
_tmux_apply_title_options() {
  "${TMUX_BASE[@]}" set-option -g set-titles on 2>/dev/null
  "${TMUX_BASE[@]}" set-option -g set-titles-string "#S" 2>/dev/null
  return 0
}

_ensure_tmux_session() {
  local name="${1:-dev}"
  if "${TMUX_BASE[@]}" has-session -t "$name" 2>/dev/null; then
    _tmux_apply_title_options
    return 0
  fi
  "${TMUX_BASE[@]}" new-session -d -s "$name" -x 200 -y 50 2>/dev/null || return 1
  _tmux_apply_title_options
}

# 기존 _ensure_tmux는 wrapper로 유지 (회귀 호환).
_ensure_tmux() {
  local name="${1:-dev}"
  if "${TMUX_BASE[@]}" has-session -t "$name" 2>/dev/null; then
    echo "✓ $(_t 'tmux 세션 존재 (소켓: {socket}): {sessions}' socket="$VT_TMUX_SOCKET" sessions="$("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' | tr '\n' ' ')")"
    _maybe_register_client_hooks
    return 0
  fi
  if _ensure_tmux_session "$name"; then
    echo "✓ $(_t "tmux 세션 '{name}' 생성 (소켓: {socket})" name="$name" socket="$VT_TMUX_SOCKET")"
    _maybe_register_client_hooks
  else
    echo "✗ $(_t "tmux 세션 '{name}' 생성 실패" name="$name")"
    return 1
  fi
}

# D9: SSH(+Tailscale)로 붙는 클라이언트는 web/voice 경로와 달리 서버가 자연히
# 알 방법이 없다 — tmux client-attached/detached 훅으로 "누가 언제 접속했는지"를
# push 알림(ntfy/Telegram)으로 알려준다. 기본은 OFF (VT_NOTIFY_CLIENT_EVENTS=1로 옵트인),
# 매 _ensure_tmux 호출마다 재등록해도 set-hook은 멱등이라 안전함.
_maybe_register_client_hooks() {
  [ "${VT_NOTIFY_CLIENT_EVENTS:-0}" = "1" ] || return 0
  local hook_script="$VT_DIR/server/hooks/tmux_client_notify.sh"
  [ -f "$hook_script" ] || return 0
  chmod +x "$hook_script" 2>/dev/null
  "${TMUX_BASE[@]}" set-hook -g client-attached \
    "run-shell -b '\"$hook_script\" attached \"#{client_tty}\" \"#{session_name}\"'" 2>/dev/null
  "${TMUX_BASE[@]}" set-hook -g client-detached \
    "run-shell -b '\"$hook_script\" detached \"#{client_tty}\" \"#{session_name}\"'" 2>/dev/null
}

# 자동 오픈 실패 원인 안내. osascript 실패 시 stderr가 담긴 VT_AUTOOPEN_ERR을
# 읽어, 특히 macOS 자동화(Automation) 권한 거부(-1743)를 감지해 해결법을 출력한다.
# 출력 후 변수를 비워 다음 호출에 이전 오류가 새지 않게 한다.
_autoopen_failure_hint() {
  local err="${VT_AUTOOPEN_ERR:-}"
  VT_AUTOOPEN_ERR=""
  [ -n "$err" ] || return 0
  case "$err" in
    *-1743*|*"Not authorized"*|*"not allowed to send"*|*"권한"*|*"승인"*)
      echo "  ⚠ $(_t "원인: 터미널을 자동 제어할 '자동화(Automation)' 권한이 없습니다.")"
      echo "     $(_t '시스템 설정 → 개인정보 보호 및 보안 → 자동화 에서')"
      echo "     $(_t "지금 실행 중인 앱(iTerm/Terminal/Claude)의 'iTerm' 항목을 켜세요.")"
      ;;
    *)
      echo "  ⚠ $(_t '원인: {err}' err="$err")"
      ;;
  esac
}

# 새 터미널 창에서 tmux dev 세션 + claude --resume 자동 실행.
# 이미 tmux 안에 있으면 호출하지 않음 (멱등성).
# $TERM_PROGRAM 기반으로 현재 쓰는 터미널 앱에 맞춰 오픈.
# 지원: iTerm2, Terminal.app(Apple), WezTerm, Warp, Alacritty, Kitty, Ghostty
_open_tmux_terminal() {
  # 호환 wrapper: 디폴트는 dev + claude --resume (W1-3 이전 동작 유지)
  _open_tmux_terminal_with "dev" "claude --resume"
}

# 해당 tmux 세션에 이미 붙어있는 클라이언트의 tty 목록 (없으면 빈 문자열).
# 세션당 창 하나 원칙: 이미 어딘가 attach돼 있으면 새 창을 또 열지 않기 위한 판단 근거.
_tmux_session_client_ttys() {
  local name="${1:-dev}"
  "${TMUX_BASE[@]}" list-clients -t "$name" -F '#{client_tty}' 2>/dev/null
}

# iTerm2 창들 중 주어진 tty를 표시 중인 탭/세션을 찾아 앞으로 가져온다.
# iTerm session에는 tty 속성이 있어 client-tty와 직접 매칭 가능.
_focus_iterm_by_tty() {
  local tty="$1"
  [ -d "/Applications/iTerm.app" ] || return 1
  local ok
  ok="$(osascript <<APPLESCRIPT 2>/dev/null
tell application "iTerm"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$tty" then
          activate
          select w
          select t
          tell w to select s
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
  return "no"
end tell
APPLESCRIPT
)"
  [ "$ok" = "ok" ]
}

# 세션이 이미 다른 창에 attach돼 있으면 새 창을 열지 않고(가능하면 그 창으로
# 포커스만 전환) 성공(0)을 반환한다. attach된 곳이 없으면 1을 반환 — 호출자가
# 새 창을 열어야 한다는 뜻.
_tmux_already_open() {
  local name="${1:-dev}"
  local ttys first_tty
  ttys="$(_tmux_session_client_ttys "$name")"
  if [ -n "$ttys" ]; then
    first_tty="$(printf '%s\n' "$ttys" | head -1)"
    if [ "$(uname)" = "Darwin" ] && _focus_iterm_by_tty "$first_tty"; then
      echo "  ✓ $(_t "tmux 세션 '{name}'이 이미 열려 있어 그 창으로 전환했습니다." name="$name")"
    else
      echo "  ⓘ $(_t "tmux 세션 '{name}'이 이미 다른 창에 열려 있어 새 창을 열지 않습니다." name="$name")"
    fi
    return 0
  fi
  # 붙어 있는 클라이언트가 없으면 세션이 이미 있어도 창은 비어 있는 것이다 — 새 창을 열어
  # attach 한다. 예전엔 "세션이 있으면 안 연다"로 막았는데, handoff desktop이
  # 창을 열기 직전에 _ensure_tmux로 세션을 먼저 만들어서 항상 이 판정에 걸려 창이 안 열렸다.
  # (창이 붙어 있는 세션은 위에서 이미 걸러져, 반복 호출해도 창이 늘지 않는다.)
  return 1
}

# 임의 세션을 새 OS 터미널 창에서 attach하는 헬퍼.
# 인자: $1=session_name, $2=optional command (없으면 attach만)
# 세션당 창 하나 원칙: 이미 attach된 창이 있으면 새로 열지 않는다.
# 실제 창 열기는 server/terminal_open.py 한 곳이 한다 — 웹의 "맥에서 열기"와 같은 코드라
# VT_TERMINAL(fsh terminal)과 Ghostty 처리가 CLI·웹에서 똑같이 적용된다.
_open_tmux_terminal_with() {
  local session="${1:-dev}"
  local extra_cmd="${2:-}"

  # 반환값 3종: 0=새 창을 실제로 열었음, 2=이미 있어서 안 열었음(안내 메시지는
  # _tmux_already_open이 이미 출력함 — 호출자가 "새로 열렸다"는 메시지를 또 찍으면 안 됨),
  # 1=열기 시도했으나 실패.
  _tmux_already_open "$session" && return 2

  local cmd
  if [ -n "$extra_cmd" ]; then
    # 작은따옴표로 감싸 extra_cmd 안의 큰따옴표가 그대로 tmux에 넘어가게 한다.
    # 안의 작은따옴표는 '\'' 로 바꾼다(bash·zsh 동일 동작).
    local sq="'"
    local q=${extra_cmd//$sq/$sq\\$sq$sq}
    cmd="tmux -L $VT_TMUX_SOCKET new -A -s $session '$q'"
  else
    cmd="tmux -L $VT_TMUX_SOCKET new -A -s $session"
  fi

  local out rc note
  out="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m terminal_open -- "$cmd" 2>&1)"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    note="$(printf '%s\n' "$out" | sed -n 's/^note://p')"
    [ -n "$note" ] && echo "  ⓘ $note"
    return 0
  fi
  # osascript 오류 원문(자동화 권한 거부 -1743 등)을 _autoopen_failure_hint가 읽는다.
  VT_AUTOOPEN_ERR="$out"
  return 1
}

cmd_voice() {
  echo ""
  echo "  🎤 fsh voice — $(_t '음성 모드')"
  echo "  $(_t '노션/브라우저 작업을 계속하면서 음성으로 코딩')"
  echo ""

  _onboarding_check  # W5-2: 첫 실행 시 안내

  _start_server
  _start_voice_daemon

  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  if vt_is_en; then
  echo "  │  Voice mode is on                       │"
  echo "  │                                         │"
  echo "  │  Ctrl+Shift+M → start/stop recording    │"
  echo "  │  What you say → STT → typed into tmux   │"
  echo "  │  Result → read back via TTS             │"
  echo "  │                                         │"
  echo "  │  Keep working. Voice runs in the        │"
  echo "  │  background.                            │"
  echo "  │                                         │"
  echo "  │  Stop: fsh stop                         │"
  else
  echo "  │  음성 모드 활성화 완료                      │"
  echo "  │                                         │"
  echo "  │  Ctrl+Shift+M → 녹음 시작/종료           │"
  echo "  │  말한 내용 → STT → tmux에 자동 입력       │"
  echo "  │  결과 → TTS로 음성 확인                   │"
  echo "  │                                         │"
  echo "  │  작업을 계속하세요. 음성이 백그라운드에서    │"
  echo "  │  동작합니다.                              │"
  echo "  │                                         │"
  echo "  │  종료: fsh stop                          │"
  fi
  echo "  └─────────────────────────────────────────┘"
  echo ""
}

cmd_clip() {
  echo ""
  echo "  📋 fsh clip — $(_t '클립보드 동기화')"
  echo "  $(_t '맥북 시스템 클립보드 변경 감지 → 웹이 열린 기기의 클립보드로 push')"
  if vt_is_en; then
  echo "  (Copies made inside the terminal, like vim or tmux copy-mode, are already synced via OSC52 —"
  echo "   they work without this daemon.)"
  else
  echo "  (vim/tmux copy-mode 등 터미널 내부 복사는 OSC52로 이미 자동 동기화됨 —"
  echo "   그 경우엔 이 데몬 없이도 동작)"
  fi
  echo ""

  _start_server
  _start_clipboard_daemon

  echo ""
  echo "  $(_t '종료: fsh stop')"
  echo ""
}

# ── 접근 범위(--network)와 공개 전 인증 확인 — start / mobile 공용 ─────────────────
# 서버를 어떤 범위로 열지(localhost|lan|tailscale|all)는 `fsh start`가 정한다.
# `fsh mobile`은 그 결과(주소)를 폰에 보여주기만 하므로, 서버가 어떤 범위로 떠 있는지를
# start가 $PID_DIR/network_mode에 남겨 mobile·status가 읽는다.
_NETWORK_MODES="localhost lan tailscale all"

# 지금 떠 있는 서버의 접근 범위. start가 남긴 기록 → 환경변수 → all.
_current_network_mode() {
  local m=""
  [ -f "$PID_DIR/network_mode" ] && m="$(cat "$PID_DIR/network_mode" 2>/dev/null)"
  [ -n "$m" ] || m="${VT_NETWORK_MODE:-all}"
  echo "$m"
}

# 접근 범위별 폰/브라우저 접속 주소. all은 터널 주소(없으면 빈 값).
_mode_access_url() {
  case "$1" in
    localhost) echo "http://127.0.0.1:$VT_PORT" ;;
    lan)
      local lan_ip
      lan_ip="$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')"
      [ -z "$lan_ip" ] && lan_ip="$(ifconfig 2>/dev/null | awk '/inet 192\./{print $2; exit}')"
      [ -z "$lan_ip" ] && lan_ip="localhost"
      echo "http://${lan_ip}:$VT_PORT"
      ;;
    tailscale)
      local ts_ip
      ts_ip="$(command -v tailscale >/dev/null 2>&1 && tailscale ip -4 2>/dev/null | head -1)"
      [ -n "$ts_ip" ] || return 1
      echo "http://${ts_ip}:$VT_PORT"
      ;;
    all) _main_tunnel_url ;;
    *) return 1 ;;
  esac
}

# 공개 터널(all 범위)을 열기 전, 인증(비밀번호/VT_AUTH_TOKEN)이 설정돼 있는지 먼저
# 확인한다. 서버는 인증 없이도 기동되고 startup()에서 경고만 로그로 남기지만, 그
# 경고는 아무도 안 본다 — 공개 URL이 곧 인증 없는 원격 코드 실행이 되는 걸 여기서
# 미리 막는다. localhost/lan/tailscale 범위는 네트워크 자체가 좁혀져 있으니 대상이
# 아니다. --force는 사용자가 위험을 인지하고 명시적으로 우회하는 경로.
# (예전엔 이 검사가 `fsh mobile`에만 있어서 `fsh start`는 인증 없이도 공개 터널을 열었다.)
_require_auth_for_public() {
  local force="${1:-0}"
  (cd "$VT_DIR/server" && "$VT_PYTHON" -m auth status >/dev/null 2>&1) && return 0
  if [ "$force" -eq 1 ]; then
    echo ""
    echo "  ⚠️  $(_t '경고: 인증 없이 --force로 공개 터널을 엽니다.')"
    echo "     $(_t 'URL을 아는 누구나 이 맥에서 명령을 실행할 수 있습니다.')"
    echo ""
    return 0
  fi
  echo ""
  echo "  ✗ $(_t '인증(비밀번호/VT_AUTH_TOKEN)이 설정되지 않았습니다.')"
  echo ""
  if vt_is_en; then
  echo "    If you run 'fsh start' like this, the tunnel that opens to the public internet"
  echo "    exposes your terminal with no auth — anyone who knows the URL"
  echo "    can run commands on this Mac."
  else
  echo "    이 상태로 'fsh start'를 실행하면 공개 인터넷에 열리는 터널에"
  echo "    아무 인증 없이 터미널이 노출됩니다 — URL을 아는 누구나"
  echo "    이 맥에서 명령을 실행할 수 있습니다."
  fi
  echo ""
  echo "    $(_t '먼저 다음 중 하나를 하세요:')"
  echo "      fsh password              $(_t '비밀번호 설정 (권장)')"
  echo "      export VT_AUTH_TOKEN=... $(_t '기계용 토큰 설정')"
  echo ""
  echo "    $(_t '공개하지 않으려면: fsh start --network tailscale   (또는 lan / localhost)')"
  echo "    $(_t '위험을 감수하고 그대로 진행하려면: fsh start --force')"
  echo ""
  return 1
}

_start_usage() {
  echo ""
  if vt_is_en; then
  echo "  Usage: fsh start [--network <localhost|lan|tailscale|all>] [--safe] [--force] [--voice]"
  echo "    --network <scope>  Who can connect (default: all = public tunnel + auth)"
  echo "                       localhost this Mac only / lan same network / tailscale same tailnet"
  echo "    --safe             Block dangerous commands"
  echo "    --force            Open the public tunnel even without auth (risky)"
  echo "    --voice            Also start the Voice Daemon"
  else
  echo "  사용법: fsh start [--network <localhost|lan|tailscale|all>] [--safe] [--force] [--voice]"
  echo "    --network <범위>  누가 접속할 수 있는지 (기본 all = 공개 터널 + 인증)"
  echo "                      localhost 이 맥만 / lan 같은 네트워크 / tailscale 같은 tailnet"
  echo "    --safe            위험 명령 차단 모드"
  echo "    --force           인증 없이도 공개 터널을 강행 (위험)"
  echo "    --voice           Voice Daemon도 함께 시작"
  fi
  echo ""
}

cmd_start() {
  # 서버 + 접속 경로를 시작한다. 폰 접속 주소/QR은 `fsh mobile`.
  # 음성은 기본 OFF — 켜려면 --voice 명시하거나 별도로 'fsh voice' 실행.
  # 항상 켜져 있던 예전 동작을 기대하고 핫키가 안 먹는다고 헷갈리지 않도록,
  # 옵션 없이 실행하면 "필요하면 --voice로" 안내를 남긴다.
  local want_voice=0 want_safe=0 want_force=0
  local network_mode=""
  local args=("$@") i=0
  while [ $i -lt ${#args[@]} ]; do
    local arg="${args[$i]}"
    case "$arg" in
      --voice) want_voice=1 ;;
      --safe) want_safe=1 ;;
      --force) want_force=1 ;;
      --network)
        i=$((i+1)); network_mode="${args[$i]:-}"
        if [ -z "$network_mode" ]; then
          echo "  ✗ $(_t '--network 값이 없습니다') (${_NETWORK_MODES// /|})"; return 1
        fi ;;
      --network=*) network_mode="${arg#--network=}" ;;
      --help|-h) _start_usage; return 0 ;;
      *) echo "  ✗ $(_t '알 수 없는 옵션: {arg}' arg="$arg")"; _start_usage; return 1 ;;
    esac
    i=$((i+1))
  done

  # 접근 범위: 옵션 → 환경변수(VT_NETWORK_MODE) → 직전에 start가 남긴 기록 → all.
  # (restart가 옵션 없이 다시 start해도 이전 범위를 그대로 이어가도록)
  [ -n "$network_mode" ] || network_mode="${VT_NETWORK_MODE:-}"
  if [ -z "$network_mode" ] && [ -f "$PID_DIR/network_mode" ]; then
    network_mode="$(cat "$PID_DIR/network_mode" 2>/dev/null)"
  fi
  [ -n "$network_mode" ] || network_mode="all"
  case " $_NETWORK_MODES " in
    *" $network_mode "*) ;;
    *) echo "  ✗ $(_t '지원되지 않는 --network 범위: {mode}' mode="$network_mode") (${_NETWORK_MODES// /|})"; return 1 ;;
  esac
  export VT_NETWORK_MODE="$network_mode"

  if [ "$network_mode" = "all" ]; then
    _require_auth_for_public "$want_force" || return 1
  fi
  [ $want_safe -eq 1 ] && export VT_SAFE_MODE=1

  local tag=" [network=$network_mode]"
  [ $want_safe -eq 1 ] && tag="${tag} (SAFE)"
  echo ""
  echo "  🚀 fsh start — $(_t '전체 시작')${tag}"
  echo ""

  local was_running=0
  _port_in_use "$VT_PORT" && was_running=1
  _start_server || return 1
  if [ $was_running -eq 1 ]; then
    local prev_mode=""
    [ -f "$PID_DIR/network_mode" ] && prev_mode="$(cat "$PID_DIR/network_mode" 2>/dev/null)"
    if [ -n "$prev_mode" ] && [ "$prev_mode" != "$network_mode" ]; then
      echo "  ⚠ $(_t "서버가 이미 '{prev}' 범위로 실행 중이라 '{new}'는 아직 적용되지 않았습니다." prev="$prev_mode" new="$network_mode")"
      echo "    $(_t '적용하려면: fsh restart --network {mode}' mode="$network_mode")"
    fi
  else
    printf '%s\n' "$network_mode" > "$PID_DIR/network_mode"
  fi

  case "$network_mode" in
    localhost) echo "  ⓘ $(_t 'localhost 범위: 이 맥에서만 접속 가능 (터널 없음)')" ;;
    lan)       echo "  ⓘ $(_t 'lan 범위: 같은 네트워크에서만 접속 가능 (터널 없음)')" ;;
    tailscale)
      if ! _mode_access_url tailscale >/dev/null; then
        echo "  ✗ $(_t "tailscale 미실행/미설치. 'tailscale up' 먼저 실행하세요")"
        return 1
      fi
      echo "  ⓘ $(_t 'tailscale 범위: 같은 tailnet에서만 접속 가능 (터널 없음, 회사망에서도 안전)')" ;;
    all) _start_tunnel ;;
  esac
  if [ "$network_mode" != "all" ] && [ -n "$(_main_tunnel_pids)" ]; then
    if vt_is_en; then
    echo "  ⚠ The public tunnel (cloudflared) is still running. The access scope is narrower now, but the"
    echo "    tunnel process is still up — run 'fsh stop' and start again to shut it down."
    else
    echo "  ⚠ 공개 터널(cloudflared)이 아직 실행 중입니다. 접근 범위는 좁혀졌지만 터널 프로세스는"
    echo "    남아 있으니, 끄려면 'fsh stop' 후 다시 시작하세요."
    fi
  fi

  if [ $want_voice -eq 1 ]; then
    _start_voice_daemon
  else
    echo "ⓘ $(_t "음성은 기본으로 안 켭니다 — 필요하면 'fsh start --voice' 또는 'fsh voice'")"
  fi

  echo ""
  echo "  $(_t '모든 서비스 시작 완료.')"
  echo "  $(_t 'fsh status 로 상태 확인 · fsh mobile 로 폰 접속 QR')"
  echo ""
}

cmd_mobile() {
  # 폰으로 접속할 URL과 QR을 보여준다. 서버·터널은 시작하지 않는다 — 그건 `fsh start`.
  # 옵션: --e2e              E2E 암호화로 열기(URL hash에 #e2e=1 — 서버 로그에 안 남는다)
  #       --session <이름>   폰이 열릴 때 이 tmux 세션을 바로 보도록(#tmux=<이름>)
  #       --temp             이 QR로 등록되는 기기를 1일짜리 임시 기기로(남의 폰에 잠깐 열어 줄 때)
  #
  # 호환: 예전엔 이 명령이 서버까지 시작해서 --network/--safe/--force를 받았다. 그 옵션은
  # `fsh start`로 옮겼지만, 옛 스크립트(부팅 자동 시작 등)가 깨지지 않게 받으면
  # `fsh start`를 대신 실행한 뒤 QR을 보여준다.
  local want_e2e=0 want_temp=0 session=""
  local legacy=()
  local args=("$@") i=0
  while [ $i -lt ${#args[@]} ]; do
    local arg="${args[$i]}"
    case "$arg" in
      --e2e) want_e2e=1 ;;
      --temp) want_temp=1 ;;
      --session) i=$((i+1)); session="${args[$i]:-}" ;;
      --session=*) session="${arg#--session=}" ;;
      --network) legacy+=("$arg" "${args[$((i+1))]:-}"); i=$((i+1)) ;;
      --network=*|--safe|--force) legacy+=("$arg") ;;
      --help|-h)
        echo ""
        if vt_is_en; then
        echo "  Usage: fsh mobile [--e2e] [--session <tmux-session>] [--temp]"
        echo "    Shows the URL and QR code for your phone. The server must be running (fsh start)."
        echo "    --e2e       Open with E2E encryption"
        echo "    --session   Open this tmux session right away on the phone"
        echo "    --temp      Devices registered with this QR expire after 1 day (for a quick look on someone else's phone)"
        else
        echo "  사용법: fsh mobile [--e2e] [--session <tmux세션>] [--temp]"
        echo "    폰으로 접속할 URL과 QR을 보여줍니다. 서버가 떠 있어야 합니다(fsh start)."
        echo "    --e2e       E2E 암호화로 열기"
        echo "    --session   폰이 열릴 때 이 tmux 세션을 바로 보기"
        echo "    --temp      이 QR로 등록되는 기기는 1일 뒤 만료(남의 폰에 잠깐 열어 줄 때)"
        fi
        echo ""
        return 0 ;;
      *) echo "  ✗ $(_t '알 수 없는 옵션: {arg}' arg="$arg") (fsh mobile --help)"; return 1 ;;
    esac
    i=$((i+1))
  done
  if [ -n "$session" ] && ! [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "  ✗ $(_t 'tmux 세션 이름이 올바르지 않습니다: {session}' session="$session")"
    return 1
  fi

  if [ ${#legacy[@]} -gt 0 ]; then
    echo ""
    echo "  ⓘ $(_t "{opts} 는 이제 'fsh start' 옵션입니다. 'fsh start {opts}'를 실행한 뒤 QR을 보여드립니다." opts="${legacy[*]}")"
    cmd_start "${legacy[@]}" || return $?
  elif ! _port_in_use "$VT_PORT"; then
    echo ""
    echo "  ✗ $(_t "서버가 실행 중이 아닙니다. 먼저 'fsh start'로 시작하세요.")"
    echo "    $(_t "(폰 접속 URL과 QR은 서버가 떠 있을 때 'fsh mobile'로 봅니다)")"
    echo ""
    return 1
  fi

  local mode url
  mode="$(_current_network_mode)"
  url="$(_mode_access_url "$mode")"
  if [ -z "$url" ]; then
    echo ""
    if [ "$mode" = "all" ]; then
      echo "  ✗ $(_t "공개 접속 주소를 찾지 못했습니다 — 터널이 실행 중이 아닙니다. 'fsh start'를 실행하세요.")"
    else
      echo "  ✗ $(_t "'{mode}' 범위의 접속 주소를 찾지 못했습니다. (tailscale 미연결 등) 'fsh status'로 확인하세요." mode="$mode")"
    fi
    echo ""
    return 1
  fi

  # 상시 토큰 대신 1회용 기기 등록 티켓(5분)을 싣는다. QR을 띄우는 시점에 이 맥에
  # 대한 물리적 접근이 이미 증명됐으므로 스캔 = 기기 등록 승인으로 본다. 상시 토큰을
  # URL에 박던 예전 방식은 그 값이 로그·히스토리·QR 이미지에 영구히 남는 문제가 있었다.
  local ticket full_url="$url" ticket_label="mobile"
  [ -n "$session" ] && ticket_label="handoff"
  if [ $want_temp -eq 1 ]; then
    ticket="$(_issue_ticket "$ticket_label" temp)"
  else
    ticket="$(_issue_ticket "$ticket_label")"
  fi
  [ -n "$ticket" ] && full_url="${full_url}?ticket=${ticket}"
  # hash fragment는 서버 로그에 남지 않는다. 프런트가 URLSearchParams로 읽으므로 &로 잇는다.
  local frag=""
  [ -n "$session" ] && frag="tmux=${session}"
  [ $want_e2e -eq 1 ] && frag="${frag:+$frag&}e2e=1"
  [ -n "$frag" ] && full_url="${full_url}#${frag}"

  echo ""
  echo "  📱 fsh mobile — $(_t '폰 접속') [network=$mode]"
  echo ""
  echo "  ┌─────────────────────────────────────────┐"
  echo "  │  URL: $full_url"
  echo "  │                                         │"
  if vt_is_en; then
  echo "  │  Open the URL above in your phone       │"
  echo "  │  browser to auto-connect to tmux        │"
  else
  echo "  │  폰 브라우저에서 위 URL을 열면             │"
  echo "  │  tmux 세션에 자동 연결됩니다               │"
  fi
  [ -n "$session" ] && echo "  │  $(_t 'tmux 세션: {session}' session="$session")"
  if [ $want_e2e -eq 1 ]; then
  echo "  │                                         │"
  if vt_is_en; then
  echo "  │  🔒 E2E encryption mode                 │"
  echo "  │     The tunnel cannot see plaintext     │"
  else
  echo "  │  🔒 E2E 암호화 모드                        │"
  echo "  │     터널이 평문을 볼 수 없음               │"
  fi
  fi
  if [ $want_temp -eq 1 ] && [ -n "$ticket" ]; then
  echo "  │                                         │"
  if vt_is_en; then
  echo "  │  ⏱ Temp registration: devices added    │"
  echo "  │     with this QR expire in 1 day        │"
  else
  echo "  │  ⏱ 임시 등록: 이 QR로 등록한 기기는       │"
  echo "  │     1일 뒤 만료됩니다                      │"
  fi
  fi
  echo "  │                                         │"
  if vt_is_en; then
  echo "  │  🎧 Voice-only mode: tap the 🎧 button  │"
  echo "  │  🔄 Hands-free: tap the 🔄 button       │"
  else
  echo "  │  🎧 음성 전용 모드: 🎧 버튼 탭            │"
  echo "  │  🔄 핸즈프리: 🔄 버튼 탭                  │"
  fi
  echo "  │                                         │"
  echo "  │  종료: fsh stop                          │"
  echo "  └─────────────────────────────────────────┘"
  echo ""

  # QR 코드 (qrencode 설치 시)
  if command -v qrencode >/dev/null 2>&1; then
    echo "  $(_t 'QR 코드:')"
    qrencode -t UTF8 "$full_url" 2>/dev/null || true
  fi

  # adb 연결 시 자동 열기
  if adb devices 2>/dev/null | grep -q "device$"; then
    echo "  📱 $(_t 'Android 기기 감지. Chrome에서 열기...')"
    adb shell am start -a android.intent.action.VIEW -d "$full_url" com.android.chrome 2>/dev/null || true
  fi
}

# 메인 터미널 선택: fsh terminal [set <앱>|unset]. 값은 ~/.vt.env의 VT_TERMINAL.
# 창을 여는 명령(fsh attach / handoff desktop)이 이 값을 먼저 따른다.
# 선택지·설치 여부는 server/terminal_open.py가 정한다 (웹과 같은 판정, 단일 출처).
_terminal_py() { (cd "$VT_DIR/server" && "$VT_PYTHON" -m terminal_open "$@" 2>/dev/null); }

# 앱 이름 -> 설치 여부(0=있음).
_terminal_installed() {
  case " $(_terminal_py --installed) " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

cmd_terminal() {
  local sub="${1:-show}" val
  local _TERMINAL_CHOICES
  _TERMINAL_CHOICES="$(_terminal_py --choices)"
  [ -n "$_TERMINAL_CHOICES" ] || _TERMINAL_CHOICES="auto ghostty iterm terminal wezterm warp kitty alacritty"
  case "$sub" in
    show|"")
      local cur="${VT_TERMINAL:-auto}"
      echo ""
      echo "  🖥  $(_t '메인 터미널: {cur}' cur="$cur")"
      local c inst=""
      for c in $_TERMINAL_CHOICES; do
        [ "$c" = "auto" ] && continue
        _terminal_installed "$c" && inst="$inst $c"
      done
      echo "  $(_t '설치됨:')${inst:- $(_t '(없음)')}"
      if [ "$cur" != "auto" ] && ! _terminal_installed "$cur"; then
        echo "  ⚠ $(_t "'{cur}'은(는) 설치돼 있지 않아 자동 선택으로 열립니다." cur="$cur")"
      fi
      echo "  $(_t '변경: fsh terminal set <{choices}>   (되돌리기: fsh terminal unset)' choices="${_TERMINAL_CHOICES// /|}")"
      echo ""
      ;;
    set)
      val="$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')"
      if [ -z "$val" ]; then
        echo "  ✗ $(_t '값이 비었습니다') (${_TERMINAL_CHOICES// /|})"; return 1
      fi
      case " $_TERMINAL_CHOICES " in
        *" $val "*) ;;
        *) echo "  ✗ $(_t "지원하지 않는 터미널: '{val}'" val="${2:-}") (${_TERMINAL_CHOICES// /|})"; return 1 ;;
      esac
      if [ "$val" != "auto" ] && ! _terminal_installed "$val"; then
        echo "  ✗ $(_t "'{val}'이(가) 설치돼 있지 않습니다. 설치된 앱: fsh terminal" val="$val")"
        return 1
      fi
      vt_env_set VT_TERMINAL "$val" || return 1
      echo "  ✓ $(_t "메인 터미널을 '{val}'(으)로 설정했습니다 (다음 창 열기부터 적용)" val="$val")"
      ;;
    unset)
      vt_env_unset VT_TERMINAL && echo "  ✓ $(_t '메인 터미널 설정을 지웠습니다 (자동 선택)')"
      ;;
    *)
      echo "$(_t '사용법: fsh terminal [show|set <{choices}>|unset]' choices="${_TERMINAL_CHOICES// /|}")"
      return 1
      ;;
  esac
}

# Wave 1 W1-3: 임의 tmux 세션을 새 OS 터미널 창에서 attach
cmd_attach() {
  local target="${1:-}"

  if [ -z "$target" ]; then
    # 인자 없으면 세션 목록 표시 후 선택
    if ! "${TMUX_BASE[@]}" list-sessions >/dev/null 2>&1; then
      echo "  ⓘ $(_t "tmux 세션 없음. 'fsh voice' 또는 'fsh start'로 시작하세요.")"
      return 1
    fi
    echo ""
    echo "  📂 $(_t 'tmux 세션 (fsh 소켓):')"
    echo ""
    "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}  (#{session_windows} window, #{session_attached} attached)" 2>/dev/null
    echo ""
    if command -v fzf >/dev/null 2>&1; then
      target=$("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' 2>/dev/null | fzf --prompt="attach which? > " --height=40% 2>/dev/null || true)
    else
      printf "  $(_t '세션 이름을 입력하세요:') "
      read -r target
    fi
    [ -z "$target" ] && return 0
  fi

  # 세션 이름 안전성 검증 — 셸/AppleScript 인젝션 방어
  if ! [[ "$target" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "  ✗ $(_t "안전하지 않은 세션 이름: '{target}'" target="$target")"
    echo "  $(_t '영숫자/dash/underscore만 허용됩니다.')"
    return 1
  fi

  # 세션 존재 확인
  if ! "${TMUX_BASE[@]}" has-session -t "$target" 2>/dev/null; then
    echo "  ✗ $(_t "tmux 세션 '{target}' 없음" target="$target")"
    echo ""
    echo "  $(_t '사용 가능한 세션:')"
    "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}" 2>/dev/null || echo "    $(_t '(없음)')"
    return 1
  fi

  # 이미 tmux 안이면 switch-client
  if [ -n "${TMUX:-}" ]; then
    "${TMUX_BASE[@]}" switch-client -t "$target"
    echo "  ✓ $(_t "현재 tmux 클라이언트를 '{target}'으로 전환" target="$target")"
    return 0
  fi

  # 새 OS 터미널 창에 attach (W1-3)
  _open_tmux_terminal_with "$target"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "  ✓ $(_t "새 터미널 창에 tmux 세션 '{target}' attach" target="$target")"
  elif [ "$rc" -eq 2 ]; then
    : # 이미 열려 있음 — 안내 메시지는 _tmux_already_open이 이미 출력했다.
  else
    echo "  ⓘ $(_t '터미널 자동 오픈 실패. 수동:')"
    echo "      tmux -L $VT_TMUX_SOCKET attach -t $target"
    _autoopen_failure_hint
    return 1
  fi
}

# Wave 2 W2-5: 토픽별 도움말
cmd_help() {
  local topic="${1:-}"
  local docs_dir="$VT_DIR/docs/help"
  local ko_dir="$docs_dir"
  # 영어면 docs/help/en/ 의 번역본을 먼저 본다. 없는 토픽은 한국어 원본으로 떨어진다.
  if vt_is_en && [ -d "$docs_dir/en" ]; then docs_dir="$docs_dir/en"; fi

  if [ -z "$topic" ]; then
    if vt_is_en; then cat <<'HELP_EN'

  fsh — FarShell CLI    (details: fsh help <topic>  ·  per-command help: fsh help <command>)

  Start and connect
    fsh start [--network <scope>] [--safe] [--voice]
                            Start server + access path (default: public tunnel + auth)
                            scope: all | tailscale | lan | localhost
    fsh restart [options]   Restart the server only — the access URL stays the same (use this to pick up code/config changes)
    fsh stop [--purge]      Stop (--purge: tmux too / --keep-tunnel: server only)
    fsh status              Server, tunnel and access security (scope, auth, OTP, devices)
    fsh mobile [--e2e] [--session <name>] [--temp]
                            Phone URL + QR (while the server is running; --temp: devices registered with this QR expire after 1 day)
    fsh tunnel <action>     Manage tunnels: list · expose/unexpose · pin · mode · setup/teardown/switch
                            · hook · restart · watchdog · status
    fsh doctor              Diagnose install/environment (doctor paste: paste-in diagnosis)

  Sessions and terminal
    fsh attach [name]       Attach a tmux session in a new terminal window
    fsh handoff mobile|desktop
                            Hand the current session to your phone (= mobile --session) / to the Mac terminal
    fsh terminal            Show/choose the main terminal used to open windows (fsh terminal set ghostty)
    fsh ssh [session]       Show the command to SSH into this Mac (Tailscale); doesn't run it
    fsh shell-init <shell>  Print the shell init snippet
    fsh install-profiles    Register terminal app profiles
    fsh setup-keybind       Register the tmux popup shortcut
    fsh popup <action>      Quick-call fsh commands from a tmux popup
    fsh manage              TUI management tool (sessions/targets/hotkeys/state)  (alias: tui)

  Voice and input
    fsh voice               Voice mode (in the background, even while you work in Notion)
    fsh voice-target        Lock/unlock the voice daemon's target session
    fsh hotkey              Show/change hotkeys
    fsh clip                Clipboard sync daemon (Mac clipboard → web)

  Agents and tasks
    fsh hooks               Register/show/dedupe Claude Code and Codex hooks (required for status badges and the queue)
    fsh pane report         Report this pane's state to the server (for agents without hooks)
                            With --agent <name>, the agent detection coverage
                            raises that CLI to "self-reported · high"
    fsh queue               Prompt queue — stack instructions while the agent is busy and feed them in order
    fsh delegate            List/close agent delegations (ls|close <id>)
    fsh migrate-auth        Migrate permissions to the authz store (--dry-run|--apply|--verify|--status)
    fsh msg                 Messages between agents (log / agents / send)
    fsh mcp                 MCP server (stdio) for agents — register it with Claude
    fsh worktree            Create/open/delete git worktrees (alias: wt)
    fsh run "…"             Run headless claude -p in the background + notify when done
    fsh template            Save/apply CLAUDE.md templates
    fsh usage               Record/show cumulative usage (local LLMs etc.)
    fsh clauth              Show usage (clauth integration, read-only)

  Security and other Macs
    fsh password [clear]    Set/clear the web login password
    fsh otp                 Require an OTP when registering a new device (status / setup / disable)
    fsh device              List registered devices · rename · revoke (lost phone) · clean up expired ones (prune)
    fsh host                Pair with FarShell on another Mac (alias: hosts)
    fsh files               File store + share links
    fsh git-account         git account store

  Help
    fsh help <topic|command> The topics below, or a command name (start, mobile, attach …)
HELP_EN
    else cat <<'HELP'

  fsh — FarShell CLI    (자세한 설명: fsh help <토픽>  ·  명령별 도움말: fsh help <명령>)

  시작과 접속
    fsh start [--network <범위>] [--safe] [--voice]
                            서버 + 접속 경로 시작 (기본: 공개 터널 + 인증)
                            범위: all | tailscale | lan | localhost
    fsh restart [옵션]      서버만 재기동 — 접속 주소는 유지됨 (코드·설정 반영은 이걸로)
    fsh stop [--purge]      종료 (--purge: tmux까지 / --keep-tunnel: 서버만)
    fsh status              서버·터널·접속 보안(범위·인증·OTP·기기) 상태
    fsh mobile [--e2e] [--session <이름>] [--temp]
                            폰 접속 URL + QR (서버가 떠 있을 때, --temp: 이 QR로 등록한 기기는 1일 뒤 만료)
    fsh tunnel <동작>       터널 관리: list · expose/unexpose · pin · mode · setup/teardown/switch
                            · hook · restart · watchdog · status
    fsh doctor              설치/환경 진단 (doctor paste: 붙여넣기 진단)

  세션과 터미널
    fsh attach [name]       tmux 세션을 새 터미널 창에 붙임
    fsh handoff mobile|desktop
                            현재 세션을 폰으로(= mobile --session) / 맥 터미널로
    fsh terminal            창을 열 때 쓸 메인 터미널 확인/선택 (fsh terminal set ghostty)
    fsh ssh [session]       이 맥에 SSH(Tailscale)로 붙는 명령 안내 (실행은 안 함)
    fsh shell-init <셸>     셸 init 스니펫 출력
    fsh install-profiles    터미널 앱 프로필 등록
    fsh setup-keybind       tmux popup 단축키 등록
    fsh popup <동작>        tmux popup으로 fsh 명령 빠른 호출
    fsh manage              TUI 관리 도구 (세션/타깃/핫키/상태)  (별칭: tui)

  음성과 입력
    fsh voice               음성 모드 (백그라운드, 노션 작업 중에도)
    fsh voice-target        음성 daemon 타깃 세션 lock/해제
    fsh hotkey              핫키 조회/변경
    fsh clip                클립보드 동기화 데몬 (맥 클립보드 → 웹)

  에이전트와 작업
    fsh hooks               Claude Code·Codex 훅 등록/조회/dedupe (상태 배지·큐의 전제)
    fsh pane report         이 pane의 상태를 서버에 보고 (훅 없는 에이전트용)
                            --agent <이름>을 함께 주면 설정 → 에이전트의 감지
                            커버리지가 그 CLI를 「자기보고 · 높음」으로 올린다
    fsh queue               프롬프트 큐 — 작업 중일 때 지시를 쌓아뒀다 순차 투입
    fsh delegate            에이전트 위임 목록·닫기 (ls|close <id>)
    fsh migrate-auth        권한 저장소 이전 (--dry-run|--apply|--verify|--status)
    fsh msg                 에이전트 간 메시지 (log / agents / send)
    fsh mcp                 에이전트용 MCP 서버(stdio) — Claude에 등록해 쓴다
    fsh worktree            git 워크트리 만들기/열기/삭제 (별칭: wt)
    fsh run "…"             헤드리스 claude -p 백그라운드 실행 + 완료 알림
    fsh template            CLAUDE.md 템플릿 저장/적용
    fsh usage               누적 사용량 기록/조회 (로컬 LLM 등)
    fsh clauth              사용량 조회 (clauth 연동, 읽기 전용)

  보안과 다른 맥
    fsh password [clear]    웹 로그인 비밀번호 설정/해제
    fsh otp                 새 기기 등록 시 OTP 요구 (status / setup / disable)
    fsh device              등록된 기기 조회 · 이름 변경 · 폐기 (폰 분실 시) · 만료 기기 정리 (prune)
    fsh host                다른 맥의 FarShell과 페어링 (별칭: hosts)
    fsh files               파일 저장소 + 공유 링크
    fsh git-account         git 계정 저장소

  도움말
    fsh help <토픽|명령>    아래 토픽, 또는 명령 이름(start, mobile, attach …)
HELP
    fi
    echo ""
    echo "  $(_t '도움말 토픽:')"
    local f t d
    for f in "$docs_dir"/*.md; do
      [ -f "$f" ] || continue
      t="$(basename "$f" .md)"
      # 첫 줄 제목("# fsh help <토픽> — 설명")에서 설명만 뽑는다. 토픽이 늘어도 이 목록은 저절로 따라간다.
      d="$(head -1 "$f" | sed -E 's/^#+ *//; s/^fsh help [a-z-]+ *— *//')"
      printf "    fsh help %-14s %s\n" "$t" "$d"
    done
    echo ""
    return 0
  fi

  # 명령 이름으로도 찾을 수 있게 — 명령은 토픽 문서가 설명하는 쪽으로 연결한다.
  case "$topic" in
    start|restart|stop|status|mobile|password|otp|device|devices) topic="access" ;;
    attach|handoff|terminal) topic="terminal" ;;
    hooks|pane|queue|msg|mcp|delegate) topic="agent-state" ;;
    voice-target) topic="target" ;;
    hotkey) topic="hotkeys" ;;
  esac

  local file="$docs_dir/${topic}.md"
  [ -f "$file" ] || file="$ko_dir/${topic}.md"
  if [ -f "$file" ]; then
    if command -v less >/dev/null 2>&1 && [ -t 1 ]; then
      less -R "$file"
    else
      cat "$file"
    fi
  else
    local names
    names="$(for f in "$docs_dir"/*.md; do basename "$f" .md; done | tr '\n' ' ')"
    echo "  ✗ $(_t "도움말 토픽 '{topic}' 없음" topic="$topic")"
    echo "  $(_t '토픽 목록: {names}' names="$names")"
    return 1
  fi
}

# A0: Claude Code·Codex 훅 등록/조회/해제.
# 실제 병합 로직은 server/{claude,codex}_hooks.py에 있다 — 설정을 sed로 만지는 건
# 남의 설정 파일을 망가뜨리는 가장 빠른 길이라, 파싱·백업·원자적 쓰기를 전부
# 파이썬 쪽에 두고 여기서는 부르기만 한다(lib/vt_env.sh가 ~/.vt.env를
# echo/sed로 못 만지게 막아둔 것과 같은 이유).
# ~/.codex/hooks.json 에 복제된 FarShell 훅(Codex 앱 「Claude 설정 가져오기」) 경고.
# $1=full 이면 이벤트 목록까지, short 이면 한 줄. 중복이 없으면 아무것도 안 낸다.
_hooks_dup_warn() {
  local mode="${1:-full}" py="${VT_PYTHON:-python3}" dups n dpath
  dups="$("$py" "$VT_DIR/server/codex_hooks.py" duplicates 2>/dev/null)" || return 0
  [ -z "$dups" ] && return 0
  n="$(printf '%s\n' "$dups" | grep -c .)"
  dpath="$("$py" -c 'import sys; sys.path.insert(0, sys.argv[1]); import codex_hooks as c; print(c.display_path(c.hooks_json_path()))' "$VT_DIR/server" 2>/dev/null)"
  dpath="${dpath:-~/.codex/hooks.json}"
  echo ""
  echo "  ⚠ $(_t '{path} 에 FarShell 훅 {n}개가 중복 등록돼 있습니다 — Codex 세션 이벤트가 두 번(claude 태그 포함) 들어옵니다.' path="$dpath" n="$n")"
  if [ "$mode" = "full" ]; then
    local ev args tag
    while IFS=$'\t' read -r ev args tag; do
      [ -z "$ev" ] && continue
      printf "      %-18s agent_hook.sh %s\n" "$ev" "$args"
    done <<< "$dups"
  fi
  echo "    $(_t '제거: fsh hooks dedupe')"
}

cmd_hooks() {
  local sub="${1:-status}"
  local py="${VT_PYTHON:-python3}"
  case "$sub" in
    status|list|"")
      echo ""
      echo "  🪝 fsh hooks — $(_t '에이전트 훅 등록 상태')"
      echo ""
      local out rc
      out="$("$py" "$VT_DIR/server/claude_hooks.py" status 2>&1)"; rc=$?
      if [ "$rc" = "2" ]; then
        echo "  ✗ $out"
        return 1
      fi
      local line event state cur
      while IFS=$'\t' read -r event state cur; do
        [ -z "$event" ] && continue
        case "$state" in
          ok)     printf "  ✓ %-14s %s\n" "$event" "$cur" ;;
          add)    printf "  ✗ %-14s %s\n" "$event" "$(_t '미등록')" ;;
          update) printf "  ⚠ %-14s %s\n" "$event" "$(_t '다른 경로/스크립트: {cur}' cur="$cur")" ;;
        esac
      done <<< "$out"
      local claude_rc="$rc" codex_out codex_rc
      echo ""
      echo "  Codex"
      codex_out="$("$py" "$VT_DIR/server/codex_hooks.py" status 2>&1)"; codex_rc=$?
      if [ "$codex_rc" = "2" ]; then
        echo "  ✗ $codex_out"
      else
        while IFS=$'\t' read -r event state cur; do
          [ -z "$event" ] && continue
          case "$state" in
            ok)     printf "  ✓ %-18s %s\n" "$event" "$cur" ;;
            add)    printf "  ✗ %-18s %s\n" "$event" "$(_t '미등록')" ;;
            update) printf "  ⚠ %-18s %s\n" "$event" "$(_t '다른 경로/스크립트: {cur}' cur="$cur")" ;;
          esac
        done <<< "$codex_out"
      fi
      _hooks_dup_warn full
      # 등록돼 있다고 **동작하는 것은 아니다.** 훅은 Claude를 막으면 안 되므로
      # 실패해도 조용히 넘어가는데, 그래서 인증이 막히면 아무도 모른 채 죽는다 —
      # 실제로 `POST /api/agent/event`가 1,440번 전부 401이었고(2026-09-17)
      # 그동안 상태 배지·큐 자동 투입이 통째로 멎어 있었다. 훅이 마지막 실패를
      # 남기게 했으니(~/.vt/hook-last-error) 여기서 그걸 읽어 보여준다.
      local errfile="$HOME/.vt/hook-last-error"
      if [ -f "$errfile" ]; then
        local ev reason
        IFS=$'\t' read -r ev reason < "$errfile"
        echo ""
        echo "  ⚠ $(_t '마지막 훅 전송이 실패했습니다 — 등록은 됐지만 서버에 닿지 못합니다.')"
        printf "      %s\n" "$(_t '{ev} 이벤트: {reason}' ev="${ev:-?}" reason="${reason:-$(_t '알 수 없음')}")"
        case "$reason" in
          *401*|*403*) echo "      → $(_t '인증 문제입니다. ~/.vt.env의 VT_AUTH_TOKEN을 확인하세요.')" ;;
          *연결*)       echo "      → $(_t '서버가 떠 있지 않을 수 있습니다: fsh status')" ;;
        esac
      fi
      echo ""
      if [ "$claude_rc" != "0" ] || [ "$codex_rc" != "0" ]; then
        echo "  → $(_t '등록: fsh hooks install')"
      else
        echo "  → $(_t '해제: fsh hooks uninstall')"
      fi
      echo ""
      ;;
    install)
      echo ""
      echo "  🪝 $(_t 'Claude Code · Codex 훅 등록')"
      echo ""
      "$py" "$VT_DIR/server/claude_hooks.py" install
      "$py" "$VT_DIR/server/codex_hooks.py" install
      _hooks_dup_warn short
      echo ""
      ;;
    dedupe)
      shift
      local dry=""
      case "${1:-}" in
        "") ;;
        --dry-run) dry="--dry-run" ;;
        *) echo "  $(_t '사용법: fsh hooks dedupe [--dry-run]')"; return 1 ;;
      esac
      echo ""
      echo "  🪝 $(_t 'Codex hooks.json 의 FarShell 중복 훅 제거')${dry:+ (dry-run)}"
      echo ""
      "$py" "$VT_DIR/server/codex_hooks.py" dedupe $dry
      local drc=$?
      echo ""
      return $drc
      ;;
    uninstall|remove)
      echo ""
      echo "  🪝 $(_t 'Claude Code · Codex 훅 해제')"
      echo ""
      "$py" "$VT_DIR/server/claude_hooks.py" uninstall
      "$py" "$VT_DIR/server/codex_hooks.py" uninstall
      echo ""
      ;;
    *)
      echo "  $(_t '사용법: fsh hooks [status|install|uninstall|dedupe [--dry-run]]')"
      return 1
      ;;
  esac
}

# Wave 2 W2-2: 핫키 조회/변경
cmd_hotkey() {
  local sub="${1:-list}"
  local env_file="$HOME/.vt.env"

  case "$sub" in
    list|"")
      echo ""
      echo "  ⌨  fsh hotkey — $(_t '현재 핫키 설정')"
      echo ""
      local voice_hotkey
      voice_hotkey="$(vt_env_get VT_HOTKEY_VOICE)"
      [ -z "$voice_hotkey" ] && voice_hotkey="ctrl+shift+m ($(_t '디폴트'))"
      local voice_disabled
      voice_disabled="$(vt_env_get VT_HOTKEY_VOICE_DISABLED)"
      local voice_state="$(_t '활성')"
      [ "$voice_disabled" = "true" ] && voice_state="$(_t '비활성 (DISABLED)')"
      echo "    voice ($(_t '음성 토글')):     $voice_hotkey  [$voice_state]"
      echo ""
      echo "  $(_t '변경: fsh hotkey set voice <ctrl+shift+x>')"
      echo "  $(_t '비활성: fsh hotkey disable voice')"
      echo "  $(_t '복구: fsh hotkey reset voice')"
      echo ""
      echo "  ⓘ $(_t "변경 후 'fsh stop && fsh voice'로 daemon 재시작 필요")"
      ;;
    set)
      local action="${2:-}"
      local value="${3:-}"
      if [ -z "$action" ] || [ -z "$value" ]; then
        echo "  $(_t '사용법: fsh hotkey set <action> <hotkey>')"
        echo "  $(_t '예시:   fsh hotkey set voice ctrl+shift+x')"
        return 1
      fi
      _hotkey_validate_action "$action" || return 1
      _hotkey_validate_spec "$value" || return 1
      vt_env_set "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')" "$value"
      echo "  ✓ $(_t '{action} 핫키 → {value}' action="$action" value="$value")"
      echo "  ⓘ $(_t 'daemon 재시작 필요: fsh stop && fsh voice')"
      ;;
    reset)
      local action="${2:-}"
      [ -z "$action" ] && { echo "  $(_t '사용법: fsh hotkey reset <action>')"; return 1; }
      _hotkey_validate_action "$action" || return 1
      vt_env_unset "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')"
      vt_env_unset "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')_DISABLED"
      echo "  ✓ $(_t '{action} 핫키 디폴트로 복구' action="$action")"
      ;;
    disable)
      local action="${2:-}"
      [ -z "$action" ] && { echo "  $(_t '사용법: fsh hotkey disable <action>')"; return 1; }
      _hotkey_validate_action "$action" || return 1
      vt_env_set "VT_HOTKEY_$(echo "$action" | tr '[:lower:]' '[:upper:]')_DISABLED" "true"
      echo "  ✓ $(_t '{action} 핫키 비활성화' action="$action")"
      ;;
    *)
      echo "  $(_t '사용법: fsh hotkey [list|set|reset|disable] [args]')"
      return 1
      ;;
  esac
}

# 액션 이름 화이트리스트 — sed/env 인젝션 방어
_hotkey_validate_action() {
  local a="$1"
  case "$a" in
    voice) return 0 ;;
    *)
      echo "  ✗ $(_t "지원되지 않는 action: '{a}' (지원: voice)" a="$a")"
      return 1
      ;;
  esac
}

# 핫키 spec 형식 검증 — alphanumeric + '+' 만 허용
_hotkey_validate_spec() {
  local s="$1"
  if [[ "$s" =~ ^[a-zA-Z0-9_+]+$ ]]; then
    return 0
  fi
  echo "  ✗ $(_t "잘못된 핫키 형식: '{s}' (예: ctrl+shift+m)" s="$s")"
  return 1
}

# ~/.vt.env 쓰기는 전부 lib/vt_env.sh의 vt_env_set / vt_env_unset로 일원화됐다.
# 이전엔 큰따옴표로 쓰는 setter와 홑따옴표로 쓰는 setter가 공존해서,
# 큰따옴표 쪽으로 $가 든 값(scrypt 해시 등)이 흘러가면 source 시 조용히 파괴됐다.
# 또 tmp 파일을 umask(644)로 만들어 mv하는 바람에 시크릿 파일 권한이 600→644로
# 강등됐다. 두 문제 모두 단일 구현에서 구조적으로 막는다.

# 웹 로그인 비밀번호 설정 — 원문은 저장/노출하지 않고 scrypt 해시만 ~/.vt.env에 기록.
# 세션 서명키(VT_SECRET_KEY)가 없으면 자동 생성. 기계 토큰 VT_TOKEN과는 독립.
# 프롬프트 큐 (P4) — 에이전트가 작업 중일 때 지시를 쌓아뒀다 순차 투입.
# 서버가 안 떠 있어도 동작하도록 queue_store.py CLI를 직접 호출한다(`-m auth`와 같은 방식).
cmd_queue() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  case "$sub" in
    list|ls|add|rm|remove|delete|clear|unblock|run|log)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && "$VT_PYTHON" queue_store.py "$sub" "$@")
      ;;
    *)
      echo "$(_t '사용법: fsh queue [list|add "내용" [세션]|rm <id>|unblock <id>|clear|run|log [id]]')"
      return 1 ;;
  esac
}

# 파일 저장소 CLI (N23, 50-files-share.md §6) — queue와 같은 방식으로 서버 없이도
# 동작한다(직접 file_store.py를 실행). share가 찍는 "/s/<token>" 경로 앞에 base URL을
# 붙이는 것만 여기서 한다 — 어느 게 진짜 공개 주소인지(터널이냐 로컬이냐)는
# bin/fsh가 이미 알고 있는 정보라 파이썬 쪽에 다시 물을 필요가 없다.
cmd_files() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-ls}"
  case "$sub" in
    ls|list|add|rm|share|unshare|insert)
      shift 2>/dev/null || true
      local base; base="$(_main_tunnel_url)"
      [ -z "$base" ] && base="http://localhost:${VT_PORT:-7777}"
      (cd "$VT_DIR/server" && "$VT_PYTHON" file_store.py "$sub" "$@") \
        | sed "s#^\(  ✓ [^:]*: \)/s/#\1${base}/s/#"
      ;;
    *)
      echo "$(_t '사용법: fsh files [ls|add <path> [--share 1h|24h|7d|30d] [--pin]|rm <id>|share <id> [--ttl 1h|24h|7d|30d] [--pin] [--once]|unshare <id>|insert <id>]')"
      return 1 ;;
  esac
}

# 멀티호스트 (N7/N39 1단계) — 맥 두 대의 farshell 서버를 페어링한다.
# queue/files와 같은 방식으로 서버 없이 동작하지만, pair/ping은 **상대 서버**가
# 떠 있어야 한다(내 서버는 필요 없다 — 나가는 요청만 하기 때문).
cmd_host() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  case "$sub" in
    list|ls|pair|add|ping|rm|remove|rename|allow-control|deny-control|allow-agent|deny-agent|log|revoke-all)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && "$VT_PYTHON" -m host_store "$sub" "$@")
      ;;
    help|-h|--help)
      _host_usage
      echo
      echo "$(_t '권한 변경 (allow-control / deny-control / allow-agent / deny-agent):')"
      echo "  $(_t '서버가 VT_AUTHZ_ENFORCE=peer 로 떠 있으면 이 명령은 서버에 변경을 요청합니다 (unix socket).')"
      echo "  $(_t '- deny-*: 접근을 줄이는 변경이라 바로 적용되고 감사 기록에 남습니다.')"
      echo "  $(_t '- allow-*: 접근을 늘리는 변경이라 승인 요청만 만들어집니다. 웹 화면의 승인함에서 사람이 승인해야 적용되고, 이 명령으로는 승인할 수 없습니다.')"
      echo "  $(_t '서버가 꺼져 있거나 소켓을 쓸 수 없거나 그 설정이 꺼져 있으면 예전처럼 ~/.vt/hosts.json 에 바로 씁니다.')"
      echo "  $(_t '주의: control(제어) 등급은 그 맥이 이 맥의 터미널에 명령을 칠 수 있다는 뜻입니다 — 원격 셸과 같습니다.')"
      return 0 ;;
    *)
      _host_usage
      return 1 ;;
  esac
}

_host_usage() {
  echo "$(_t '사용법: fsh host [list|pair [별명]|add <url> --ticket <티켓> [--label 별명]')"
  echo "                 $(_t '|ping <id>|rm <id>|rename <id|self> <별명>')"
  echo "                 |allow-control <id>|deny-control <id>"
  echo "                 |allow-agent <id>|deny-agent <id>|log [id]|revoke-all|help]"
}

# 에이전트 간 메시지 (2026-09-28) — `fsh mcp`는 에이전트가 쓰는 MCP 서버(stdio)를
# 띄우고, `fsh msg`는 같은 기능을 사람이 셸에서 쓰는 길이다(MCP가 없는 에이전트도
# 셸 명령으로 보낼 수 있다). 둘 다 서버(agent_msg.py)를 부르므로 서버가 떠 있어야 한다.
cmd_mcp() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")" >&2
    return 1
  fi
  # stdout은 MCP 채널이다 — 여기서 아무것도 찍지 않는다.
  cd "$VT_DIR/server" && VT_PORT="${VT_PORT:-7777}" exec "$VT_PYTHON" mcp_farshell.py
}

# 에이전트 위임 — queue와 같은 방식으로 서버 없이 장부를 읽는다.
cmd_delegate() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-ls}"
  case "$sub" in
    ls|list|close)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && "$VT_PYTHON" delegation.py "$sub" "$@")
      ;;
    *)
      echo "$(_t '사용법: fsh delegate [ls|close <id>]')"
      return 1 ;;
  esac
}

# 권한 저장소 이전 — 옛 grant·peer 등급·위임을 ~/.vt/authz/ 로 옮긴다.
# 서버 없이 동작한다(저장소 파일·tmux 만 읽는다). 기본은 --dry-run(아무것도 쓰지 않음).
cmd_migrate_auth() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  case "${1:---dry-run}" in
    --dry-run|--apply|--verify|--backup|--restore|--status|--json|--finalize)
      (cd "$VT_DIR/server" && "$VT_PYTHON" -m authz migrate-auth "$@")
      ;;
    *)
      echo "$(_t '사용법: fsh migrate-auth [--dry-run|--apply|--verify|--backup|--restore <ts>|--status] [--json]')"
      return 1 ;;
  esac
}

cmd_msg() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-log}"
  case "$sub" in
    send|log|ls|agents)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && VT_PORT="${VT_PORT:-7777}" FSH_MSG_USAGE="$(_t '사용법: fsh msg send <[호스트/]세션> "내용" [--reply <id>]')" "$VT_PYTHON" - "$sub" "$@" <<'PYEOF'
import os, sys
import mcp_farshell as m

sub, args = sys.argv[1], sys.argv[2:]
if sub == "send":
    reply = ""
    if "--reply" in args:
        i = args.index("--reply")
        reply = args[i + 1] if i + 1 < len(args) else ""
        args = args[:i] + args[i + 2:]
    if len(args) < 2:
        print("  " + os.environ.get("FSH_MSG_USAGE", ""), file=sys.stderr)
        sys.exit(2)
    text, err = m.tool_send_message({"to": args[0], "text": " ".join(args[1:]), "reply_to": reply})
elif sub == "agents":
    text, err = m.tool_list_agents({"fresh": True})
else:
    text, err = m.tool_read_messages({"conv": args[0] if args else "", "limit": 30})
print(("  ✗ " if err else "") + text)
sys.exit(1 if err else 0)
PYEOF
)
      ;;
    *)
      echo "$(_t '사용법: fsh msg [log [대화id]|agents|send <[호스트/]세션> "내용" [--reply <id>]]')"
      return 1 ;;
  esac
}

# 워크트리 (N8/N44, 30-worktree.md §5) — 서버 API(server/worktree.py)를 그대로
# 호출한다. queue와 같은 방식으로 서버가 안 떠 있어도 동작한다.
cmd_worktree() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  # `add`는 "지금 있는 저장소"를 대상으로 한다 — worktree.py가 server/ 안에서
  # 돌아가므로(아래 cd), 부모 셸의 cwd를 VT_WORKTREE_CWD로 명시해 넘긴다.
  local orig_cwd; orig_cwd="$(pwd)"
  case "$sub" in
    list|ls|add|rm|open)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && VT_WORKTREE_CWD="$orig_cwd" "$VT_PYTHON" worktree.py "$sub" "$@")
      ;;
    *)
      echo "$(_t '사용법: fsh worktree [list|add <name> [--base b] [--ports] [--copy-modules] [--agent claude]|rm <name> [--force]|open <name>]')"
      return 1 ;;
  esac
}

# N41(60-settings-palette.md §5) — 누적형 사용량 기록. 로컬 LLM 등 %가 없는
# 소스는 "얼마나 썼는지"를 아는 게 그 모델을 돌린 스크립트 자신뿐이라, 기록은
# 여기(CLI)나 POST /api/usage/counter로 사용자가 직접 넣는다 — 에이전트 훅에서
# 언제 부를지는 FarShell이 정하지 않는다. 서버 없이도 동작(queue와 같은 방식).
cmd_usage() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  case "$sub" in
    list|add)
      shift 2>/dev/null || true
      (cd "$VT_DIR/server" && "$VT_PYTHON" usage/counter_jsonl.py "$sub" "$@")
      ;;
    *)
      echo "$(_t '사용법: fsh usage [list|add --model <이름> --tokens <N> --seconds <N>]')"
      return 1 ;;
  esac
}

# A2: pane 자기보고. 관리형 훅이 없는 에이전트(aider/agy 등)의 폴백 —
# 그 pane들이 "나 지금 working이야"를 서버에 알릴 수 있는 유일한 경로다.
# tmux 안에서 실행해야 의미가 있다($TMUX_PANE/$TMUX를 그대로 실어 보낸다).
cmd_pane() {
  local sub="${1:-report}"
  case "$sub" in
    report)
      shift 2>/dev/null || true
      local state="working" agent=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --state) state="${2:-}"; shift 2 ;;
          --agent) agent="${2:-}"; shift 2 ;;
          -h|--help)
            echo "  $(_t '사용법: fsh pane report [--state idle|working|waiting|done] [--agent claude|codex|...]')"
            return 0 ;;
          *) echo "  ✗ $(_t '알 수 없는 옵션: {arg}' arg="$1")"; return 1 ;;
        esac
      done
      if [ -z "${TMUX_PANE:-}" ]; then
        echo "  ⚠ $(_t 'tmux pane 밖입니다 — pane id 없이 cwd로만 판정됩니다')"
      fi
      local resp
      resp="$("${VT_PYTHON:-python3}" - "$state" "$agent" "$VT_DIR/server" <<'PYEOF'
import json, os, sys

state, agent = sys.argv[1], sys.argv[2]
sys.path.insert(0, sys.argv[3])
port = os.environ.get("VT_PORT", "7777")
server = os.environ.get("VT_SERVER") or f"http://localhost:{port}"
body = {
    "state": state,
    "agent": agent or None,
    "pane": os.environ.get("TMUX_PANE"),
    "tmux": os.environ.get("TMUX"),
    "cwd": os.getcwd(),
}
token = os.environ.get("VT_AUTH_TOKEN") or os.environ.get("VT_TOKEN") or ""
try:
    # 소켓 우선(pane 안이면 서버가 peer pid 로 agent 를 안다), 없으면 TCP + 토큰.
    import fsh_client
    _, raw = fsh_client.call("POST", "/api/agent/report", body=body, timeout=3, svc="cli", server=server,
                             token=token, port=port, raise_for_status=True)
    data = json.loads(raw.decode("utf-8"))
    print(data.get("resolved_by", "?") if data.get("ok") else f"ERR {data.get('reason', data)}")
except Exception as e:
    print(f"ERR {e}")
PYEOF
)" || true
      case "$resp" in
        ERR*) echo "  ✗ $(_t '보고 실패: {reason} (서버가 실행 중인지 확인: fsh status)' reason="${resp#ERR }")"; return 1 ;;
        pane*) echo "  ✓ $(_t "'{state}' 보고 완료 — pane id로 정확히 매칭됨" state="$state")" ;;
        cwd*)  echo "  ✓ $(_t "'{state}' 보고 완료 — cwd로 매칭됨 (pane id 미확보)" state="$state")" ;;
        foreign-tmux*) echo "  ⚠ $(_t "'{state}' 보고했지만 세션 특정 실패 — 이 tmux는 FarShell 소켓(-L {socket})이 아닙니다" state="$state" socket="$VT_TMUX_SOCKET")" ;;
        ambiguous*) echo "  ⚠ $(_t "'{state}' 보고했지만 세션 특정 실패 — 같은 디렉토리에 세션이 여럿입니다" state="$state")" ;;
        *) echo "  ⚠ $(_t "'{state}' 보고했지만 세션을 특정하지 못했습니다" state="$state")" ;;
      esac
      ;;
    *)
      echo "  $(_t '사용법: fsh pane report [--state idle|working|waiting|done] [--agent <이름>]')"
      return 1 ;;
  esac
}

# U4: clauth 읽기 전용 래퍼. **전역 스위치(clauth <profile>)는 2.0에 넣지 않는다**
# — FarShell은 tmux 세션을 여러 개 띄우는 도구라, 세션 5개를 돌려놓고 전역을
# 바꾸면 기존 세션은 그대로고 새 세션만 바뀐다. 어느 세션이 어느 계정인지
# 알 수 없게 되고 폰에서 원격으로 볼 때 특히 치명적이다(60-usage-provider.md).
#
# 미설치는 **에러가 아니다** — clauth를 안 쓰는 환경이 정상이므로 안내 후 0으로 끝낸다.
cmd_clauth() {
  local sub="${1:-status}"
  local feed="${VT_CLAUTH_STATUS:-$HOME/.clauth/status.json}"

  if [ ! -f "$feed" ]; then
    echo ""
    echo "  ⓘ $(_t 'clauth 사용량 피드가 없습니다 ({feed})' feed="$feed")"
    echo "    $(_t 'clauth를 쓰지 않는 환경이면 정상입니다 — FarShell은 이 경우 사용량 UI를 숨깁니다.')"
    echo "    $(_t '쓰는데도 안 보이면: clauth 데몬이 떠 있는지 확인하세요.')"
    echo ""
    return 0
  fi

  case "$sub" in
    status|"")
      "${VT_PYTHON:-python3}" - "$feed" "$(vt_is_en && echo en || echo ko)" <<'PYEOF'
import json, sys, time
from datetime import datetime

path = sys.argv[1]
EN = len(sys.argv) > 2 and sys.argv[2] == "en"
try:
    with open(path) as f:
        d = json.load(f)
except Exception as e:
    print(f"  ✗ Couldn't read the feed: {e}" if EN else f"  ✗ 피드를 읽을 수 없습니다: {e}")
    raise SystemExit(0)

if d.get("schema") != 1:
    print(f"  ⚠ Unknown feed format (schema={d.get('schema')}) — check your clauth version" if EN else f"  ⚠ 모르는 피드 형식(schema={d.get('schema')}) — clauth 버전을 확인하세요")
    raise SystemExit(0)

def age(ts):
    try:
        return time.time() - datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None

a = age(d.get("generated_at"))
fresh = "" if a is None else (f"  (updated {a:.0f}s ago)" if EN else f"  ({a:.0f}초 전 갱신)")
print("")
print(f"  📊 clauth {'usage' if EN else '사용량'}{fresh}")
print(("  Active profile: " if EN else "  활성 프로필: ") + str(d.get('active_profile') or '?'))
print("")
for p in d.get("profiles") or []:
    live = " ●live" if p.get("has_live_session") else ""
    tier = f" [{p['tier']}]" if p.get("tier") else ""
    auth = "" if p.get("auth_status", "ok") == "ok" else (f"  ⚠ re-auth needed ({p['auth_status']})" if EN else f"  ⚠ 재인증 필요({p['auth_status']})")
    mark = "*" if p.get("active") else " "
    print(f"  {mark} {p.get('name','?')}{tier}{live}{auth}")
    wins = p.get("windows") or []
    if not wins:
        print("      " + ("No usage data" if EN else "사용량 정보 없음"))
    for w in wins:
        pct = w.get("utilization_pct") or 0
        filled = int(pct / 10)
        bar = "▓" * filled + "░" * (10 - filled)
        print(f"      {str(w.get('label','')):>3}  {bar} {pct:5.1f}%")
print("")
PYEOF
      ;;
    which)
      "${VT_PYTHON:-python3}" - "$feed" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(0)
print(d.get("active_profile") or "")
PYEOF
      ;;
    *)
      echo "  $(_t '사용법: fsh clauth [status|which]')"
      echo "  $(_t '(읽기 전용입니다 — 프로필 전환은 clauth 자체 명령을 쓰세요)')"
      return 1 ;;
  esac
}

cmd_password() {
  local env_file="$HOME/.vt.env"
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-set}"
  if [ "$sub" = "clear" ] || [ "$sub" = "disable" ]; then
    vt_env_unset "VT_AUTH_PASSWORD_HASH"
    vt_env_unset "VT_PASSWORD_HASH"   # 레거시 이름도 함께 정리
    echo "  ✓ $(_t '웹 로그인 비밀번호 해제 (VT_AUTH_PASSWORD_HASH 제거)')"
    echo "  ⓘ $(_t '서버 재시작 필요: fsh restart')"
    return 0
  fi
  local pw pw2
  printf "  %s " "$(_t '새 웹 로그인 비밀번호:')" >&2; read -rs pw; echo >&2
  printf "  %s " "$(_t '확인 입력:')" >&2; read -rs pw2; echo >&2
  if [ -z "$pw" ]; then echo "  ✗ $(_t '비밀번호가 비어 있습니다.')"; return 1; fi
  if [ "$pw" != "$pw2" ]; then echo "  ✗ $(_t '두 입력이 일치하지 않습니다.')"; return 1; fi
  if [ "${#pw}" -lt 6 ]; then echo "  ✗ $(_t '6자 이상이어야 합니다.')"; return 1; fi
  # 원문은 stdin으로만 python에 전달 → ps/argv/환경변수에 노출되지 않음.
  #
  # 같은 호출에서 **비ASCII를 먼저 거른다.** 웹 로그인 폼(frontend/js/gate.js)은
  # 한/영 상태와 무관하게 영문이 들어가도록 한글 IME 입력을 두벌식 매핑으로
  # 역변환하는데, 이 터미널 입력에는 그 변환이 없다. 그래서 한글이 섞인 채로
  # 설정하면 저장되는 해시는 한글 문자열이고 웹은 영문으로 바꿔 보내므로
  # **웹에서는 영원히 로그인할 수 없는 비밀번호**가 조용히 만들어진다.
  # (2026-09-17 점검에서 확인된 실제 함정. 거부가 맞다 — 경고만 하면 그대로 저장된다.)
  local hash rc=0
  hash="$(cd "$VT_DIR/server" && printf '%s' "$pw" | "$VT_PYTHON" -c '
import sys, auth
pw = sys.stdin.read()
# 판정 결과는 **종료코드로만** 돌려준다 — 문제가 된 글자를 stderr로 내보내면
# 그게 곧 비밀번호 일부를 화면·로그에 찍는 일이 된다.
if not pw.isascii():
    raise SystemExit(3)
if any(ord(c) < 32 or ord(c) == 127 for c in pw):
    raise SystemExit(4)
print(auth.hash_password(pw))
' 2>/dev/null)" || rc=$?
  if [ "$rc" = 3 ]; then
    unset pw pw2
    if vt_is_en; then
    echo "  ✗ The password contains characters that aren't letters, digits or symbols (the Korean IME may have been on)."
    echo "    The web login form maps Korean input back to English keys, so if you save it as is,"
    echo "    **you will never be able to sign in on the web.** Switch to English input and try again."
    else
    echo "  ✗ 비밀번호에 영문·숫자·기호가 아닌 문자가 들어 있습니다(한글 IME가 켜져 있었을 가능성)."
    echo "    웹 로그인 폼은 한글 입력을 영문 키로 되돌려 보내므로, 이대로 저장하면"
    echo "    **웹에서는 절대 로그인할 수 없습니다.** 한/영을 영문으로 바꾸고 다시 시도하세요."
    fi
    return 1
  fi
  if [ "$rc" = 4 ]; then
    unset pw pw2
    echo "  ✗ $(_t '비밀번호에 제어문자가 들어 있습니다. 다시 입력하세요.')"
    return 1
  fi
  if [ "$rc" != 0 ]; then unset pw pw2; echo "  ✗ $(_t '해시 생성 실패')"; return 1; fi
  unset pw pw2
  if [ -z "$hash" ]; then echo "  ✗ $(_t '해시 생성 실패(빈 값)')"; return 1; fi
  vt_env_set "VT_AUTH_PASSWORD_HASH" "$hash"
  vt_env_unset "VT_PASSWORD_HASH"   # 레거시 이름 잔재 제거(중복 방지)
  if ! grep -qE '^VT_AUTH_SESSION_KEY=' "$env_file" && ! grep -qE '^VT_SECRET_KEY=' "$env_file"; then
    local secret
    secret="$("$VT_PYTHON" -c 'import secrets; print(secrets.token_hex(32))')"
    vt_env_set "VT_AUTH_SESSION_KEY" "$secret"
    echo "  ✓ $(_t '세션 서명키(VT_AUTH_SESSION_KEY) 자동 생성')"
  fi
  echo "  ✓ $(_t '웹 로그인 비밀번호 설정 완료 — 해시만 저장(원문 미저장)')"
  echo "  ⓘ $(_t '적용하려면 서버 재시작: fsh restart')"
}

# OTP(TOTP) 연동 — 여기서 setup을 하기 전까지 OTP는 완전히 비활성이고,
# 로그인은 기존과 똑같이 비밀번호만으로 동작한다. setup 이후부터 "처음 보는 기기"에만
# 6자리를 요구한다(이미 등록된 맥/폰은 영향 없음).
cmd_otp() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-status}"
  local py_dir="$VT_DIR/server"
  case "$sub" in
    status)
      local enabled
      enabled="$(cd "$py_dir" && "$VT_PYTHON" -m auth otp-status 2>/dev/null)"
      echo ""
      if echo "$enabled" | grep -q '"enabled": *true'; then
        echo "  🔐 OTP: $(_t '활성 — 새 기기 등록 시 6자리 코드 필요')"
      else
        echo "  🔓 OTP: $(_t '비활성 — 비밀번호만으로 동작 (기존과 동일)')"
        echo "     $(_t '연동하려면:') fsh otp setup"
      fi
      echo ""
      ;;
    setup)
      if [ -z "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ]; then
        echo "  ✗ $(_t '먼저 웹 로그인 비밀번호를 설정하세요:') fsh password"
        echo "    $(_t "OTP는 비밀번호를 대체하지 않고, '새 기기 등록' 관문으로만 쓰입니다.")"
        return 1
      fi
      local out secret uri
      out="$(cd "$py_dir" && "$VT_PYTHON" -m auth otp-setup)" || { echo "  ✗ $(_t '시크릿 생성 실패')"; return 1; }
      secret="$(printf '%s' "$out" | "$VT_PYTHON" -c 'import sys,json; print(json.load(sys.stdin)["secret"])')"
      uri="$(printf '%s' "$out" | "$VT_PYTHON" -c 'import sys,json; print(json.load(sys.stdin)["uri"])')"
      echo ""
      echo "  🔐 $(_t '인증 앱에 등록하세요 (1Password / Authy / Google Authenticator 등)')"
      echo ""
      if command -v qrencode >/dev/null 2>&1; then
        qrencode -t UTF8 "$uri" 2>/dev/null || true
      else
        echo "  $(_t '(qrencode 설치 시 QR로 표시됩니다: brew install qrencode)')"
      fi
      echo ""
      echo "  $(_t '수동 입력용 키:') $secret"
      echo ""
      printf "  %s " "$(_t '등록 후 확인을 위해 6자리 코드를 입력하세요:')"
      local code; read -r code
      if (cd "$py_dir" && "$VT_PYTHON" -m auth otp-verify "$code" >/dev/null); then
        echo "  ✓ $(_t "OTP 연동 완료 — 지금부터 '새' 기기 등록 시에만 코드를 요구합니다")"
        echo "  ⓘ $(_t '현재 등록된 기기는 그대로 통과합니다:') fsh device list"
      else
        echo "  ✗ $(_t "코드가 맞지 않습니다. 시계 동기화를 확인하고 'fsh otp setup'을 다시 실행하세요.")"
        echo "    $(_t '(지금 상태로는 새 기기 등록 시 코드가 필요하니, 확실히 하려면 재실행 권장)')"
        return 1
      fi
      ;;
    disable|clear|off)
      (cd "$py_dir" && "$VT_PYTHON" -m auth otp-disable >/dev/null)
      echo "  ✓ $(_t 'OTP 연동 해제 — 새 기기도 비밀번호만으로 등록됩니다')"
      ;;
    *)
      echo "  $(_t '사용법:') fsh otp [status|setup|disable]"
      return 1
      ;;
  esac
}

# 등록된 기기(화이트리스트) 조회/폐기. 폰 분실 시 revoke하면 그 기기의 세션 쿠키까지 함께 죽는다.
cmd_device() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  local py_dir="$VT_DIR/server"
  case "$sub" in
    list|ls|"")
      (cd "$py_dir" && "$VT_PYTHON" -m auth device-list-pretty)
      ;;
    rename)
      # 자동 라벨(UA에서 뽑은 "iPhone"/"Mac")만으로는 같은 기종이 여럿이면 구분이
      # 안 된다 — 목록에서 어느 행이 어느 기기인지 알아야 revoke를 안심하고 쓴다.
      local id="${2:-}"; shift 2 2>/dev/null || true
      local label="$*"
      if [ -z "$id" ] || [ -z "$label" ]; then
        echo "  $(_t '사용법: fsh device rename <id앞자리> <별명>')"; return 1
      fi
      if (cd "$py_dir" && "$VT_PYTHON" -m auth device-rename "$id" "$label" >/dev/null); then
        echo "  ✓ $(_t '기기 이름 변경:') $label"
      else
        echo "  ✗ $(_t '해당 id로 특정되는 기기가 없습니다 (fsh device list로 확인)')"
        return 1
      fi
      ;;
    revoke|rm|remove)
      local id="${2:-}"
      if [ -z "$id" ]; then echo "  $(_t '사용법: fsh device revoke <id앞자리>')"; return 1; fi
      if (cd "$py_dir" && "$VT_PYTHON" -m auth device-revoke "$id" >/dev/null); then
        echo "  ✓ $(_t '기기 폐기 완료 — 해당 기기의 세션도 즉시 무효화됩니다')"
      else
        echo "  ✗ $(_t '해당 id로 시작하는 기기를 찾지 못했습니다 (fsh device list로 확인)')"
        return 1
      fi
      ;;
    prune)
      # 만료된 기기는 7일 뒤 자동으로 지워진다. 그 전에 목록을 비우고 싶을 때 쓴다.
      local _out _n
      _out="$(cd "$py_dir" && "$VT_PYTHON" -m auth device-prune)" || {
        echo "  ✗ $(_t '정리 실패 (fsh doctor로 확인)')"; return 1; }
      _n="$(printf '%s' "$_out" | "$VT_PYTHON" -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "?")"
      if [ "$_n" = "0" ]; then
        echo "  ✓ $(_t '정리할 만료 기기가 없습니다')"
      else
        echo "  ✓ $(_t '만료된 기기 {n}개를 목록에서 지웠습니다' n="$_n")"
      fi
      ;;
    *)
      echo "  $(_t '사용법: fsh device [list|rename <id> <별명>|revoke <id>|prune]')"
      return 1
      ;;
  esac
}

# git 계정 저장소 + 바인딩 (N30, 40-dock-git.md §1). 토큰은 절대 argv로 넘기지
# 않는다 — add는 --token-stdin만 받고 표준입력을 그대로 파이썬 프로세스에 전달한다
# (이 함수가 stdin을 별도로 리다이렉트하지 않으므로 그대로 상속된다).
cmd_git_account() {
  if [ -z "${VT_PYTHON:-}" ] || [ ! -x "$VT_PYTHON" ]; then
    echo "  ✗ $(_t "VT_PYTHON 미설정/실행불가. 'fsh doctor'로 확인하세요.")"
    return 1
  fi
  local sub="${1:-list}"
  local py_dir="$VT_DIR/server"
  shift 2>/dev/null || true
  case "$sub" in
    list|ls|"")
      (cd "$py_dir" && "$VT_PYTHON" git_account_store.py list)
      ;;
    add)
      (cd "$py_dir" && "$VT_PYTHON" git_account_store.py add "$@")
      ;;
    rm|remove)
      (cd "$py_dir" && "$VT_PYTHON" git_account_store.py rm "$@")
      ;;
    bind)
      (cd "$py_dir" && "$VT_PYTHON" git_account_store.py bind "$@")
      ;;
    *)
      echo "  $(_t '사용법:') fsh git-account [list|add --provider github|gitlab [--host H] --token-stdin|rm <id>|bind <repo> <id>]"
      echo "  $(_t '예:')     echo \"\$TOKEN\" | fsh git-account add --provider github --token-stdin"
      return 1
      ;;
  esac
}

# 모바일/핸드오프 URL에 붙일 1회용 기기 등록 티켓. 인증이 꺼져 있으면 빈 문자열.
# 두 번째 인자가 temp면 이 티켓으로 등록되는 기기가 1일짜리 임시 기기가 된다.
_issue_ticket() {
  [ -z "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ] && [ -z "${VT_AUTH_TOKEN:-${VT_TOKEN:-}}" ] && return 0
  [ -z "${VT_PYTHON:-}" ] && return 0
  (cd "$VT_DIR/server" && "$VT_PYTHON" -m auth ticket-new "$1" ${2:+"$2"} 2>/dev/null) || true
}

# Wave 2 W2-4: 음성 daemon 타깃 세션 lock/해제 (V3-R)
cmd_voice_bind() {
  if [ "$#" -ne 2 ] || [ -z "${TMUX_PANE:-}" ]; then
    echo "$(_t '사용법: 해당 tmux pane에서 fsh voice-bind <claude|codex> <대화 ID>')"
    return 1
  fi
  "$VT_PYTHON" "$VT_DIR/server/voice_bind.py" "$1" "$2"
}

cmd_voice_target() {
  local target_file="$HOME/.vt/voice_target"
  mkdir -p "$HOME/.vt"

  local arg="${1:-}"
  case "$arg" in
    ""|list|status)
      echo ""
      echo "  🎤 fsh voice-target — $(_t '현재 음성 타깃')"
      echo ""
      if [ -f "$target_file" ]; then
        local locked
        locked="$(cat "$target_file" 2>/dev/null)"
        if [ -n "$locked" ]; then
          echo "    🔒 LOCK: $locked"
        else
          echo "    🔓 $(_t 'AUTO: tmux most-recent (lock 없음)')"
        fi
      else
        echo "    🔓 $(_t 'AUTO: tmux most-recent (lock 없음)')"
      fi
      echo ""
      echo "  $(_t '사용 가능한 세션:')"
      "${TMUX_BASE[@]}" list-sessions -F "    • #{session_name}" 2>/dev/null || echo "    $(_t '(없음)')"
      echo ""
      echo "  $(_t '변경: fsh voice-target <세션명>     # lock')"
      echo "  $(_t '해제: fsh voice-target --auto       # auto로')"
      echo ""
      ;;
    --auto|auto)
      rm -f "$target_file"
      echo "  ✓ $(_t '음성 타깃 → AUTO (most-recent)')"
      ;;
    *)
      # 세션 존재 확인
      if ! "${TMUX_BASE[@]}" has-session -t "$arg" 2>/dev/null; then
        echo "  ✗ $(_t "tmux 세션 '{name}' 없음" name="$arg")"
        return 1
      fi
      printf '%s\n' "$arg" > "$target_file"
      echo "  ✓ $(_t '음성 타깃 → {name} (lock)' name="$arg")"
      ;;
  esac
}

# Wave 5 W5-2: 첫 실행 onboarding 안내
_onboarding_check() {
  local marker="$HOME/.vt/onboarded"
  [ -f "$marker" ] && return 0
  mkdir -p "$HOME/.vt"

  # 셸 init 또는 iTerm Dynamic Profile 등록 여부 확인 (구 파일명 vt.json도 인식)
  local has_profile=0
  if [ -f "$HOME/Library/Application Support/iTerm2/DynamicProfiles/fsh.json" ] || \
     [ -f "$HOME/Library/Application Support/iTerm2/DynamicProfiles/vt.json" ]; then
    has_profile=1
  fi
  local has_shellinit=0
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.config/fish/config.fish"; do
    if [ -f "$rc" ] && grep -q "tmux -L $VT_TMUX_SOCKET new -A -s dev" "$rc" 2>/dev/null; then
      has_shellinit=1
      break
    fi
  done

  if [ "$has_profile" -eq 0 ] && [ "$has_shellinit" -eq 0 ]; then
    echo ""
    echo "  ⚡ $(_t '첫 실행 안내')"
    echo ""
    echo "  $(_t '새 터미널 창이 자동으로 FarShell tmux로 진입하도록 설정하지 않았습니다.')"
    echo "  $(_t "이 설정 없이도 'fsh voice'는 동작하지만, 새 창에서 자동 attach가 더 편리합니다.")"
    echo ""
    echo "  $(_t '설정하려면:')"
    echo "    fsh install-profiles               $(_t '(iTerm2 등 자동 등록)')"
    echo "    eval \"\$(fsh shell-init zsh)\" >> ~/.zshrc   $(_t '(셸 init)')"
    echo ""
    echo "  $(_t '개념 설명:') fsh help concepts"
    echo ""
  fi

  touch "$marker"
}

# Wave 4 W4-1: TUI 관리 도구 진입점
cmd_manage() {
  if ! "$VT_PYTHON" -c "import textual" 2>/dev/null; then
    echo ""
    echo "  ✗ $(_t 'textual 미설치 — TUI를 실행할 수 없습니다.')"
    echo ""
    echo "  $(_t '설치:')"
    echo "    cd $VT_DIR && .venv/bin/pip install textual"
    echo "  $(_t '또는:')"
    echo "    ./install.sh"
    echo ""
    return 1
  fi
  export VT_BIN="$VT_DIR/bin/fsh"
  exec "$VT_PYTHON" "$VT_DIR/server/tui_manager.py" "$@"
}

cmd_stop() {
  # Wave 1 W1-4: --purge 옵션으로 tmux까지 종료
  #
  # --keep-tunnel: 공개 입구(cloudflared/ngrok + 워치독)는 남기고 서버만 내린다.
  # 익명 quick tunnel은 **프로세스가 살아 있는 동안 URL이 유지된다** — 백엔드를
  # 죽였다 살려도 같은 주소로 돌아온다(2026-09-21 실측: 내리는 동안 502, 복구 후
  # 200, URL 불변). 그래서 서버만 재기동할 때 터널까지 죽이면 북마크·열어둔 탭·
  # 폰 홈화면이 **재시작할 때마다 통째로 죽는다.** `fsh restart`가 이 옵션을 쓴다.
  local purge=0 keep_tunnel=0
  for arg in "$@"; do
    case "$arg" in
      --purge|-p)    purge=1 ;;
      --keep-tunnel) keep_tunnel=1 ;;
    esac
  done

  echo ""
  local _hdr="  ⏹  fsh stop"
  [ "$keep_tunnel" -eq 1 ] && _hdr="$_hdr — $(_t '터널은 유지합니다 (URL 보존)')"
  echo "$_hdr"
  echo ""

  # 터널이 **떠 있었는지**를 죽이기 전에 기억해 둔다. 종료 훅은 이 값으로만
  # 쏜다 — 이미 꺼진 상태에서 `fsh stop`을 또 쳤다고 게시 대상을 다시 건드리면
  # 훅이 노이즈가 된다(노션이라면 블록 타임스탬프가 의미 없이 계속 바뀐다).
  local had_tunnel
  had_tunnel="$(_main_tunnel_pids)"

  local _svcs="voice clip tunnel-hook-retry tunnel-watchdog tunnel server"
  [ "$keep_tunnel" -eq 1 ] && _svcs="voice clip server"
  for svc in $_svcs; do
    local pidfile="$PID_DIR/$svc.pid"
    if [ -f "$pidfile" ]; then
      local pid
      pid=$(cat "$pidfile")
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        # SIGTERM을 무시하는 프로세스가 실제로 있다(2026-09-17: ngrok이 그랬다).
        # 확인 없이 pid 파일만 지우면 "종료했다"고 말해 놓고 터널은 계속 살아
        # 있는 상태가 된다 — 다음 start가 "이미 실행 중"으로 넘어가 버린다.
        local waited=0
        while kill -0 "$pid" 2>/dev/null && [ $waited -lt 20 ]; do
          sleep 0.1; waited=$((waited + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        echo "  ✓ $(_t '{svc} 종료 (PID {pid})' svc="$svc" pid="$pid")"
      fi
      rm -f "$pidfile"
    fi
  done

  # 접근 범위 기록은 전체 종료 때만 지운다. restart(--keep-tunnel)는 이어서 start가 이 값을
  # 읽어 같은 범위로 다시 띄워야 한다 — 지우면 --network tailscale로 띄운 서버가 restart 한 번에
  # 기본값(all)으로 되돌아간다.
  [ "$keep_tunnel" -eq 0 ] && rm -f "$PID_DIR/network_mode"

  # 추가 포트 터널 (fsh tunnel expose)
  # --keep-tunnel이면 이것도 남긴다 — expose한 포트는 우리 서버가 아니라 **다른
  # 앱**을 내보내는 입구라, 우리 서버를 재기동한다고 같이 끊을 이유가 없다.
  if [ "$keep_tunnel" -eq 0 ]; then
    for pidfile in "$PID_DIR"/tunnel-*.pid; do
      [ -f "$pidfile" ] || continue
      local epid
      epid="$(cat "$pidfile")"
      if kill -0 "$epid" 2>/dev/null; then
        kill "$epid" 2>/dev/null
        echo "  ✓ $(_t '{svc} 종료 (PID {pid})' svc="$(basename "$pidfile" .pid)" pid="$epid")"
      fi
      rm -f "$pidfile"
    done
    rm -f "$TUNNEL_REGISTRY"
  fi

  # 혹시 남은 프로세스 정리 — pidfile을 잃어버린 고아만 대상이다.
  #
  # ⚠ **반드시 이 인스턴스 것만 죽인다.** 예전엔 `pkill -f "voice_daemon.py"`처럼
  # 파일 이름만으로 매칭해서, 한 머신에서 두 인스턴스를 돌릴 때(VT_RUN_DIR,
  # 커밋 380233c) **다른 인스턴스의 데몬과 터널까지 같이 죽었다.** 2.1 작업 중
  # `fsh21 stop`을 칠 때마다 돌아가던 2.0의 cloudflared가 끊겨서 원격 접속이
  # 죽는 걸로 실제로 드러났다(2.0 서버 프로세스만 `lsof -i :$VT_PORT`가
  # 포트별이라 살아남아서 더 늦게 발견됐다).
  #
  # 데몬 3종은 `$VT_DIR/server/*.py` 절대경로로 뜨므로 그 경로째로 매칭하면
  # 트리가 다른 인스턴스와 자연히 갈린다. cloudflared는 포트로 갈린다 —
  # 위에서 이미 쓰는 _main_tunnel_pids()와 같은 기준.
  local _daemons="voice_daemon clipboard_daemon tunnel_watchdog"
  [ "$keep_tunnel" -eq 1 ] && _daemons="voice_daemon clipboard_daemon"
  for d in $_daemons; do
    pkill -f "$VT_DIR/server/$d.py" 2>/dev/null || true
  done
  # cloudflared는 **포트가 명시된 익명 터널만** 정리한다. 명명 터널
  # (`cloudflared tunnel run <name>`)은 명령줄에 포트가 없어서 내 것인지
  # 남의 것인지 구별할 방법이 없다 — 정리 경로에서 확신 없이 죽이느니
  # 놔두는 쪽이 옳다(위 pidfile 루프가 정상 경로에서 이미 처리한다).
  # --keep-tunnel이면 이 정리를 통째로 건너뛴다. 여기를 안 막으면 pidfile 루프를
  # 비켜간 터널이 바로 이 줄에서 죽어, 옵션이 있으나 마나가 된다.
  if [ "$keep_tunnel" -eq 0 ] && command -v pgrep >/dev/null 2>&1; then
    local leftover
    leftover="$(pgrep -f "^([^ ]*/)?cloudflared[[:space:]].*--url http://localhost:$VT_PORT\$" 2>/dev/null | tr '\n' ' ')"
    [ -n "${leftover// /}" ] && kill $leftover 2>/dev/null || true
  fi
  # **듣는(LISTEN) 소켓만** 대상이다. `lsof -i :PORT`는 그 포트에 *연결한* 프로세스도
  # 전부 내놓는데, cloudflared는 트래픽을 넘기려고 localhost:$VT_PORT에 늘 연결해
  # 있다 — 그래서 누가 접속 중일 때 `fsh restart`(--keep-tunnel)를 하면 터널까지
  # 여기서 죽어 **주소가 바뀌었다**(2026-09-28, M1·M5 둘 다 실측. 가짜 cloudflared가
  # 포트를 물고 있게 해서 재현). 브라우저·peer 연결 같은 다른 클라이언트도 같이
  # 죽이던 것이 함께 사라진다.
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$VT_PORT" -sTCP:LISTEN -t 2>/dev/null | xargs kill 2>/dev/null || true
  elif command -v fuser >/dev/null 2>&1; then
    fuser -k $VT_PORT/tcp 2>/dev/null || true
  fi

  if [ "$keep_tunnel" -eq 1 ]; then
    echo "  ✓ $(_t '서버/음성 데몬 종료 (터널은 그대로 — URL 유지)')"
  else
    echo "  ✓ $(_t '서버/터널/음성 데몬 종료')"
  fi
  echo ""

  # 종료를 알린다. **전부 내린 뒤**에 쏜다 — 훅이 보고하는 상태가 실제와
  # 어긋나면 안 되고, 이 시점엔 _tunnel_entries()가 비어 있는 게 맞다.
  #
  # --keep-tunnel이면 쏘지 않는다: 입구는 그대로 살아 있으니 "종료됨"은 거짓이다.
  # 이때 서버가 잠깐 죽은 것은 터널이 502로 답하는 것으로 드러나고, 곧 복구된다.
  if [ "$keep_tunnel" -eq 0 ] && [ -n "${had_tunnel// /}" ]; then
    _run_tunnel_hook stop
  fi

  # tmux 세션 처리: 디폴트는 살림(영속성), --purge면 완전 종료
  local sessions=""
  if "${TMUX_BASE[@]}" list-sessions 2>/dev/null | grep -q .; then
    sessions="$("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ')"
  fi

  if [ "$purge" -eq 1 ]; then
    if [ -n "$sessions" ]; then
      "${TMUX_BASE[@]}" kill-server 2>/dev/null || true
      echo "  ✓ $(_t 'tmux 세션 완전 종료 (--purge):') $sessions"
    else
      echo "  ⓘ $(_t '종료할 tmux 세션 없음')"
    fi
    echo ""
  else
    if [ -n "$sessions" ]; then
      echo "  ⓘ $(_t 'tmux 세션은 살아있습니다 (영속성):')"
      echo "      $sessions"
      echo "  $(_t '완전 종료:') fsh stop --purge"
    fi
    echo ""
  fi
}

cmd_restart() {
  # 서버만 다시 띄운다. **공개 입구(cloudflared/ngrok)는 건드리지 않는다.**
  #
  # 왜 이 명령이 필요한가 (2026-09-21):
  #   익명 quick tunnel은 주소가 프로세스 수명에 묶여 있다. 그동안 코드를 고치고
  #   반영하려면 `fsh stop && fsh start` 말고는 방법이 없었는데, 그 stop이 터널까지
  #   죽여서 **재시작할 때마다 URL이 통째로 바뀌었다.** 북마크·열어둔 탭·폰 홈화면
  #   아이콘이 전부 죽고, Service Worker가 캐시 셸을 내주는 바람에 화면은 멀쩡해
  #   보여서 원인도 안 보였다(서버 로그엔 요청이 한 줄도 안 남는다).
  #
  #   그런데 터널을 죽일 이유가 없었다. 실측: cloudflared를 살려 둔 채 백엔드만
  #   죽였다 살리면 내리는 동안 502를 내다가 복구되고 **URL은 그대로다.**
  #   `_start_tunnel`은 이미 떠 있는 cloudflared를 재사용하도록 돼 있었으므로
  #   (같은 파일의 "외부에서 떠있는 cloudflared도 발견하여 재사용"),
  #   stop 쪽만 터널을 남기게 하면 끝난다.
  #
  # 인자는 cmd_start로 그대로 넘긴다(--voice 등).
  echo ""
  echo "  ♻️  fsh restart — $(_t '서버만 재기동 (입구 유지)')"

  local url_before
  url_before="$(_main_tunnel_url)"

  cmd_stop --keep-tunnel
  cmd_start "$@"

  local url_after
  url_after="$(_main_tunnel_url)"
  echo ""
  if [ -n "$url_before" ] && [ "$url_before" = "$url_after" ]; then
    echo "  ✓ $(_t '접속 주소 유지됨:') $url_after"
    echo "    $(_t '열어둔 탭·북마크를 그대로 쓰시면 됩니다.')"
  elif [ -n "$url_after" ]; then
    # 터널이 죽어 있었거나(맥 재부팅 직후 등) 새로 떴다는 뜻 — 주소가 바뀌었다.
    echo "  ⚠ $(_t '접속 주소가 바뀌었습니다:') $url_after"
    [ -n "$url_before" ] && echo "    $(_t '이전:') $url_before"
  fi
  echo ""
}

cmd_doctor() {
  if [ "${1:-}" = "paste" ]; then
    cmd_doctor_paste
    return $?
  fi
  # 설치 상태 및 실행 환경 진단
  echo ""
  echo "  🩺 fsh doctor — $(_t '설치/환경 진단')"
  echo ""

  local ok=0 warn=0 fail=0
  _check() {
    local label="$1" status="$2" detail="$3"
    case "$status" in
      ok)   printf "  ✓ %-22s %s\n" "$label" "$detail"; ok=$((ok+1)) ;;
      warn) printf "  ⚠ %-22s %s\n" "$label" "$detail"; warn=$((warn+1)) ;;
      fail) printf "  ✗ %-22s %s\n" "$label" "$detail"; fail=$((fail+1)) ;;
    esac
  }

  # 1. Python
  if [ -x "$VT_PYTHON" ]; then
    local pyver; pyver="$("$VT_PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "?")"
    _check "Python" ok "$VT_PYTHON (v$pyver)"
  else
    _check "Python" fail "$VT_PYTHON — $(_t '실행 불가. install.sh 재실행')"
  fi

  # 2. venv
  if [ -d "$VT_DIR/.venv" ]; then
    _check "venv" ok "$VT_DIR/.venv"
  elif [ -n "${VT_PYTHON:-}" ] && [ "$VT_PYTHON" != "$VT_DIR/.venv/bin/python" ] && [ -x "$VT_PYTHON" ]; then
    _check "venv" ok "$(_t '외부 환경 사용:') $VT_PYTHON (~/.vt.env)"
  else
    _check "venv" fail "$(_t ".venv 없음 → './install.sh' 실행 또는 ~/.vt.env에 VT_PYTHON 지정")"
  fi

  # 2-1. Node.js (F1 — 프런트엔드 빌드 전용, 런타임에는 불필요)
  if command -v node >/dev/null 2>&1; then
    local nodever; nodever="$(node --version 2>/dev/null)"
    # engines.node >=20 (package.json) — 대략적인 major 버전만 확인
    local nodemajor="${nodever#v}"; nodemajor="${nodemajor%%.*}"
    if [ "${nodemajor:-0}" -ge 20 ] 2>/dev/null; then
      _check "Node.js" ok "$nodever"
    else
      _check "Node.js" warn "$nodever — $(_t 'package.json은 >=20 요구. 프런트 빌드가 실패할 수 있음')"
    fi
  else
    _check "Node.js" fail "$(_t "미설치 — 프런트엔드 빌드에 필요. macOS: 'brew install node', Linux: nodejs.org")"
  fi

  # 2-2. 프런트엔드 빌드 산출물 (Vite/Tailwind, F1. voice.js는 F4에서 별도 lib
  # entry로 분리됐다 — vite.config.js 주석 참고)
  if [ -f "$VT_DIR/frontend/dist/app.js" ] && [ -f "$VT_DIR/frontend/dist/app.css" ] && [ -f "$VT_DIR/frontend/dist/voice.js" ]; then
    # 소스(frontend/js, styles/)가 산출물보다 최신이면 재빌드가 필요할 수 있다.
    local newest_src
    newest_src="$(find "$VT_DIR/frontend/js" "$VT_DIR/styles" -newer "$VT_DIR/frontend/dist/app.js" 2>/dev/null | head -1)"
    if [ -n "$newest_src" ]; then
      _check "frontend/dist" warn "$(_t "소스가 산출물보다 최신 — 'npm run build'로 다시 빌드하세요 ({src} 등)" src="$newest_src")"
    else
      _check "frontend/dist" ok "$(_t 'app.js / app.css / voice.js 존재, 소스보다 최신')"
    fi
  else
    _check "frontend/dist" fail "$(_t "빌드 산출물 없음(또는 voice.js 누락) → 'npm ci && npm run build' (또는 './install.sh' 재실행)")"
  fi

  # 3. 핵심 Python 패키지
  if "$VT_PYTHON" -c "import fastapi, uvicorn" 2>/dev/null; then
    _check "core packages" ok "$(_t 'fastapi, uvicorn 설치됨')"
  else
    _check "core packages" fail "pip install -r requirements-core.txt"
  fi
  if "$VT_PYTHON" -c "import edge_tts, sounddevice" 2>/dev/null; then
    # STT 엔진은 설정에서 고르는 모델에 따라 다르다 — 선택된 모델이 바로 쓸 수 있는 상태인지 서버 코드로 확인한다.
    local stt_state
    stt_state="$(PYTHONPATH="$VT_DIR/server" "$VT_PYTHON" -c "
import stt_service
d = stt_service.catalog_payload()
sel = next((m for m in d['models'] if m['selected']), None)
print(('ok|' if sel and sel['ready'] else 'warn|') + (sel['label'] + ('|ready' if sel['ready'] else '|download') if sel else '|none'))" 2>/dev/null || true)"
    local _stt_txt="" _stt_lbl=""
    if [ -n "$stt_state" ]; then
      _stt_lbl="${stt_state#*|}"; _stt_lbl="${_stt_lbl%|*}"
      case "${stt_state##*|}" in
        ready)    _stt_txt="$(_t '{label} 준비됨' label="$_stt_lbl")" ;;
        download) _stt_txt="$(_t '{label} — 설정에서 받아 주세요' label="$_stt_lbl")" ;;
        none)     _stt_txt="$(_t '선택된 모델 없음')" ;;
      esac
    fi
    case "$stt_state" in
      ok\|*)   _check "voice packages" ok "edge-tts, sounddevice · STT $_stt_txt" ;;
      warn\|*) _check "voice packages" warn "edge-tts, sounddevice · STT $_stt_txt" ;;
      *)       _check "voice packages" ok "$(_t 'edge-tts, sounddevice (STT 상태는 설정에서 확인)')" ;;
    esac
  else
    _check "voice packages" warn "$(_t "음성 기능 미설치 ('./install.sh voice'로 추가)")"
  fi

  # 4. tmux
  if command -v tmux >/dev/null 2>&1; then
    _check "tmux" ok "$(tmux -V)"
    # L2: window-size latest(여러 클라이언트 동시 attach 시 리사이즈 안정화)는
    # tmux 3.1+ 전용. config/vt-tmux.conf가 실패를 조용히 삼키므로 기능이 그냥
    # 안 켜질 뿐 에러는 안 나지만, 사용자가 원인을 알 수 있게 여기서 경고한다.
    local _tmux_ver _first_ver
    _tmux_ver="$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[a-z]$//')"
    _first_ver="$(printf '3.1\n%s' "$_tmux_ver" | sort -V | head -1)"
    if [ "$_first_ver" != "3.1" ]; then
      _check "$(_t 'tmux 리사이즈 안정화')" warn "$(_t 'tmux 3.1+ 필요(현재 {ver}) — 여러 화면 동시 접속 시 창이 계속 찌그러질 수 있음' ver="$_tmux_ver")"
    fi
  else
    _check "tmux" fail "brew install tmux / apt install tmux"
  fi

  # 4-9. 경계값 — 이 창의 환경변수가 설정 파일과 다른가
  if [ -n "${VT_ENV_BOUNDARY_FIXED:-}" ]; then
    _check "$(_t '경계값')" warn "$(_t '낡은 환경변수를 파일 값으로 바로잡음: {keys} — 창을 새로 여세요' keys="$VT_ENV_BOUNDARY_FIXED")"
  else
    _check "$(_t '경계값')" ok "$(_t '환경변수와 설정 파일이 일치')"
  fi
  # 돌고 있는 서버가 옛 **설정**으로 떴는지. N28은 옛 *코드*만 본다 —
  # 2026-09-17에 값이 안 바뀐 채 서버가 떠 있는 걸 몇 시간 못 알아챘다.
  local _srv_pid _srv_stale
  _srv_pid="$(cat "$PID_DIR/server.pid" 2>/dev/null || true)"
  if [ -n "$_srv_pid" ] && kill -0 "$_srv_pid" 2>/dev/null; then
    _srv_stale=""
    local _k _fileval _srv_env
    # 값에 공백이 든 키(VT_TUNNEL_HOOK 등)가 있어서 ps 출력을 공백으로 잘라 읽으면
    # 첫 단어만 남아 항상 '옛 설정'으로 오판한다. 줄 전체에서 " KEY=값 " 을 통째로 찾는다.
    _srv_env=" $(ps eww -o command= -p "$_srv_pid" 2>/dev/null) "
    for _k in $VT_ENV_BOUNDARY_KEYS; do
      _fileval="$(vt_env_get "$_k" 2>/dev/null || true)"
      [ -n "$_fileval" ] || continue
      case "$_srv_env" in *" $_k="*) ;; *) continue ;; esac
      case "$_srv_env" in
        *" $_k=$_fileval "*) ;;
        *) _srv_stale="${_srv_stale}${_srv_stale:+ }$_k" ;;
      esac
    done
    if [ -n "$_srv_stale" ]; then
      _check "$(_t '서버 설정')" fail "$(_t "서버가 옛 설정으로 돌고 있습니다: {keys} — 'fsh restart' 필요" keys="$_srv_stale")"
    else
      _check "$(_t '서버 설정')" ok "$(_t '돌고 있는 서버가 현재 설정과 일치')"
    fi
  fi

  # 5. 공개 입구 제공자 + 그 제공자의 실행 파일
  local _provider; _provider="$(_tunnel_provider)"
  _check "$(_t '터널 제공자')" ok "$_provider${VT_TUNNEL_PROVIDER:+ (VT_TUNNEL_PROVIDER)}"
  case "$_provider" in
    ngrok)
      if command -v ngrok >/dev/null 2>&1; then
        _check "ngrok" ok "$(ngrok version 2>&1 | head -1)"
        # authtoken이 없으면 기동은 되고 연결에서 실패한다 — 그 실패는 로그에만
        # 남아서, 여기서 미리 말해주지 않으면 원인을 찾기 어렵다.
        if ngrok config check >/dev/null 2>&1; then
          _check "$(_t 'ngrok 설정')" ok "$(_t 'authtoken 등록됨')"
        else
          _check "$(_t 'ngrok 설정')" fail "$(_t "'ngrok config add-authtoken <토큰>' 필요")"
        fi
        if [ -n "${VT_NGROK_DOMAIN:-}" ]; then
          _check "$(_t 'ngrok 도메인')" ok "$(_t '{domain} (고정)' domain="${VT_NGROK_DOMAIN#https://}")"
        else
          _check "$(_t 'ngrok 도메인')" warn "$(_t 'VT_NGROK_DOMAIN 미설정 — 매번 임시 주소가 발급됩니다')"
        fi
      else
        _check "ngrok" fail "$(_t 'VT_TUNNEL_PROVIDER=ngrok인데 미설치. brew install ngrok')"
      fi
      ;;
    none)
      _check "$(_t '공개 터널')" ok "$(_t '사용 안 함 (VT_TUNNEL_PROVIDER=none)')"
      ;;
    *)
      if command -v cloudflared >/dev/null 2>&1; then
        _check "cloudflared" ok "$(cloudflared --version 2>&1 | head -1)"
      else
        _check "cloudflared" warn "$(_t '원격 접속 시 필요. brew install cloudflared')"
      fi
      ;;
  esac

  # 5b. Tailscale (D9: 회사망 등 화면 원격이 막힌 환경의 SSH 경유 접속용, `fsh ssh`)
  if command -v tailscale >/dev/null 2>&1; then
    local ts_ip
    ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    if [ -n "$ts_ip" ]; then
      _check "Tailscale" ok "$(_t "연결됨 ({ip}) — 'fsh ssh'로 원격 SSH 접속 명령 안내" ip="$ts_ip")"
    else
      _check "Tailscale" warn "$(_t "설치됨, 미연결 — 'tailscale up' 실행 필요")"
    fi
  else
    _check "Tailscale" warn "$(_t '미설치 — 회사망 등에서 SSH로 원격 접속 시 필요. https://tailscale.com/download')"
  fi

  # 6. ffmpeg (모바일 음성 입력 디코딩)
  if command -v ffmpeg >/dev/null 2>&1; then
    _check "ffmpeg" ok "$(_t '설치됨')"
  else
    _check "ffmpeg" warn "$(_t '모바일 음성 입력 시 필요. brew install ffmpeg')"
  fi

  # 7. 포트 사용 상태
  if _port_in_use "$VT_PORT"; then
    _check "port $VT_PORT" warn "$(_t '사용 중 (서버 이미 실행 중일 수 있음)')"
  else
    _check "port $VT_PORT" ok "$(_t '사용 가능')"
  fi

  # 7-1. N28 — 실행 중인 서버가 옛 코드를 붙들고 있지 않은지.
  # 파이썬은 import 시점에 모듈을 올리므로 재시작 없이는 수정이 반영되지 않는다.
  # "고쳤는데 왜 그대로냐"를 몇 시간 쫓은 실제 사건(2026-09-09)의 재발 방지책.
  local _stale
  _stale="$(_stale_server_warning)"
  if [ -n "$_stale" ]; then
    _check "$(_t '서버 코드 최신성')" warn "$_stale"
  elif _is_running server; then
    _check "$(_t '서버 코드 최신성')" ok "$(_t '실행 중인 서버가 현재 코드로 떠 있습니다')"
  fi

  # 8. fsh CLI 심링크
  if [ -L "$HOME/.local/bin/fsh" ]; then
    _check "fsh CLI" ok "~/.local/bin/fsh"
  elif [ -f "$HOME/.local/bin/fsh" ]; then
    _check "fsh CLI" warn "$(_t '심링크 아닌 파일 (install.sh 재실행 권장)')"
  else
    _check "fsh CLI" warn "$(_t '~/.local/bin/fsh 없음 (현재 {path}로 실행 중)' path="$0")"
  fi

  # 9. PATH
  if echo ":$PATH:" | grep -q ":$HOME/.local/bin:"; then
    _check "PATH" ok "$(_t '~/.local/bin 포함')"
  else
    _check "PATH" warn "$(_t '~/.local/bin 미포함.') echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc"
  fi

  # 10. 설정 파일 — 존재 / 권한 / 형식
  if [ -f "$VT_CONFIG" ]; then
    _check ".vt.env" ok "$VT_CONFIG"

    # 시크릿(토큰·비밀번호 해시·세션 서명키)이 담기므로 그룹/기타 읽기 권한은 위험
    local perm
    perm="$(ls -l "$VT_CONFIG" 2>/dev/null | cut -c1-10)"
    case "$perm" in
      -rw-------|-r--------)
        _check "$(_t '.vt.env 권한')" ok "$perm" ;;
      *)
        _check "$(_t '.vt.env 권한')" fail "$perm — $(_t '다른 사용자가 읽을 수 있음.') 'chmod 600 $VT_CONFIG'" ;;
    esac

    # bash source와 Python 파서가 다르게 읽을 수 있는 줄 (따옴표 없음 / 큰따옴표)
    local badlines
    badlines="$(vt_env_lint "$VT_CONFIG" || true)"
    if [ -n "$badlines" ]; then
      _check "$(_t '.vt.env 형식')" warn "$(_t '홑따옴표로 감싸지 않은 값이 있습니다 — bash가 $를 확장해 값이 깨질 수 있음')"
      printf '%s\n' "$badlines" | sed 's/^/        /'
    else
      _check "$(_t '.vt.env 형식')" ok "$(_t '모든 값이 정규 형식')"
    fi
  else
    _check ".vt.env" warn "$(_t '없음. install.sh가 자동 생성')"
  fi

  # 11. 인증 (비밀번호 해시 또는 토큰)
  if [ -n "${VT_AUTH_PASSWORD_HASH:-${VT_PASSWORD_HASH:-}}" ]; then
    _check "$(_t '인증')" ok "$(_t '웹 로그인 비밀번호 설정됨 (fsh password)')"
  elif [ -n "${VT_AUTH_TOKEN:-${VT_TOKEN:-}}" ]; then
    _check "$(_t '인증')" ok "$(_t 'VT_AUTH_TOKEN 설정됨 (원격 인증 활성)')"
  else
    _check "$(_t '인증')" warn "$(_t "미설정 (공개 터널에선 누구나 접속 가능) — 'fsh password' 권장")"
  fi

  # 11-a. unix socket — 서버가 peer uid/pid 로 호출자를 아는 경로
  local _sk _sk_lvl _sk_msg
  _sk="$(_sock_status_line 2>/dev/null)"
  if [ -n "$_sk" ]; then
    _sk_lvl="${_sk%%$'\t'*}"; _sk_msg="${_sk#*$'\t'}"
    _check "$(_t 'unix socket')" "$_sk_lvl" "$_sk_msg"
  fi

  # 11-a2. 권한 저장소 — 읽을 수 없는 파일이 있으면 변경이 거부된다(덮어써서 권한이 사라지는 것을 막는다)
  if [ -x "${VT_PYTHON:-}" ]; then
    local _st _st_name _st_why _st_path _st_n
    _st="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m authz store-status 2>/dev/null)"
    if [ -n "$_st" ]; then
      while IFS='|' read -r _st_name _st_why _st_path _st_n; do
        [ -n "$_st_name" ] || continue
        _check "$(_t '권한 저장소')" fail "$(_t '{name} 읽을 수 없음 — 변경 거부 중(파일은 그대로, 복사본 {n}개): {why} — {path}' name="$_st_name" why="$_st_why" n="${_st_n:-0}" path="${_st_path/#$HOME/~}")"
      done <<<"$_st"
    fi
  fi

  # 11-b. OTP(새 기기 등록 관문) + 등록 기기 수
  if [ -x "${VT_PYTHON:-}" ]; then
    local _otp_json _ndev
    _otp_json="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m auth otp-status 2>/dev/null)"
    _ndev="$(cd "$VT_DIR/server" && "$VT_PYTHON" -c 'import auth,sys; d=auth.list_devices(); a=sum(1 for x in d if not x.get("expired")); e=len(d)-a; sys.stdout.write(str(a)+("|"+str(e) if e else ""))' 2>/dev/null || echo "?")"
    case "$_ndev" in *\|*) _ndev="${_ndev%%|*} + $(_t '만료') ${_ndev##*|}" ;; esac
    if echo "$_otp_json" | grep -q '"enabled": *true'; then
      _check "OTP" ok "$(_t '활성 — 새 기기 등록 시 코드 필요 (등록 기기 {n}개)' n="$_ndev")"
    else
      _check "OTP" warn "$(_t "미연동 — 비밀번호만으로 새 기기도 접속 가능 (등록 기기 {n}개). 'fsh otp setup'" n="$_ndev")"
    fi
  fi

  # 11-b2. 노출 중인 포트 — 위험 포트(Chrome 원격 디버깅 등)가 공개돼 있거나 PIN 실패가
  # 쌓이고 있으면 알린다. 막지 않는다: 이미 열린 노출을 doctor가 내리지는 않는다.
  if [ -x "${VT_PYTHON:-}" ]; then
    local _shares _row _p _m _att _danger _risky="" _attacked=""
    _shares="$(_port_share_cli cli-list 2>/dev/null)"
    if [ -z "$_shares" ]; then
      _check "$(_t '노출 포트')" ok "$(_t '열린 노출 없음')"
    else
      while IFS=$'\t' read -r _p _m _ _att; do
        [ -z "$_p" ] && continue
        _danger="$(_port_share_cli cli-danger "$_p" 2>/dev/null)"
        [ -n "$_danger" ] && _risky="$_risky $_p"
        [ "${_att:-0}" -ge 10 ] 2>/dev/null && _attacked="$_attacked $_p($(_t '{n}회' n="$_att"))"
      done <<<"$_shares"
      local _n; _n="$(printf '%s\n' "$_shares" | grep -c .)"
      if [ -n "$_risky" ]; then
        _check "$(_t '노출 포트')" warn "$(_t "위험한 포트가 공개 중:{ports} — 원격 제어 수단이 될 수 있습니다. 'fsh tunnel unexpose <port>'" ports="$_risky")"
      elif [ -n "$_attacked" ]; then
        _check "$(_t '노출 포트')" warn "$(_t "접속 코드 실패가 많은 포트:{ports} — 'fsh tunnel pin <port>'로 재발급하세요" ports="$_attacked")"
      else
        _check "$(_t '노출 포트')" ok "$(_t '{n}개 노출 중 (위험 포트 없음)' n="$_n")"
      fi
    fi
  fi

  # 11-c. Claude Code 훅 (A0) — 에이전트 상태·큐 자동 투입·TTS 요약이 전부
  # 이 훅에 달려 있는데, 지금까지 등록은 README의 JSON 예시로만 안내됐다.
  # 등록이 안 돼 있으면 서버는 이벤트를 한 건도 못 받고, 그 사실을 알 방법도
  # 없었다(조용히 아무 일도 안 일어난다) — 그래서 진단에 넣는다.
  if [ -f "$VT_DIR/server/claude_hooks.py" ]; then
    local _hooks_out _hooks_rc _hooks_missing
    _hooks_out="$("${VT_PYTHON:-python3}" "$VT_DIR/server/claude_hooks.py" status 2>&1)"; _hooks_rc=$?
    if [ "$_hooks_rc" = "2" ]; then
      _check "$(_t 'Claude 훅')" fail "$(_t 'settings.json을 읽을 수 없음 — {err}' err="$_hooks_out")"
    elif [ "$_hooks_rc" = "0" ]; then
      # 개수는 status 출력에서 센다 — 설치기의 이벤트 목록이 바뀌어도 문구가 낡지 않게(예전엔
      # 「pre/post/stop 3종」으로 굳어 있어 8종을 검사하면서도 3종이라고 말했다).
      _check "$(_t 'Claude 훅')" ok "$(_t '이벤트 {n}종 등록됨' n="$(printf '%s
' "$_hooks_out" | grep -c .)")"
    else
      _hooks_missing="$(echo "$_hooks_out" | awk -F'\t' '$2!="ok"{printf "%s ", $1}')"
      _check "$(_t 'Claude 훅')" warn "$(_t "미등록/불일치: {missing}— 'fsh hooks install' (없으면 상태 배지·큐 자동 투입·TTS가 동작 안 함)" missing="$_hooks_missing")"
    fi
  fi

  if [ -f "$VT_DIR/server/codex_hooks.py" ]; then
    local _codex_hooks_out _codex_hooks_rc _codex_hooks_missing
    _codex_hooks_out="$("${VT_PYTHON:-python3}" "$VT_DIR/server/codex_hooks.py" status 2>&1)"; _codex_hooks_rc=$?
    if [ "$_codex_hooks_rc" = "2" ]; then
      _check "$(_t 'Codex 훅')" fail "$(_t 'config.toml을 읽을 수 없음 — {err}' err="$_codex_hooks_out")"
    elif [ "$_codex_hooks_rc" = "0" ]; then
      _check "$(_t 'Codex 훅')" ok "$(_t '이벤트 {n}종 등록됨' n="$(printf '%s
' "$_codex_hooks_out" | grep -c .)")"
    else
      _codex_hooks_missing="$(echo "$_codex_hooks_out" | awk -F'\t' '$2!="ok"{printf "%s ", $1}')"
      _check "$(_t 'Codex 훅')" warn "$(_t "미등록/불일치: {missing}— 'fsh hooks install'" missing="$_codex_hooks_missing")"
    fi
    local _codex_dups _codex_dup_n
    _codex_dups="$("${VT_PYTHON:-python3}" "$VT_DIR/server/codex_hooks.py" duplicates 2>/dev/null)"
    if [ -n "$_codex_dups" ]; then
      _codex_dup_n="$(printf '%s\n' "$_codex_dups" | grep -c .)"
      _check "Codex hooks.json" warn "$(_t "FarShell 훅 {n}개 중복(앱 가져오기) — 이벤트가 두 번 들어옴. 'fsh hooks dedupe'" n="$_codex_dup_n")"
    fi
  fi

  # 11-d. clauth 사용량 피드 (U4) — 있으면 신선도까지, 없으면 조용히 넘어간다
  # (clauth를 안 쓰는 환경이 정상이다. 경고로 띄우면 노이즈가 된다).
  local _clauth_feed="${VT_CLAUTH_STATUS:-$HOME/.clauth/status.json}"
  if [ -f "$_clauth_feed" ]; then
    local _cl
    _cl="$("${VT_PYTHON:-python3}" - "$_clauth_feed" <<'PYEOF' 2>/dev/null
import json, sys, time
from datetime import datetime
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("broken"); raise SystemExit
if d.get("schema") != 1:
    print(f"schema:{d.get('schema')}"); raise SystemExit
try:
    age = time.time() - datetime.fromisoformat(str(d.get("generated_at")).replace("Z", "+00:00")).timestamp()
except Exception:
    age = -1
print(f"ok:{len(d.get('profiles') or [])}:{age:.0f}")
PYEOF
)"
    case "$_cl" in
      ok:*)
        local _np _age; _np="$(echo "$_cl" | cut -d: -f2)"; _age="$(echo "$_cl" | cut -d: -f3)"
        if [ "${_age:-999}" -gt 300 ] 2>/dev/null; then
          _check "$(_t 'clauth 사용량')" warn "$(_t '피드가 {age}초째 안 바뀜 — clauth 데몬 확인 (프로필 {np}개)' age="$_age" np="$_np")"
        else
          _check "$(_t 'clauth 사용량')" ok "$(_t '프로필 {np}개, {age}초 전 갱신' np="$_np" age="$_age")"
        fi ;;
      schema:*) _check "$(_t 'clauth 사용량')" warn "$(_t '모르는 피드 형식({fmt}) — clauth 버전 확인' fmt="$_cl")" ;;
      broken)   _check "$(_t 'clauth 사용량')" warn "$(_t '피드를 읽을 수 없음 ({path})' path="$_clauth_feed")" ;;
    esac
  fi

  # 12. 푸시 알림
  if [ -n "${VT_NOTIFY_URL:-}" ]; then
    _check "VT_NOTIFY_URL" ok "$(echo "$VT_NOTIFY_URL" | sed 's|https://||;s|/.*|/...|')"
  elif [ -n "${VT_TELEGRAM_TOKEN:-}" ]; then
    _check "Telegram" ok "$(_t '토큰 설정됨')"
  else
    _check "$(_t 'push 알림')" warn "$(_t '미설정 (작업 완료 알림 받으려면 VT_NOTIFY_URL=https://ntfy.sh/your-topic)')"
  fi

  # 13. macOS 터미널 앱 감지 (자동 창 오픈용)
  if [ "$(uname)" = "Darwin" ]; then
    local detected=()
    [ -d "/Applications/iTerm.app" ] && detected+=("iTerm2")
    [ -d "/Applications/Ghostty.app" ] && detected+=("Ghostty")
    [ -d "/Applications/WezTerm.app" ] && detected+=("WezTerm")
    [ -d "/Applications/kitty.app" ] && detected+=("Kitty")
    [ -d "/Applications/Alacritty.app" ] && detected+=("Alacritty")
    [ -d "/Applications/Warp.app" ] && detected+=("Warp")
    # Terminal.app은 맥에 기본 내장이므로 항상 사용 가능
    detected+=("Terminal.app")
    _check "$(_t '터미널 앱')" ok "$(_t '감지: {apps} — 현재 TERM_PROGRAM={term}, 메인 터미널(VT_TERMINAL)={main}' apps="${detected[*]}" term="${TERM_PROGRAM:-unknown}" main="${VT_TERMINAL:-auto}")"
    if [ -n "${VT_TERMINAL:-}" ] && [ "${VT_TERMINAL}" != "auto" ] && ! _terminal_installed "${VT_TERMINAL}"; then
      _check "$(_t '메인 터미널')" warn "$(_t 'VT_TERMINAL={term} 이(가) 설치돼 있지 않아 자동 선택으로 열림 (fsh terminal)' term="${VT_TERMINAL}")"
    fi
  fi

  # W3-6: Linux 환경 검사
  if [ "$(uname)" = "Linux" ]; then
    # 14. Linux 터미널 emulator
    local lin_terms=()
    for em in gnome-terminal konsole alacritty kitty wezterm xfce4-terminal xterm; do
      command -v "$em" >/dev/null 2>&1 && lin_terms+=("$em")
    done
    if [ "${#lin_terms[@]}" -gt 0 ]; then
      _check "$(_t 'Linux 터미널')" ok "$(_t '감지:') ${lin_terms[*]}"
    else
      _check "$(_t 'Linux 터미널')" warn "$(_t '지원 emulator 없음 — gnome-terminal/konsole 등 설치 권장')"
    fi

    # 15. Linux TTS
    local lin_tts=""
    for t in espeak-ng espeak spd-say piper; do
      command -v "$t" >/dev/null 2>&1 && lin_tts="$lin_tts $t"
    done
    if [ -n "$lin_tts" ]; then
      _check "Linux TTS" ok "$(_t '감지:')$lin_tts"
    else
      _check "Linux TTS" warn "$(_t 'TTS 미설치 — sudo apt-get install espeak-ng')"
    fi

    # 16. notify-send
    if command -v notify-send >/dev/null 2>&1; then
      _check "notify-send" ok "$(command -v notify-send)"
    else
      _check "notify-send" warn "$(_t '데스크톱 알림 미지원 — sudo apt-get install libnotify-bin')"
    fi

    # 17. Wayland 글로벌 핫키 가드
    local sess_type="${XDG_SESSION_TYPE:-unknown}"
    if [ "$sess_type" = "wayland" ]; then
      _check "Display Server" warn "$(_t 'Wayland — 글로벌 핫키 캡처 제한. X11 세션 또는 모바일 🎤 사용 권장')"
    elif [ "$sess_type" = "x11" ]; then
      _check "Display Server" ok "X11"
    else
      _check "Display Server" warn "XDG_SESSION_TYPE=$sess_type"
    fi
  fi

  # 18. textual (TUI 의존성)
  if "$VT_PYTHON" -c "import textual" 2>/dev/null; then
    _check "TUI (textual)" ok "$(_t 'fsh manage 사용 가능')"
  else
    _check "TUI (textual)" warn "$(_t 'fsh manage 사용 불가 — pip install textual')"
  fi

  # 19. fzf (fsh attach 인터랙티브)
  if command -v fzf >/dev/null 2>&1; then
    _check "fzf" ok "$(_t 'fsh attach 인터랙티브 선택 가능')"
  else
    _check "fzf" warn "$(_t "fzf 미설치 — 'fsh attach' 시 텍스트 입력만 가능")"
  fi

  # 20. ADR-43(2.3.0) — 스크롤백 영속화 제거 잔여 로그. 서버가 기동할 때마다
  # 1회 정리하지만(main.py), 서버를 안 띄운 채 업그레이드했거나 그 정리가
  # 실패했을 경우를 위한 안전망.
  if [ -d "$HOME/.vt/scrollback" ]; then
    _check "$(_t '스크롤백 잔여 로그')" warn "$(_t '~/.vt/scrollback/ 에 옛 로그가 남아 있습니다 (2.3.0에서 제거된 기능) — 정리: rm -rf ~/.vt/scrollback')"
  else
    _check "$(_t '스크롤백 잔여 로그')" ok "$(_t '없음')"
  fi

  # 21. 개인 값 가드 훅(scripts/guard_personal.py) — 클론마다 켜야 동작한다. 꺼져 있으면 개인 값·기록
  # 문서가 커밋에 섞여도 아무도 막지 않는다(2026-10 실제로 그랬다). git 클론일 때만 본다.
  if [ -e "$VT_DIR/.git" ] && command -v git >/dev/null 2>&1; then
    if [ "$(git -C "$VT_DIR" config --get core.hooksPath 2>/dev/null)" = "scripts/githooks" ]; then
      _check "$(_t '개인 값 가드')" ok "$(_t 'pre-commit·pre-push 훅 켜짐')"
    else
      _check "$(_t '개인 값 가드')" warn "$(_t '꺼져 있음 — 켜기: git config core.hooksPath scripts/githooks')"
    fi
  fi

  echo ""
  echo "  $(_t '결과:') ✓ $ok  ⚠ $warn  ✗ $fail"
  echo ""
  if [ $fail -gt 0 ]; then
    echo "  🔴 $(_t '치명적 문제 있음. ✗ 항목부터 해결하세요.')"
    return 1
  elif [ $warn -gt 0 ]; then
    echo "  🟡 $(_t '기본 동작은 가능하지만 일부 기능 미설치. ⚠ 항목 확인 권장.')"
  else
    echo "  🟢 $(_t '모든 체크 통과.')"
  fi
  echo ""
}

# N29(2.1.5 5/n) — 붙여넣기 진단. `~/.vt/pastecheck.py`(2026-09-09 임시로
# 설치해 실사용자 붙여넣기 잘림 원인을 찾는 데 썼던 스크립트)를 정식
# 서브커맨드로 승격한다. 셸·앱·tty 한계를 전부 우회하고 "이 터미널이 실제로
# 몇 바이트를 어떤 형태로 받았는가"만 본다 — FarShell 서버·PTY 코드를
# 하나도 거치지 않으므로 우리 쪽 문제인지 터미널/앱 쪽 문제인지를 갈라낸다.
#
# 2.1.5에서 추가한 것: 1/n(input_mode.py)이 서버 쪽에서 판정하는 것과 같은
# 정보(ICANON·정규 모드 한 줄 한계·tmux 안인지)를 **이 tty에서 직접** 재서
# 같이 보여준다 — 서버 없이 로컬 termios/pathconf 호출뿐이라 서버가 죽어
# 있어도 동작한다. 그러면 "왜 내 붙여넣기가 이상한가"가 한 번의 왕복으로
# 끝난다(원인이 서버 쪽인지, 이 터미널 자체의 한계인지).
cmd_doctor_paste() {
  local _paste_en=""; vt_is_en && _paste_en=1
  echo ""
  echo "  🩺 fsh doctor paste — $(_t '붙여넣기 진단')"
  echo ""
  echo "  ⚠ $(_t '진단하려는 그 pane에서 직접 실행하세요 — 이 명령이 그 자리의')"
  echo "     $(_t 'stdin을 직접 읽습니다(다른 세션은 진단 못 합니다).')"
  echo "  $(_t '안내가 뜨면 곧바로 확인하려는 텍스트를 붙여넣으세요(60초 무응답 시 종료).')"
  echo ""

  FSH_PASTE_EN="$_paste_en" "${VT_PYTHON:-python3}" - <<'PYEOF'
import os, sys, time, select, termios, tty

# 한국어/영어 선택: 쉘이 FSH_PASTE_EN=1 을 넘기면 영어
_EN = bool(os.environ.get("FSH_PASTE_EN"))
def T(ko, en):
    return en if _EN else ko
def EL(en):
    return "  " + en.ljust(24) + " : "

def is_canonical(fd):
    try:
        attrs = termios.tcgetattr(fd)
    except Exception:
        return None
    return bool(attrs[3] & termios.ICANON)

def max_canon(fd):
    try:
        v = os.pathconf(fd, "PC_MAX_CANON")
    except Exception:
        return None
    return v if isinstance(v, int) and v > 0 else None

# ⚠ 이 스크립트 자체가 `python3 - <<'PYEOF'` heredoc으로 전달된다 — bash의
# heredoc은 **표준입력**을 그 본문으로 갈아 끼운다(표준출력은 안 건드린다).
# 그래서 sys.stdin.fileno()는 실제 터미널이 아니라 그 heredoc 파이프를
# 가리킨다 — /dev/tty를 직접 열어야 진짜 터미널에 닿는다. 쓰기도 같은 fd로
# 한다(sys.stdout에 기대지 않는다 — 어떻게 호출되든 항상 같은 채널이 되게).
try:
    fd = os.open("/dev/tty", os.O_RDWR)
except OSError:
    print(T("  ✗ 이 세션에 연결된 터미널이 없습니다(파이프·리다이렉트로 실행했나요?) — 진단 불가", "  ✗ This session has no terminal attached (piped or redirected?) — can't diagnose"))
    raise SystemExit(1)
before_icanon = is_canonical(fd)
before_limit = max_canon(fd)
in_tmux = bool(os.environ.get("TMUX"))

def yn(v):
    return T("예", "yes") if v else (T("모름", "unknown") if v is None else T("아니오", "no"))

print(T("  이 tty 정규(줄 단위) 모드 : ", EL("Canonical (line) mode")) + yn(before_icanon)
      + (T(f" (한 줄 한계 {before_limit}바이트)", f" (line limit {before_limit} bytes)") if before_icanon and before_limit else ""))
print(T("  tmux 안                  : ", EL("Inside tmux")) + (
    T("예 — 서버가 이 tty를 직접 판정하지 않고 tmux paste-buffer에 위임합니다(N25)", "yes — the server hands off to tmux paste-buffer instead of judging this tty directly (N25)")
    if in_tmux else
    T("아니오 — 서버가 이 tty를 직접 보고 판정합니다", "no — the server inspects this tty directly")))
print()

old = termios.tcgetattr(fd)
os.write(fd, b"\x1b[?2004h")  # 이 터미널에게 "다음 붙여넣기는 마커로 감싸 달라"고 요청
tty.setraw(fd)
buf = bytearray()
t = time.monotonic()
try:
    while True:
        r, _, _ = select.select([fd], [], [], 0.4)
        if r:
            b = os.read(fd, 65536)
            if not b:
                break
            buf += b
            t = time.monotonic()
        elif buf and time.monotonic() - t > 1.2:
            break
        elif not buf and time.monotonic() - t > 60:
            break
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
    os.write(fd, b"\x1b[?2004l\r\n")
    os.close(fd)

has_start = b"\x1b[200~" in buf
has_end = b"\x1b[201~" in buf
body = buf.replace(b"\x1b[200~", b"").replace(b"\x1b[201~", b"")

print(T("  받은 총 바이트      : ", EL("Total bytes received")) + str(len(buf)))
print(T("  마커 제외 본문      : ", EL("Body (markers excluded)")) + str(len(body)))
print(T("  시작마커 ESC[200~   : ", EL("Start marker ESC[200~")) + (T("있음", "present") if has_start else
      T("없음  ← 이 터미널이 bracketed paste를 지원 안 하거나 요청을 못 받았습니다", "missing  ← this terminal doesn't support bracketed paste, or never got the request")))
print(T("  끝마커  ESC[201~    : ", EL("End marker ESC[201~")) + (T("있음", "present") if has_end else
      (T("없음  ← 붙여넣기 도중 잘렸을 수 있습니다", "missing  ← the paste may have been cut off") if has_start else "-")))
if before_icanon and before_limit and not has_start:
    over = [i for i, ln in enumerate(body.split(b"\r")) if len(ln) >= before_limit - 8]
    if over:
        print(T(f"  ⚠ 정규 모드 한계({before_limit}바이트) 근처 — {len(over)}번째 줄(들)이 "
              "근접/초과합니다. 넘겼다면 잘리는 게 아니라 그 줄이 통째로 사라졌을 수 있습니다.",
              f"  ⚠ Near the canonical-mode limit ({before_limit} bytes) — {len(over)} line(s) "
              "are close to or over it. If exceeded, the line may have vanished entirely rather than being truncated."))
print(T("  본문 앞 40자        : ", EL("First 40 chars")) + body[:40].decode('utf-8','replace'))
print(T("  본문 뒤 40자        : ", EL("Last 40 chars")) + body[-40:].decode('utf-8','replace'))
PYEOF
}

cmd_template() {
  # fsh template [save|apply|list|rm] <name>
  local action="${1:-list}"
  local name="${2:-default}"
  local DIR="$HOME/.config/vt/templates"
  mkdir -p "$DIR"

  case "$action" in
    save)
      if [ ! -f "CLAUDE.md" ]; then
        echo "  ✗ $(_t '현재 디렉토리에 CLAUDE.md가 없습니다')"
        return 1
      fi
      cp "CLAUDE.md" "$DIR/$name.md"
      echo "  ✓ $(_t "'{name}' 템플릿으로 저장됨 → {path}" name="$name" path="$DIR/$name.md")"
      ;;
    apply)
      if [ ! -f "$DIR/$name.md" ]; then
        echo "  ✗ $(_t "템플릿 '{name}'을 찾을 수 없습니다" name="$name")"
        echo "  $(_t '사용 가능한 템플릿:') $(ls -1 "$DIR" 2>/dev/null | sed 's/\.md$//' | tr '\n' ' ')"
        return 1
      fi
      if [ -f "CLAUDE.md" ]; then
        cp "CLAUDE.md" "CLAUDE.md.bak"
        echo "  ⓘ $(_t '기존 CLAUDE.md → CLAUDE.md.bak으로 백업')"
      fi
      cp "$DIR/$name.md" "CLAUDE.md"
      echo "  ✓ $(_t "'{name}' 템플릿 적용 → ./CLAUDE.md" name="$name")"
      ;;
    list)
      echo ""
      echo "  📋 fsh template — $(_t '사용 가능한 템플릿')"
      echo "  $(_t '저장 위치:') $DIR"
      echo ""
      if [ -d "$DIR" ] && [ "$(ls -A "$DIR" 2>/dev/null)" ]; then
        for t in "$DIR"/*.md; do
          [ -f "$t" ] || continue
          local base
          base="$(basename "$t" .md)"
          local size
          size="$(wc -c < "$t" | tr -d ' ')"
          printf "    • %-20s (%s bytes)\n" "$base" "$size"
        done
      else
        echo "    $(_t "(템플릿 없음. 'fsh template save <이름>' 으로 저장)")"
      fi
      echo ""
      ;;
    rm|remove|delete)
      if [ ! -f "$DIR/$name.md" ]; then
        echo "  ✗ $(_t "템플릿 '{name}'을 찾을 수 없습니다" name="$name")"
        return 1
      fi
      rm "$DIR/$name.md"
      echo "  ✓ $(_t "'{name}' 템플릿 삭제" name="$name")"
      ;;
    *)
      echo "$(_t '사용법:') fsh template [save|apply|list|rm] <name>"
      return 1
      ;;
  esac
}

cmd_popup() {
  # fsh popup <action> — tmux 3.2+ display-popup으로 빠른 호출
  local action="${1:-status}"

  if [ -z "${TMUX:-}" ]; then
    # tmux 밖이면 그냥 직접 실행
    cmd_${action} 2>/dev/null || {
      echo "  ⓘ $(_t 'tmux 안에서만 popup으로 띄울 수 있습니다.')"
      echo "  $(_t '대신 직접 실행:') fsh $action"
    }
    return
  fi

  # tmux 3.2+ 확인
  local tmux_ver
  tmux_ver="$(tmux -V | awk '{print $2}')"
  local first_ver
  first_ver="$(printf '3.2\n%s' "$tmux_ver" | sort -V | head -1)"

  if [ "$first_ver" = "3.2" ]; then
    "${TMUX_BASE[@]}" display-popup -E -w 80% -h 70% \
      "$0 $action; echo; echo '$(_t '엔터를 눌러 닫기')'; read -r"
  else
    echo "  ⓘ $(_t 'tmux 3.2+ 필요 (현재: {ver}). 직접 실행:' ver="$tmux_ver")"
    cmd_${action} 2>/dev/null
  fi
}

cmd_run() {
  # fsh run "..." — headless claude -p 백그라운드 실행 + 완료 시 TTS/푸시
  # Phase 8 G4: --disallowedTools 자동 주입 + lockfile (중복 실행 방지)
  local prompt="$*"
  if [ -z "$prompt" ]; then
    echo "$(_t '사용법: fsh run "명령어"')"
    echo "  $(_t '예: fsh run "오늘 git 변경사항 요약해줘"')"
    return 1
  fi

  if ! command -v claude >/dev/null 2>&1; then
    echo "  ✗ $(_t 'claude CLI 미설치')"
    return 1
  fi

  # lockfile — 같은 프롬프트 중복 실행 방지 (reminder-watch 패턴)
  local prompt_hash
  prompt_hash="$(printf '%s' "$prompt" | shasum 2>/dev/null | cut -c1-8 || echo "$$")"
  local LOCK="/tmp/vt-run-${prompt_hash}.lock"
  if [ -f "$LOCK" ]; then
    local lock_pid
    lock_pid="$(cat "$LOCK" 2>/dev/null)"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo "  ⓘ $(_t '이미 실행 중 (PID {pid}). 같은 프롬프트는 동시 실행 차단.' pid="$lock_pid")"
      echo "    $(_t '중복 해제: rm {lock}' lock="$LOCK")"
      return 1
    else
      # stale lockfile → 자동 정리
      rm -f "$LOCK"
    fi
  fi

  local LOG="/tmp/vt-run-${prompt_hash}-$(date +%s).log"
  local TIMEOUT="${VT_RUN_TIMEOUT:-3600}"
  local disallowed
  disallowed="$(_resolve_disallowed_tools)"

  echo ""
  echo "  🚀 $(_t 'fsh run — 백그라운드 dispatch')"
  echo "    $(_t '프롬프트: {prompt}' prompt="$prompt")"
  echo "    $(_t '타임아웃: {sec}초' sec="$TIMEOUT")"
  echo "    $(_t '로그: {path}' path="$LOG")"
  echo "    $(_t '차단 도구: {tools}...' tools="${disallowed:0:60}")"
  echo ""

  (
    echo $$ > "$LOCK"
    trap 'rm -f "$LOCK"' EXIT

    local timeout_flag=0
    if command -v timeout >/dev/null 2>&1; then
      timeout "$TIMEOUT" claude -p "$prompt" \
        --permission-mode bypassPermissions \
        --disallowedTools "$disallowed" \
        > "$LOG" 2>&1
      [ $? -eq 124 ] && timeout_flag=1
    else
      claude -p "$prompt" \
        --permission-mode bypassPermissions \
        --disallowedTools "$disallowed" \
        > "$LOG" 2>&1
    fi

    local result
    result="$(tail -c 400 "$LOG" 2>/dev/null)"
    [ -z "$result" ] && result="(빈 응답 또는 실패)"
    local title_tag="fsh run 완료"
    if [ $timeout_flag -eq 1 ]; then
      title_tag="[TIMEOUT] fsh run"
      result="타임아웃 (${TIMEOUT}초): $result"
    fi

    # TTS — 서버 실행 중이면
    if curl -sf "http://localhost:${VT_PORT}/" -o /dev/null 2>/dev/null; then
      curl -sf -X POST "http://localhost:${VT_PORT}/voice/output" \
        -H 'Content-Type: application/json' \
        -d "$(python3 -c "import json,sys; print(json.dumps({'text': sys.argv[1][:200]}))" "$result")" \
        -o /tmp/vt-run-tts.mp3 2>/dev/null && \
        afplay /tmp/vt-run-tts.mp3 2>/dev/null
    else
      # fallback: macOS say
      command -v say >/dev/null && say -v Yuna "${result:0:200}" 2>/dev/null
    fi

    # ntfy 푸시
    if [ -n "${VT_NOTIFY_URL:-}" ]; then
      curl -sf -d "$result" \
        -H "Title: ${title_tag}" \
        -H "Tags: white_check_mark" \
        "$VT_NOTIFY_URL" >/dev/null 2>&1
    fi
  ) &

  local bg_pid=$!
  echo "  ✓ $(_t 'PID {pid} — 완료 시 TTS·푸시 알림' pid="$bg_pid")"
  echo "    $(_t '실시간 확인: tail -f {path}' path="$LOG")"
  echo ""
}

cmd_handoff() {
  # fsh handoff mobile  — 폰으로 현재 tmux 세션 넘기기 (QR + 좌표)
  # fsh handoff desktop — 맥북 iTerm으로 tmux 가져오기
  local target="${1:-mobile}"

  case "$target" in
    mobile)
      # `fsh mobile --session <이름>`과 같은 일이다 — 서버가 안 떠 있으면 먼저 시작한다.
      echo ""
      echo "  📱 $(_t 'fsh handoff mobile — 현재 tmux 세션을 폰으로')"
      _ensure_tmux
      _port_in_use "$VT_PORT" || { cmd_start || return $?; }

      # 현재 tmux 세션 결정 (TMUX 안이면 그 세션, 아니면 dev)
      local session=""
      if [ -n "${TMUX:-}" ]; then
        session="$("${TMUX_BASE[@]}" display -p '#S' 2>/dev/null || tmux display -p '#S')"
      else
        session="dev"
      fi
      cmd_mobile --session "$session"
      ;;
    desktop|mac)
      echo ""
      echo "  🖥  $(_t 'fsh handoff desktop — 맥북 터미널로 tmux')"
      echo ""
      if [ -n "${TMUX:-}" ]; then
        _ensure_tmux
        echo "  ⓘ $(_t '이미 tmux 안 ({session}). 추가 동작 없음.' session="$(tmux display -p '#S')")"
        return
      fi
      # dev가 없으면 미리 만들지 않는다 — 창이 `new -A -s dev 'claude --resume'`로 세션과 claude를
      # 함께 만든다. 빈 세션을 먼저 만들면 창이 그 빈 세션에 붙기만 하고 claude가 안 뜬다.
      "${TMUX_BASE[@]}" has-session -t dev 2>/dev/null && _ensure_tmux
      _open_tmux_terminal
      case $? in
        0) echo "  ✓ $(_t "새 터미널 창에 tmux 'dev' + claude --resume 열림")" ;;
        2) ;;
        *)
          echo "  ⓘ $(_t "터미널 자동 오픈 실패. 수동: tmux new -A -s dev 'claude --resume'")"
          _autoopen_failure_hint
          ;;
      esac
      ;;
    *)
      echo "$(_t '사용법: fsh handoff [mobile|desktop]')"
      return 1
      ;;
  esac
  echo ""
}

cmd_ssh() {
  # fsh ssh [session] [--user <name>] [--add-key "ssh-ed25519 AAAA..."]
  # 회사망처럼 화면 원격(RDP/VNC/크롬 원격 등)이 막힌 환경에서도 Tailscale은
  # 대개 통과함 → Tailscale + SSH로 이 맥북의 tmux -L fsh 세션에 바로 attach.
  # 이 명령은 "복사해서 다른 기기에서 실행할 명령어"를 안내만 한다 (원격 실행 없음).
  local session="dev"
  local remote_user
  remote_user="$(whoami)"
  local add_key=""
  local args=("$@")
  local i=0
  while [ $i -lt ${#args[@]} ]; do
    local arg="${args[$i]}"
    case "$arg" in
      --user) i=$((i+1)); remote_user="${args[$i]:-$remote_user}" ;;
      --user=*) remote_user="${arg#--user=}" ;;
      --add-key) i=$((i+1)); add_key="${args[$i]:-}" ;;
      --add-key=*) add_key="${arg#--add-key=}" ;;
      -*) echo "  ✗ $(_t '알 수 없는 옵션: {opt}' opt="$arg")"; return 1 ;;
      *) session="$arg" ;;
    esac
    i=$((i+1))
  done

  echo ""
  echo "  🔑 $(_t 'fsh ssh — Tailscale + SSH로 tmux 세션 직접 접속')"
  echo ""

  if [ -n "$add_key" ]; then
    case "$add_key" in
      ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *)
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        touch "$HOME/.ssh/authorized_keys" && chmod 600 "$HOME/.ssh/authorized_keys"
        if grep -qF "$add_key" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
          echo "  ⓘ $(_t '이미 등록된 공개키 (중복 스킵)')"
        else
          echo "$add_key" >> "$HOME/.ssh/authorized_keys"
          echo "  ✓ $(_t '공개키를 ~/.ssh/authorized_keys에 추가했습니다')"
        fi
        echo ""
        ;;
      *)
        echo "  ✗ $(_t '공개키 형식이 아님 (ssh-ed25519/ssh-rsa/ecdsa-sha2-*로 시작해야 함)')"
        return 1
        ;;
    esac
  fi

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "  ✗ $(_t 'tailscale 미설치. brew install tailscale (macOS) 또는 https://tailscale.com/download')"
    return 1
  fi

  local ts_json
  ts_json="$(tailscale status --json 2>/dev/null)"
  if ! echo "$ts_json" | grep -q '"BackendState":"Running"'; then
    echo "  ✗ $(_t "tailscale 미실행. 'tailscale up' 실행 후 다시 시도하세요")"
    return 1
  fi

  local ts_ip
  ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
  local ts_host
  ts_host="$("$VT_PYTHON" -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print((d.get('Self') or {}).get('DNSName', '').rstrip('.'))
except Exception:
    pass
" <<<"$ts_json" 2>/dev/null)"
  local target="${ts_host:-$ts_ip}"

  if [ -z "$target" ]; then
    echo "  ✗ $(_t "tailscale IP/호스트명을 가져오지 못했습니다. 'tailscale status'로 확인하세요")"
    return 1
  fi

  # 세션을 미리 보장해두면 이후 attach가 항상 성공 + 옵트인 시 client hook도 함께 등록됨
  _ensure_tmux "$session" >/dev/null

  local tmux_cmd="tmux -L $VT_TMUX_SOCKET attach -t $session || tmux -L $VT_TMUX_SOCKET new -A -s $session"

  echo "  $(_t '이 머신의 tailnet 주소: {addr}' addr="$target")"
  echo ""
  echo "  $(_t '── 다른 기기(예: 회사 노트북)에서 아래 명령을 그대로 실행 ──')"
  echo ""
  echo "  $(_t '# 1) 일반 SSH (이 머신 ~/.ssh/authorized_keys에 공개키 등록 필요)')"
  echo "  ssh -t ${remote_user}@${target} '${tmux_cmd}'"
  echo ""
  echo "  $(_t '# 2) Tailscale SSH (tailnet에서 SSH 허용 시 — 키 등록 불필요, tailscale 계정으로 인증)')"
  echo "  tailscale ssh ${remote_user}@${target} -- '${tmux_cmd}'"
  echo ""
  if [ -z "$add_key" ]; then
    echo "  ⓘ $(_t "공개키 미등록이면: 그 기기에서 'cat ~/.ssh/id_ed25519.pub' 결과를 복사해")"
    echo "     $(_t '여기서 fsh ssh --add-key "<붙여넣은 값>" 실행')"
  fi
  echo "  ⓘ $(_t "접속하면 fsh mobile/음성/데스크톱과 같은 tmux 세션 '{session}'에 들어갑니다 (단일 tmux 서버 원칙)" session="$session")"
  echo "  ⓘ $(_t '회사망이 방화벽으로 막아도 Tailscale은 대개 UDP 홀펀칭 또는 443 DERP 폴백으로 통과함')"
  echo "  ⓘ $(_t '음성 입력은 이 경로에선 동작하지 않습니다 (SSH는 텍스트 전용) — 그냥 키보드로 입력하세요')"
  echo ""
  if [ "${VT_NOTIFY_CLIENT_EVENTS:-0}" = "1" ]; then
    echo "  🔔 $(_t '클라이언트 접속/해제 알림: 활성화됨 (VT_NOTIFY_CLIENT_EVENTS=1)')"
  else
    echo "  ⓘ $(_t '누가 언제 이 세션에 붙는지 push로 알림 받기: ~/.vt.env에 VT_NOTIFY_CLIENT_EVENTS=1 추가')"
    echo "     $(_t '(+ VT_NOTIFY_URL 또는 VT_TELEGRAM_TOKEN/CHAT_ID 설정 필요)')"
  fi
  echo ""
}

cmd_tunnel() {
  # fsh tunnel <subcommand> — Phase 8 G1 옵션 C (명명 터널 옵트인)
  # subcommands: status | setup | teardown | switch [anon|named]
  local sub="${1:-status}"

  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "  ✗ $(_t 'cloudflared 미설치')"
    return 1
  fi

  case "$sub" in
    status)
      _tunnel_print_status
      ;;
    setup)
      _tunnel_setup_named
      ;;
    teardown)
      _tunnel_teardown_named
      ;;
    switch)
      _tunnel_switch "${2:-}"
      ;;
    restart)
      echo ""
      _tunnel_restart
      echo ""
      ;;
    watchdog)
      echo ""
      if _is_running tunnel-watchdog; then
        echo "  ✓ $(_t '터널 워치독 실행 중 (PID {pid})' pid="$(cat "$PID_DIR/tunnel-watchdog.pid" 2>/dev/null)")"
      else
        echo "  ✗ $(_t '터널 워치독 중지 상태 — 시작 중...')"
        _start_tunnel_watchdog
      fi
      echo ""
      ;;
    expose)
      echo ""
      cmd_tunnel_expose "${@:2}"
      local rc=$?
      echo ""
      return $rc
      ;;
    unexpose)
      echo ""
      _stop_extra_tunnel "${2:-}" "${3:-}"
      echo ""
      ;;
    pin)
      echo ""
      cmd_tunnel_pin "${2:-}"
      echo ""
      ;;
    mode)
      echo ""
      cmd_tunnel_mode "${2:-}" "${3:-}"
      echo ""
      ;;
    auto)
      echo ""
      cmd_tunnel_auto "${2:-}" "${3:-}"
      local rc=$?
      echo ""
      return $rc
      ;;
    list)
      _tunnel_list
      ;;
    __hook-retry)
      # 내부용 — _spawn_tunnel_hook_retry가 nohup으로 띄운다.
      _tunnel_hook_retry "${2:-}"
      ;;
    hook)
      echo ""
      if [ -z "${VT_TUNNEL_HOOK:-}" ]; then
        echo "  $(_t 'VT_TUNNEL_HOOK 미설정 — URL이 바뀌어도 아무 곳에도 알리지 않습니다.')"
        echo "  $(_t 'Notion/Slack/ntfy 등으로 자동 게시하는 방법: fsh help tunnel-hook')"
        echo ""
        return 0
      fi
      echo "  $(_t '훅: {hook}' hook="$VT_TUNNEL_HOOK")"
      echo "  $(_t '전달할 내용 (stdin):')"
      _tunnel_entries | sed 's/^/    /'
      _run_tunnel_hook manual
      echo ""
      ;;
    *)
      echo "$(_t '사용법: fsh tunnel [status|list|hook|restart|watchdog|expose <port> [라벨] [--mode public|session|pin] [--ttl 1h|24h|7d|30d] [--auto-renew|--no-auto-renew]|unexpose <port>|pin <port>|mode <port> <mode>|auto <port> <on|off>|setup|teardown|switch <anon|named>]')"
      return 1
      ;;
  esac
}

_tunnel_list() {
  echo ""
  echo "  🌐 $(_t '열려 있는 터널')"
  echo ""
  local main; main="$(_main_tunnel_url)"
  if [ -n "$main" ]; then
    printf "  %-6s %-22s %s\n" "$VT_PORT" "$(_t '터미널 (FarShell)')" "$main"
  else
    echo "  $(_t '(메인 터널 없음 — fsh start)')"
  fi
  _registry_prune
  if [ -s "$TUNNEL_REGISTRY" ]; then
    # 2.2 — port_shares.json에서 포트별 모드를 읽어 같이 보여준다(plan §6).
    # 정책이 없는 행(레거시/내부 호출)은 "-"로 둔다.
    local modes; modes="$(_port_share_cli cli-list 2>/dev/null)"
    # modes는 정책마다 한 줄이라 줄바꿈이 들어 있다 — awk -v 로 넘기면 macOS 기본 awk(BWK)가
    # "newline in string"으로 프로그램 전체를 포기해 정책이 2개 이상일 때 행이 하나도 안 나온다.
    # 환경변수로 넘기면 줄바꿈을 그대로 읽는다(macOS·Linux 공통).
    MODES="$modes" awk -F'\t' -v failfmt="$(_t '실패{n}')" -v autofmt="$(_t '자동')" '
      BEGIN {
        n = split(ENVIRON["MODES"], lines, "\n")
        for (i = 1; i <= n; i++) {
          split(lines[i], f, "\t")
          if (f[1] != "") {
            mode_of[f[1]] = f[2]
            if (f[3] == "1") mode_of[f[1]] = mode_of[f[1]] " ⚠broken"
            # PIN 실패 누적 — 공격받고 있는지 알 수 있게(share는 잠그지 않는다)
            if (f[4] != "" && f[4] != "0") { fl = failfmt; i2 = index(fl, "{n}"); fl = substr(fl, 1, i2 - 1) f[4] substr(fl, i2 + 3); mode_of[f[1]] = mode_of[f[1]] " " fl }
            if (f[5] == "1") mode_of[f[1]] = mode_of[f[1]] " " autofmt
          }
        }
      }
      { m = ($1 in mode_of) ? mode_of[$1] : "-"
        printf "  %-6s %-22s %-16s %s\n", $1, ($3==""?"-":$3), m, $2 }
    ' "$TUNNEL_REGISTRY"
  fi
  echo ""
  if vt_is_en; then
    echo "  Add:           fsh tunnel expose 3000 \"RAPA app\" [--mode public|session|pin] [--ttl 1h|24h|7d|30d] [--auto-renew]"
    echo "  Remove:        fsh tunnel unexpose 3000"
    echo "  Reissue code:  fsh tunnel pin 3000"
    echo "  Change mode:   fsh tunnel mode 3000 <public|session|pin>"
    echo "  Auto re-expose: fsh tunnel auto 3000 <on|off>"
  else
    echo "  추가:      fsh tunnel expose 3000 \"RAPA 앱\" [--mode public|session|pin] [--ttl 1h|24h|7d|30d] [--auto-renew]"
    echo "  해제:      fsh tunnel unexpose 3000"
    echo "  코드 재발급: fsh tunnel pin 3000"
    echo "  모드 변경:  fsh tunnel mode 3000 <public|session|pin>"
    echo "  자동 재노출: fsh tunnel auto 3000 <on|off>"
  fi
  echo ""
}

_tunnel_print_status() {
  echo ""
  echo "  🌐 $(_t 'Cloudflare Tunnel 상태')"
  echo ""
  local pids
  pids="$(pgrep -f '^([^ ]*/)?cloudflared[[:space:]]+tunnel' 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$pids" ]; then
    echo "  $(_t '실행:    ')✓ $(_t 'PID(s) {pids}  (메인: {main})' pids="$pids" main="$(_main_tunnel_pids)")"
  else
    echo "  $(_t '실행:    ')✗ $(_t '중지')"
  fi

  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "  $(_t '모드:    ')$(_t '명명 (named)')"
    echo "  $(_t '이름:    ')$VT_TUNNEL_NAME"
    echo "  $(_t '호스트:  ')$VT_TUNNEL_HOSTNAME"
    echo "  URL:     https://$VT_TUNNEL_HOSTNAME"
  else
    echo "  $(_t '모드:    ')$(_t '익명 (anonymous, trycloudflare.com)')"
    local url
    url=$(_quick_tunnel_url_from_log "$TUNNEL_LOG")
    [ -n "$url" ] && echo "  URL:     $url"
  fi

  if [ -d "$HOME/.cloudflared" ] && [ -f "$HOME/.cloudflared/cert.pem" ]; then
    echo "  $(_t '인증:    ')✓ $(_t '~/.cloudflared/cert.pem 있음')"
    local count
    count="$(ls -1 "$HOME/.cloudflared"/*.json 2>/dev/null | wc -l | tr -d ' ')"
    echo "  $(_t '터널 수: ')$(_t '{n} (credentials JSON 파일)' n="$count")"
  else
    echo "  $(_t '인증:    ')✗ $(_t "~/.cloudflared/cert.pem 없음 — 'cloudflared tunnel login' 필요")"
  fi
  echo ""
}

_tunnel_setup_named() {
  echo ""
  echo "  🔧 $(_t 'fsh tunnel setup — 명명 터널 마법사')"
  echo ""
  echo "  $(_t '요구사항:')"
  echo "    1. $(_t 'Cloudflare 계정')"
  echo "    2. $(_t 'Cloudflare DNS에 등록된 도메인')"
  echo "  $(_t '계속하시겠습니까? (y/N)')"
  read -r ans
  case "$ans" in y|Y|yes) ;; *) echo "  $(_t '중단됨')"; return 1 ;; esac

  # 1. cloudflared 인증
  if [ ! -f "$HOME/.cloudflared/cert.pem" ]; then
    echo ""
    echo "▸ $(_t 'cloudflared 인증 (브라우저 자동 열림)...')"
    cloudflared tunnel login || { echo "✗ $(_t '인증 실패')"; return 1; }
  else
    echo "✓ $(_t 'cloudflared 이미 인증됨')"
  fi

  # 2. 터널 이름
  echo ""
  printf "%s " "$(_t '터널 이름 (default: vt-mobile):')"
  read -r tunnel_name
  tunnel_name="${tunnel_name:-vt-mobile}"

  # 3. 호스트명
  echo ""
  printf "%s " "$(_t '호스트명 (예: vt.example.com):')"
  read -r hostname
  if [ -z "$hostname" ]; then
    echo "  ✗ $(_t '호스트명 필요')"
    return 1
  fi

  # 4. 터널 생성
  echo ""
  echo "▸ $(_t '터널 생성: {name}' name="$tunnel_name")"
  cloudflared tunnel create "$tunnel_name" 2>&1 | tail -5
  if [ $? -ne 0 ]; then
    echo "  ⓘ $(_t '이미 존재하는 이름이면 무시 가능')"
  fi

  # 5. DNS 라우팅
  echo ""
  echo "▸ $(_t 'DNS 라우팅: {name} → {host}' name="$tunnel_name" host="$hostname")"
  cloudflared tunnel route dns "$tunnel_name" "$hostname" 2>&1 | tail -3 || {
    echo "  ⚠ $(_t 'DNS 라우팅 실패 — 도메인이 Cloudflare DNS인지 확인')"
  }

  # 6. config.yml 생성
  local cf_dir="$HOME/.cloudflared"
  local config_yml="$cf_dir/config.yml"
  local creds_json="$cf_dir/${tunnel_name}.json"
  if [ ! -f "$creds_json" ]; then
    # UUID 형태 파일 찾기
    creds_json="$(ls -1 "$cf_dir"/*.json 2>/dev/null | head -1)"
  fi
  cat > "$config_yml" <<EOF
tunnel: $tunnel_name
credentials-file: $creds_json
ingress:
  - hostname: $hostname
    service: http://localhost:${VT_PORT:-7777}
  - service: http_status:404
EOF
  echo "✓ $(_t 'config.yml 작성: {path}' path="$config_yml")"

  # 7. ~/.vt.env에 저장
  vt_env_set "VT_TUNNEL_NAME" "$tunnel_name" || return 1
  vt_env_set "VT_TUNNEL_HOSTNAME" "$hostname" || return 1
  echo "✓ $(_t '~/.vt.env에 저장')"

  echo ""
  echo "  ✅ $(_t '명명 터널 설정 완료')"
  echo "    $(_t "이제 접속 주소로 https://{host} 를 씁니다 ('fsh mobile'이 이 주소로 QR을 만듭니다)" host="$hostname")"
  echo "    $(_t '(DNS 전파 ~1분 소요 가능)')"
}

_tunnel_teardown_named() {
  echo ""
  echo "  ⚠️  $(_t '명명 터널 제거')"
  local none; none="$(_t '(없음)')"
  echo "  $(_t '현재 설정: {name} → {host}' name="${VT_TUNNEL_NAME:-$none}" host="${VT_TUNNEL_HOSTNAME:-$none}")"
  echo "  $(_t '~/.vt.env에서 제거하고 익명 터널로 fallback (cloudflared 터널 자체는 유지).')"
  echo "  $(_t '계속? (y/N)')"
  read -r ans
  case "$ans" in y|Y|yes) ;; *) echo "  $(_t '중단됨')"; return 1 ;; esac

  if vt_env_unset "VT_TUNNEL_NAME" "VT_TUNNEL_HOSTNAME"; then
    echo "✓ $(_t '~/.vt.env에서 VT_TUNNEL_NAME/HOSTNAME 제거')"
  fi
  echo ""
  echo "  ⓘ $(_t 'cloudflared 터널 자체를 삭제하려면:')"
  echo "    cloudflared tunnel delete <name>"
  echo "    cloudflared tunnel route dns <name> <hostname> --overwrite-dns"
}

_tunnel_switch() {
  local mode="${1:-}"
  case "$mode" in
    anon|anonymous)
      unset VT_TUNNEL_NAME VT_TUNNEL_HOSTNAME
      echo "✓ $(_t '현재 셸: 익명 터널 모드 (영구 적용은 fsh tunnel teardown)')"
      ;;
    named)
      if [ -z "${VT_TUNNEL_NAME:-}" ] || [ -z "${VT_TUNNEL_HOSTNAME:-}" ]; then
        echo "  ✗ $(_t '명명 터널 미설정. fsh tunnel setup 먼저 실행')"
        return 1
      fi
      echo "✓ $(_t '현재 셸: 명명 터널 사용 ({host})' host="$VT_TUNNEL_HOSTNAME")"
      ;;
    *)
      echo "$(_t '사용법: fsh tunnel switch <anon|named>')"
      return 1 ;;
  esac
}

cmd_setup_keybind() {
  # fsh setup-keybind [key] [action] — Phase 7 #7-2 (lunemis/mux popup.go 차용)
  # tmux conf에 popup 키바인딩 자동 등록. oh-my-tmux 호환, 마커 멱등 갱신, sentinel 보호.
  local key="${1:-v}"
  local action="${2:-status}"

  # tmux 3.2+ 확인
  if ! command -v tmux >/dev/null 2>&1; then
    echo "  ✗ $(_t 'tmux 미설치')"
    return 1
  fi
  local tmux_ver first_ver
  tmux_ver="$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[a-z]$//')"
  first_ver="$(printf '3.2\n%s' "$tmux_ver" | sort -V | head -1)"
  if [ "$first_ver" != "3.2" ]; then
    echo "  ✗ $(_t 'tmux 3.2+ 필요 (현재: {ver})' ver="$tmux_ver")"
    return 1
  fi

  local self_path
  self_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  [ -L "$self_path" ] && self_path="$(readlink "$self_path")"

  local bind_line="bind $key display-popup -E -w 85% -h 80% \"$self_path $action\""
  local marker="# fsh popup keybinding"
  local tagged="${bind_line}  ${marker}"

  local conf_path
  conf_path="$(_find_tmux_conf)"

  if _is_oh_my_tmux "$conf_path"; then
    local local_path
    local_path="$(_find_tmux_conf_local "$conf_path")"
    _write_bind_to_local "$local_path" "$tagged" "$marker"
    # 메인 conf의 옛 잘못된 라인 정리
    local removed=0
    _strip_marker_lines "$conf_path" "$marker" && removed=1
    echo "  ✓ $(_t 'oh-my-tmux 감지 → {path}' path="$local_path")"
    echo "    $bind_line"
    if [ $removed -eq 1 ]; then
      echo "  ⓘ $(_t '{path}에서 옛 fsh 라인 제거 (oh-my-tmux heredoc 보호)' path="$conf_path")"
    fi
    echo ""
    echo "  reload: tmux source-file $local_path"
  else
    _upsert_bind_line "$conf_path" "$tagged" "$marker"
    echo "  ✓ $(_t '등록 → {path}' path="$conf_path")"
    echo "    $bind_line"
    echo ""
    echo "  reload: tmux source-file $conf_path"
  fi
  echo "  $(_t '사용: prefix + {key}  (default prefix: Ctrl+b)' key="$key")"
}

_find_tmux_conf() {
  if [ -n "${XDG_CONFIG_HOME:-}" ] && [ -f "$XDG_CONFIG_HOME/tmux/tmux.conf" ]; then
    echo "$XDG_CONFIG_HOME/tmux/tmux.conf"; return
  fi
  if [ -f "$HOME/.config/tmux/tmux.conf" ]; then
    echo "$HOME/.config/tmux/tmux.conf"; return
  fi
  if [ -f "$HOME/.tmux.conf" ]; then
    echo "$HOME/.tmux.conf"; return
  fi
  # 없으면 default 위치 (생성될 곳)
  echo "$HOME/.tmux.conf"
}

_find_tmux_conf_local() {
  local conf="$1"
  local dir base
  dir="$(dirname "$conf")"
  base="$(basename "$conf")"
  case "$base" in
    tmux.conf)  echo "$dir/tmux.conf.local" ;;
    .tmux.conf) echo "$dir/.tmux.conf.local" ;;
    *)          echo "$conf.local" ;;
  esac
}

_is_oh_my_tmux() {
  local conf="$1"
  [ -f "$conf" ] || return 1
  # 전략 1: symlink 타겟에 .tmux/ 포함
  if [ -L "$conf" ]; then
    local target
    target="$(readlink "$conf")"
    case "$target" in
      */.tmux/*) return 0 ;;
    esac
  fi
  # 전략 2: 첫 줄이 oh-my-tmux heredoc 시그니처
  local first_line
  first_line="$(head -1 "$conf" 2>/dev/null)"
  [ "$first_line" = "# : << 'EOF'" ] && return 0
  return 1
}

_upsert_bind_line() {
  # path, tagged_line, marker
  local path="$1" tagged="$2" marker="$3"
  local tmp
  tmp="$(mktemp)"
  if [ -f "$path" ]; then
    local replaced=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *"$marker"*) printf '%s\n' "$tagged" >> "$tmp"; replaced=1 ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$path"
    if [ $replaced -eq 0 ]; then
      printf '\n%s\n' "$tagged" >> "$tmp"
    fi
  else
    printf '%s\n' "$tagged" > "$tmp"
  fi
  mv "$tmp" "$path"
}

_write_bind_to_local() {
  # path, tagged_line, marker — sentinel ('# "$@"') 앞 삽입
  local path="$1" tagged="$2" marker="$3"
  local tmp
  tmp="$(mktemp)"
  local sentinel='# "$@"'

  if [ ! -f "$path" ]; then
    printf '%s\n' "$tagged" > "$path"
    return
  fi

  # marker 라인 있으면 in-place 교체
  if grep -qF "$marker" "$path" 2>/dev/null; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *"$marker"*) printf '%s\n' "$tagged" >> "$tmp" ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$path"
    mv "$tmp" "$path"
    return
  fi

  # sentinel 있으면 그 앞에 빈줄+태그+빈줄 삽입
  if grep -qxF "$sentinel" "$path" 2>/dev/null; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [ "$line" = "$sentinel" ]; then
        printf '\n%s\n\n' "$tagged" >> "$tmp"
      fi
      printf '%s\n' "$line" >> "$tmp"
    done < "$path"
    mv "$tmp" "$path"
    return
  fi

  # sentinel 없으면 EOF append
  rm -f "$tmp"
  printf '\n%s\n' "$tagged" >> "$path"
}

_strip_marker_lines() {
  # path, marker — 마커 또는 legacy 패턴 라인 제거
  local path="$1" marker="$2"
  [ -f "$path" ] || return 1
  if ! grep -qF "$marker" "$path" 2>/dev/null; then
    # legacy 패턴 (마커 없이 등록된 옛 라인)
    if ! grep -qE 'display-popup .*"fsh ' "$path" 2>/dev/null; then
      return 1
    fi
  fi
  local tmp
  tmp="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *"$marker"*) ;;
      *'display-popup'*'"fsh '*) ;;
      *) printf '%s\n' "$line" >> "$tmp" ;;
    esac
  done < "$path"
  mv "$tmp" "$path"
  return 0
}

cmd_install_profiles() {
  # Phase 6 #6-2: 터미널 앱 profile 자동 등록
  # --dry-run: 변경 없이 미리보기만
  local dry_run=0
  for arg in "$@"; do
    [ "$arg" = "--dry-run" ] && dry_run=1
  done

  echo ""
  echo "  📦 $(_t 'fsh install-profiles — 터미널 앱 profile 자동 등록')"
  if [ $dry_run -eq 1 ]; then
    echo "  $(_t '(dry-run: 실제 변경 없음)')"
  fi
  echo ""

  local installed=0 skipped=0 hinted=0

  # iTerm2 Dynamic Profile (자동 등록)
  if [ -d "/Applications/iTerm.app" ]; then
    if _install_iterm_profile "$dry_run"; then
      installed=$((installed+1))
    else
      skipped=$((skipped+1))
    fi
  fi

  # Ghostty (config 주석 추가 — 사용자가 # 제거하여 활성화)
  if [ -d "/Applications/Ghostty.app" ] || command -v ghostty >/dev/null 2>&1; then
    if _install_ghostty_profile "$dry_run"; then
      installed=$((installed+1))
    else
      skipped=$((skipped+1))
    fi
  fi

  # WezTerm / Kitty / Alacritty / Windows Terminal — snippet 안내 (자동 편집은 위험)
  if command -v wezterm >/dev/null 2>&1 || [ -d "/Applications/WezTerm.app" ]; then
    _print_wezterm_snippet
    hinted=$((hinted+1))
  fi
  if command -v kitty >/dev/null 2>&1 || [ -d "/Applications/kitty.app" ]; then
    _print_kitty_snippet
    hinted=$((hinted+1))
  fi
  if command -v alacritty >/dev/null 2>&1 || [ -d "/Applications/Alacritty.app" ]; then
    _print_alacritty_snippet
    hinted=$((hinted+1))
  fi
  # Windows Terminal (WSL2)
  if grep -qi microsoft /proc/version 2>/dev/null; then
    _print_windows_terminal_snippet
    hinted=$((hinted+1))
  fi

  # macOS Terminal.app — 가이드만
  if [ "$(uname)" = "Darwin" ]; then
    _print_terminal_app_snippet
    hinted=$((hinted+1))
  fi

  echo ""
  echo "  $(_t '결과:') ✓ $(_t '{n}개 자동 등록' n="$installed"), ⓘ $(_t '{n}개 건너뜀' n="$skipped"), 📋 $(_t '{n}개 snippet 안내' n="$hinted")"
  echo ""
  if [ $dry_run -eq 1 ]; then
    echo "  $(_t '실제 적용: fsh install-profiles (옵션 없이 재실행)')"
    echo ""
  fi
}

_install_iterm_profile() {
  local dry_run="$1"
  local DIR="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
  local FILE="$DIR/fsh.json"
  local OLD_FILE="$DIR/vt.json"
  local cmd="tmux -L $VT_TMUX_SOCKET new -A -s dev"

  if [ "$dry_run" = "1" ]; then
    echo "  [dry-run] $(_t 'iTerm2 → {path} 생성/갱신' path="$FILE")"
    [ -f "$OLD_FILE" ] && echo "  [dry-run] $(_t '구 프로필 제거 → {path} (Guid가 바뀌어 중복 방지)' path="$OLD_FILE")"
    return 0
  fi

  mkdir -p "$DIR"
  cat > "$FILE" <<EOF
{
  "Profiles": [{
    "Name": "fsh (FarShell)",
    "Guid": "fsh-farshell",
    "Custom Command": "Custom Shell",
    "Command": "/bin/zsh -c '$cmd'",
    "Working Directory Type": "Recycle"
  }]
}
EOF
  # 구 파일(vt.json, Guid=vt-farshell)이 남아 있으면 iTerm2가 두 프로필을 동시에
  # 보여준다 — Guid를 바꾼 김에 구 파일도 정리해 중복 등록을 막는다.
  if [ -f "$OLD_FILE" ]; then
    rm -f "$OLD_FILE"
    echo "  ✓ $(_t '구 iTerm2 프로필 제거 (Guid 변경으로 인한 중복 방지) → {path}' path="$OLD_FILE")"
  fi
  echo "  ✓ iTerm2 Dynamic Profile → $FILE"
  echo "    $(_t "iTerm2 재시작 후 Profiles 메뉴에서 'fsh (FarShell)' 선택")"
  return 0
}

_install_ghostty_profile() {
  local dry_run="$1"
  local CFG="$HOME/.config/ghostty/config"
  local snippet="# fsh (FarShell) — auto-attach (활성화 원하면 아래 # 제거)
# command = tmux -L $VT_TMUX_SOCKET new -A -s dev"

  # 예전 리네임(vt→fsh, farshell→FarShell) 이전에 등록된 마커도 인식해야
  # 중복 등록을 안 한다 — 이미 써둔 사용자 설정 파일을 소급 수정하진 않는다
  # (어차피 사람이 안 읽는 주석이라 그대로 둬도 무해하고, 잘못 건드리면
  # 사용자가 손으로 고쳐둔 부분까지 덮어쓸 위험이 있다).
  if grep -qE '# (vt|fsh) \((vt|farshell|FarShell)\) — auto-attach' "$CFG" 2>/dev/null; then
    echo "  ⓘ $(_t 'Ghostty 이미 등록됨: {path}' path="$CFG")"
    return 1
  fi

  if [ "$dry_run" = "1" ]; then
    echo "  [dry-run] $(_t 'Ghostty → {path} 에 다음 추가:' path="$CFG")"
    echo "$snippet" | sed 's/^/      /'
    return 0
  fi

  mkdir -p "$(dirname "$CFG")"
  printf '\n%s\n' "$snippet" >> "$CFG"
  echo "  ✓ $(_t 'Ghostty config 주석 추가 → {path}' path="$CFG")"
  echo "    $(_t "활성화: {path} 열어 'command =' 라인의 # 제거" path="$CFG")"
  return 0
}

_print_wezterm_snippet() {
  cat <<EOF

  📋 WezTerm — $(_t '~/.config/wezterm/wezterm.lua 에 추가:')

      config.default_prog = { 'tmux', '-L', '$VT_TMUX_SOCKET', 'new', '-A', '-s', 'dev' }

EOF
}

_print_kitty_snippet() {
  cat <<EOF

  📋 Kitty — $(_t '~/.config/kitty/kitty.conf 에 추가:')

      shell tmux -L $VT_TMUX_SOCKET new -A -s dev

EOF
}

_print_alacritty_snippet() {
  cat <<EOF

  📋 Alacritty — $(_t '~/.config/alacritty/alacritty.toml 에 추가:')

      [shell]
      program = "tmux"
      args = ["-L", "$VT_TMUX_SOCKET", "new", "-A", "-s", "dev"]

EOF
}

_print_windows_terminal_snippet() {
  cat <<EOF

  📋 Windows Terminal (WSL2) — $(_t 'settings.json profile에 추가:')
     %LOCALAPPDATA%/Packages/Microsoft.WindowsTerminal_*/LocalState/settings.json

      "commandline": "wsl.exe -e tmux -L $VT_TMUX_SOCKET new -A -s dev"

EOF
}

_print_terminal_app_snippet() {
  cat <<EOF

  📋 macOS Terminal.app — Profiles → Shell → "Run command":

      tmux -L $VT_TMUX_SOCKET new -A -s dev

      $(_t '(체크: "Run command in shell")')

EOF
}

cmd_shell_init() {
  # Phase 6 #6-3: 셸별 안전 통합 스니펫 출력
  # 사용법: eval "$(fsh shell-init zsh)" >> ~/.zshrc 형태로 한 줄 통합
  local shell="${1:-zsh}"
  case "$shell" in
    zsh)             _print_zsh_init ;;
    bash)            _print_bash_init ;;
    fish)            _print_fish_init ;;
    pwsh|powershell) _print_pwsh_init ;;
    *)
      echo "$(_t '사용법: fsh shell-init [zsh|bash|fish|pwsh]')" >&2
      return 1
      ;;
  esac
}

_print_zsh_init() {
  cat <<EOF
# fsh shell-init zsh — instant prompt 위에 배치 (p10k와 함께 쓰는 경우 ~/.zshrc 최상단)
if [[ -o interactive ]] \\
   && [[ -t 0 && -t 1 ]] \\
   && [[ -z "\$TMUX" ]] \\
   && [[ -z "\$INSIDE_EMACS\$VSCODE_INJECTION\$ZED_TERM\$INTELLIJ_ENVIRONMENT_READER" ]] \\
   && command -v tmux >/dev/null; then
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
fi
EOF
}

_print_bash_init() {
  cat <<EOF
# fsh shell-init bash — ~/.bashrc 또는 ~/.bash_profile 상단에 추가
case \$- in *i*) ;; *) return ;; esac
if [ -t 0 ] && [ -t 1 ] && [ -z "\$TMUX" ] \\
   && [ -z "\$INSIDE_EMACS\$VSCODE_INJECTION\$ZED_TERM" ] \\
   && command -v tmux >/dev/null; then
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
fi
EOF
}

_print_fish_init() {
  cat <<EOF
# fsh shell-init fish — ~/.config/fish/config.fish에 추가
if status is-interactive
  and not set -q TMUX
  and isatty stdin
  and isatty stdout
  and not set -q INSIDE_EMACS
  and not set -q VSCODE_INJECTION
  and not set -q ZED_TERM
  and command -v tmux >/dev/null
  exec tmux -L $VT_TMUX_SOCKET new -A -s dev
end
EOF
}

_print_pwsh_init() {
  cat <<EOF
# fsh shell-init pwsh — \$PROFILE에 추가 (WSL2 PowerShell용)
# Windows Terminal profile에 직접 등록을 더 권장
if (-not \$env:TMUX -and -not \$env:INSIDE_EMACS) {
  if (Get-Command tmux -ErrorAction SilentlyContinue) {
    & tmux -L $VT_TMUX_SOCKET new -A -s dev
    exit
  }
}
EOF
}

# ngrok 상태 — fsh가 관리하지 않는 외부 터널이지만, 공개 입구가 그것 하나뿐일 때
# status 화면이 "외부 접속 경로 없음"처럼 읽히는 걸 막는다(2026-09-17).
# 감지되지 않으면 줄 자체를 출력하지 않는다 — ngrok을 안 쓰는 사람 화면은 그대로다.
_ngrok_status() {
  local url
  if url="$(_ngrok_public_url "$VT_PORT")"; then
    # provider=ngrok이면 fsh가 띄우고 끄는 대상이다. 아니라면 사용자가 직접
    # 띄운 것이므로 "fsh가 관리하지 않음"을 붙인다 — fsh stop이 안 끄는 걸
    # 버그로 읽지 않게 하는 유일한 단서다.
    if [ "$(_tunnel_provider)" = "ngrok" ]; then
      echo "✓ $url → :$VT_PORT"
    else
      echo "✓ $url → :$VT_PORT  ($(_t 'fsh가 관리하지 않음'))"
    fi
    return 0
  fi
  # 프로세스는 있는데 에이전트 API가 안 열린 경우 — "없음"이라고 말하면 안 된다.
  if pgrep -f "ngrok .*http" >/dev/null 2>&1; then
    echo "⚠ $(_t '실행 중 (URL 확인 불가 — ngrok 에이전트 API 무응답)')"
    return 0
  fi
  return 1
}
# `fsh status`의 "접속 보안" 블록 — 외부에서 이 서버에 누가, 어떻게 들어올 수 있는지.
# 특정 사용자의 값이 아니라 설정에서 읽은 값만 보여준다. 접속 범위가 열려 있는데 인증이
# 없으면 그 자체를 경고한다(공개 주소 = 인증 없는 원격 셸).
_status_security_block() {
  local mode spec_note="" auth_json protected="false" auth_kind="" otp_state ndev
  mode="$(_current_network_mode)"
  [ -n "${VT_ACCESS_SPEC:-}" ] && spec_note=" · $(_t '허용 목록(VT_ACCESS_SPEC): {spec}' spec="$VT_ACCESS_SPEC")"

  local mode_desc
  case "$mode" in
    all)       mode_desc="all — $(_t '인터넷 어디서나 도달 가능 (인증으로 보호)')" ;;
    tailscale) mode_desc="tailscale — $(_t '같은 tailnet에서만')" ;;
    lan)       mode_desc="lan — $(_t '같은 네트워크에서만')" ;;
    localhost) mode_desc="localhost — $(_t '이 맥에서만')" ;;
    *)         mode_desc="$mode" ;;
  esac

  # 외부 주소: 명명 터널(도메인 고정)인지, 익명 터널(재시작하면 바뀜)인지
  local entry; entry="$(_t '없음')"
  if [ "$mode" = "all" ]; then
    local ext
    ext="$(_mode_access_url all 2>/dev/null)"
    if [ -n "$ext" ]; then
      if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
        entry="$ext ($(_t '고정 도메인'))"
      elif [ "$(_tunnel_provider)" = "ngrok" ] && [ -n "${VT_NGROK_DOMAIN:-}" ]; then
        entry="$ext ($(_t '고정 도메인'))"
      else
        entry="$ext ($(_t '익명 터널 — 터널을 다시 띄우면 주소가 바뀜'))"
      fi
    else
      entry="$(_t '터널이 실행 중이 아님')"
    fi
  fi

  auth_json="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m auth status 2>/dev/null)"
  case "$auth_json" in *'"protected": true'*) protected="true" ;; esac
  [ -n "${VT_AUTH_PASSWORD_HASH:-}" ] && auth_kind="$(_t '비밀번호')"
  [ -n "${VT_AUTH_TOKEN:-}" ] && auth_kind="${auth_kind:+$auth_kind + }$(_t '기계 토큰')"

  otp_state="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m auth otp-status 2>/dev/null)"
  case "$otp_state" in
    *'"enabled": true'*)  otp_state="✓ $(_t '켜짐 (새 기기 등록 시 OTP 요구)')" ;;
    *)                    otp_state="✗ $(_t '꺼짐 — 비밀번호만으로 새 기기 등록 가능 (fsh otp setup)')" ;;
  esac
  ndev="$(cd "$VT_DIR/server" && "$VT_PYTHON" -m auth device-list 2>/dev/null | "$VT_PYTHON" -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null)"

  echo "  $(_t '접속 보안:')"
  echo "    $(_t '접근 범위:  ')${mode_desc}${spec_note}"
  echo "    $(_t '외부 주소:  ')$entry"
  if [ "$protected" = "true" ]; then
    echo "    $(_t '인증:       ')✓ ${auth_kind:-$(_t '설정됨')}"
  else
    echo "    $(_t '인증:       ')✗ $(_t '없음')"
  fi
  echo "    $(_t 'OTP:        ')$otp_state"
  local _sk; _sk="$(_sock_status_line 2>/dev/null)"
  [ -n "$_sk" ] && echo "    $(_t '소켓:       ')${_sk#*$'\t'}"
  echo "    $(_t '등록 기기:  ')$(_t '{n}개 (fsh device list)' n="${ndev:-?}")"
  if [ "$mode" = "all" ] && [ "$protected" != "true" ]; then
    echo "    ⚠ $(_t "공개 접속인데 인증이 없습니다 — URL을 아는 누구나 이 맥에서 명령을 실행할 수 있습니다. 'fsh password'로 설정하세요.")"
  fi
}

cmd_status() {
  echo ""
  echo "  📊 fsh status"
  echo ""

  local server_status; server_status="✗ $(_t '중지')"
  local tunnel_status; tunnel_status="✗ $(_t '중지')"
  local ts_status; ts_status="✗ $(_t '미설치')"
  local voice_status; voice_status="✗ $(_t '중지')"
  local clip_status; clip_status="✗ $(_t '중지')"
  local watchdog_status; watchdog_status="✗ $(_t '중지')"
  local tmux_status; tmux_status="✗ $(_t '없음')"

  if _port_in_use $VT_PORT; then
    server_status="✓ $(_t '실행 중 (port {port})' port="$VT_PORT")"
  fi
  local stale_warn
  stale_warn="$(_stale_server_warning)"

  # Phase 8 G1: cloudflared 정밀 표시
  local tunnel_installed="✗"
  command -v cloudflared >/dev/null 2>&1 && tunnel_installed="✓"
  local tunnel_pids
  tunnel_pids="$(_main_tunnel_pids)"
  if [ -n "$tunnel_pids" ]; then
    local url
    if [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
      url="https://$VT_TUNNEL_HOSTNAME"
    else
      url=$(_quick_tunnel_url_from_log "$TUNNEL_LOG")
    fi
    tunnel_status="✓ PID $tunnel_pids — $url"
  fi

  # D9: Tailscale 상태 (회사망 등에서 fsh ssh로 접속하는 경로)
  if command -v tailscale >/dev/null 2>&1; then
    local ts_ip
    ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    if [ -n "$ts_ip" ]; then
      ts_status="✓ $ts_ip"
    else
      ts_status="⚠ $(_t "설치됨, 미연결 ('tailscale up' 필요)")"
    fi
  fi

  if _is_running voice; then
    voice_status="✓ $(_t '실행 중 (Ctrl+Shift+M)')"
  fi

  if _is_running clip; then
    clip_status="✓ $(_t '실행 중')"
  fi

  if _is_running tunnel-watchdog; then
    watchdog_status="✓ $(_t '실행 중 (좀비 재연결 자동 감지)')"
  fi

  if "${TMUX_BASE[@]}" list-sessions 2>/dev/null | grep -q .; then
    tmux_status="✓ $("${TMUX_BASE[@]}" list-sessions -F '#{session_name}' | tr '\n' ' ')"
  fi

  echo "  $(_t '서버:        ')$server_status"
  [ -n "$stale_warn" ] && echo "               ⚠ $stale_warn"
  # 제공자가 cloudflare가 아니면, cloudflared가 실제로 떠 있을 때만 보여준다.
  # 안 쓰는 제공자의 "✗ 중지"를 계속 띄우면 화면이 문제처럼 읽힌다.
  if [ "$(_tunnel_provider)" = "cloudflare" ] || [ -n "$tunnel_pids" ]; then
  echo "  Cloudflare:"
  echo "    $(_t '설치:       ')$tunnel_installed"
  echo "    $(_t '실행:       ')$tunnel_status"
  if [ -n "${VT_TUNNEL_NAME:-}" ] && [ -n "${VT_TUNNEL_HOSTNAME:-}" ]; then
    echo "    $(_t '모드:       ')$(_t '명명 (named)') → $VT_TUNNEL_HOSTNAME"
  else
    echo "    $(_t '모드:       ')$(_t '익명 (anonymous, trycloudflare.com)')"
  fi
  _registry_prune
  if [ -s "$TUNNEL_REGISTRY" ]; then
    echo "    $(_t '추가 포트:')"
    awk -F'\t' '{printf "      %-6s %s  (%s)\n", $1, $2, ($3==""?"-":$3)}' "$TUNNEL_REGISTRY"
  fi
  fi
  local ngrok_line
  if ngrok_line="$(_ngrok_status)"; then
    echo "  ngrok:       $ngrok_line"
  fi
  echo "  $(_t '터널 제공자: ')$(_tunnel_provider)${VT_TUNNEL_PROVIDER:+ (VT_TUNNEL_PROVIDER)}"
  # 이 창이 낡은 export를 들고 있었다는 사실 자체가 정보다 — 조용히 고치면
  # "왜 내가 export한 값이 안 먹지"를 아무도 설명해 주지 못한다.
  if [ -n "${VT_ENV_BOUNDARY_FIXED:-}" ]; then
    echo "  ⚠ $(_t '낡은 환경변수를 설정 파일 값으로 바로잡음: {vars}' vars="$VT_ENV_BOUNDARY_FIXED")"
    echo "     $(_t '(이 창이 예전 값을 들고 있습니다. 창을 새로 여는 게 좋습니다)')"
  fi
  if [ -n "${VT_TUNNEL_HOOK:-}" ]; then
    echo "  $(_t 'URL 변경 훅: ')✓ $(_t '설정됨') (fsh tunnel hook)"
  else
    echo "  $(_t 'URL 변경 훅: ')✗ $(_t '미설정') (fsh help tunnel-hook)"
  fi
  echo "  $(_t '터널 워치독: ')$watchdog_status"
  _status_security_block
  echo "  Tailscale:   $ts_status  ($(_t '이 맥에 SSH로 붙는 명령 안내: fsh ssh'))"
  echo "  Voice Daemon: $voice_status"
  echo "  Clipboard:   $clip_status"
  echo "  tmux:        $tmux_status"
  echo ""
}

# --- Main ---
case "${1:-help}" in
  voice)   cmd_voice ;;
  clip)    cmd_clip ;;
  mobile)  shift; cmd_mobile "$@" ;;
  start)   shift 2>/dev/null || true; cmd_start "$@" ;;
  stop)    shift 2>/dev/null || true; cmd_stop "$@" ;;
  restart) shift 2>/dev/null || true; cmd_restart "$@" ;;
  status)  cmd_status ;;
  handoff)  shift; cmd_handoff "$@" ;;
  attach)   shift; cmd_attach "$@" ;;
  terminal) shift; cmd_terminal "$@" ;;
  ssh)      shift; cmd_ssh "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  shell-init) shift; cmd_shell_init "$@" ;;
  install-profiles) shift; cmd_install_profiles "$@" ;;
  setup-keybind) shift; cmd_setup_keybind "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  template) shift; cmd_template "$@" ;;
  popup)    shift; cmd_popup "$@" ;;
  run)      shift; cmd_run "$@" ;;
  queue)    shift; cmd_queue "$@" ;;
  delegate) shift; cmd_delegate "$@" ;;
  migrate-auth) shift; cmd_migrate_auth "$@" ;;
  files)    shift; cmd_files "$@" ;;
  host|hosts) shift; cmd_host "$@" ;;
  mcp)      shift; cmd_mcp "$@" ;;
  msg)      shift; cmd_msg "$@" ;;
  worktree|wt) shift; cmd_worktree "$@" ;;
  usage)    shift; cmd_usage "$@" ;;
  help)     shift 2>/dev/null || true; cmd_help "$@" ;;
  hotkey)   shift; cmd_hotkey "$@" ;;
  hooks)    shift; cmd_hooks "$@" ;;
  pane)     shift; cmd_pane "$@" ;;
  clauth)   shift; cmd_clauth "$@" ;;
  password) shift; cmd_password "$@" ;;
  otp)      shift; cmd_otp "$@" ;;
  device|devices) shift; cmd_device "$@" ;;
  git-account) shift; cmd_git_account "$@" ;;
  voice-bind) shift; cmd_voice_bind "$@" ;;
  voice-target) shift; cmd_voice_target "$@" ;;
  manage)   shift; cmd_manage "$@" ;;
  tui)      shift; cmd_manage "$@" ;;
  -h|--help)
    cmd_help
    ;;
  *)
    echo ""
    echo "  ✗ $(_t '알 수 없는 명령: {cmd}' cmd="$1")"
    cmd_help
    exit 1
    ;;
esac
